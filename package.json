{
  "name": "smoke-api-cli",
  "version": "1.0.0",
  "description": "API 冒烟测试命令行工具 - 面向测试工程师的日常工作流",
  "type": "module",
  "bin": {
    "smoke-api": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "dev:bun": "bun run src/cli.ts",
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node20 --outfile=dist/cli.js --format=esm --banner:js=\"#!/usr/bin/env node\"",
    "build:bun": "bun build src/cli.ts --outdir dist --target bun --minify",
    "build:exe": "bun build src/cli.ts --compile --outfile smoke-api",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "vitest run",
    "test:bun": "bun test",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run build",
    "release": "npm version patch && npm publish",
    "release:minor": "npm version minor && npm publish",
    "release:major": "npm version major && npm publish"
  },
  "keywords": [
    "api",
    "testing",
    "smoke-test",
    "cli",
    "bun",
    "typescript"
  ],
  "author": "QA Engineering Team",
  "license": "MIT",
  "dependencies": {
    "yargs": "^17.7.2",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "yaml": "^2.4.1",
    "zod": "^3.23.8",
    "jsonpath-plus": "^8.0.0",
    "p-limit": "^5.0.0",
    "junit-report-builder": "^3.2.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/yargs": "^17.0.32",
    "@types/node": "^20.12.0",
    "typescript": "^5.4.5",
    "tsx": "^4.7.1",
    "esbuild": "^0.20.2",
    "vitest": "^1.5.0",
    "@vitest/coverage-v8": "^1.5.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.1.0"
  }
}
