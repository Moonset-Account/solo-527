{
  "name": "dental-clinic-system",
  "version": "1.0.0",
  "description": "连锁口腔处方收费台系统",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev --workspace=backend\" \"npm:start --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run start --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "start:prod": "npm run start:prod --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  }
}
