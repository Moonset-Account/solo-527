{
  "name": "pet-fostering-station",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev -w @pet-fostering/server",
    "dev:client": "npm run dev -w @pet-fostering/client",
    "build": "npm run build -w @pet-fostering/server && npm run build -w @pet-fostering/client",
    "db:generate": "npm run db:generate -w @pet-fostering/server",
    "db:migrate": "npm run db:migrate -w @pet-fostering/server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5"
  }
}
