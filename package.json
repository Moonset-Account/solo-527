{
  "name": "circuit-sandbox",
  "version": "1.0.0",
  "description": "电子电路沙盒 - 教育电路仿真工具",
  "private": true,
  "scripts": {
    "build": "esbuild src/main.ts --bundle --outfile=dist/bundle.js --format=iife --target=es2020 --minify",
    "dev": "esbuild src/main.ts --bundle --outfile=dist/bundle.js --format=iife --target=es2020 --sourcemap --watch",
    "start": "npx http-server . -p 8080 -c-1"
  },
  "devDependencies": {
    "esbuild": "^0.20.0",
    "http-server": "^14.1.1",
    "typescript": "^5.9.3"
  }
}
