{
  "name": "api-smoke-tester",
  "version": "1.0.0",
  "description": "API冒烟测试命令行工具 - 支持集合管理、鉴权、并发执行、断言报告和失败重试",
  "bin": {
    "api-smoke": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "cli": "node dist/cli.js",
    "cli:dev": "ts-node src/cli.ts",
    "test": "jest --config jest.config.js",
    "test:coverage": "jest --config jest.config.js --coverage",
    "lint": "eslint src/**/*.ts",
    "completion:bash": "node dist/cli.js completion bash",
    "completion:zsh": "node dist/cli.js completion zsh"
  },
  "keywords": [
    "api",
    "testing",
    "smoke-test",
    "cli",
    "http",
    "integration-test"
  ],
  "author": "DevOps Team",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "axios": "^1.6.5",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "fast-xml-parser": "^4.3.3",
    "js-yaml": "^4.1.0",
    "jsonpath-plus": "^7.2.0",
    "ora": "^5.4.1",
    "p-limit": "^3.1.0",
    "table": "^6.8.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.6",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
