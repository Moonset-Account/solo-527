# ============================================================
# 销售邮件知识检索助手 - 根环境变量模板
# 复制此文件到各子目录并按实际情况修改
# ============================================================

# ---------- 后端环境变量 (backend/.env) ----------
BACKEND_APP_KEY=your-32-char-random-secret-key-here-please
BACKEND_APP_NAME=SalesEmailAssistant
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3333
BACKEND_TZ=Asia/Shanghai
BACKEND_NODE_ENV=development

# PostgreSQL 数据库
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=sales_email_assistant

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# LLM 提供商配置（当前使用 Mock 模拟，可替换为真实 API）
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o
LLM_API_KEY=your-llm-api-key
LLM_API_BASE_URL=https://api.openai.com/v1

# ---------- 前端环境变量 (frontend/.env) ----------
VITE_APP_TITLE=销售邮件知识检索助手
VITE_API_BASE_URL=http://localhost:3333/api/v1
VITE_USE_MOCK=true
VITE_APP_VERSION=1.0.0
