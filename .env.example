# ========================================
# 汽车保养客户回访系统 - 环境变量配置示例
# ========================================

# 复制此文件为 .env 并修改实际值
# cp .env.example .env

# ========================================
# 服务端口配置
# ========================================

# 后端服务端口
PORT=3000

# 前端开发服务器端口（Vite 默认 5173）
VITE_PORT=5173

# ========================================
# MongoDB 数据库配置
# ========================================

# MongoDB 连接地址
# 本地开发使用 docker-compose 启动的 MongoDB
MONGODB_URI=mongodb://localhost:27017/auto_maintenance

# MongoDB 用户名（可选，生产环境建议配置）
MONGODB_USERNAME=

# MongoDB 密码（可选，生产环境建议配置）
MONGODB_PASSWORD=

# ========================================
# Redis 缓存配置
# ========================================

# Redis 主机地址
REDIS_HOST=localhost

# Redis 端口
REDIS_PORT=6379

# Redis 密码（可选，生产环境建议配置）
REDIS_PASSWORD=

# Redis 数据库编号
REDIS_DB=0

# ========================================
# JWT 认证配置
# ========================================

# JWT 密钥（请修改为复杂的随机字符串）
JWT_SECRET=your-secret-key-change-me-in-production

# JWT Token 过期时间（例如：1d = 1天，2h = 2小时）
JWT_EXPIRES_IN=1d

# ========================================
# 跨域配置
# ========================================

# 允许的跨域来源（多个域名用逗号分隔）
CORS_ORIGIN=http://localhost:5173

# ========================================
# 日志配置
# ========================================

# 日志级别: debug, info, warn, error
LOG_LEVEL=info

# 日志文件路径（可选）
LOG_FILE=./logs/app.log

# ========================================
# 业务配置
# ========================================

# 默认管理员密码（初始化时使用）
DEFAULT_ADMIN_PASSWORD=admin123

# 文件上传目录
UPLOAD_DIR=./uploads

# 最大上传文件大小（MB）
MAX_FILE_SIZE=10
