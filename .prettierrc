{
	"name": "Cold Chain Temperature Tracking Analytics",
	"description": "冷链物流温控追踪分析系统 - SvelteKit + Apache ECharts + DuckDB",
	"tabWidth": 2,
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"plugins": ["prettier-plugin-svelte", "prettier-plugin-tailwindcss"],
	"pluginSearchDirs": ["."],
	"overrides": [{ "files": "*.svelte", "options": { "parser": "svelte" } }]
}
