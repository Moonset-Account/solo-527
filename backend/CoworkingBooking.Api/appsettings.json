{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=CoworkingBooking;User Id=sa;Password=YourPassword123!;TrustServerCertificate=True;",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "Jwt": {
    "Secret": "your-super-secret-key-for-jwt-token-generation-must-be-at-least-32-characters",
    "Issuer": "CoworkingBooking",
    "Audience": "CoworkingBookingUsers",
    "ExpireHours": "24"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
}
