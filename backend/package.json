{
  "name": "tea-inventory-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node bin/server.js",
    "dev": "node ace.js serve --watch",
    "build": "node ace.js build",
    "test": "node ace.js test",
    "migrate": "node ace.js migration:run",
    "seed": "node ace.js db:seed"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#models/*": "./app/models/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js",
    "#database/*": "./database/*.js"
  },
  "dependencies": {
    "@adonisjs/auth": "^9.2.4",
    "@adonisjs/core": "^6.14.0",
    "@adonisjs/cors": "^2.2.1",
    "@adonisjs/lucid": "^21.3.0",
    "@adonisjs/redis": "^9.1.0",
    "@adonisjs/validator": "^13.0.2",
    "@vinejs/vine": "^2.1.0",
    "ioredis": "^5.4.1",
    "luxon": "^3.5.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.8.2",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
