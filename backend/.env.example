PORT=3333
HOST=0.0.0.0
NODE_ENV=development
APP_KEY=G8b8JfH2dKp5mN7qR9sT3wX6yA1cE4gU
LOG_LEVEL=info
DRIVE_DISK=local

# ========== 数据库配置 ==========
DB_CONNECTION=pg
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB_NAME=appliance_repair

# ========== Redis 配置 ==========
REDIS_CONNECTION=local
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ========== Session 配置 ==========
SESSION_DRIVER=redis

# ========== 功能开关 ==========
# 是否启用演示数据（生产环境必须设为 false）
# 启用后创建的订单会标记为 is_demo=true，正式统计会排除
ENABLE_DEMO_DATA=false

# ========== 上传配置 ==========
UPLOAD_MAX_SIZE=10mb
UPLOAD_MAX_FILES=5

# ========== 业务配置 ==========
# 默认服务区域
DEFAULT_SERVICE_AREA=全市

# ========== 管理员初始账号 ==========
# 首次启动时用于创建管理员账号
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456

# ========== CORS 配置 ==========
# 允许的前端域名，多个用逗号分隔
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
