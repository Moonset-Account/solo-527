# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/summit_ticket?schema=public"

# JWT
JWT_ACCESS_SECRET="summit-access-secret-change-in-production"
JWT_REFRESH_SECRET="summit-refresh-secret-change-in-production"
JWT_ACCESS_EXPIRES_IN="2h"
JWT_REFRESH_EXPIRES_IN="7d"

# SMTP (for notifications)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@example.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="峰会组委会 <noreply@example.com>"

# Server
PORT=3001
CORS_ORIGIN="http://localhost:4200"
