generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ORGANIZER
  INTERNAL
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
  REFUNDING
}

enum CheckInStatus {
  PENDING
  SUCCESS
  FAILED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum TodoStatus {
  PENDING
  IN_PROGRESS
  DONE
  OVERDUE
}

enum TodoPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  name      String
  role      Role
  avatar    String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders     Order[]
  checkIns   CheckIn[]
  todos      Todo[]
  notifications Notification[]
  savedFilters SavedFilter[]
  feedbacks  Feedback[]
}

model Event {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  poster      String?
  venue       String
  startTime   DateTime
  endTime     DateTime
  status      String   @default("DRAFT")
  organizerId Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizer   User     @relation(fields: [organizerId], references: [id])
  sessions    Session[]
  tickets     Ticket[]
  orders      Order[]
  checkIns    CheckIn[]
  feedbacks   Feedback[]
  revenueLogs RevenueLog[]
}

model Session {
  id         Int      @id @default(autoincrement())
  eventId    Int
  name       String
  startTime  DateTime
  endTime    DateTime
  totalSeats Int      @default(0)
  soldSeats  Int      @default(0)
  checkedIn  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  event     Event    @relation(fields: [eventId], references: [id])
  seats     Seat[]
  orderItems OrderItem[]
  checkIns  CheckIn[]
}

model Seat {
  id         Int      @id @default(autoincrement())
  sessionId  Int
  row        String
  number     String
  zone       String
  price      Decimal  @db.Decimal(10, 2)
  status     String   @default("AVAILABLE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  session   Session  @relation(fields: [sessionId], references: [id])
  orderItem OrderItem?
}

model Ticket {
  id        Int      @id @default(autoincrement())
  eventId   Int
  name      String
  type      String
  price     Decimal  @db.Decimal(10, 2)
  quantity  Int
  sold      Int      @default(0)
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event     Event    @relation(fields: [eventId], references: [id])
  orderItems OrderItem[]
}

model Order {
  id             Int      @id @default(autoincrement())
  orderNo        String   @unique
  userId         Int
  eventId        Int
  totalAmount    Decimal  @db.Decimal(10, 2)
  status         OrderStatus @default(PENDING)
  paymentMethod  String?
  paidAt         DateTime?
  remark         String?
  sourceOrder    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  event     Event      @relation(fields: [eventId], references: [id])
  items     OrderItem[]
  refunds   Refund[]
  checkIns  CheckIn[]
  feedbacks Feedback[]
  revenueLogs RevenueLog[]
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  ticketId   Int?
  sessionId  Int?
  seatId     Int?
  seatName   String?
  ticketName String
  price      Decimal  @db.Decimal(10, 2)
  quantity   Int
  status     String   @default("VALID")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  order    Order    @relation(fields: [orderId], references: [id])
  ticket   Ticket?  @relation(fields: [ticketId], references: [id])
  session  Session? @relation(fields: [sessionId], references: [id])
  seat     Seat?    @relation(fields: [seatId], references: [id])
  checkIns CheckIn[]
}

model CheckIn {
  id              Int      @id @default(autoincrement())
  orderId         Int
  orderItemId     Int
  eventId         Int
  sessionId       Int
  userId          Int
  operatorId      Int?
  status          CheckInStatus @default(PENDING)
  checkInCode     String?
  checkedInAt     DateTime?
  failureReason   String?
  handleRemark    String?
  sourceOrder     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  order    Order    @relation(fields: [orderId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  event    Event    @relation(fields: [eventId], references: [id])
  session  Session  @relation(fields: [sessionId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  operator User?    @relation(fields: [operatorId], references: [id])
}

model Refund {
  id             Int      @id @default(autoincrement())
  orderId        Int
  orderItemId    Int?
  userId         Int
  operatorId     Int?
  amount         Decimal  @db.Decimal(10, 2)
  status         RefundStatus @default(PENDING)
  reason         String?
  handleRemark   String?
  sourceOrder    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order    Order  @relation(fields: [orderId], references: [id])
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id])
  user     User   @relation(fields: [userId], references: [id])
  operator User?  @relation(fields: [operatorId], references: [id])
}

model RevenueLog {
  id          Int      @id @default(autoincrement())
  eventId     Int
  orderId     Int?
  type        String
  amount      Decimal  @db.Decimal(10, 2)
  balance     Decimal  @db.Decimal(10, 2)
  description String
  sourceOrder String?
  operatorId  Int?
  createdAt   DateTime @default(now())

  event    Event  @relation(fields: [eventId], references: [id])
  order    Order? @relation(fields: [orderId], references: [id])
  operator User?  @relation(fields: [operatorId], references: [id])
}

model Feedback {
  id          Int      @id @default(autoincrement())
  eventId     Int
  orderId     Int
  userId      Int
  rating      Int
  content     String?
  feedbackType String
  sourceOrder String?
  handleRemark String?
  createdAt   DateTime @default(now())

  event    Event  @relation(fields: [eventId], references: [id])
  order    Order  @relation(fields: [orderId], references: [id])
  user     User   @relation(fields: [userId], references: [id])
}

model Todo {
  id            Int      @id @default(autoincrement())
  userId        Int
  title         String
  description   String?
  status        TodoStatus @default(PENDING)
  priority      TodoPriority @default(MEDIUM)
  relatedType   String?
  relatedId     Int?
  dueDate       DateTime?
  isOverdue     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User   @relation(fields: [userId], references: [id])
}

model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int
  type        String
  title       String
  content     String
  relatedType String?
  relatedId   Int?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user     User   @relation(fields: [userId], references: [id])
}

model SavedFilter {
  id         Int      @id @default(autoincrement())
  userId     Int
  pageKey    String
  name       String
  filterData Json
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User   @relation(fields: [userId], references: [id])

  @@unique([userId, pageKey, name])
}
