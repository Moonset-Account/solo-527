generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Property {
  id                String   @id @default(uuid())
  title             String
  address           String
  area              Float
  monthlyRent       Decimal  @db.Decimal(10, 2)
  layout            String
  floor             String
  orientation       String
  status            PropertyStatus @default(VACANT)
  vacancyDays       Int      @default(0)
  landlordId        String
  landlordName      String
  escrowManagerId   String?
  escrowManagerName String?
  escrowCloseReason String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  viewings    Viewing[]
  contracts   Contract[]
  followUps   ConsultantFollowUp[]
}

enum PropertyStatus {
  VACANT
  RESERVED
  OCCUPIED
  UNDER_MAINTENANCE
  PROCESSING
  ANOMALOUS
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  phone     String
  idCard    String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  viewings   Viewing[]
  contracts  Contract[]
  followUps  ConsultantFollowUp[]
}

model Consultant {
  id        String   @id @default(uuid())
  name      String
  phone     String
  role      String   @default("consultant")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  followUps ConsultantFollowUp[]
  viewings  Viewing[]
  contracts Contract[]
}

model ConsultantFollowUp {
  id             String   @id @default(uuid())
  consultantId   String
  tenantId       String
  propertyId     String?
  content        String
  followUpType   FollowUpType
  nextFollowUpAt DateTime?
  createdAt      DateTime @default(now())

  consultant Consultant @relation(fields: [consultantId], references: [id])
  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  property   Property?  @relation(fields: [propertyId], references: [id])
}

enum FollowUpType {
  PHONE_CALL
  SITE_VISIT
  CONTRACT_DISCUSSION
  ISSUE_RESOLUTION
  RENT_REMINDER
  OTHER
}

model Viewing {
  id           String   @id @default(uuid())
  tenantId     String
  propertyId   String
  consultantId String?
  scheduledAt  DateTime
  status       ViewingStatus @default(PENDING)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  property   Property    @relation(fields: [propertyId], references: [id])
  consultant Consultant? @relation(fields: [consultantId], references: [id])
}

enum ViewingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Contract {
  id            String   @id @default(uuid())
  tenantId      String
  propertyId    String
  consultantId  String?
  startDate     DateTime
  endDate       DateTime
  monthlyRent   Decimal  @db.Decimal(10, 2)
  depositAmount Decimal  @db.Decimal(10, 2)
  paymentDay    Int      @default(1)
  attachmentUrl String?
  reviewStatus  ContractReviewStatus @default(DRAFT)
  signStatus    ContractSignStatus   @default(PENDING_SIGN)
  rejectReason  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  property   Property    @relation(fields: [propertyId], references: [id])
  consultant Consultant? @relation(fields: [consultantId], references: [id])
  bills      Bill[]
}

enum ContractReviewStatus {
  DRAFT
  PENDING_REVIEW
  REVIEWING
  APPROVED
  REJECTED
  ANOMALOUS
}

enum ContractSignStatus {
  PENDING_SIGN
  SIGNING
  SIGNED
  TERMINATED
  ANOMALOUS
}

model Bill {
  id          String    @id @default(uuid())
  contractId  String
  billType    BillType
  amount      Decimal   @db.Decimal(10, 2)
  dueDate     DateTime
  paidDate    DateTime?
  status      BillStatus @default(PENDING)
  overdueDays Int       @default(0)
  remark      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  contract Contract @relation(fields: [contractId], references: [id])
}

enum BillType {
  DEPOSIT
  RENT
  UTILITY
  MANAGEMENT_FEE
  PENALTY
}

enum BillStatus {
  PENDING
  PROCESSING
  PAID
  OVERDUE
  ANOMALOUS
  CANCELLED
}

model Todo {
  id           String        @id @default(uuid())
  sourceType   TodoSourceType
  sourceId     String?
  title        String
  description  String?
  priority     TodoPriority  @default(MEDIUM)
  status       TodoStatus    @default(OPEN)
  assignedTo   String?
  closedReason String?
  dueDate      DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum TodoSourceType {
  OVERDUE_RENT
  CONTRACT_ANOMALY
  VACANCY_ALERT
  REVIEW_REQUIRED
  ESCROW_CLOSURE
  OTHER
}

enum TodoPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TodoStatus {
  OPEN
  IN_PROGRESS
  PENDING_CONFIRM
  CLOSED
}

model ChangeLog {
  id             String   @id @default(uuid())
  entityType     String
  entityId       String
  action         String
  beforeSnapshot Json?
  afterSnapshot  Json?
  operatorId     String?
  operatorName   String?
  remark         String?
  createdAt      DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
