{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "./build",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["@types/node"],
    "baseUrl": ".",
    "paths": {
      "#controllers/*": ["./app/controllers/*.js", "./app/controllers/*.ts"],
      "#models/*": ["./app/models/*.js", "./app/models/*.ts"],
      "#middleware/*": ["./app/middleware/*.js", "./app/middleware/*.ts"],
      "#exceptions/*": ["./app/exceptions/*.js", "./app/exceptions/*.ts"],
      "#start/*": ["./start/*.js", "./start/*.ts"],
      "#config/*": ["./config/*.js", "./config/*.ts"],
      "#database/*": ["./database/*.js", "./database/*.ts"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "build"]
}
