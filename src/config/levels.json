    "knowledgeCards": [
      {
        "id": "kc_solvent",
        "title": "什么是溶剂？",
        "content": "溶剂是能够溶解其他物质的液体。水是最常用的溶剂，被称为\"万能溶剂\"。实验中使用蒸馏水可以避免杂质干扰。",
        "category": "concept",
        "icon": "FlaskConical"
      },
      {
        "id": "kc_solute",
        "title": "溶质与溶液",
        "content": "被溶解的物质叫溶质，溶质+溶剂=溶液。氯化钠（NaCl）是食盐的主要成分，易溶于水形成无色透明的盐水溶液。",
        "category": "concept",
        "icon": "Beaker"
      },
      {
        "id": "kc_stirring",
        "title": "为什么要搅拌？",
        "content": "搅拌可以加速溶质分子扩散，使溶解更快更均匀。但注意搅拌速度不宜过快，避免溶液溅出造成误差或危险。",
        "category": "concept",
        "icon": "CircleDot"
      }
    ],
    "safetyNotes": [
      "本实验所有试剂均为安全等级",
      "试剂取用要注意不要超过容器容量的2/3",
      "搅拌时防止溶液溅出"
    ]
  },
