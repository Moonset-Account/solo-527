      "choices": [{"text": "开始工作", "action": "close"}]
    },
    {
      "trigger": "task_completed",
      "task_type": "any",
      "type": "dialog",
      "title": "🎉 任务完成！",
      "content": "第一个任务完成了！满意度上升！继续完成其他任务吧。按 E 键或结束回合按钮进入下一回合。",
      "choices": [{"text": "继续加油", "action": "close"}]
    }
  ],
  "tutorial_hints": true
