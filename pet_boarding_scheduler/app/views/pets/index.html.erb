<div id="flashes"></div>

<div class="max-w-7xl mx-auto px-4">
  <div class="flex flex-wrap justify-between items-center mb-6 gap-4">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 flex items-center gap-3">
        <span>🐾</span> 宠物档案中心
      </h1>
      <p class="text-gray-500 mt-1">提交您的宠物信息，我们将为您提供贴心的寄养服务</p>
    </div>
    <%= link_to new_pet_path,
                class: "bg-gradient-to-r from-indigo-500 to-purple-600 text-white px-6 py-3 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all hover:scale-105" do %>
      <span class="flex items-center gap-2">
        <span>➕</span> 新建宠物档案
      </span>
    <% end %>
  </div>

  <div class="bg-white rounded-xl shadow-sm border p-4 mb-6">
    <%= form_with url: pets_path, method: :get, local: true, class: "flex flex-wrap gap-3 items-end" do |f| %>
      <div class="flex-1 min-w-48">
        <label class="block text-xs text-gray-500 mb-1">搜索宠物名称/主人</label>
        <input type="text" name="q[name_or_owner_name_cont]" value="<%= params.dig(:q, :name_or_owner_name_cont) %>"
               class="w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
               placeholder="输入宠物名或主人姓名...">
      </div>
      <div>
        <label class="block text-xs text-gray-500 mb-1">种类</label>
        <%= select_tag "q[species_eq]",
                       options_for_select(["狗", "猫", "其他"], params.dig(:q, :species_eq)),
                       { include_blank: "全部", class: "rounded-lg border-gray-300 shadow-sm" } %>
      </div>
      <div>
        <button type="submit" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-5 py-2 rounded-lg font-medium">搜索</button>
      </div>
    <% end %>
  </div>

  <div class="bg-white rounded-xl shadow-sm border overflow-hidden">
    <div class="p-6">
      <% if @pets.any? %>
        <div id="pet_list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
          <% @pets.each do |pet| %>
            <%= link_to pet_path(pet), class: "group relative border-2 border-gray-100 rounded-2xl p-5 hover:shadow-xl hover:border-indigo-300 transition-all duration-300 block bg-gradient-to-br from-white to-gray-50" do %>
              <div class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 transition">
                <span class="text-xs bg-indigo-100 text-indigo-700 px-2 py-1 rounded-full">查看详情 →</span>
              </div>
              <div class="flex items-center mb-4">
                <div class="text-5xl mr-4 transform group-hover:scale-110 transition-transform duration-300">
                  <%= pet.species == "狗" ? "🐕" : "🐱" %>
                </div>
                <div class="flex-1 min-w-0">
                  <h3 class="font-bold text-xl text-gray-900 truncate"><%= pet.name %></h3>
                  <p class="text-sm text-gray-500 truncate"><%= pet.breed || pet.species %></p>
                </div>
              </div>
              <div class="space-y-1.5 text-sm">
                <div class="flex justify-between text-gray-600">
                  <span class="text-gray-400">年龄</span>
                  <span class="font-medium"><%= pet.age ? "#{pet.age}岁" : "未填" %></span>
                </div>
                <div class="flex justify-between text-gray-600">
                  <span class="text-gray-400">体重</span>
                  <span class="font-medium"><%= pet.weight ? "#{pet.weight}kg" : "未填" %></span>
                </div>
                <div class="flex justify-between text-gray-600">
                  <span class="text-gray-400">性别</span>
                  <span class="font-medium"><%= pet.gender || "未填" %></span>
                </div>
              </div>
              <div class="mt-4 pt-3 border-t border-gray-100">
                <div class="flex items-center gap-2">
                  <span class="text-gray-400 text-xs">👤</span>
                  <span class="text-sm text-gray-600 font-medium truncate"><%= pet.owner_name %></span>
                </div>
                <% if pet.current_reservation %>
                  <div class="mt-2 px-3 py-1.5 bg-green-100 text-green-700 text-xs rounded-full text-center font-semibold animate-pulse">
                    🏠 当前寄养中
                  </div>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-16">
          <div class="text-7xl mb-4">🐾</div>
          <h3 class="text-xl font-semibold text-gray-700 mb-2">还没有宠物档案</h3>
          <p class="text-gray-500 mb-6">点击上方"新建宠物档案"开始提交</p>
          <%= link_to "立即创建", new_pet_path, class: "bg-indigo-600 text-white px-6 py-3 rounded-xl font-semibold hover:bg-indigo-700 transition" %>
        </div>
      <% end %>
    </div>
  </div>

  <% if @pagy&.pages&.>1 %>
    <div class="mt-6 flex justify-center">
      <%= pagy_nav(@pagy) %>
    </div>
  <% end %>
</div>
