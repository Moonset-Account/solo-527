<%= turbo_stream.append :flashes do %>
  <div class="fixed top-4 right-4 z-50 bg-green-50 border-2 border-green-300 text-green-800 px-6 py-4 rounded-lg shadow-xl animate-bounce-in" id="flash-notice">
    <div class="flex items-center gap-3">
      <span class="text-2xl">✅</span>
      <div>
        <p class="font-bold">宠物档案创建成功！</p>
        <p class="text-sm"><%= link_to "查看 #{@pet.name} 的档案", pet_path(@pet), class: "underline hover:text-green-900" %></p>
      </div>
      <button onclick="document.getElementById('flash-notice').style.display='none'" class="text-green-600 hover:text-green-800 ml-4 text-xl">×</button>
    </div>
  </div>
<% end %>

<%= turbo_stream.replace :pet_form do %>
  <%= render partial: "pets/form", locals: { pet: Pet.new } %>
<% end %>

<%= turbo_stream.prepend :pet_list do %>
  <div class="border rounded-lg p-4 hover:shadow-md transition block animate-slide-in" id="pet_<%= @pet.id %>">
    <%= link_to pet_path(@pet), class: "block" do %>
      <div class="flex items-center mb-3">
        <div class="text-4xl mr-3"><%= @pet.species == "狗" ? "🐕" : "🐱" %></div>
        <div>
          <h3 class="font-semibold text-gray-900"><%= @pet.name %></h3>
          <p class="text-sm text-gray-500"><%= @pet.breed || @pet.species %></p>
        </div>
      </div>
      <div class="space-y-1 text-sm text-gray-600">
        <p>年龄：<%= @pet.age ? "#{@pet.age}岁" : "未填写" %></p>
        <p>体重：<%= @pet.weight ? "#{@pet.weight}kg" : "未填写" %></p>
        <p>主人：<%= @pet.owner_name %></p>
      </div>
    <% end %>
  </div>
<% end %>
