<%= turbo_frame_tag :pet_form do %>
  <div class="bg-white rounded-xl shadow-sm border p-6">
    <%= form_with model: pet, id: "pet-form", data: { turbo: true } do |form| %>
      <% if pet.errors.any? %>
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
          <p class="font-medium"><%= pluralize(pet.errors.count, "个错误") %> 导致保存失败：</p>
          <ul class="mt-2 text-sm list-disc list-inside">
            <% pet.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="space-y-6">
        <fieldset>
          <legend class="text-lg font-medium text-gray-900 mb-4">🐾 基本信息</legend>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <%= form.label :name, "宠物名称", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.text_field :name, required: true, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
            </div>
            <div>
              <%= form.label :species, "宠物种类", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.select :species, ["狗", "猫", "其他"], { include_blank: "请选择", required: true }, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
            </div>
            <div>
              <%= form.label :breed, "品种", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.text_field :breed, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", placeholder: "如：拉布拉多、英短等" %>
            </div>
            <div>
              <%= form.label :gender, "性别", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.select :gender, ["公", "母"], { include_blank: "请选择" }, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
            </div>
            <div>
              <%= form.label :age, "年龄（岁）", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.number_field :age, min: 0, max: 30, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
            </div>
            <div>
              <%= form.label :weight, "体重（kg）", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.number_field :weight, step: "0.1", min: 0, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
            </div>
          </div>
        </fieldset>

        <fieldset>
          <legend class="text-lg font-medium text-gray-900 mb-4">👤 主人信息</legend>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <%= form.label :owner_name, "主人姓名", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.text_field :owner_name, required: true, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
            </div>
            <div>
              <%= form.label :owner_phone, "联系电话", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.text_field :owner_phone, required: true, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", placeholder: "手机号" %>
            </div>
            <div class="md:col-span-2">
              <%= form.label :owner_email, "电子邮箱（选填）", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.email_field :owner_email, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", placeholder: "用于接收通知" %>
            </div>
          </div>
        </fieldset>

        <fieldset>
          <legend class="text-lg font-medium text-gray-900 mb-4">🏥 健康与特殊需求</legend>
          <div class="space-y-4">
            <div>
              <%= form.label :medical_notes, "医疗记录（疫苗、病史等）", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.text_area :medical_notes, rows: 2, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", placeholder: "如：已接种三联疫苗，每年加强一次..." %>
            </div>
            <div>
              <%= form.label :allergies, "过敏史", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.text_field :allergies, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", placeholder: "如：对鸡肉过敏、对某种药物过敏..." %>
            </div>
            <div>
              <%= form.label :special_needs, "特殊需求（喂养、护理注意事项）", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.text_area :special_needs, rows: 2, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", placeholder: "如：每天早晚各喂一次，需要安静环境..." %>
            </div>
          </div>
        </fieldset>

        <div class="flex justify-end gap-3 pt-4 border-t">
          <%= form.submit "提交档案",
              class: "bg-indigo-600 text-white px-8 py-2.5 rounded-lg font-medium hover:bg-indigo-700 shadow-md hover:shadow-lg transition-all cursor-pointer",
              data: { disable_with: "提交中..." } %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
