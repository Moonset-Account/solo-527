<div class="max-w-6xl mx-auto">
  <%= turbo_stream_from "pet_#{@pet.id}" %>

  <div class="bg-white rounded-xl shadow-sm border overflow-hidden mb-6">
    <div class="bg-gradient-to-r <%= @pet.species == '狗' ? 'from-blue-500 to-indigo-600' : 'from-pink-500 to-rose-500' %> text-white p-6">
      <div class="flex items-start justify-between">
        <div class="flex items-center">
          <div class="text-7xl mr-6 drop-shadow"><%= @pet.species == "狗" ? "🐕" : "🐱" %></div>
          <div>
            <h1 class="text-3xl font-bold"><%= @pet.name %></h1>
            <p class="text-white/80 mt-1"><%= @pet.breed || @pet.species %></p>
            <div class="flex gap-4 mt-3 text-sm">
              <span class="bg-white/20 px-3 py-1 rounded-full">
                年龄：<%= @pet.age ? "#{@pet.age}岁" : "未填写" %>
              </span>
              <span class="bg-white/20 px-3 py-1 rounded-full">
                体重：<%= @pet.weight ? "#{@pet.weight}kg" : "未填写" %>
              </span>
              <span class="bg-white/20 px-3 py-1 rounded-full">
                性别：<%= @pet.gender || "未填写" %>
              </span>
            </div>
          </div>
        </div>
        <% if @current_reservation %>
          <div class="bg-white/20 backdrop-blur-sm px-5 py-3 rounded-xl border border-white/30">
            <p class="font-bold text-lg">🏠 寄养中</p>
            <p class="text-sm text-white/80">入住：<%= @current_reservation.check_in_at.strftime("%Y-%m-%d") %></p>
            <p class="text-sm text-white/80">主理人：<%= @current_reservation.caretaker_name %></p>
            <p class="text-sm text-white/80">预计离店：<%= @current_reservation.check_out_at&.strftime("%Y-%m-%d") || "待定" %></p>
          </div>
        <% end %>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 p-6">
      <div class="bg-gray-50 rounded-xl p-4">
        <h3 class="font-semibold text-gray-800 mb-3 flex items-center gap-2">
          <span>👤</span> 主人信息
        </h3>
        <div class="space-y-2 text-sm text-gray-700">
          <p class="flex justify-between"><span class="text-gray-500">姓名</span><b><%= @pet.owner_name %></b></p>
          <p class="flex justify-between"><span class="text-gray-500">电话</span><b><%= @pet.owner_phone %></b></p>
          <p class="flex justify-between"><span class="text-gray-500">邮箱</span><b><%= @pet.owner_email || "未填写" %></b></p>
        </div>
      </div>
      <div class="bg-gray-50 rounded-xl p-4">
        <h3 class="font-semibold text-gray-800 mb-3 flex items-center gap-2">
          <span>🏥</span> 医疗信息
        </h3>
        <div class="space-y-2 text-sm">
          <p class="text-gray-500 mb-1">医疗记录</p>
          <p class="text-gray-700"><%= @pet.medical_notes.presence || "无特殊医疗记录" %></p>
          <p class="text-gray-700 mt-2">
            <span class="text-gray-500">过敏：</span>
            <% if @pet.allergies.present? %>
              <span class="px-2 py-0.5 bg-red-100 text-red-700 rounded text-xs"><%= @pet.allergies %></span>
            <% else %>
              <span class="text-green-600">无</span>
            <% end %>
          </p>
        </div>
      </div>
      <div class="bg-gray-50 rounded-xl p-4">
        <h3 class="font-semibold text-gray-800 mb-3 flex items-center gap-2">
          <span>⭐</span> 特殊需求
        </h3>
        <p class="text-sm text-gray-700 leading-relaxed"><%= @pet.special_needs.presence || "无特殊需求" %></p>
      </div>
    </div>
  </div>

  <% if @health_trend.any? %>
    <div class="bg-white rounded-xl shadow-sm border p-6 mb-6">
      <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
        <span>📈</span> 近期健康趋势
      </h2>
      <div class="h-48 flex items-end gap-2">
        <% max_score = 5.0 %>
        <% @health_trend.each do |point| %>
          <div class="flex-1 flex flex-col items-center gap-1 group">
            <% height_percent = point[:score] ? (point[:score] / max_score * 100) : 0 %>
            <div class="w-full rounded-t-lg transition-all duration-500 group-hover:opacity-80
                        <%= point[:label] == '良好' ? 'bg-gradient-to-t from-green-400 to-green-500' :
                           point[:label] == '一般' ? 'bg-gradient-to-t from-yellow-400 to-yellow-500' :
                           point[:label] == '较差' ? 'bg-gradient-to-t from-orange-400 to-orange-500' :
                           'bg-gradient-to-t from-red-400 to-red-500' %>"
                 style="height: <%= [height_percent, 8].max %>%">
            </div>
            <span class="text-xs font-semibold
                         <%= point[:label] == '良好' ? 'text-green-700' :
                            point[:label] == '一般' ? 'text-yellow-700' :
                            point[:label] == '较差' ? 'text-orange-700' : 'text-red-700' %>">
              <%= point[:score] ? sprintf("%.1f", point[:score]) : '-' %>
            </span>
            <span class="text-xs text-gray-500"><%= point[:date] %></span>
          </div>
        <% end %>
      </div>
      <div class="mt-4 flex gap-4 justify-center text-xs text-gray-600">
        <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-green-400"></span> 良好</span>
        <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-yellow-400"></span> 一般</span>
        <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-orange-400"></span> 较差</span>
        <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-red-400"></span> 需关注</span>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white rounded-xl shadow-sm border overflow-hidden">
      <div class="p-4 border-b bg-gradient-to-r from-pink-50 to-red-50 flex justify-between items-center">
        <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2">
          <span>❤️</span> 健康记录
        </h2>
        <span class="text-xs text-gray-500 bg-white px-2 py-1 rounded-full"><%= @health_records.size %> 条记录</span>
      </div>
      <div class="divide-y max-h-96 overflow-y-auto">
        <% if @health_records.any? %>
          <% @health_records.each do |record| %>
            <div class="p-4 hover:bg-gray-50 transition">
              <div class="flex justify-between items-start mb-2">
                <span class="text-sm font-medium text-gray-900 flex items-center gap-2">
                  📅 <%= record.recorded_at.strftime("%Y-%m-%d %H:%M") %>
                  <% if record.caretaker %>
                    <span class="text-xs text-gray-500">· 👤 <%= record.caretaker.name %></span>
                  <% end %>
                </span>
                <span class="text-xs px-2 py-1 rounded-full font-medium
                  <%= record.health_status == "良好" ? "bg-green-100 text-green-700" :
                     record.health_status == "一般" ? "bg-yellow-100 text-yellow-700" :
                     record.health_status == "较差" ? "bg-orange-100 text-orange-700" :
                     "bg-red-100 text-red-700" %>">
                  <%= record.health_status %>
                </span>
              </div>
              <div class="grid grid-cols-4 gap-2 text-xs mb-2">
                <div class="bg-gray-50 rounded p-2 text-center">
                  <p class="text-gray-500">🌡️ 体温</p>
                  <p class="font-semibold text-gray-800"><%= record.temperature ? "#{record.temperature}°C" : "-" %></p>
                </div>
                <div class="bg-gray-50 rounded p-2 text-center">
                  <p class="text-gray-500">⚖️ 体重</p>
                  <p class="font-semibold text-gray-800"><%= record.weight ? "#{record.weight}kg" : "-" %></p>
                </div>
                <div class="bg-gray-50 rounded p-2 text-center">
                  <p class="text-gray-500">🍽️ 食欲</p>
                  <p class="font-semibold text-gray-800"><%= record.appetite_display || "-" %></p>
                </div>
                <div class="bg-gray-50 rounded p-2 text-center">
                  <p class="text-gray-500">🏃 活动</p>
                  <p class="font-semibold text-gray-800"><%= record.activity_display || "-" %></p>
                </div>
              </div>
              <% if record.symptoms.present? %>
                <p class="text-xs text-red-600 bg-red-50 rounded p-2">⚠️ 症状：<%= record.symptoms %></p>
              <% end %>
              <% if record.notes.present? %>
                <p class="text-xs text-gray-500 mt-1">📝 <%= record.notes %></p>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <p class="text-gray-500 text-center py-12">暂无健康记录</p>
        <% end %>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border overflow-hidden">
      <div class="p-4 border-b bg-gradient-to-r from-orange-50 to-yellow-50 flex justify-between items-center">
        <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2">
          <span>🏋️</span> 训练记录
        </h2>
        <span class="text-xs text-gray-500 bg-white px-2 py-1 rounded-full"><%= @training_records.size %> 条记录</span>
      </div>
      <div class="divide-y max-h-96 overflow-y-auto">
        <% if @training_records.any? %>
          <% @training_records.each do |record| %>
            <div class="p-4 hover:bg-gray-50 transition">
              <div class="flex justify-between items-start mb-2">
                <div>
                  <span class="font-bold text-gray-900 flex items-center gap-2">
                    <%= record.service_name || "训练" %>
                    <% if record.caretaker %>
                      <span class="text-xs text-gray-500">👤 <%= record.caretaker.name %></span>
                    <% end %>
                  </span>
                  <p class="text-sm text-gray-500 mt-0.5">📅 <%= record.training_date %>
                    <% if record.duration_minutes.present? %>
                      · ⏱ <%= record.duration_minutes %>分钟
                    <% end %>
                  </p>
                </div>
                <span class="text-xs px-2 py-1 rounded-full font-medium
                  <%= record.status == "completed" ? "bg-green-100 text-green-700" :
                     record.status == "scheduled" ? "bg-blue-100 text-blue-700" :
                     record.status == "delayed" ? "bg-yellow-100 text-yellow-700" :
                     "bg-gray-100 text-gray-700" %>">
                  <%= { "scheduled" => "已安排", "completed" => "已完成", "delayed" => "延期", "cancelled" => "已取消" }[record.status] %>
                </span>
              </div>
              <% if record.content.present? %>
                <p class="text-sm text-gray-700 bg-gray-50 rounded p-2 mt-2"><%= record.content %></p>
              <% end %>
              <% if record.progress.present? %>
                <p class="text-sm text-green-700 bg-green-50 rounded p-2 mt-1">✅ <%= record.progress %></p>
              <% end %>
              <% if record.delayed? && record.delay_reason.present? %>
                <p class="text-xs text-yellow-700 bg-yellow-50 rounded p-2 mt-1">⏰ 延期原因：<%= record.delay_reason %></p>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <p class="text-gray-500 text-center py-12">暂无训练记录</p>
        <% end %>
      </div>
    </div>
  </div>

  <div class="mt-6 flex gap-3">
    <%= link_to "← 返回宠物列表", pets_path, class: "text-indigo-600 hover:text-indigo-700 font-medium" %>
  </div>
</div>
