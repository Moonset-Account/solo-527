<div class="max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">新增健康记录</h1>

  <div class="bg-white rounded-lg shadow-sm border p-6">
    <%= form_with model: [:admin, @health_record], local: true do |form| %>
      <% if @health_record.errors.any? %>
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
          <p class="font-medium"><%= pluralize(@health_record.errors.count, "个错误") %> 导致保存失败：</p>
          <ul class="mt-2 text-sm list-disc list-inside">
            <% @health_record.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= form.label :pet_id, "宠物", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.select :pet_id, @pets.map { |p| ["#{p.name} (#{p.species})", p.id] }, { include_blank: true }, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>
          <div>
            <%= form.label :caretaker_id, "主理人", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.select :caretaker_id, @caretakers.map { |c| [c.name, c.id] }, { include_blank: true }, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>
        </div>

        <div>
          <%= form.label :recorded_at, "记录时间", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.datetime_local_field :recorded_at, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= form.label :temperature, "体温 (°C)", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.number_field :temperature, step: "0.1", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>
          <div>
            <%= form.label :weight, "体重 (kg)", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.number_field :weight, step: "0.1", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= form.label :appetite_level, "食欲评分", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.select :appetite_level, [["很差", 1], ["较差", 2], ["一般", 3], ["良好", 4], ["很好", 5]], { include_blank: true }, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>
          <div>
            <%= form.label :activity_level, "活动量评分", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.select :activity_level, [["很低", 1], ["较低", 2], ["一般", 3], ["活跃", 4], ["很活跃", 5]], { include_blank: true }, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>
        </div>

        <div>
          <%= form.label :symptoms, "症状", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.text_area :symptoms, rows: 2, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>

        <div>
          <%= form.label :notes, "备注", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.text_area :notes, rows: 2, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>

        <div class="flex justify-end gap-3 pt-4 border-t">
          <%= link_to "取消", admin_health_records_path, class: "px-4 py-2 border rounded-lg text-gray-700 hover:bg-gray-50" %>
          <%= form.submit "创建记录", class: "bg-indigo-600 text-white px-6 py-2 rounded-lg font-medium hover:bg-indigo-700" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
