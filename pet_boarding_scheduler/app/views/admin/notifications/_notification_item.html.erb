<div id="<%= dom_id(notification) %>">
  <%= link_to admin_notification_path(notification),
              class: "block p-3 hover:bg-indigo-50 transition #{notification.is_read? ? 'bg-white' : 'bg-indigo-50/70'} border-b last:border-b-0",
              data: { turbo_frame: "_top" } do %>
  <div class="flex items-start">
    <div class="flex-shrink-0 mr-3 text-2xl">
      <%= case notification.notification_type
          when "health" then "❤️"
          when "training" then "🏋️"
          when "safety" then "⚠️"
          when "reservation" then "📅"
          when "system" then "🔔"
          else "🔔"
          end %>
    </div>
    <div class="flex-1 min-w-0">
      <div class="flex items-center justify-between">
        <p class="font-semibold text-gray-900 text-sm <%= 'font-bold' unless notification.is_read? %>">
          <%= notification.title %>
          <% unless notification.is_read? %>
            <span class="ml-1 w-2 h-2 inline-block bg-red-500 rounded-full align-middle animate-pulse"></span>
          <% end %>
        </p>
        <span class="text-xs text-gray-400 flex-shrink-0 ml-2">
          <%= notification.created_at.strftime("%H:%M") %>
        </span>
      </div>
      <p class="text-sm text-gray-600 mt-0.5 line-clamp-2"><%= notification.content %></p>
    </div>
  </div>
<% end %>
</div>
