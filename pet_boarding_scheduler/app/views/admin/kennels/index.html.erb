<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold text-gray-900">笼位管理</h1>
  <%= link_to "新增笼位", new_admin_kennel_path, class: "bg-indigo-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-indigo-700" %>
</div>

<div class="bg-white rounded-lg shadow-sm border overflow-hidden">
  <div class="p-4 border-b bg-gray-50">
    <div class="flex gap-6 text-sm">
      <span class="flex items-center">
        <span class="w-3 h-3 rounded-full bg-green-400 mr-2"></span>
        可用 (<%= Kennel.available.count %>)
      </span>
      <span class="flex items-center">
        <span class="w-3 h-3 rounded-full bg-blue-400 mr-2"></span>
        占用 (<%= Kennel.occupied.count %>)
      </span>
      <span class="flex items-center">
        <span class="w-3 h-3 rounded-full bg-gray-400 mr-2"></span>
        维修 (<%= Kennel.maintenance.count %>)
      </span>
    </div>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 p-6">
    <% @kennels.each do |kennel| %>
      <div class="border rounded-lg p-4 text-center
        <%= kennel.status == "available" ? "border-green-300 bg-green-50" :
           kennel.status == "occupied" ? "border-blue-300 bg-blue-50" :
           "border-gray-300 bg-gray-50" %>">
        <p class="font-bold text-gray-900 text-lg"><%= kennel.name %></p>
        <p class="text-xs text-gray-500 mb-2"><%= kennel.size_category %></p>
        <% if kennel.occupied? && kennel.current_pet %>
          <div class="text-2xl mb-1"><%= kennel.current_pet.species == "狗" ? "🐕" : "🐱" %></div>
          <p class="text-xs font-medium text-gray-700 truncate"><%= kennel.current_pet.name %></p>
        <% else %>
          <div class="text-2xl mb-1">
            <%= kennel.status == "available" ? "✅" : "🔧" %>
          </div>
          <p class="text-xs text-gray-500">
            <%= kennel.status == "available" ? "可用" : "维修中" %>
          </p>
        <% end %>
        <p class="text-xs text-gray-500 mt-2">¥<%= kennel.daily_rate %>/天</p>
        <%= link_to "详情", admin_kennel_path(kennel), class: "text-xs text-indigo-600 hover:text-indigo-700 mt-2 inline-block" %>
      </div>
    <% end %>
  </div>
</div>
