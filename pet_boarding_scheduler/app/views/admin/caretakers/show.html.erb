<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-900">主理人详情</h1>
  <div class="flex gap-2">
    <%= link_to "编辑", edit_admin_caretaker_path(@caretaker), class: "bg-indigo-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-indigo-700" %>
    <%= link_to "返回列表", admin_caretakers_path, class: "border text-gray-700 px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-50" %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="bg-white rounded-lg shadow-sm border p-6">
    <div class="text-center mb-6">
      <div class="w-20 h-20 bg-indigo-100 rounded-full flex items-center justify-center text-indigo-600 font-bold text-3xl mx-auto mb-3">
        <%= @caretaker.name.first %>
      </div>
      <h2 class="text-xl font-semibold text-gray-900"><%= @caretaker.name %></h2>
      <span class="text-xs px-2 py-1 rounded-full <%= @caretaker.active? ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-700' %>">
        <%= @caretaker.active? ? "在岗" : "离岗" %>
      </span>
    </div>

    <div class="space-y-3">
      <div class="flex justify-between text-sm">
        <span class="text-gray-500">电话</span>
        <span class="text-gray-900"><%= @caretaker.phone || "未填写" %></span>
      </div>
      <div class="flex justify-between text-sm">
        <span class="text-gray-500">邮箱</span>
        <span class="text-gray-900"><%= @caretaker.email || "未填写" %></span>
      </div>
      <div class="flex justify-between text-sm">
        <span class="text-gray-500">最大容量</span>
        <span class="text-gray-900"><%= @caretaker.max_pets_capacity %> 只</span>
      </div>
    </div>

    <% if @caretaker.bio.present? %>
      <div class="mt-6 pt-6 border-t">
        <h3 class="font-medium text-gray-900 mb-2">个人简介</h3>
        <p class="text-sm text-gray-600"><%= @caretaker.bio %></p>
      </div>
    <% end %>
  </div>

  <div class="lg:col-span-2 space-y-6">
    <div class="bg-white rounded-lg shadow-sm border p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">当前寄养宠物</h2>
      <% if @current_boardings.any? %>
        <div class="space-y-3">
          <% @current_boardings.each do |reservation| %>
            <div class="flex items-center justify-between p-3 border rounded">
              <div class="flex items-center">
                <span class="text-2xl mr-3"><%= reservation.pet.species == "狗" ? "🐕" : "🐱" %></span>
                <div>
                  <p class="font-medium text-gray-900"><%= reservation.pet.name %></p>
                  <p class="text-sm text-gray-500">入住：<%= reservation.check_in_at.strftime("%m-%d") %></p>
                </div>
              </div>
              <div class="text-sm text-gray-500">
                <%= reservation.kennel.name %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500 text-center py-8">当前没有寄养中的宠物</p>
      <% end %>
    </div>

    <div class="bg-white rounded-lg shadow-sm border p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">近期训练记录</h2>
      <% if @recent_trainings.any? %>
        <div class="space-y-3">
          <% @recent_trainings.each do |record| %>
            <div class="flex items-center justify-between p-3 border rounded">
              <div>
                <p class="font-medium text-gray-900"><%= record.service_name || "训练" %></p>
                <p class="text-sm text-gray-500"><%= record.pet_name %> · <%= record.training_date %></p>
              </div>
              <span class="text-xs px-2 py-1 rounded
                <%= record.status == "completed" ? "bg-green-100 text-green-700" :
                   record.status == "scheduled" ? "bg-blue-100 text-blue-700" :
                   record.status == "delayed" ? "bg-yellow-100 text-yellow-700" :
                   "bg-gray-100 text-gray-700" %>">
                <%= { "scheduled" => "已安排", "completed" => "已完成", "delayed" => "延期", "cancelled" => "已取消" }[record.status] %>
              </span>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500 text-center py-8">暂无训练记录</p>
      <% end %>
    </div>
  </div>
</div>
