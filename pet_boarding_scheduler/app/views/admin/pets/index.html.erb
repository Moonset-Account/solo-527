<div class="flex flex-wrap justify-between items-center mb-6 gap-4">
  <h1 class="text-2xl font-bold text-gray-900">🐾 宠物管理</h1>
  <%= link_to "新增宠物", new_admin_pet_path, class: "bg-indigo-600 text-white px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-indigo-700 shadow" %>
</div>

<div class="bg-white rounded-lg shadow-sm border p-4 mb-6">
  <%= form_with url: admin_pets_path, method: :get, local: true, class: "flex flex-wrap gap-3 items-end" do |f| %>
    <div class="flex-1 min-w-48">
      <label class="block text-xs text-gray-500 mb-1">搜索（名称/品种/主人）</label>
      <input type="text" name="q[name_or_breed_or_owner_name_cont]" value="<%= params.dig(:q, :name_or_breed_or_owner_name_cont) %>"
             class="w-full rounded-lg border-gray-300 text-sm shadow-sm"
             placeholder="输入关键词搜索...">
    </div>
    <div>
      <label class="block text-xs text-gray-500 mb-1">种类</label>
      <%= select_tag "q[species_eq]",
                     options_for_select(["狗", "猫", "其他"], params.dig(:q, :species_eq)),
                     { include_blank: "全部", class: "rounded-lg border-gray-300 text-sm" } %>
    </div>
    <div>
      <label class="block text-xs text-gray-500 mb-1">状态</label>
      <%= select_tag "q[active_eq]",
                     options_for_select([["活跃", true], ["停用", false]], params.dig(:q, :active_eq)),
                     { include_blank: "全部", class: "rounded-lg border-gray-300 text-sm" } %>
    </div>
    <div class="flex gap-2">
      <button type="submit" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium">搜索</button>
      <%= link_to "重置", admin_pets_path, class: "bg-gray-50 hover:bg-gray-100 text-gray-600 px-4 py-2 rounded-lg text-sm" %>
    </div>
  <% end %>
</div>

<div class="bg-white rounded-lg shadow-sm border overflow-hidden">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">宠物</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">品种/年龄</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">主人</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">寄养状态</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">健康记录</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">状态</th>
          <th class="px-4 py-3 text-right text-xs font-semibold text-gray-600 uppercase tracking-wider">操作</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @pets.each do |pet| %>
          <tr class="hover:bg-gray-50 transition">
            <td class="px-4 py-3 whitespace-nowrap">
              <div class="flex items-center">
                <span class="text-3xl mr-2"><%= pet.species == "狗" ? "🐕" : "🐱" %></span>
                <div>
                  <div class="font-semibold text-gray-900"><%= pet.name %></div>
                  <div class="text-xs text-gray-500"><%= pet.species %></div>
                </div>
              </div>
            </td>
            <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600">
              <p><%= pet.breed.presence || "-" %></p>
              <p class="text-xs text-gray-400">
                <%= [pet.age ? "#{pet.age}岁" : nil, pet.weight ? "#{pet.weight}kg" : nil].compact.join(" · ") %>
              </p>
            </td>
            <td class="px-4 py-3 whitespace-nowrap text-sm">
              <p class="font-medium text-gray-900"><%= pet.owner_name %></p>
              <p class="text-xs text-gray-500">📱 <%= pet.owner_phone %></p>
            </td>
            <td class="px-4 py-3 whitespace-nowrap">
              <% if pet.current_reservation %>
                <span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs font-medium">
                  🏠 寄养中
                </span>
                <p class="text-xs text-gray-500 mt-1">
                  至 <%= pet.current_reservation.check_out_at&.strftime("%m-%d") || "待定" %>
                </p>
              <% else %>
                <span class="px-2 py-1 bg-gray-100 text-gray-600 rounded-full text-xs">未寄养</span>
              <% end %>
            </td>
            <td class="px-4 py-3 whitespace-nowrap text-sm">
              <% latest = pet.latest_health_record %>
              <% if latest %>
                <span class="px-2 py-1 text-xs rounded-full
                  <%= latest.health_status == "良好" ? "bg-green-100 text-green-700" :
                     latest.health_status == "一般" ? "bg-yellow-100 text-yellow-700" :
                     latest.health_status == "较差" ? "bg-orange-100 text-orange-700" :
                     "bg-red-100 text-red-700" %>">
                  <%= latest.health_status %>
                </span>
                <p class="text-xs text-gray-400 mt-1"><%= latest.recorded_at.strftime("%m-%d") %></p>
              <% else %>
                <span class="text-xs text-gray-400">无记录</span>
              <% end %>
            </td>
            <td class="px-4 py-3 whitespace-nowrap">
              <% if pet.active? %>
                <span class="px-2 py-1 bg-green-50 text-green-700 rounded-full text-xs font-medium">活跃</span>
              <% else %>
                <span class="px-2 py-1 bg-gray-100 text-gray-500 rounded-full text-xs">已停用</span>
              <% end %>
            </td>
            <td class="px-4 py-3 whitespace-nowrap text-right text-sm font-medium">
              <%= link_to "详情", admin_pet_path(pet), class: "text-indigo-600 hover:text-indigo-900" %>
              <%= link_to "编辑", edit_admin_pet_path(pet), class: "text-gray-600 hover:text-gray-900 ml-2" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @pagy&.pages&.>1 %>
    <div class="px-4 py-3 border-t">
      <%= pagy_nav(@pagy) %>
    </div>
  <% end %>
</div>
