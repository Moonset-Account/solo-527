<div class="max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">新增训练记录</h1>

  <div class="bg-white rounded-lg shadow-sm border p-6">
    <%= form_with model: [:admin, @training_record], local: true do |form| %>
      <% if @training_record.errors.any? %>
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
          <p class="font-medium"><%= pluralize(@training_record.errors.count, "个错误") %> 导致保存失败：</p>
          <ul class="mt-2 text-sm list-disc list-inside">
            <% @training_record.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= form.label :pet_id, "宠物", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.select :pet_id, @pets.map { |p| ["#{p.name} (#{p.species})", p.id] }, { include_blank: true }, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>
          <div>
            <%= form.label :caretaker_id, "主理人", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.select :caretaker_id, @caretakers.map { |c| [c.name, c.id] }, { include_blank: true }, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= form.label :training_date, "训练日期", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.date_field :training_date, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>
          <div>
            <%= form.label :service_id, "服务项目", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.select :service_id, @services.map { |s| ["#{s.name} (#{s.formatted_duration})", s.id] }, { include_blank: true }, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= form.label :duration_minutes, "时长（分钟）", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.number_field :duration_minutes, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>
          <div>
            <%= form.label :status, "状态", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.select :status, [["已安排", "scheduled"], ["已完成", "completed"], ["延期", "delayed"], ["已取消", "cancelled"]], {}, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>
        </div>

        <div>
          <%= form.label :content, "训练内容", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.text_area :content, rows: 3, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>

        <div>
          <%= form.label :progress, "训练进度", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.text_area :progress, rows: 2, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>

        <div>
          <%= form.label :delay_reason, "延期原因", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.select :delay_reason, TrainingRecord::DELAY_REASONS, { include_blank: true }, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>

        <div>
          <%= form.label :notes, "备注", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.text_area :notes, rows: 2, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>

        <div class="flex justify-end gap-3 pt-4 border-t">
          <%= link_to "取消", admin_training_records_path, class: "px-4 py-2 border rounded-lg text-gray-700 hover:bg-gray-50" %>
          <%= form.submit "创建记录", class: "bg-indigo-600 text-white px-6 py-2 rounded-lg font-medium hover:bg-indigo-700" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
