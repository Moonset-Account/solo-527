<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold text-gray-900">🏋️ 训练记录</h1>
  <div class="flex gap-2">
    <%= link_to admin_exports_training_path(params.permit(:q).merge(format: :csv, async: true)),
                class: "bg-green-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-green-700" do %>
      📄 导出
    <% end %>
    <%= link_to "新增记录", new_admin_training_record_path, class: "bg-indigo-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-indigo-700" %>
  </div>
</div>

<div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
  <div class="bg-white rounded-lg shadow-sm border p-4 border-l-4 border-gray-400">
    <p class="text-xs text-gray-500">总记录</p>
    <p class="text-2xl font-bold text-gray-900"><%= @stats[:total] %></p>
  </div>
  <div class="bg-white rounded-lg shadow-sm border p-4 border-l-4 border-blue-400">
    <p class="text-xs text-gray-500">已安排</p>
    <p class="text-2xl font-bold text-blue-600"><%= @stats[:scheduled] %></p>
  </div>
  <div class="bg-white rounded-lg shadow-sm border p-4 border-l-4 border-green-400">
    <p class="text-xs text-gray-500">已完成</p>
    <p class="text-2xl font-bold text-green-600"><%= @stats[:completed] %></p>
  </div>
  <div class="bg-white rounded-lg shadow-sm border p-4 border-l-4 border-yellow-400">
    <p class="text-xs text-gray-500">延期</p>
    <p class="text-2xl font-bold text-yellow-600"><%= @stats[:delayed] %></p>
  </div>
</div>

<div class="bg-white rounded-lg shadow-sm border p-4 mb-6">
  <%= form_with url: admin_training_records_path, method: :get, local: true, class: "flex flex-wrap gap-3 items-end" do |f| %>
    <div class="flex-1 min-w-40">
      <label class="block text-xs text-gray-500 mb-1">宠物</label>
      <input type="text" name="q[pet_name_cont]" value="<%= params.dig(:q, :pet_name_cont) %>"
             class="w-full rounded-lg border-gray-300 text-sm" placeholder="宠物名称搜索...">
    </div>
    <div>
      <label class="block text-xs text-gray-500 mb-1">主理人</label>
      <%= select_tag "q[caretaker_id_eq]",
                     options_from_collection_for_select(Caretaker.active.order(:name), :id, :name, params.dig(:q, :caretaker_id_eq)),
                     { include_blank: "全部", class: "rounded-lg border-gray-300 text-sm" } %>
    </div>
    <div>
      <label class="block text-xs text-gray-500 mb-1">状态</label>
      <%= select_tag "q[status_eq]",
                     options_for_select([["已安排", "scheduled"], ["已完成", "completed"], ["延期", "delayed"], ["已取消", "cancelled"]], params.dig(:q, :status_eq)),
                     { include_blank: "全部", class: "rounded-lg border-gray-300 text-sm" } %>
    </div>
    <div>
      <label class="block text-xs text-gray-500 mb-1">延期原因</label>
      <%= select_tag "q[delay_reason_eq]",
                     options_for_select(TrainingRecord::DELAY_REASONS, params.dig(:q, :delay_reason_eq)),
                     { include_blank: "全部", class: "rounded-lg border-gray-300 text-sm" } %>
    </div>
    <div>
      <label class="block text-xs text-gray-500 mb-1">日期从</label>
      <input type="date" name="q[training_date_gteq]" value="<%= params.dig(:q, :training_date_gteq) %>" class="rounded-lg border-gray-300 text-sm">
    </div>
    <div>
      <label class="block text-xs text-gray-500 mb-1">到</label>
      <input type="date" name="q[training_date_lteq]" value="<%= params.dig(:q, :training_date_lteq) %>" class="rounded-lg border-gray-300 text-sm">
    </div>
    <div class="flex gap-2">
      <button type="submit" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium">筛选</button>
      <%= link_to "重置", admin_training_records_path, class: "bg-gray-50 hover:bg-gray-100 text-gray-600 px-4 py-2 rounded-lg text-sm" %>
    </div>
  <% end %>
</div>

<div class="bg-white rounded-lg shadow-sm border overflow-hidden">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">训练日期</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">宠物</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">主理人</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">服务项目</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">时长</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">状态</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">延期原因</th>
          <th class="px-4 py-3 text-right text-xs font-semibold text-gray-600 uppercase tracking-wider">操作</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @training_records.each do |record| %>
          <tr class="hover:bg-gray-50 <%= record.delayed? ? 'bg-yellow-50/50' : '' %>">
            <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600">
              <%= record.training_date %>
            </td>
            <td class="px-4 py-3 whitespace-nowrap">
              <div class="flex items-center">
                <span class="text-2xl mr-2"><%= record.pet.species == "狗" ? "🐕" : "🐱" %></span>
                <span class="font-medium text-gray-900"><%= record.pet_name %></span>
              </div>
            </td>
            <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600">
              👤 <%= record.caretaker_name %>
            </td>
            <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600">
              <%= record.service_name || "-" %>
            </td>
            <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600">
              <%= record.duration_minutes ? "#{record.duration_minutes}分钟" : "-" %>
            </td>
            <td class="px-4 py-3 whitespace-nowrap">
              <span class="px-2 py-1 text-xs rounded-full font-medium
                <%= record.status == "completed" ? "bg-green-100 text-green-700" :
                   record.status == "scheduled" ? "bg-blue-100 text-blue-700" :
                   record.status == "delayed" ? "bg-yellow-100 text-yellow-700" :
                   "bg-gray-100 text-gray-700" %>">
                <%= { "scheduled" => "已安排", "completed" => "已完成", "delayed" => "延期", "cancelled" => "已取消" }[record.status] %>
              </span>
            </td>
            <td class="px-4 py-3 whitespace-nowrap text-sm">
              <% if record.delay_reason.present? %>
                <span class="text-yellow-700 bg-yellow-50 px-2 py-0.5 rounded text-xs"><%= record.delay_reason %></span>
              <% else %>
                <span class="text-gray-400 text-xs">-</span>
              <% end %>
            </td>
            <td class="px-4 py-3 whitespace-nowrap text-right text-sm font-medium">
              <%= link_to "查看", admin_training_record_path(record), class: "text-indigo-600 hover:text-indigo-900" %>
              <%= link_to "编辑", edit_admin_training_record_path(record), class: "text-gray-600 hover:text-gray-900 ml-2" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<% if @pagy&.pages&.>1 %>
  <div class="mt-6 flex justify-center">
    <%= pagy_nav(@pagy) %>
  </div>
<% end %>
