<div class="max-w-3xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-900 mb-6"><%= @boarding_reservation.new_record? ? "新增寄养预约" : "编辑寄养预约" %></h1>

  <div class="bg-white rounded-lg shadow-sm border p-6">
    <%= form_with model: [:admin, @boarding_reservation], local: true do |form| %>
      <% if @boarding_reservation.errors.any? %>
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
          <p class="font-medium"><%= pluralize(@boarding_reservation.errors.count, "个错误") %> 导致保存失败：</p>
          <ul class="mt-2 text-sm list-disc list-inside">
            <% @boarding_reservation.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <%= form.label :pet_id, "宠物", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.select :pet_id, @pets.map { |p| ["#{p.name} (#{p.species})", p.id] }, { include_blank: true }, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>
          <div>
            <%= form.label :caretaker_id, "主理人", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.select :caretaker_id, @caretakers.map { |c| [c.name, c.id] }, { include_blank: true }, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>
          <div>
            <%= form.label :kennel_id, "笼位", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.select :kennel_id, @kennels.map { |k| ["#{k.name} (#{k.size_category})", k.id] }, { include_blank: true }, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <%= form.label :check_in_at, "入住时间", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.datetime_local_field :check_in_at, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>
          <div>
            <%= form.label :check_out_at, "预计离店时间", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.datetime_local_field :check_out_at, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <%= form.label :status, "状态", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.select :status, [["已预约", "scheduled"], ["入住中", "checked_in"], ["已完成", "completed"], ["已取消", "cancelled"]], {}, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>
          <div>
            <%= form.label :total_price, "总价（元）", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.number_field :total_price, step: "0.01", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>
        </div>

        <div>
          <%= form.label :notes, "备注", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.text_area :notes, rows: 2, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>

        <div>
          <%= form.label :special_requests, "特殊要求", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.text_area :special_requests, rows: 2, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>

        <div class="flex justify-end gap-3 pt-4 border-t">
          <%= link_to "取消", admin_boarding_reservations_path, class: "px-4 py-2 border rounded-lg text-gray-700 hover:bg-gray-50" %>
          <%= form.submit @boarding_reservation.new_record? ? "创建预约" : "保存更改", class: "bg-indigo-600 text-white px-6 py-2 rounded-lg font-medium hover:bg-indigo-700" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
