<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-900">寄养预约详情</h1>
  <div class="flex gap-2">
    <% if @boarding_reservation.scheduled? %>
      <%= button_to "办理入住", check_in_admin_boarding_reservation_path(@boarding_reservation), method: :post, class: "bg-green-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-green-700" %>
    <% end %>
    <% if @boarding_reservation.checked_in? %>
      <%= button_to "办理离店", check_out_admin_boarding_reservation_path(@boarding_reservation), method: :post, class: "bg-orange-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-orange-700" %>
    <% end %>
    <%= link_to "编辑", edit_admin_boarding_reservation_path(@boarding_reservation), class: "bg-indigo-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-indigo-700" %>
    <%= link_to "返回列表", admin_boarding_reservations_path, class: "border text-gray-700 px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-50" %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 space-y-6">
    <div class="bg-white rounded-lg shadow-sm border p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">预约信息</h2>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <p class="text-sm text-gray-500">状态</p>
          <p class="font-medium">
            <span class="px-2 py-1 text-xs rounded-full
              <%= @boarding_reservation.status == "checked_in" ? "bg-green-100 text-green-700" :
                 @boarding_reservation.status == "scheduled" ? "bg-blue-100 text-blue-700" :
                 @boarding_reservation.status == "completed" ? "bg-gray-100 text-gray-700" :
                 "bg-red-100 text-red-700" %>">
              <%= { "scheduled" => "已预约", "checked_in" => "入住中", "completed" => "已完成", "cancelled" => "已取消" }[@boarding_reservation.status] %>
            </span>
          </p>
        </div>
        <div>
          <p class="text-sm text-gray-500">总价</p>
          <p class="font-bold text-indigo-600 text-lg">¥<%= sprintf("%.2f", @boarding_reservation.total_price) %></p>
        </div>
        <div>
          <p class="text-sm text-gray-500">入住时间</p>
          <p class="font-medium text-gray-900"><%= @boarding_reservation.check_in_at.strftime("%Y年%m月%d日 %H:%M") %></p>
        </div>
        <div>
          <p class="text-sm text-gray-500">预计离店</p>
          <p class="font-medium text-gray-900"><%= @boarding_reservation.check_out_at&.strftime("%Y年%m月%d日 %H:%M") || "待定" %></p>
        </div>
      </div>
    </div>

    <% if @boarding_reservation.notes.present? %>
      <div class="bg-white rounded-lg shadow-sm border p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-2">备注</h2>
        <p class="text-gray-600"><%= @boarding_reservation.notes %></p>
      </div>
    <% end %>

    <% if @boarding_reservation.special_requests.present? %>
      <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6">
        <h2 class="text-lg font-semibold text-yellow-800 mb-2">⚠️ 特殊要求</h2>
        <p class="text-yellow-700"><%= @boarding_reservation.special_requests %></p>
      </div>
    <% end %>
  </div>

  <div class="space-y-6">
    <div class="bg-white rounded-lg shadow-sm border p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">宠物信息</h2>
      <div class="flex items-center mb-4">
        <span class="text-4xl mr-3"><%= @boarding_reservation.pet.species == "狗" ? "🐕" : "🐱" %></span>
        <div>
          <p class="font-semibold text-gray-900"><%= @boarding_reservation.pet_name %></p>
          <p class="text-sm text-gray-500"><%= @boarding_reservation.pet.breed %></p>
        </div>
      </div>
      <div class="space-y-2 text-sm">
        <p><span class="text-gray-500">年龄：</span><%= @boarding_reservation.pet.age ? "#{@boarding_reservation.pet.age}岁" : "未填写" %></p>
        <p><span class="text-gray-500">体重：</span><%= @boarding_reservation.pet.weight ? "#{@boarding_reservation.pet.weight}kg" : "未填写" %></p>
        <p><span class="text-gray-500">主人：</span><%= @boarding_reservation.pet.owner_name %></p>
        <p><span class="text-gray-500">电话：</span><%= @boarding_reservation.pet.owner_phone %></p>
      </div>
      <%= link_to "查看档案", admin_pet_path(@boarding_reservation.pet), class: "text-indigo-600 hover:text-indigo-700 text-sm mt-3 inline-block" %>
    </div>

    <div class="bg-white rounded-lg shadow-sm border p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">主理人</h2>
      <div class="flex items-center">
        <div class="w-12 h-12 bg-indigo-100 rounded-full flex items-center justify-center text-indigo-600 font-bold text-lg mr-3">
          <%= @boarding_reservation.caretaker.name.first %>
        </div>
        <div>
          <p class="font-semibold text-gray-900"><%= @boarding_reservation.caretaker_name %></p>
          <p class="text-sm text-gray-500"><%= @boarding_reservation.caretaker.phone %></p>
        </div>
      </div>
      <%= link_to "查看详情", admin_caretaker_path(@boarding_reservation.caretaker), class: "text-indigo-600 hover:text-indigo-700 text-sm mt-3 inline-block" %>
    </div>

    <div class="bg-white rounded-lg shadow-sm border p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">笼位</h2>
      <div class="text-center py-2">
        <p class="font-bold text-2xl text-gray-900"><%= @boarding_reservation.kennel_name %></p>
        <p class="text-sm text-gray-500"><%= @boarding_reservation.kennel.size_category %> · <%= @boarding_reservation.kennel.location %></p>
        <p class="text-sm text-indigo-600 font-medium mt-2">¥<%= sprintf("%.2f", @boarding_reservation.kennel.daily_rate) %>/天</p>
      </div>
    </div>
  </div>
</div>
