<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold text-gray-900">寄养排班管理</h1>
  <div class="flex gap-2">
    <%= link_to "导出CSV", admin_exports_boarding_path(params.permit(:q).merge(format: :csv, async: true)), class: "bg-green-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-green-700" %>
    <%= link_to "新增预约", new_admin_boarding_reservation_path, class: "bg-indigo-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-indigo-700" %>
  </div>
</div>

<div class="bg-white rounded-lg shadow-sm border overflow-hidden">
  <div class="p-4 border-b bg-gray-50">
    <%= form_with url: admin_boarding_reservations_path, method: :get, local: true, class: "flex flex-wrap gap-4 items-end" do |f| %>
      <div>
        <label class="block text-xs text-gray-500 mb-1">宠物名称</label>
        <input type="text" name="q[pet_name_cont]" value="<%= params.dig(:q, :pet_name_cont) %>" class="rounded border-gray-300 text-sm">
      </div>
      <div>
        <label class="block text-xs text-gray-500 mb-1">状态</label>
        <select name="q[status_eq]" class="rounded border-gray-300 text-sm">
          <option value="">全部</option>
          <option value="scheduled" <%= 'selected' if params.dig(:q, :status_eq) == 'scheduled' %>>已预约</option>
          <option value="checked_in" <%= 'selected' if params.dig(:q, :status_eq) == 'checked_in' %>>入住中</option>
          <option value="completed" <%= 'selected' if params.dig(:q, :status_eq) == 'completed' %>>已完成</option>
          <option value="cancelled" <%= 'selected' if params.dig(:q, :status_eq) == 'cancelled' %>>已取消</option>
        </select>
      </div>
      <div>
        <button type="submit" class="bg-gray-200 hover:bg-gray-300 px-4 py-2 rounded text-sm">搜索</button>
      </div>
    <% end %>
  </div>

  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">宠物</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">主理人</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">笼位</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">入住时间</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">离店时间</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">总价</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @boarding_reservations.each do |reservation| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center">
                <span class="text-2xl mr-2"><%= reservation.pet.species == "狗" ? "🐕" : "🐱" %></span>
                <div>
                  <div class="font-medium text-gray-900"><%= reservation.pet_name %></div>
                  <div class="text-sm text-gray-500"><%= reservation.pet.breed %></div>
                </div>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
              <%= reservation.caretaker_name %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
              <%= reservation.kennel_name %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
              <%= reservation.check_in_at.strftime("%Y-%m-%d %H:%M") %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
              <%= reservation.check_out_at&.strftime("%Y-%m-%d %H:%M") || "-" %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="px-2 py-1 text-xs rounded-full
                <%= reservation.status == "checked_in" ? "bg-green-100 text-green-700" :
                   reservation.status == "scheduled" ? "bg-blue-100 text-blue-700" :
                   reservation.status == "completed" ? "bg-gray-100 text-gray-700" :
                   "bg-red-100 text-red-700" %>">
                <%= { "scheduled" => "已预约", "checked_in" => "入住中", "completed" => "已完成", "cancelled" => "已取消" }[reservation.status] %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
              ¥<%= sprintf("%.2f", reservation.total_price) %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <%= link_to "查看", admin_boarding_reservation_path(reservation), class: "text-indigo-600 hover:text-indigo-900" %>
              <% if reservation.scheduled? %>
                <%= link_to "入住", check_in_admin_boarding_reservation_path(reservation), method: :post, class: "text-green-600 hover:text-green-900 ml-2" %>
              <% end %>
              <% if reservation.checked_in? %>
                <%= link_to "离店", check_out_admin_boarding_reservation_path(reservation), method: :post, class: "text-orange-600 hover:text-orange-900 ml-2" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<% if @pagy&.pages&.>1 %>
  <div class="mt-6 flex justify-center">
    <%= pagy_nav(@pagy) %>
  </div>
<% end %>
