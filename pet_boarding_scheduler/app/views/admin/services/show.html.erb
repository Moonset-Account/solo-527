<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-900">服务详情</h1>
  <div class="flex gap-2">
    <%= link_to "编辑", edit_admin_service_path(@service), class: "bg-indigo-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-indigo-700" %>
    <%= link_to "返回列表", admin_services_path, class: "border text-gray-700 px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-50" %>
  </div>
</div>

<div class="bg-white rounded-lg shadow-sm border p-6">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <h2 class="text-lg font-semibold text-gray-900 mb-4">基本信息</h2>
      <div class="space-y-3">
        <div class="flex justify-between">
          <span class="text-gray-500">服务名称</span>
          <span class="font-medium text-gray-900"><%= @service.name %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-500">服务类别</span>
          <span class="font-medium text-gray-900">
            <%= { "boarding" => "寄养", "training" => "训练", "grooming" => "美容", "medical" => "医疗", "daycare" => "日托" }[@service.category] || @service.category %>
          </span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-500">服务时长</span>
          <span class="font-medium text-gray-900"><%= @service.formatted_duration %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-500">服务价格</span>
          <span class="font-bold text-indigo-600"><%= @service.formatted_price %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-500">状态</span>
          <span class="px-2 py-1 text-xs rounded-full <%= @service.is_active? ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-700' %>">
            <%= @service.is_active? ? "启用" : "停用" %>
          </span>
        </div>
      </div>
    </div>
    <div>
      <h2 class="text-lg font-semibold text-gray-900 mb-4">服务描述</h2>
      <p class="text-gray-600"><%= @service.description %></p>
    </div>
  </div>
</div>
