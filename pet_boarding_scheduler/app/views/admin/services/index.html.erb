<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold text-gray-900">服务项目管理</h1>
  <%= link_to "新增服务", new_admin_service_path, class: "bg-indigo-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-indigo-700" %>
</div>

<div class="bg-white rounded-lg shadow-sm border overflow-hidden">
  <div class="p-4 border-b bg-gray-50">
    <div class="flex gap-4">
      <%= link_to "全部服务", admin_services_path, class: "text-sm #{params[:active_only].blank? ? 'font-medium text-indigo-600' : 'text-gray-600 hover:text-gray-900'}" %>
      <%= link_to "仅显示启用", admin_services_path(active_only: true), class: "text-sm #{params[:active_only].present? ? 'font-medium text-indigo-600' : 'text-gray-600 hover:text-gray-900'}" %>
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">服务名称</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">类别</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">时长</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">价格</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @services.each do |service| %>
          <tr>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="font-medium text-gray-900"><%= service.name %></div>
              <div class="text-sm text-gray-500"><%= service.description %></div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
              <span class="px-2 py-1 text-xs rounded-full bg-gray-100 text-gray-700">
                <%= { "boarding" => "寄养", "training" => "训练", "grooming" => "美容", "medical" => "医疗", "daycare" => "日托" }[service.category] || service.category %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
              <%= service.formatted_duration %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
              <%= service.formatted_price %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="px-2 py-1 text-xs rounded-full <%= service.is_active? ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-700' %>">
                <%= service.is_active? ? "启用" : "停用" %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <%= link_to "查看", admin_service_path(service), class: "text-indigo-600 hover:text-indigo-900 mr-3" %>
              <%= link_to "编辑", edit_admin_service_path(service), class: "text-gray-600 hover:text-gray-900" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
