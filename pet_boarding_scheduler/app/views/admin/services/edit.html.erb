<h1 class="text-2xl font-bold text-gray-900 mb-6">编辑服务</h1>

<div class="max-w-2xl mx-auto bg-white rounded-lg shadow-sm border p-6">
  <%= form_with model: [:admin, @service], local: true do |form| %>
    <% if @service.errors.any? %>
      <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
        <p class="font-medium"><%= pluralize(@service.errors.count, "个错误") %> 导致保存失败：</p>
        <ul class="mt-2 text-sm list-disc list-inside">
          <% @service.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="space-y-4">
      <div>
        <%= form.label :name, "服务名称", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :name, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      </div>

      <div>
        <%= form.label :category, "服务类别", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.select :category, [["寄养", "boarding"], ["训练", "training"], ["美容", "grooming"], ["医疗", "medical"], ["日托", "daycare"]], {}, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= form.label :duration_minutes, "时长（分钟）", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.number_field :duration_minutes, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>
        <div>
          <%= form.label :price, "价格（元）", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.number_field :price, step: "0.01", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>
      </div>

      <div>
        <%= form.label :description, "服务描述", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_area :description, rows: 3, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      </div>

      <div class="flex items-center">
        <%= form.check_box :is_active, class: "rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
        <%= form.label :is_active, "启用此服务", class: "ml-2 text-sm text-gray-700" %>
      </div>

      <div class="flex justify-end gap-3 pt-4 border-t">
        <%= link_to "取消", admin_service_path(@service), class: "px-4 py-2 border rounded-lg text-gray-700 hover:bg-gray-50" %>
        <%= form.submit "保存更改", class: "bg-indigo-600 text-white px-6 py-2 rounded-lg font-medium hover:bg-indigo-700" %>
      </div>
    </div>
  <% end %>
</div>
