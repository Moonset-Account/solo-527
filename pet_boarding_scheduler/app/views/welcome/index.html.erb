<div class="text-center py-16">
  <h1 class="text-4xl font-bold text-gray-900 mb-4">
    🐾 宠物寄养服务排班系统
  </h1>
  <p class="text-xl text-gray-600 mb-8">
    专业的宠物寄养、训练和健康管理服务
  </p>

  <div class="flex justify-center gap-4 mb-12">
    <%= link_to "创建宠物档案", new_pet_path, class: "bg-indigo-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-indigo-700 transition" %>
    <%= link_to "查看宠物列表", pets_path, class: "bg-white text-indigo-600 border border-indigo-600 px-6 py-3 rounded-lg font-medium hover:bg-indigo-50 transition" %>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
  <div class="bg-white rounded-xl shadow-sm p-6 border">
    <div class="text-4xl mb-4">🏠</div>
    <h3 class="text-lg font-semibold text-gray-900 mb-2">舒适寄养环境</h3>
    <p class="text-gray-600">提供多种规格的笼位，满足不同体型宠物的需求</p>
  </div>

  <div class="bg-white rounded-xl shadow-sm p-6 border">
    <div class="text-4xl mb-4">🏋️</div>
    <h3 class="text-lg font-semibold text-gray-900 mb-2">专业训练服务</h3>
    <p class="text-gray-600">经验丰富的训练师提供个性化训练方案</p>
  </div>

  <div class="bg-white rounded-xl shadow-sm p-6 border">
    <div class="text-4xl mb-4">❤️</div>
    <h3 class="text-lg font-semibold text-gray-900 mb-2">健康监测</h3>
    <p class="text-gray-600">每日健康检查，实时关注宠物健康状态</p>
  </div>
</div>

<div class="bg-white rounded-xl shadow-sm p-6 border">
  <h2 class="text-xl font-semibold text-gray-900 mb-6">我们的服务</h2>
  <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
    <% @active_services.each do |service| %>
      <div class="border rounded-lg p-4 hover:shadow-md transition">
        <h4 class="font-medium text-gray-900"><%= service.name %></h4>
        <p class="text-sm text-gray-500 mb-2"><%= service.description %></p>
        <div class="flex justify-between items-center">
          <span class="text-indigo-600 font-bold"><%= service.formatted_price %></span>
          <span class="text-sm text-gray-500"><%= service.formatted_duration %></span>
        </div>
      </div>
    <% end %>
  </div>
</div>

<div class="mt-12">
  <h2 class="text-xl font-semibold text-gray-900 mb-6">最近入住的宠物</h2>
  <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
    <% @recent_pets.each do |pet| %>
      <%= link_to pet_path(pet), class: "bg-white rounded-lg shadow-sm p-4 border hover:shadow-md transition block" do %>
        <div class="text-center">
          <div class="text-4xl mb-2"><%= pet.species == "狗" ? "🐕" : "🐱" %></div>
          <h4 class="font-medium text-gray-900"><%= pet.name %></h4>
          <p class="text-sm text-gray-500"><%= pet.breed || pet.species %></p>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
