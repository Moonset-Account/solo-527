<div class="min-h-screen bg-gray-50">
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-6 flex items-center justify-between">
      <div class="flex items-center space-x-4">
        <%= link_to '← 返回', settlements_path, class: 'text-sm text-gray-500 hover:text-gray-700' %>
        <h1 class="text-2xl font-bold text-gray-900">结算单详情</h1>
        <span class="font-mono text-sm text-gray-500"><%= @settlement.settlement_no %></span>
      </div>
      <div class="flex items-center space-x-3">
        <% status_class = case @settlement.status
          when 'draft' then 'bg-gray-100 text-gray-800'
          when 'pending' then 'bg-yellow-100 text-yellow-800'
          when 'approved' then 'bg-green-100 text-green-800'
          when 'paid' then 'bg-purple-100 text-purple-800'
          when 'cancelled' then 'bg-red-100 text-red-800'
          else 'bg-gray-100 text-gray-800'
          end %>
        <span class="inline-flex rounded-full px-3 py-1 text-sm font-medium <%= status_class %>">
          <%= @settlement.status.text %>
        </span>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      <div class="lg:col-span-2 space-y-6">
        <div class="rounded-lg bg-white p-6 shadow-sm">
          <h2 class="mb-4 text-lg font-semibold text-gray-900">基本信息</h2>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <p class="text-sm text-gray-500">结算单号</p>
              <p class="mt-1 font-mono text-sm font-medium text-gray-900"><%= @settlement.settlement_no %></p>
            </div>
            <div>
              <p class="text-sm text-gray-500">车牌号</p>
              <p class="mt-1 text-sm font-medium text-gray-900"><%= @settlement.vehicle&.plate_number %></p>
            </div>
            <div>
              <p class="text-sm text-gray-500">司机</p>
              <p class="mt-1 text-sm text-gray-900"><%= @settlement.driver&.email %></p>
            </div>
            <div>
              <p class="text-sm text-gray-500">车队长</p>
              <p class="mt-1 text-sm text-gray-900"><%= @settlement.captain&.email || '未分配' %></p>
            </div>
            <div>
              <p class="text-sm text-gray-500">开始日期</p>
              <p class="mt-1 text-sm text-gray-900"><%= @settlement.start_date&.strftime('%Y-%m-%d') %></p>
            </div>
            <div>
              <p class="text-sm text-gray-500">结束日期</p>
              <p class="mt-1 text-sm text-gray-900"><%= @settlement.end_date&.strftime('%Y-%m-%d') %></p>
            </div>
          </div>
        </div>

        <div class="rounded-lg bg-white p-6 shadow-sm">
          <h2 class="mb-4 text-lg font-semibold text-gray-900">费用明细</h2>
          <div class="space-y-3">
            <div class="flex items-center justify-between py-2 border-b border-gray-100">
              <span class="text-sm text-gray-600">基础费用</span>
              <span class="text-sm font-medium text-gray-900">¥<%= number_with_precision(@settlement.base_fee, precision: 2) %></span>
            </div>
            <div class="flex items-center justify-between py-2 border-b border-gray-100">
              <span class="text-sm text-gray-600">奖励金额</span>
              <span class="text-sm font-medium text-green-600">+¥<%= number_with_precision(@settlement.bonus_amount, precision: 2) %></span>
            </div>
            <div class="flex items-center justify-between py-2 border-b border-gray-100">
              <span class="text-sm text-gray-600">扣款金额</span>
              <span class="text-sm font-medium text-red-600">-¥<%= number_with_precision(@settlement.deduction_amount, precision: 2) %></span>
            </div>
            <div class="flex items-center justify-between pt-3">
              <span class="text-base font-semibold text-gray-900">总计</span>
              <span class="text-2xl font-bold text-blue-600">¥<%= number_with_precision(@settlement.total_amount, precision: 2) %></span>
            </div>
          </div>
        </div>

        <div class="rounded-lg bg-white p-6 shadow-sm">
          <div class="mb-4 flex items-center justify-between">
            <h2 class="text-lg font-semibold text-gray-900">关联工单</h2>
            <span class="text-sm text-gray-500">共 <%= @settlement.claims.count %> 条</span>
          </div>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">工单号</th>
                  <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">类型</th>
                  <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">金额</th>
                  <th class="px-4 py-2 text-left text-xs font-medium uppercase tracking-wider text-gray-500">状态</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200 bg-white">
                <% @settlement.claims.each do |claim| %>
                  <tr class="hover:bg-gray-50">
                    <td class="whitespace-nowrap px-4 py-2">
                      <%= link_to claim.claim_no, claim_path(claim), class: 'text-sm text-blue-600 hover:text-blue-900' %>
                    </td>
                    <td class="whitespace-nowrap px-4 py-2 text-sm text-gray-700"><%= claim.claim_type&.text %></td>
                    <td class="whitespace-nowrap px-4 py-2 text-sm font-medium text-gray-900">¥<%= number_with_precision(claim.amount, precision: 2) %></td>
                    <td class="whitespace-nowrap px-4 py-2">
                      <% status_class = case claim.status
                        when 'pending' then 'bg-yellow-100 text-yellow-800'
                        when 'processing' then 'bg-blue-100 text-blue-800'
                        when 'approved' then 'bg-green-100 text-green-800'
                        when 'rejected' then 'bg-red-100 text-red-800'
                        when 'paid' then 'bg-purple-100 text-purple-800'
                        else 'bg-gray-100 text-gray-800'
                        end %>
                      <span class="inline-flex rounded-full px-2 py-0.5 text-xs font-medium <%= status_class %>">
                        <%= claim.status.text %>
                      </span>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <% if @settlement.claims.empty? %>
            <div class="py-8 text-center text-sm text-gray-500">
              暂无关联工单
            </div>
          <% end %>
        </div>

        <div class="rounded-lg bg-white p-6 shadow-sm">
          <h2 class="mb-4 text-lg font-semibold text-gray-900">统计信息</h2>
          <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
            <div class="rounded-lg bg-blue-50 p-4 text-center">
              <p class="text-2xl font-bold text-blue-600">-</p>
              <p class="mt-1 text-xs text-gray-600">总里程 (km)</p>
            </div>
            <div class="rounded-lg bg-green-50 p-4 text-center">
              <p class="text-2xl font-bold text-green-600">-</p>
              <p class="mt-1 text-xs text-gray-600">总时长 (h)</p>
            </div>
            <div class="rounded-lg bg-yellow-50 p-4 text-center">
              <p class="text-2xl font-bold text-yellow-600"><%= @settlement.claims.count %></p>
              <p class="mt-1 text-xs text-gray-600">工单数</p>
            </div>
            <div class="rounded-lg bg-purple-50 p-4 text-center">
              <p class="text-2xl font-bold text-purple-600">¥<%= number_with_precision(@settlement.total_amount, precision: 2) %></p>
              <p class="mt-1 text-xs text-gray-600">结算金额</p>
            </div>
          </div>
        </div>

        <% if @settlement.remark.present? %>
          <div class="rounded-lg bg-white p-6 shadow-sm">
            <h2 class="mb-4 text-lg font-semibold text-gray-900">备注</h2>
            <div class="rounded-md bg-gray-50 p-4">
              <p class="whitespace-pre-wrap text-sm text-gray-700"><%= @settlement.remark %></p>
            </div>
          </div>
        <% end %>
      </div>

      <div class="space-y-6">
        <div class="rounded-lg bg-white p-6 shadow-sm">
          <h2 class="mb-4 text-lg font-semibold text-gray-900">操作</h2>
          <div class="space-y-3">
            <% if policy(@settlement).generate? %>
              <%= link_to '生成结算单', generate_admin_settlement_path(@settlement), method: :post, class: 'w-full rounded-md bg-blue-600 px-4 py-2 text-center text-sm font-medium text-white hover:bg-blue-700' %>
            <% end %>
            <% if policy(@settlement).approve? %>
              <%= link_to '审批通过', approve_admin_settlement_path(@settlement), method: :post, class: 'w-full rounded-md bg-green-600 px-4 py-2 text-center text-sm font-medium text-white hover:bg-green-700' %>
            <% end %>
            <% if policy(@settlement).pay? %>
              <%= link_to '标记支付', pay_admin_settlement_path(@settlement), method: :post, class: 'w-full rounded-md bg-purple-600 px-4 py-2 text-center text-sm font-medium text-white hover:bg-purple-700' %>
            <% end %>
          </div>
        </div>

        <div class="rounded-lg bg-white p-6 shadow-sm">
          <h2 class="mb-4 text-lg font-semibold text-gray-900">处理记录</h2>
          <div class="space-y-4">
            <% @logs = OperationLog.by_target(@settlement).recent.limit(10) %>
            <% if @logs.any? %>
              <% @logs.each do |log| %>
                <div class="border-l-2 border-gray-200 pl-4">
                  <p class="text-sm font-medium text-gray-900"><%= log.action %></p>
                  <p class="text-xs text-gray-500"><%= log.user&.email %> · <%= log.created_at.strftime('%Y-%m-%d %H:%M') %></p>
                </div>
              <% end %>
            <% else %>
              <p class="text-sm text-gray-500">暂无处理记录</p>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
