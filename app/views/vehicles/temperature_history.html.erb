<% content_for :title, "温度历史 - #{@vehicle.plate_number}" %>
<%
  start_time = params[:start_time]&.to_time || 24.hours.ago
  end_time = params[:end_time]&.to_time || Time.current
%>

<div class="min-h-screen bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-6">
      <div class="flex items-center">
        <%= link_to vehicle_path(@vehicle), class: "text-gray-400 hover:text-gray-600 mr-3" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
        <% end %>
        <div>
          <h1 class="text-2xl font-bold text-gray-900">温度历史</h1>
          <p class="mt-1 text-sm text-gray-500"><%= @vehicle.plate_number %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 mb-6">
      <form method="get" action="<%= temperature_history_vehicle_path(@vehicle) %>" class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
          <div class="md:col-span-2">
            <label class="block text-sm font-medium text-gray-700 mb-1">开始时间</label>
            <input type="datetime-local" name="start_time" value="<%= start_time.strftime('%Y-%m-%dT%H:%M') %>"
                   class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
          </div>
          <div class="md:col-span-2">
            <label class="block text-sm font-medium text-gray-700 mb-1">结束时间</label>
            <input type="datetime-local" name="end_time" value="<%= end_time.strftime('%Y-%m-%dT%H:%M') %>"
                   class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
          </div>
          <div class="flex items-end space-x-2">
            <button type="submit" class="flex-1 bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 sm:text-sm font-medium">
              查询
            </button>
            <button type="button" onclick="exportData()" class="flex-1 bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 sm:text-sm font-medium">
              导出
            </button>
          </div>
        </div>
        <div class="flex flex-wrap gap-2">
          <button type="button" onclick="setTimeRange('1h')" class="px-3 py-1 text-xs font-medium rounded-full bg-gray-100 text-gray-700 hover:bg-gray-200">最近1小时</button>
          <button type="button" onclick="setTimeRange('6h')" class="px-3 py-1 text-xs font-medium rounded-full bg-gray-100 text-gray-700 hover:bg-gray-200">最近6小时</button>
          <button type="button" onclick="setTimeRange('24h')" class="px-3 py-1 text-xs font-medium rounded-full bg-gray-100 text-gray-700 hover:bg-gray-200">最近24小时</button>
          <button type="button" onclick="setTimeRange('7d')" class="px-3 py-1 text-xs font-medium rounded-full bg-gray-100 text-gray-700 hover:bg-gray-200">最近7天</button>
          <button type="button" onclick="setTimeRange('30d')" class="px-3 py-1 text-xs font-medium rounded-full bg-gray-100 text-gray-700 hover:bg-gray-200">最近30天</button>
        </div>
      </form>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">温度曲线图</h2>
      <% if @temperature_records.any? %>
        <%= line_chart @temperature_records.map { |r| [r.recorded_at, r.temperature] },
                       xtitle: "时间",
                       ytitle: "温度 (°C)",
                       colors: ["#3b82f6"],
                       height: "400px",
                       curve: false,
                       min: @vehicle.min_temperature ? @vehicle.min_temperature - 5 : nil,
                       max: @vehicle.max_temperature ? @vehicle.max_temperature + 5 : nil,
                       library: {
                         chart: { zoomType: 'x' },
                         tooltip: {
                           shared: true,
                           crosshairs: true
                         },
                         plotLines: [
                           if @vehicle.min_temperature
                             {
                               color: '#ef4444',
                               dashStyle: 'dash',
                               value: @vehicle.min_temperature,
                               width: 2,
                               label: {
                                 text: "下限 #{@vehicle.min_temperature}°C",
                                 align: 'right',
                                 style: { color: '#ef4444', fontSize: '12px' }
                               }
                             }
                           end,
                           if @vehicle.max_temperature
                             {
                               color: '#ef4444',
                               dashStyle: 'dash',
                               value: @vehicle.max_temperature,
                               width: 2,
                               label: {
                                 text: "上限 #{@vehicle.max_temperature}°C",
                                 align: 'right',
                                 style: { color: '#ef4444', fontSize: '12px' }
                               }
                             }
                           end
                         ].compact
                       } %>
      <% else %>
        <div class="text-center py-16 text-gray-500">
          <svg class="mx-auto h-12 w-12 text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
          <p>该时间段内暂无温度数据</p>
        </div>
      <% end %>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-900">详细数据</h2>
        <p class="text-sm text-gray-500 mt-1">共 <%= @temperature_records.size %> 条记录</p>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">序号</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">记录时间</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">温度</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @temperature_records.each_with_index do |record, index| %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-500">
                  <%= index + 1 %>
                </td>
                <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-900">
                  <%= record.recorded_at.strftime("%Y-%m-%d %H:%M:%S") %>
                </td>
                <td class="px-6 py-3 whitespace-nowrap text-sm font-semibold text-gray-900">
                  <%= "%.2f" % record.temperature %>°C
                </td>
                <td class="px-6 py-3 whitespace-nowrap">
                  <%= render "shared/temperature_badge", temperature: record.temperature, vehicle: @vehicle %>
                </td>
              </tr>
            <% end %>
            <% if @temperature_records.empty? %>
              <tr>
                <td colspan="4" class="px-6 py-12 text-center text-sm text-gray-500">
                  <svg class="mx-auto h-12 w-12 text-gray-400 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                  </svg>
                  暂无温度记录
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  function setTimeRange(range) {
    const end = new Date();
    let start = new Date();

    switch(range) {
      case '1h':
        start.setHours(end.getHours() - 1);
        break;
      case '6h':
        start.setHours(end.getHours() - 6);
        break;
      case '24h':
        start.setHours(end.getHours() - 24);
        break;
      case '7d':
        start.setDate(end.getDate() - 7);
        break;
      case '30d':
        start.setDate(end.getDate() - 30);
        break;
    }

    document.querySelector('input[name="start_time"]').value = formatDateTime(start);
    document.querySelector('input[name="end_time"]').value = formatDateTime(end);
    document.querySelector('form').submit();
  }

  function formatDateTime(date) {
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, '0');
    const day = String(date.getDate()).padStart(2, '0');
    const hours = String(date.getHours()).padStart(2, '0');
    const minutes = String(date.getMinutes()).padStart(2, '0');
    return `${year}-${month}-${day}T${hours}:${minutes}`;
  }

  function exportData() {
    const startTime = document.querySelector('input[name="start_time"]').value;
    const endTime = document.querySelector('input[name="end_time"]').value;
    const url = `<%= temperature_history_vehicle_path(@vehicle, format: :json) %>?start_time=${encodeURIComponent(startTime)}&end_time=${encodeURIComponent(endTime)}`;

    fetch(url)
      .then(response => response.json())
      .then(data => {
        let csv = '时间,温度\n';
        data.forEach(item => {
          csv += `${item.time},${item.temperature}\n`;
        });

        const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement('a');
        const url = URL.createObjectURL(blob);
        link.setAttribute('href', url);
        link.setAttribute('download', `温度记录_<%= @vehicle.plate_number %>_${new Date().toISOString().slice(0,10)}.csv`);
        link.style.visibility = 'hidden';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      });
  }
</script>
