<% content_for :title, "轨迹回放 - #{@vehicle.plate_number}" %>
<%
  start_time = params[:start_time]&.to_time || 24.hours.ago
  end_time = params[:end_time]&.to_time || Time.current
  records = @location_records.to_a
%>

<div class="min-h-screen bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-6">
      <div class="flex items-center">
        <%= link_to vehicle_path(@vehicle), class: "text-gray-400 hover:text-gray-600 mr-3" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
        <% end %>
        <div>
          <h1 class="text-2xl font-bold text-gray-900">轨迹回放</h1>
          <p class="mt-1 text-sm text-gray-500"><%= @vehicle.plate_number %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 mb-6">
      <form method="get" action="<%= track_playback_vehicle_path(@vehicle) %>" class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
          <div class="md:col-span-2">
            <label class="block text-sm font-medium text-gray-700 mb-1">开始时间</label>
            <input type="datetime-local" name="start_time" value="<%= start_time.strftime('%Y-%m-%dT%H:%M') %>"
                   class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
          </div>
          <div class="md:col-span-2">
            <label class="block text-sm font-medium text-gray-700 mb-1">结束时间</label>
            <input type="datetime-local" name="end_time" value="<%= end_time.strftime('%Y-%m-%dT%H:%M') %>"
                   class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
          </div>
          <div class="flex items-end">
            <button type="submit" class="w-full bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 sm:text-sm font-medium">
              查询
            </button>
          </div>
        </div>
        <div class="flex flex-wrap gap-2">
          <button type="button" onclick="setTimeRange('1h')" class="px-3 py-1 text-xs font-medium rounded-full bg-gray-100 text-gray-700 hover:bg-gray-200">最近1小时</button>
          <button type="button" onclick="setTimeRange('6h')" class="px-3 py-1 text-xs font-medium rounded-full bg-gray-100 text-gray-700 hover:bg-gray-200">最近6小时</button>
          <button type="button" onclick="setTimeRange('24h')" class="px-3 py-1 text-xs font-medium rounded-full bg-gray-100 text-gray-700 hover:bg-gray-200">最近24小时</button>
          <button type="button" onclick="setTimeRange('7d')" class="px-3 py-1 text-xs font-medium rounded-full bg-gray-100 text-gray-700 hover:bg-gray-200">最近7天</button>
        </div>
      </form>
    </div>

    <% if records.any? %>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
          <div class="flex items-center">
            <div class="flex-shrink-0 h-10 w-10 bg-blue-100 rounded-lg flex items-center justify-center">
              <svg class="h-5 w-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              </svg>
            </div>
            <div class="ml-3">
              <p class="text-sm font-medium text-gray-500">轨迹点数</p>
              <p class="text-xl font-bold text-gray-900"><%= records.size %></p>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
          <div class="flex items-center">
            <div class="flex-shrink-0 h-10 w-10 bg-green-100 rounded-lg flex items-center justify-center">
              <svg class="h-5 w-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
            </div>
            <div class="ml-3">
              <p class="text-sm font-medium text-gray-500">总里程</p>
              <p class="text-xl font-bold text-gray-900"><%= "%.2f" % calculate_distance(records) %> km</p>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
          <div class="flex items-center">
            <div class="flex-shrink-0 h-10 w-10 bg-purple-100 rounded-lg flex items-center justify-center">
              <svg class="h-5 w-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div class="ml-3">
              <p class="text-sm font-medium text-gray-500">行驶时长</p>
              <p class="text-xl font-bold text-gray-900"><%= format_duration(records.last.recorded_at - records.first.recorded_at) %></p>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
          <div class="flex items-center">
            <div class="flex-shrink-0 h-10 w-10 bg-orange-100 rounded-lg flex items-center justify-center">
              <svg class="h-5 w-5 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <div class="ml-3">
              <p class="text-sm font-medium text-gray-500">平均速度</p>
              <p class="text-xl font-bold text-gray-900"><%= "%.1f" % average_speed(records) %> km/h</p>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden mb-6">
        <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-semibold text-gray-900">轨迹地图</h2>
            <div class="flex items-center space-x-2">
              <span class="text-sm text-gray-500">速度:</span>
              <select id="playback-speed" class="rounded-md border-gray-300 text-sm focus:border-blue-500 focus:ring-blue-500">
                <option value="1">1x</option>
                <option value="2">2x</option>
                <option value="5">5x</option>
                <option value="10">10x</option>
              </select>
            </div>
          </div>
        </div>

        <div class="relative bg-gradient-to-br from-blue-50 to-green-50 h-96 overflow-hidden">
          <div class="absolute inset-0 opacity-20">
            <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
                  <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#94a3b8" stroke-width="0.5"/>
                </pattern>
              </defs>
              <rect width="100%" height="100%" fill="url(#grid)" />
            </svg>
          </div>

          <div id="track-map" class="absolute inset-0 p-8">
            <svg id="track-svg" class="w-full h-full" viewBox="0 0 800 400" preserveAspectRatio="xMidYMid meet">
              <polyline
                id="track-path"
                points="<%= generate_track_points(records) %>"
                fill="none"
                stroke="#3b82f6"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-dasharray="1000"
                stroke-dashoffset="1000"
                class="transition-all duration-300"
              />
              <circle
                id="track-marker"
                cx="0"
                cy="0"
                r="8"
                fill="#ef4444"
                stroke="white"
                stroke-width="3"
                class="transition-all duration-100"
              />
            </svg>
          </div>

          <div class="absolute top-4 left-4 bg-white/90 backdrop-blur rounded-lg p-3 shadow-lg">
            <p class="text-xs text-gray-500">当前时间</p>
            <p id="current-time" class="text-sm font-semibold text-gray-900">
              <%= records.first.recorded_at.strftime("%Y-%m-%d %H:%M:%S") %>
            </p>
          </div>

          <div class="absolute top-4 right-4 bg-white/90 backdrop-blur rounded-lg p-3 shadow-lg">
            <p class="text-xs text-gray-500">当前速度</p>
            <p id="current-speed" class="text-sm font-semibold text-gray-900">
              <%= records.first.speed ? "#{'%.1f' % records.first.speed} km/h" : "--" %>
            </p>
          </div>

          <div class="absolute bottom-4 left-4 bg-white/90 backdrop-blur rounded-lg p-3 shadow-lg">
            <p class="text-xs text-gray-500">起点</p>
            <p class="text-xs font-medium text-gray-900">
              <%= records.first.latitude %>, <%= records.first.longitude %>
            </p>
          </div>

          <div class="absolute bottom-4 right-4 bg-white/90 backdrop-blur rounded-lg p-3 shadow-lg">
            <p class="text-xs text-gray-500">终点</p>
            <p class="text-xs font-medium text-gray-900">
              <%= records.last.latitude %>, <%= records.last.longitude %>
            </p>
          </div>
        </div>

        <div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
          <div class="flex items-center space-x-4">
            <button id="play-btn" onclick="togglePlay()" class="flex items-center justify-center w-10 h-10 rounded-full bg-blue-600 text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
              <svg id="play-icon" class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z" />
              </svg>
              <svg id="pause-icon" class="w-5 h-5 hidden" fill="currentColor" viewBox="0 0 20 20">
                <path d="M5.75 3a.75.75 0 00-.75.75v12.5c0 .414.336.75.75.75h1.5a.75.75 0 00.75-.75V3.75A.75.75 0 007.25 3h-1.5zM12.75 3a.75.75 0 00-.75.75v12.5c0 .414.336.75.75.75h1.5a.75.75 0 00.75-.75V3.75a.75.75 0 00-.75-.75h-1.5z" />
              </svg>
            </button>

            <div class="flex-1">
              <input
                type="range"
                id="progress-slider"
                min="0"
                max="<%= records.size - 1 %>"
                value="0"
                class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-blue-600"
                oninput="seekTo(this.value)"
              >
            </div>

            <span class="text-sm text-gray-500 min-w-[100px] text-right">
              <span id="current-index">1</span> / <%= records.size %>
            </span>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">轨迹数据</h2>
        </div>
        <div class="overflow-x-auto max-h-96">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50 sticky top-0">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">序号</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">时间</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">纬度</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">经度</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">速度</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">方向</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% records.each_with_index do |record, index| %>
                <tr class="hover:bg-gray-50 cursor-pointer" onclick="seekTo(<%= index %>)" id="row-<%= index %>">
                  <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-500"><%= index + 1 %></td>
                  <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-900">
                    <%= record.recorded_at.strftime("%Y-%m-%d %H:%M:%S") %>
                  </td>
                  <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-900"><%= record.latitude %></td>
                  <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-900"><%= record.longitude %></td>
                  <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-900">
                    <% if record.speed %>
                      <%= "%.1f" % record.speed %> km/h
                    <% else %>
                      --
                    <% end %>
                  </td>
                  <td class="px-6 py-3 whitespace-nowrap text-sm text-gray-900">
                    <% if record.heading %>
                      <%= "%.0f" % record.heading %>°
                    <% else %>
                      --
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% else %>
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-12 text-center">
        <svg class="mx-auto h-12 w-12 text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        </svg>
        <h3 class="text-lg font-medium text-gray-900 mb-2">暂无轨迹数据</h3>
        <p class="text-sm text-gray-500">该时间段内没有位置记录</p>
      </div>
    <% end %>
  </div>
</div>

<script>
  const records = <%= raw records.to_json(only: [:latitude, :longitude, :speed, :heading, :recorded_at]) %>;
  let currentIndex = 0;
  let isPlaying = false;
  let playInterval = null;
  let playbackSpeed = 1;

  function togglePlay() {
    isPlaying = !isPlaying;
    const playIcon = document.getElementById('play-icon');
    const pauseIcon = document.getElementById('pause-icon');

    if (isPlaying) {
      playIcon.classList.add('hidden');
      pauseIcon.classList.remove('hidden');
      startPlayback();
    } else {
      playIcon.classList.remove('hidden');
      pauseIcon.classList.add('hidden');
      stopPlayback();
    }
  }

  function startPlayback() {
    if (currentIndex >= records.length - 1) {
      currentIndex = 0;
    }

    playInterval = setInterval(() => {
      if (currentIndex < records.length - 1) {
        currentIndex++;
        updatePosition();
      } else {
        togglePlay();
      }
    }, 1000 / playbackSpeed);
  }

  function stopPlayback() {
    if (playInterval) {
      clearInterval(playInterval);
      playInterval = null;
    }
  }

  function seekTo(index) {
    currentIndex = parseInt(index);
    updatePosition();
    document.getElementById('progress-slider').value = currentIndex;
  }

  function updatePosition() {
    const record = records[currentIndex];
    const marker = document.getElementById('track-marker');
    const path = document.getElementById('track-path');
    const svg = document.getElementById('track-svg');
    const viewBox = svg.viewBox.baseVal;

    const lats = records.map(r => parseFloat(r.latitude));
    const lngs = records.map(r => parseFloat(r.longitude));
    const minLat = Math.min(...lats);
    const maxLat = Math.max(...lats);
    const minLng = Math.min(...lngs);
    const maxLng = Math.max(...lngs);

    const latRange = maxLat - minLat || 0.001;
    const lngRange = maxLng - minLng || 0.001;

    const padding = 40;
    const width = viewBox.width - padding * 2;
    const height = viewBox.height - padding * 2;

    const x = padding + ((parseFloat(record.longitude) - minLng) / lngRange) * width;
    const y = padding + (1 - (parseFloat(record.latitude) - minLat) / latRange) * height;

    marker.setAttribute('cx', x);
    marker.setAttribute('cy', y);

    const progress = (currentIndex + 1) / records.length;
    const pathLength = path.getTotalLength ? path.getTotalLength() : 1000;
    path.style.strokeDashoffset = pathLength * (1 - progress);

    document.getElementById('current-index').textContent = currentIndex + 1;
    document.getElementById('current-time').textContent = new Date(record.recorded_at).toLocaleString('zh-CN');
    document.getElementById('current-speed').textContent = record.speed ? record.speed.toFixed(1) + ' km/h' : '--';

    document.querySelectorAll('tbody tr').forEach((row, i) => {
      if (i === currentIndex) {
        row.classList.add('bg-blue-50');
        row.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } else {
        row.classList.remove('bg-blue-50');
      }
    });
  }

  document.getElementById('playback-speed').addEventListener('change', function(e) {
    playbackSpeed = parseInt(e.target.value);
    if (isPlaying) {
      stopPlayback();
      startPlayback();
    }
  });

  document.addEventListener('DOMContentLoaded', function() {
    updatePosition();
  });

  function setTimeRange(range) {
    const end = new Date();
    let start = new Date();

    switch(range) {
      case '1h':
        start.setHours(end.getHours() - 1);
        break;
      case '6h':
        start.setHours(end.getHours() - 6);
        break;
      case '24h':
        start.setHours(end.getHours() - 24);
        break;
      case '7d':
        start.setDate(end.getDate() - 7);
        break;
    }

    document.querySelector('input[name="start_time"]').value = formatDateTime(start);
    document.querySelector('input[name="end_time"]').value = formatDateTime(end);
    document.querySelector('form').submit();
  }

  function formatDateTime(date) {
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, '0');
    const day = String(date.getDate()).padStart(2, '0');
    const hours = String(date.getHours()).padStart(2, '0');
    const minutes = String(date.getMinutes()).padStart(2, '0');
    return `${year}-${month}-${day}T${hours}:${minutes}`;
  }
</script>

<%
  def generate_track_points(records)
    return '' if records.empty?

    lats = records.map { |r| r.latitude.to_f }
    lngs = records.map { |r| r.longitude.to_f }

    min_lat = lats.min
    max_lat = lats.max
    min_lng = lngs.min
    max_lng = lngs.max

    lat_range = max_lat - min_lat
    lng_range = max_lng - min_lng

    lat_range = 0.001 if lat_range.zero?
    lng_range = 0.001 if lng_range.zero?

    padding = 40
    width = 800 - padding * 2
    height = 400 - padding * 2

    points = records.map do |r|
      x = padding + ((r.longitude.to_f - min_lng) / lng_range) * width
      y = padding + (1 - (r.latitude.to_f - min_lat) / lat_range) * height
      "#{x},#{y}"
    end

    points.join(' ')
  end

  def calculate_distance(records)
    return 0 if records.size < 2

    total_distance = 0.0
    (1...records.size).each do |i|
      lat1 = records[i-1].latitude.to_f
      lon1 = records[i-1].longitude.to_f
      lat2 = records[i].latitude.to_f
      lon2 = records[i].longitude.to_f

      total_distance += haversine_distance(lat1, lon1, lat2, lon2)
    end

    total_distance
  end

  def haversine_distance(lat1, lon1, lat2, lon2)
    earth_radius = 6371.0

    d_lat = (lat2 - lat1) * Math::PI / 180.0
    d_lon = (lon2 - lon1) * Math::PI / 180.0

    a = Math.sin(d_lat / 2) * Math.sin(d_lat / 2) +
        Math.cos(lat1 * Math::PI / 180.0) * Math.cos(lat2 * Math::PI / 180.0) *
        Math.sin(d_lon / 2) * Math.sin(d_lon / 2)
    c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a))

    earth_radius * c
  end

  def format_duration(seconds)
    hours = (seconds / 3600).to_i
    minutes = ((seconds % 3600) / 60).to_i

    if hours > 0
      "#{hours}小时#{minutes}分钟"
    else
      "#{minutes}分钟"
    end
  end

  def average_speed(records)
    return 0 if records.empty?

    speeds = records.select { |r| r.speed.present? }.map { |r| r.speed.to_f }
    return 0 if speeds.empty?

    speeds.sum / speeds.size
  end
%>
