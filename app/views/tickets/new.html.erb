<%= content_for(:title, "提交新需求") %>

<div class="mb-6">
  <div class="flex items-center space-x-4">
    <%= link_to tickets_path, class: "p-2 text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-lg transition-colors" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
    <% end %>
    <div>
      <h1 class="text-2xl font-bold text-gray-900"><%= @ticket.persisted? ? "编辑需求" : "提交新需求" %></h1>
      <p class="mt-1 text-gray-500"><%= @ticket.persisted? ? "修改需求信息" : "填写需求信息并提交" %></p>
    </div>
  </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-200 max-w-4xl">
  <%= form_with(model: @ticket, class: "divide-y divide-gray-200") do |f| %>
    <% if @ticket.errors.any? %>
      <div class="p-4 bg-red-50 border-b border-red-200">
        <h3 class="text-sm font-medium text-red-800">以下错误需要修正：</h3>
        <ul class="mt-2 text-sm text-red-600 list-disc list-inside">
          <% @ticket.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="p-6 space-y-6">
      <div>
        <%= f.label :title, "需求标题", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_field :title, required: true, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-shadow", placeholder: "请输入需求标题..." %>
      </div>

      <div>
        <%= f.label :description, "需求描述", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_area :description, rows: 6, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-shadow", placeholder: "请详细描述需求的背景、目标和具体要求..." %>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <div>
          <%= f.label :priority, "优先级", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.select :priority, Ticket.priorities.map { |k, v| [I18n.t("activerecord.attributes.ticket.priorities.#{k}"), v] }, {}, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-shadow" %>
        </div>

        <div>
          <%= f.label :process_node, "流程节点", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.select :process_node, Ticket::PROCESS_NODES, {}, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-shadow" %>
        </div>

        <div>
          <%= f.label :department_id, "责任部门", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.collection_select :department_id, Department.ordered, :id, :name, {}, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-shadow" %>
        </div>

        <div>
          <%= f.label :assignee_id, "负责人", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.collection_select :assignee_id, User.ordered, :id, :name, {}, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-shadow" %>
        </div>

        <% if policy(@ticket).update_status? %>
          <div>
            <%= f.label :status, "状态", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.select :status, Ticket.statuses.map { |k, v| [I18n.t("activerecord.attributes.ticket.statuses.#{k}"), v] }, {}, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-shadow" %>
          </div>
        <% end %>

        <div>
          <%= f.label :deadline, "截止日期", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.datetime_field :deadline, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-shadow" %>
        </div>
      </div>
    </div>

    <div class="px-6 py-4 bg-gray-50 rounded-b-xl flex items-center justify-end space-x-3">
      <%= link_to "取消", tickets_path, class: "px-6 py-2.5 border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 transition-colors" %>
      <%= f.submit @ticket.persisted? ? "保存修改" : "提交需求", class: "px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg shadow-sm transition-colors" %>
    </div>
  <% end %>
</div>
