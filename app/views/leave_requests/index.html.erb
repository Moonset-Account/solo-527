<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">我的请假记录</h1>
    <div class="flex items-center space-x-4">
      <%= search_form_for @q, url: leave_requests_path, method: :get, class: "flex items-center space-x-2" do |f| %>
        <%= f.select :status_eq, [["待处理", "pending"], ["已批准", "approved"], ["已拒绝", "rejected"], ["已取消", "cancelled"]], { include_blank: "全部状态" }, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        <%= f.submit "搜索", class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">课程名称</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">请假日期</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">请假原因</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">提交时间</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @leave_requests.each do |lr| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4">
              <div class="font-medium text-gray-900"><%= lr.course_enrollment.course.name %></div>
            </td>
            <td class="px-6 py-4 text-sm text-gray-900">
              <%= lr.leave_date.strftime("%Y-%m-%d") %>
            </td>
            <td class="px-6 py-4 text-sm text-gray-900">
              <%= lr.reason || "-" %>
            </td>
            <td class="px-6 py-4">
              <span class="px-2 py-1 text-xs rounded-full <%= status_class(lr.status) %>">
                <%= status_text(lr.status) %>
              </span>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500">
              <%= lr.created_at.strftime("%Y-%m-%d %H:%M") %>
            </td>
            <td class="px-6 py-4 text-right">
              <%= link_to "查看详情", leave_request_path(lr), class: "text-blue-600 hover:text-blue-900 text-sm font-medium" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if @leave_requests.empty? %>
      <div class="p-12 text-center">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">暂无请假记录</h3>
        <p class="mt-1 text-sm text-gray-500">您还没有提交过请假申请</p>
      </div>
    <% end %>
  </div>

  <div class="flex justify-center">
    <%= paginate @leave_requests %>
  </div>
</div>
