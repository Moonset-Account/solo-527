<% content_for :page_title, "申请请假" %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">申请请假</h1>
    <%= link_to "返回", course_enrollment_path(@enrollment), class: "text-gray-600 hover:text-gray-900" %>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
    <h3 class="text-lg font-medium text-gray-900 mb-2">课程信息</h3>
    <p class="text-sm text-gray-600">课程名称: <span class="font-medium text-gray-900"><%= @enrollment.course.name %></span></p>
    <p class="text-sm text-gray-600 mt-1">授课教练: <span class="font-medium text-gray-900"><%= @enrollment.course.coach || "-" %></span></p>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="text-lg font-medium text-gray-900">填写请假信息</h3>
    </div>
    <div class="p-6">
      <%= form_with model: @leave_request, url: course_enrollment_leave_requests_path(@enrollment), local: true, class: "space-y-6" do |f| %>
        <% if @leave_request.errors.any? %>
          <div class="bg-red-50 border border-red-200 rounded-lg p-4">
            <h4 class="text-sm font-medium text-red-800">请修正以下问题：</h4>
            <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
              <% @leave_request.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= f.label :leave_date, "请假日期", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.date_field :leave_date, class: "block w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div>
          <%= f.label :reason, "请假原因", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :reason, placeholder: "请输入请假原因", class: "block w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div>
          <%= f.label :remark, "备注", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_area :remark, rows: 3, placeholder: "补充说明（可选）", class: "block w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div class="flex space-x-4">
          <%= f.submit "提交申请", class: "px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium" %>
          <%= link_to "取消", course_enrollment_path(@enrollment), class: "px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 font-medium" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
