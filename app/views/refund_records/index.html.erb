<% content_for :title, "退款记录" %>

<div class="card">
  <div class="card-header">退款统计</div>
  <div class="stats-grid" style="margin-bottom:0;">
    <div class="stat-card" style="border-left-color:#409eff;">
      <h3>退款总笔数</h3>
      <div class="value"><%= @stats[:total_count] %></div>
    </div>
    <div class="stat-card" style="border-left-color:#f56c6c;">
      <h3>退款总金额</h3>
      <div class="value">¥<%= @stats[:total_amount] %></div>
    </div>
    <div class="stat-card" style="border-left-color:#67c23a;">
      <h3>今日退款笔数</h3>
      <div class="value"><%= @stats[:today_count] %></div>
    </div>
    <div class="stat-card" style="border-left-color:#e6a23c;">
      <h3>今日退款金额</h3>
      <div class="value">¥<%= @stats[:today_amount] %></div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">退款记录列表</div>
  <table>
    <thead>
      <tr>
        <th>退款单号</th>
        <th>关联预约</th>
        <th>退款金额</th>
        <th>退款原因</th>
        <th>退款方式</th>
        <th>操作员</th>
        <th>处理时间</th>
        <th>状态</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% @refund_records.each do |refund| %>
        <tr>
          <td><%= link_to refund.refund_no, refund_record_path(refund) %></td>
          <td><%= link_to refund.appointment.appointment_no, appointment_path(refund.appointment) %></td>
          <td style="color:#f56c6c; font-weight:600;">¥<%= refund.refund_amount %></td>
          <td><%= refund.refund_reason %></td>
          <td>
            <% case refund.refund_method %>
            <% when "original" %><span class="tag tag-blue">原路退回</span>
            <% when "cash" %><span class="tag tag-green">现金</span>
            <% when "transfer" %><span class="tag tag-orange">转账</span>
            <% else %><%= refund.refund_method %>
            <% end %>
          </td>
          <td><%= refund.operator %></td>
          <td><%= refund.processed_at&.strftime("%m-%d %H:%M") %></td>
          <td>
            <% case refund.status %>
            <% when "pending" %><span class="tag tag-orange">处理中</span>
            <% when "processed" %><span class="tag tag-green">已完成</span>
            <% when "failed" %><span class="tag tag-red">失败</span>
            <% end %>
          </td>
          <td>
            <%= link_to "详情", refund_record_path(refund), class: "btn btn-sm btn-default" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div class="pagination">
    <%= paginate @refund_records %>
  </div>
</div>
