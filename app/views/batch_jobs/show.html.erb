<% content_for :page_title, "批量任务详情" %>

<div class="space-y-6">
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="h-40 bg-gradient-to-r from-slate-600 to-gray-700 flex items-center justify-center relative">
      <svg class="w-16 h-16 text-white/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
      </svg>
      <span class="absolute top-4 right-4 px-3 py-1 bg-white/20 backdrop-blur-sm text-white text-sm rounded-full">
        <%= @batch_job.status_text %>
      </span>
    </div>

    <div class="p-8">
      <div class="flex items-start justify-between mb-6">
        <div>
          <h1 class="text-3xl font-bold text-gray-900"><%= @batch_job.job_type_text %></h1>
          <p class="text-gray-500 mt-2">任务编号 #<%= @batch_job.id %></p>
        </div>
        <span class="px-3 py-1 text-sm rounded-full <%= status_class(@batch_job.status) %> font-medium">
          <%= @batch_job.status_text %>
        </span>
      </div>

      <div class="mb-8">
        <div class="flex items-center justify-between text-sm text-gray-600 mb-2">
          <span class="font-medium">执行进度</span>
          <span class="font-semibold text-lg"><%= @batch_job.progress_percent %>%</span>
        </div>
        <div class="h-4 bg-gray-200 rounded-full overflow-hidden">
          <div class="h-full <%= progress_color_class(@batch_job.status) %> transition-all duration-500" 
               style="width: <%= @batch_job.progress_percent %>%, min-width: 2px"></div>
        </div>
        <div class="flex items-center justify-between mt-2 text-sm">
          <span class="text-gray-500">
            已处理: <%= @batch_job.success_count + @batch_job.failure_count %> / <%= @batch_job.total_count %> 项
          </span>
          <div class="space-x-4">
            <span class="text-green-600">
              <svg class="inline w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <%= @batch_job.success_count %> 成功
            </span>
            <span class="text-red-600">
              <svg class="inline w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>
              <%= @batch_job.failure_count %> 失败
            </span>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">创建时间</p>
          <p class="font-semibold text-gray-900 mt-1"><%= @batch_job.created_at.strftime("%Y-%m-%d %H:%M") %></p>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">开始时间</p>
          <p class="font-semibold text-gray-900 mt-1"><%= @batch_job.started_at&.strftime("%Y-%m-%d %H:%M") || "-" %></p>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">完成时间</p>
          <p class="font-semibold text-gray-900 mt-1"><%= @batch_job.completed_at&.strftime("%Y-%m-%d %H:%M") || "-" %></p>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">任务总数</p>
          <p class="font-semibold text-gray-900 mt-1"><%= @batch_job.total_count %> 项</p>
        </div>
      </div>

      <div class="flex space-x-4">
        <%= link_to "返回列表", batch_jobs_path, class: "px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 font-medium" %>
      </div>
    </div>
  </div>

  <% if @batch_job.failed? && @batch_job.error_message.present? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-6">
      <div class="flex items-start">
        <svg class="w-6 h-6 text-red-600 mt-0.5 mr-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
        </svg>
        <div>
          <h3 class="text-lg font-medium text-red-800">任务执行失败</h3>
          <p class="mt-2 text-red-700"><%= @batch_job.error_message %></p>
        </div>
      </div>
    </div>
  <% end %>

  <% if @batch_job.failure_count > 0 && @batch_job.failure_details.present? %>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
        <h3 class="text-lg font-medium text-gray-900">失败详情</h3>
        <span class="text-sm text-red-600 font-medium">共 <%= @batch_job.failure_count %> 项失败</span>
      </div>
      <div class="px-6 py-4 max-h-96 overflow-y-auto">
        <div class="space-y-2">
          <% @batch_job.failure_details_list.each_with_index do |detail, index| %>
            <div class="flex items-start p-3 bg-red-50 rounded-lg">
              <span class="flex-shrink-0 w-6 h-6 bg-red-200 text-red-700 rounded-full flex items-center justify-center text-xs font-medium mr-3">
                <%= index + 1 %>
              </span>
              <p class="text-sm text-red-700"><%= detail %></p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <% if @batch_job.result_data.present? && @batch_job.result_data.any? %>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-medium text-gray-900">任务结果</h3>
      </div>
      <div class="px-6 py-4">
        <pre class="bg-gray-50 rounded-lg p-4 text-sm text-gray-700 overflow-x-auto"><%= JSON.pretty_generate(@batch_job.result_data) %></pre>
      </div>
    </div>
  <% end %>

  <% if @batch_job.completed? && @batch_job.result_data["download_url"].present? %>
    <div class="bg-green-50 border border-green-200 rounded-lg p-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center">
          <svg class="w-5 h-5 text-green-600 mr-3" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          <span class="text-green-800 font-medium">文件已生成</span>
        </div>
        <%= link_to "下载文件", @batch_job.result_data["download_url"], class: "px-4 py-2 bg-green-600 text-white rounded-lg text-sm font-medium hover:bg-green-700", target: "_blank" %>
      </div>
    </div>
  <% end %>

  <%= link_to "← 返回任务列表", batch_jobs_path, class: "text-gray-600 hover:text-gray-900" %>
</div>
