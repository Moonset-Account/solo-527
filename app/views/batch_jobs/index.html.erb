<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">我的批量任务</h1>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">任务类型</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">进度</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">创建时间</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">完成时间</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @batch_jobs.each do |job| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4">
              <div class="font-medium text-gray-900"><%= job.job_type_text %></div>
              <div class="text-sm text-gray-500">ID: #<%= job.id %></div>
            </td>
            <td class="px-6 py-4">
              <span class="px-2 py-1 text-xs rounded-full <%= status_class(job.status) %>">
                <%= job.status_text %>
              </span>
            </td>
            <td class="px-6 py-4">
              <div class="w-full">
                <div class="flex items-center justify-between text-xs mb-1">
                  <span class="text-gray-600"><%= job.success_count + job.failure_count %> / <%= job.total_count %></span>
                  <span class="font-medium"><%= job.progress_percent %>%</span>
                </div>
                <div class="h-2 bg-gray-200 rounded-full overflow-hidden">
                  <div class="h-full <%= progress_color_class(job.status) %> transition-all duration-500" 
                       style="width: <%= job.progress_percent %>%"></div>
                </div>
              </div>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500">
              <%= job.created_at.strftime("%Y-%m-%d %H:%M") %>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500">
              <%= job.completed_at&.strftime("%Y-%m-%d %H:%M") || "-" %>
            </td>
            <td class="px-6 py-4 text-right">
              <%= link_to "查看详情", batch_job_path(job), class: "text-blue-600 hover:text-blue-900 text-sm font-medium" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if @batch_jobs.empty? %>
      <div class="p-12 text-center">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">暂无批量任务</h3>
        <p class="mt-1 text-sm text-gray-500">您还没有创建过批量任务</p>
      </div>
    <% end %>
  </div>

  <div class="flex justify-center">
    <%= paginate @batch_jobs %>
  </div>
</div>
