<%= content_for(:title, "部门管理") %>

<div class="mb-6 flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">部门管理</h1>
    <p class="mt-1 text-gray-500">管理组织架构和部门信息</p>
  </div>
  <% if policy(Department).create? %>
    <%= link_to new_department_path, class: "inline-flex items-center px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg shadow-sm transition-colors" do %>
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
      </svg>
      新增部门
    <% end %>
  <% end %>
</div>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-2 xl:grid-cols-3">
  <% if @departments.any? %>
    <% @departments.each do |dept| %>
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-md transition-shadow">
        <%= link_to department_path(dept), class: "block p-6" do %>
          <div class="flex items-start justify-between">
            <div>
              <h3 class="text-lg font-semibold text-gray-900"><%= dept.name %></h3>
              <p class="mt-1 text-sm text-gray-500 line-clamp-2"><%= dept.description.presence || "暂无部门描述" %></p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-indigo-100 to-purple-100 flex items-center justify-center text-2xl">
              🏢
            </div>
          </div>
          <div class="mt-4 grid grid-cols-2 gap-4 pt-4 border-t border-gray-100">
            <div>
              <p class="text-2xl font-bold text-indigo-600"><%= dept.users.count %></p>
              <p class="text-xs text-gray-500">部门成员</p>
            </div>
            <div>
              <p class="text-2xl font-bold text-purple-600"><%= dept.tickets.count %></p>
              <p class="text-xs text-gray-500">需求总数</p>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="lg:col-span-3 xl:col-span-3 bg-white rounded-xl shadow-sm border border-gray-200">
      <div class="px-6 py-16 text-center">
        <svg class="w-12 h-12 mx-auto text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
        </svg>
        <p class="mt-4 text-gray-500">暂无部门数据</p>
        <% if policy(Department).create? %>
          <%= link_to "立即创建", new_department_path, class: "mt-2 inline-block text-indigo-600 hover:text-indigo-700 font-medium" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<% if @departments.respond_to?(:total_pages) %>
  <div class="mt-6">
    <%= paginate @departments %>
  </div>
<% end %>
