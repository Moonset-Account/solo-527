<%= content_for(:title, @department.name) %>

<div class="mb-6">
  <div class="flex items-center justify-between">
    <div class="flex items-center space-x-4">
      <%= link_to departments_path, class: "p-2 text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-lg transition-colors" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
      <% end %>
      <div>
        <h1 class="text-2xl font-bold text-gray-900"><%= @department.name %></h1>
        <p class="mt-1 text-gray-500"><%= @department.description.presence || "暂无描述" %></p>
      </div>
    </div>
    <% if policy(@department).edit? %>
      <div class="flex space-x-2">
        <%= link_to "编辑", edit_department_path(@department), class: "px-4 py-2 bg-white hover:bg-gray-50 border border-gray-300 text-gray-700 font-medium rounded-lg transition-colors" %>
        <% if policy(@department).destroy? %>
          <%= link_to "删除", department_path(@department), method: :delete, data: { confirm: "确认删除该部门?" }, class: "px-4 py-2 bg-red-50 hover:bg-red-100 border border-red-200 text-red-600 font-medium rounded-lg transition-colors" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<div class="grid grid-cols-1 gap-4 mb-6 sm:grid-cols-3">
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <p class="text-sm font-medium text-gray-500">部门成员</p>
    <p class="mt-2 text-3xl font-bold text-indigo-600"><%= @users.count %></p>
  </div>
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <p class="text-sm font-medium text-gray-500">需求总数</p>
    <p class="mt-2 text-3xl font-bold text-purple-600"><%= @tickets.total_count %></p>
  </div>
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <p class="text-sm font-medium text-gray-500">已完成需求</p>
    <p class="mt-2 text-3xl font-bold text-green-600"><%= @department.tickets.completed.count %></p>
  </div>
</div>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
  <div class="bg-white rounded-xl shadow-sm border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">部门成员</h2>
    </div>
    <% if @users.any? %>
      <ul class="divide-y divide-gray-200">
        <% @users.each do |user| %>
          <li class="px-6 py-4 hover:bg-gray-50 transition-colors">
            <%= link_to user_path(user), class: "flex items-center space-x-3" do %>
              <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-400 to-indigo-500 flex items-center justify-center text-white font-medium">
                <%= user.name.first %>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-gray-900"><%= user.name %></p>
                <p class="text-xs text-gray-500 truncate">
                  <% if user.executive? %>
                    <span class="text-purple-600 font-medium">总经办</span>
                  <% elsif user.admin? %>
                    <span class="text-blue-600 font-medium">管理员</span>
                  <% else %>
                    普通用户
                  <% end %>
                  · <%= user.email %>
                </p>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="px-6 py-12 text-center text-gray-500">暂无成员</div>
    <% end %>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">部门需求</h2>
    </div>
    <% if @tickets.any? %>
      <ul class="divide-y divide-gray-200">
        <% @tickets.each do |ticket| %>
          <li class="px-6 py-4 hover:bg-gray-50 transition-colors">
            <%= link_to ticket_path(ticket), class: "block" do %>
              <div class="flex items-start justify-between">
                <div class="min-w-0 flex-1">
                  <div class="flex items-center space-x-2">
                    <%= status_badge(ticket.status) %>
                    <%= priority_badge(ticket.priority) %>
                  </div>
                  <p class="mt-1 text-sm font-medium text-gray-900 truncate"><%= ticket.title %></p>
                  <p class="text-xs text-gray-500 mt-0.5">负责人: <%= ticket.assignee&.name %> · <%= format_date(ticket.created_at) %></p>
                </div>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>
      <div class="px-6 py-4 border-t border-gray-200">
        <%= paginate @tickets, param_name: :page %>
      </div>
    <% else %>
      <div class="px-6 py-12 text-center text-gray-500">暂无需求</div>
    <% end %>
  </div>
</div>
