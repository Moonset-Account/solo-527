<%= content_for(:title, @department.persisted? ? "编辑部门" : "新增部门") %>

<div class="mb-6">
  <div class="flex items-center space-x-4">
    <%= link_to departments_path, class: "p-2 text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-lg transition-colors" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
    <% end %>
    <div>
      <h1 class="text-2xl font-bold text-gray-900"><%= @department.persisted? ? "编辑部门" : "新增部门" %></h1>
    </div>
  </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-200 max-w-2xl">
  <%= form_with(model: @department, class: "divide-y divide-gray-200") do |f| %>
    <% if @department.errors.any? %>
      <div class="p-4 bg-red-50 border-b border-red-200">
        <ul class="text-sm text-red-600 list-disc list-inside">
          <% @department.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="p-6 space-y-6">
      <div>
        <%= f.label :name, "部门名称", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_field :name, required: true, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>

      <div>
        <%= f.label :description, "部门描述", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_area :description, rows: 4, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500", placeholder: "请输入部门职责和描述..." %>
      </div>
    </div>

    <div class="px-6 py-4 bg-gray-50 rounded-b-xl flex items-center justify-end space-x-3">
      <%= link_to "取消", departments_path, class: "px-6 py-2.5 border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 transition-colors" %>
      <%= f.submit class: "px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg shadow-sm transition-colors" %>
    </div>
  <% end %>
</div>
