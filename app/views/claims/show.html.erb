<div class="min-h-screen bg-gray-50">
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-6 flex items-center justify-between">
      <div class="flex items-center space-x-4">
        <%= link_to '← 返回', claims_path, class: 'text-sm text-gray-500 hover:text-gray-700' %>
        <h1 class="text-2xl font-bold text-gray-900">工单详情</h1>
        <span class="font-mono text-sm text-gray-500"><%= @claim.claim_no %></span>
      </div>
      <div class="flex items-center space-x-3">
        <% status_class = case @claim.status
          when 'pending' then 'bg-yellow-100 text-yellow-800'
          when 'processing' then 'bg-blue-100 text-blue-800'
          when 'approved' then 'bg-green-100 text-green-800'
          when 'rejected' then 'bg-red-100 text-red-800'
          when 'paid' then 'bg-purple-100 text-purple-800'
          else 'bg-gray-100 text-gray-800'
          end %>
        <span class="inline-flex rounded-full px-3 py-1 text-sm font-medium <%= status_class %>">
          <%= @claim.status.text %>
        </span>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      <div class="lg:col-span-2 space-y-6">
        <div class="rounded-lg bg-white p-6 shadow-sm">
          <h2 class="mb-4 text-lg font-semibold text-gray-900">基本信息</h2>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <p class="text-sm text-gray-500">工单号</p>
              <p class="mt-1 font-mono text-sm font-medium text-gray-900"><%= @claim.claim_no %></p>
            </div>
            <div>
              <p class="text-sm text-gray-500">工单类型</p>
              <p class="mt-1 text-sm text-gray-900"><%= @claim.claim_type&.text %></p>
            </div>
            <div>
              <p class="text-sm text-gray-500">车牌号</p>
              <p class="mt-1 text-sm font-medium text-gray-900"><%= @claim.vehicle&.plate_number %></p>
            </div>
            <div>
              <p class="text-sm text-gray-500">司机</p>
              <p class="mt-1 text-sm text-gray-900"><%= @claim.driver&.email %></p>
            </div>
            <div>
              <p class="text-sm text-gray-500">赔付金额</p>
              <p class="mt-1 text-lg font-bold text-blue-600">¥<%= number_with_precision(@claim.amount, precision: 2) %></p>
            </div>
            <div>
              <p class="text-sm text-gray-500">处理人</p>
              <p class="mt-1 text-sm text-gray-900"><%= @claim.handler&.email || '待分配' %></p>
            </div>
            <div class="sm:col-span-2">
              <p class="text-sm text-gray-500">关联结算单</p>
              <p class="mt-1 text-sm text-gray-900">
                <% if @claim.settlement %>
                  <%= link_to @claim.settlement.settlement_no, settlement_path(@claim.settlement), class: 'text-blue-600 hover:text-blue-900' %>
                <% else %>
                  暂未关联
                <% end %>
              </p>
            </div>
          </div>
        </div>

        <div class="rounded-lg bg-white p-6 shadow-sm">
          <h2 class="mb-4 text-lg font-semibold text-gray-900">状态时间线</h2>
          <div class="relative">
            <div class="absolute left-4 top-0 h-full w-0.5 bg-gray-200"></div>
            <div class="space-y-6">
              <div class="relative flex items-start">
                <div class="flex h-8 w-8 items-center justify-center rounded-full bg-green-500 text-white">
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                </div>
                <div class="ml-4 flex-1">
                  <p class="text-sm font-medium text-gray-900">工单上报</p>
                  <p class="text-sm text-gray-500"><%= @claim.created_at&.strftime('%Y-%m-%d %H:%M:%S') %></p>
                  <p class="mt-1 text-sm text-gray-600">由 <%= @claim.driver&.email %> 上报</p>
                </div>
              </div>

              <% if @claim.handled_at || @claim.processing? || @claim.approved? || @claim.rejected? || @claim.paid? %>
                <div class="relative flex items-start">
                  <div class="flex h-8 w-8 items-center justify-center rounded-full bg-blue-500 text-white">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                  </div>
                  <div class="ml-4 flex-1">
                    <p class="text-sm font-medium text-gray-900">工单受理</p>
                    <p class="text-sm text-gray-500"><%= @claim.handled_at&.strftime('%Y-%m-%d %H:%M:%S') || '处理中' %></p>
                    <% if @claim.handler %>
                      <p class="mt-1 text-sm text-gray-600">处理人：<%= @claim.handler.email %></p>
                    <% end %>
                  </div>
                </div>
              <% end %>

              <% if @claim.approved? || @claim.paid? %>
                <div class="relative flex items-start">
                  <div class="flex h-8 w-8 items-center justify-center rounded-full bg-green-500 text-white">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  </div>
                  <div class="ml-4 flex-1">
                    <p class="text-sm font-medium text-gray-900">工单批准</p>
                    <p class="text-sm text-gray-500"><%= @claim.approved_at&.strftime('%Y-%m-%d %H:%M:%S') %></p>
                  </div>
                </div>
              <% end %>

              <% if @claim.rejected? %>
                <div class="relative flex items-start">
                  <div class="flex h-8 w-8 items-center justify-center rounded-full bg-red-500 text-white">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  </div>
                  <div class="ml-4 flex-1">
                    <p class="text-sm font-medium text-gray-900">工单驳回</p>
                    <p class="text-sm text-gray-500"><%= @claim.rejected_at&.strftime('%Y-%m-%d %H:%M:%S') %></p>
                    <% if @claim.reject_reason.present? %>
                      <p class="mt-1 text-sm text-gray-600">驳回原因：<%= @claim.reject_reason %></p>
                    <% end %>
                  </div>
                </div>
              <% end %>

              <% if @claim.paid? %>
                <div class="relative flex items-start">
                  <div class="flex h-8 w-8 items-center justify-center rounded-full bg-purple-500 text-white">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  </div>
                  <div class="ml-4 flex-1">
                    <p class="text-sm font-medium text-gray-900">已支付</p>
                    <p class="text-sm text-gray-500">赔付金额已结算支付</p>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <div class="rounded-lg bg-white p-6 shadow-sm">
          <h2 class="mb-4 text-lg font-semibold text-gray-900">赔付描述</h2>
          <div class="rounded-md bg-gray-50 p-4">
            <p class="whitespace-pre-wrap text-sm text-gray-700"><%= @claim.description.presence || '暂无描述' %></p>
          </div>
        </div>

        <div class="rounded-lg bg-white p-6 shadow-sm">
          <h2 class="mb-4 text-lg font-semibold text-gray-900">证据材料</h2>
          <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4">
            <div class="aspect-square rounded-lg border-2 border-dashed border-gray-300 flex items-center justify-center">
              <div class="text-center">
                <svg class="mx-auto h-8 w-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                <p class="mt-1 text-xs text-gray-500">暂无证据</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="space-y-6">
        <div class="rounded-lg bg-white p-6 shadow-sm">
          <h2 class="mb-4 text-lg font-semibold text-gray-900">操作</h2>
          <div class="space-y-3">
            <% if policy(@claim).handle? %>
              <%= link_to '受理工单', handle_admin_claim_path(@claim), method: :post, class: 'w-full rounded-md bg-blue-600 px-4 py-2 text-center text-sm font-medium text-white hover:bg-blue-700' %>
            <% end %>
            <% if policy(@claim).approve? %>
              <%= link_to '批准工单', approve_admin_claim_path(@claim), method: :post, class: 'w-full rounded-md bg-green-600 px-4 py-2 text-center text-sm font-medium text-white hover:bg-green-700' %>
            <% end %>
            <% if policy(@claim).reject? %>
              <button type="button" onclick="document.getElementById('reject-modal').classList.remove('hidden')" class="w-full rounded-md bg-red-600 px-4 py-2 text-center text-sm font-medium text-white hover:bg-red-700">
                驳回工单
              </button>
            <% end %>
          </div>
        </div>

        <div class="rounded-lg bg-white p-6 shadow-sm">
          <h2 class="mb-4 text-lg font-semibold text-gray-900">处理记录</h2>
          <div class="space-y-4">
            <% @logs = OperationLog.by_target(@claim).recent.limit(10) %>
            <% if @logs.any? %>
              <% @logs.each do |log| %>
                <div class="border-l-2 border-gray-200 pl-4">
                  <p class="text-sm font-medium text-gray-900"><%= log.action %></p>
                  <p class="text-xs text-gray-500"><%= log.user&.email %> · <%= log.created_at.strftime('%Y-%m-%d %H:%M') %></p>
                </div>
              <% end %>
            <% else %>
              <p class="text-sm text-gray-500">暂无处理记录</p>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="reject-modal" class="hidden fixed inset-0 bg-gray-500 bg-opacity-75 flex items-center justify-center z-50">
  <div class="bg-white rounded-lg p-6 max-w-md w-full mx-4">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">驳回工单</h3>
    <%= form_with url: reject_admin_claim_path(@claim), method: :post, local: true do |f| %>
      <div class="mb-4">
        <%= f.label :reject_reason, '驳回原因', class: 'block text-sm font-medium text-gray-700' %>
        <%= f.text_area :reject_reason, rows: 4, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-red-500 focus:ring-red-500 sm:text-sm' %>
      </div>
      <div class="flex justify-end space-x-3">
        <button type="button" onclick="document.getElementById('reject-modal').classList.add('hidden')" class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-md hover:bg-gray-200">
          取消
        </button>
        <%= f.submit '确认驳回', class: 'px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-md hover:bg-red-700' %>
      </div>
    <% end %>
  </div>
</div>
