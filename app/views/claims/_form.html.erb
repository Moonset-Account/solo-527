<%= form_with model: @claim, local: true do |form| %>
  <% if @claim.errors.any? %>
    <div class="mb-6 rounded-md bg-red-50 p-4">
      <div class="flex">
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">表单存在 <%= @claim.errors.count %> 个错误：</h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc space-y-1 pl-5">
              <% @claim.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="space-y-6">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      <div>
        <%= form.label :vehicle_id, '选择车辆', class: 'block text-sm font-medium text-gray-700' %>
        <%= form.select :vehicle_id, Vehicle.active.map { |v| [v.plate_number, v.id] }, { include_blank: '请选择车辆' }, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
      </div>

      <div>
        <%= form.label :claim_type, '工单类型', class: 'block text-sm font-medium text-gray-700' %>
        <%= form.select :claim_type, Claim.claim_type.options, { include_blank: '请选择类型' }, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
      </div>

      <div>
        <%= form.label :amount, '赔付金额 (元)', class: 'block text-sm font-medium text-gray-700' %>
        <%= form.number_field :amount, step: '0.01', min: '0', class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
      </div>

      <div>
        <%= form.label :reported_at, '上报时间', class: 'block text-sm font-medium text-gray-700' %>
        <%= form.datetime_field :reported_at, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
      </div>
    </div>

    <div>
      <%= form.label :description, '详细描述', class: 'block text-sm font-medium text-gray-700' %>
      <%= form.text_area :description, rows: 5, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', placeholder: '请详细描述赔付原因和情况...' %>
    </div>

    <div>
      <%= form.label :evidence, '证据材料', class: 'block text-sm font-medium text-gray-700' %>
      <div class="mt-1 flex justify-center rounded-md border-2 border-dashed border-gray-300 px-6 pt-5 pb-6">
        <div class="space-y-1 text-center">
          <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
            <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <div class="flex text-sm text-gray-600">
            <label for="file-upload" class="relative cursor-pointer rounded-md bg-white font-medium text-blue-600 focus-within:outline-none focus-within:ring-2 focus-within:ring-blue-500 focus-within:ring-offset-2 hover:text-blue-500">
              <span>上传文件</span>
              <%= form.file_field :evidence, id: 'file-upload', class: 'sr-only', multiple: true %>
            </label>
            <p class="pl-1">或拖拽到此处</p>
          </div>
          <p class="text-xs text-gray-500">支持 PNG, JPG, PDF 格式，单个文件不超过 10MB</p>
        </div>
      </div>
    </div>

    <div class="flex justify-end space-x-3 pt-4 border-t border-gray-200">
      <%= link_to '取消', claims_path, class: 'inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2' %>
      <%= form.submit '提交工单', class: 'inline-flex items-center rounded-md border border-transparent bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2' %>
    </div>
  </div>
<% end %>
