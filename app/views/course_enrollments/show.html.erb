<% content_for :page_title, "报名详情" %>

<div class="space-y-6">
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="h-48 bg-gradient-to-r from-blue-500 to-indigo-500 flex items-center justify-center relative">
      <svg class="w-20 h-20 text-white/30" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
      </svg>
      <div class="absolute top-4 right-4 flex space-x-2">
        <span class="px-3 py-1 bg-white/20 backdrop-blur-sm text-white text-sm rounded-full">
          <%= status_text(@enrollment.status) %>
        </span>
        <span class="px-3 py-1 bg-white/20 backdrop-blur-sm text-white text-sm rounded-full">
          支付: <%= status_text(@enrollment.payment_status) %>
        </span>
      </div>
    </div>

    <div class="p-8">
      <div class="flex items-start justify-between mb-6">
        <div>
          <h1 class="text-3xl font-bold text-gray-900"><%= @enrollment.course.name %></h1>
          <p class="text-gray-500 mt-2">报名编号 #<%= @enrollment.id %></p>
        </div>
        <div class="text-right">
          <p class="text-3xl font-bold text-orange-600">¥<%= "%.2f" % @enrollment.price %></p>
          <p class="text-sm text-gray-500">课程费用</p>
        </div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">报名状态</p>
          <p class="mt-1"><span class="px-2 py-1 text-xs rounded-full <%= status_class(@enrollment.status) %>"><%= status_text(@enrollment.status) %></span></p>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">支付状态</p>
          <p class="mt-1"><span class="px-2 py-1 text-xs rounded-full <%= status_class(@enrollment.payment_status) %>"><%= status_text(@enrollment.payment_status) %></span></p>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">报名时间</p>
          <p class="font-semibold text-gray-900 mt-1"><%= @enrollment.enrolled_at&.strftime("%Y-%m-%d %H:%M") || "-" %></p>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">数据来源</p>
          <p class="font-semibold text-gray-900 mt-1"><%= source_text(@enrollment.source) %></p>
        </div>
      </div>

      <% if @enrollment.remark.present? %>
        <div class="mb-8 p-4 bg-gray-50 rounded-lg">
          <p class="text-sm text-gray-500">备注</p>
          <p class="text-gray-900 mt-1"><%= @enrollment.remark %></p>
        </div>
      <% end %>

      <div class="flex space-x-4">
        <% if @enrollment.pending? %>
          <%= button_to "取消报名", cancel_course_enrollment_path(@enrollment), method: :post,
                        class: "px-6 py-3 bg-red-600 text-white rounded-lg hover:bg-red-700 font-medium",
                        data: { confirm: "确认取消报名？" } %>
        <% end %>
        <%= link_to "返回列表", course_enrollments_path, class: "px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 font-medium" %>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-medium text-gray-900">课程信息</h3>
      </div>
      <div class="px-6 py-4 space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-sm text-gray-500">课程名称</span>
          <span class="font-medium text-gray-900"><%= @enrollment.course.name %></span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-sm text-gray-500">授课教练</span>
          <span class="font-medium text-gray-900"><%= @enrollment.course.coach || "-" %></span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-sm text-gray-500">课程级别</span>
          <span class="font-medium text-gray-900"><%= @enrollment.course.level || "-" %></span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-sm text-gray-500">课程状态</span>
          <span class="px-2 py-1 text-xs rounded-full <%= status_class(@enrollment.course.status) %>"><%= status_text(@enrollment.course.status) %></span>
        </div>
      </div>
      <div class="px-6 py-4 border-t border-gray-200">
        <%= link_to "查看课程", course_path(@enrollment.course), class: "block px-4 py-2 bg-gray-50 rounded-lg text-center text-gray-700 hover:bg-gray-100 text-sm" %>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-medium text-gray-900">支付信息</h3>
      </div>
      <div class="divide-y divide-gray-200">
        <% @payments.each do |payment| %>
          <div class="px-6 py-4">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-900">¥<%= "%.2f" % payment.amount %></p>
                <p class="text-xs text-gray-500 mt-1">
                  <%= payment.payment_method&.humanize || "-" %> · <%= payment.created_at.strftime("%Y-%m-%d %H:%M") %>
                </p>
              </div>
              <div class="flex items-center space-x-3">
                <span class="px-2 py-1 text-xs rounded-full <%= status_class(payment.status) %>">
                  <%= status_text(payment.status) %>
                </span>
                <%= link_to "查看", payment_path(payment), class: "text-blue-600 hover:text-blue-900 text-sm" %>
              </div>
            </div>
          </div>
        <% end %>
        <% if @payments.empty? %>
          <div class="px-6 py-8 text-center text-gray-500">
            暂无支付记录
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-medium text-gray-900">请假记录</h3>
      </div>
      <div class="divide-y divide-gray-200">
        <% @leave_requests.each do |lr| %>
          <div class="px-6 py-4">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-900">请假日期: <%= lr.leave_date.strftime("%Y-%m-%d") %></p>
                <p class="text-sm text-gray-500 mt-1"><%= lr.reason %></p>
              </div>
              <div class="flex items-center space-x-3">
                <span class="px-2 py-1 text-xs rounded-full <%= status_class(lr.status) %>">
                  <%= status_text(lr.status) %>
                </span>
                <%= link_to "查看", leave_request_path(lr), class: "text-blue-600 hover:text-blue-900 text-sm" %>
              </div>
            </div>
          </div>
        <% end %>
        <% if @leave_requests.empty? %>
          <div class="px-6 py-8 text-center text-gray-500">
            暂无请假记录
          </div>
        <% end %>
      </div>
      <div class="px-6 py-4 border-t border-gray-200">
        <%= link_to "申请请假", new_course_enrollment_leave_request_path(@enrollment), class: "block px-4 py-2 bg-gray-50 rounded-lg text-center text-gray-700 hover:bg-gray-100 text-sm" %>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-medium text-gray-900">签到记录</h3>
      </div>
      <div class="divide-y divide-gray-200">
        <% @check_ins.each do |ci| %>
          <div class="px-6 py-4">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-900"><%= ci.check_in_method&.humanize || "-" %></p>
                <p class="text-xs text-gray-500 mt-1">
                  <%= ci.checked_in_at&.strftime("%Y-%m-%d %H:%M") || "-" %> · 来源: <%= source_text(ci.source) %>
                </p>
              </div>
              <div class="flex items-center space-x-3">
                <span class="px-2 py-1 text-xs rounded-full <%= status_class(ci.status) %>">
                  <%= status_text(ci.status) %>
                </span>
                <%= link_to "查看", check_in_path(ci), class: "text-blue-600 hover:text-blue-900 text-sm" %>
              </div>
            </div>
          </div>
        <% end %>
        <% if @check_ins.empty? %>
          <div class="px-6 py-8 text-center text-gray-500">
            暂无签到记录
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%= render "shared/version_history", versions: @versions %>

  <%= link_to "← 返回报名列表", course_enrollments_path, class: "text-gray-600 hover:text-gray-900" %>
</div>
