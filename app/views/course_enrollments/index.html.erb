<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">我的课程报名</h1>
    <div class="flex items-center space-x-4">
      <%= search_form_for @q, url: course_enrollments_path, method: :get, class: "flex items-center space-x-2" do |f| %>
        <%= f.search_field :course_name_cont, placeholder: "搜索课程名称...", class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        <%= f.select :status_eq, [["待处理", "pending"], ["已确认", "confirmed"], ["已取消", "cancelled"], ["已完成", "completed"]], { include_blank: "全部状态" }, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        <%= f.select :payment_status_eq, [["未支付", "unpaid"], ["已支付", "paid"], ["支付失败", "failed"], ["已退款", "refunded"]], { include_blank: "全部支付状态" }, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        <%= f.submit "搜索", class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">课程名称</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">报名状态</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">支付状态</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">费用</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">报名时间</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">来源</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @enrollments.each do |enrollment| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4">
              <div class="font-medium text-gray-900"><%= enrollment.course.name %></div>
              <div class="text-sm text-gray-500"><%= enrollment.course.coach || "未设置教练" %></div>
            </td>
            <td class="px-6 py-4">
              <span class="px-2 py-1 text-xs rounded-full <%= status_class(enrollment.status) %>">
                <%= status_text(enrollment.status) %>
              </span>
            </td>
            <td class="px-6 py-4">
              <span class="px-2 py-1 text-xs rounded-full <%= status_class(enrollment.payment_status) %>">
                <%= status_text(enrollment.payment_status) %>
              </span>
            </td>
            <td class="px-6 py-4 text-sm text-orange-600 font-medium">
              ¥<%= "%.2f" % enrollment.price %>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500">
              <%= enrollment.enrolled_at&.strftime("%Y-%m-%d %H:%M") || enrollment.created_at.strftime("%Y-%m-%d %H:%M") %>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500">
              <%= source_text(enrollment.source) %>
            </td>
            <td class="px-6 py-4 text-right">
              <div class="flex items-center justify-end space-x-2">
                <%= link_to "查看详情", course_enrollment_path(enrollment), class: "text-blue-600 hover:text-blue-900 text-sm font-medium" %>
                <% if enrollment.pending? %>
                  <%= button_to "取消", cancel_course_enrollment_path(enrollment), method: :post, class: "text-red-600 hover:text-red-900 text-sm", data: { confirm: "确认取消报名？" } %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if @enrollments.empty? %>
      <div class="p-12 text-center">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">暂无报名记录</h3>
        <p class="mt-1 text-sm text-gray-500">您还没有报名任何课程</p>
        <%= link_to "浏览课程", courses_path, class: "mt-4 inline-block px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 text-sm font-medium" %>
      </div>
    <% end %>
  </div>

  <div class="flex justify-center">
    <%= paginate @enrollments %>
  </div>
</div>
