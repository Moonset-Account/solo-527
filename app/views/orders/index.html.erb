<% content_for :title, "我的订单" %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h2 class="text-2xl font-bold">我的订单</h2>
    <div class="flex gap-2">
      <% %w[all pending paid cancelled refunded].each do |s| %>
        <% active = (params[:status] == s) || (params[:status].blank? && s == "all") %>
        <%= link_to s == "all" ? "全部" : s, orders_path(status: s == "all" ? nil : s), class: "px-3 py-1.5 text-sm rounded-lg #{active ? 'bg-[#6C3CE1] text-white' : 'bg-[#16162a] text-gray-400 hover:text-gray-200 border border-gray-700'} transition-colors" %>
      <% end %>
    </div>
  </div>

  <div class="bg-[#16162a] rounded-lg border border-gray-800 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="text-left text-xs text-gray-500 uppercase border-b border-gray-800">
            <th class="px-5 py-3">订单号</th>
            <th class="px-5 py-3">金额</th>
            <th class="px-5 py-3">状态</th>
            <th class="px-5 py-3">下单时间</th>
            <th class="px-5 py-3">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-800">
          <% @orders.each do |order| %>
            <tr class="hover:bg-gray-800/50 transition-colors">
              <td class="px-5 py-3 text-sm"><%= order.order_no %></td>
              <td class="px-5 py-3 text-sm"><%= format_currency(order.total_amount) %></td>
              <td class="px-5 py-3 text-sm"><%= status_badge(order.status) %></td>
              <td class="px-5 py-3 text-sm text-gray-400"><%= order.created_at.strftime("%Y-%m-%d %H:%M") %></td>
              <td class="px-5 py-3 text-sm">
                <%= link_to "查看", order_path(order), class: "text-[#6C3CE1] hover:underline" %>
              </td>
            </tr>
          <% end %>
          <% if @orders.empty? %>
            <tr><td colspan="5" class="px-5 py-12 text-center text-gray-500">暂无订单</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
