<% content_for :page_title, @course.name %>

<div class="space-y-6">
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="h-56 bg-gradient-to-r from-blue-500 to-cyan-500 flex items-center justify-center relative">
      <svg class="w-24 h-24 text-white/30" fill="currentColor" viewBox="0 0 24 24">
        <path d="M2 15c1.5 0 2 1 3.5 1s2-1 3.5-1 2 1 3.5 1 2-1 3.5-1 2 1 3.5 1 2-1 3.5-1v2c-1.5 0-2 1-3.5 1s-2-1-3.5-1-2 1-3.5 1-2-1-3.5-1-2 1-3.5 1-2-1-3.5-1v-2zm0-4c1.5 0 2 1 3.5 1s2-1 3.5-1 2 1 3.5 1 2-1 3.5-1 2 1 3.5 1 2-1 3.5-1v2c-1.5 0-2 1-3.5 1s-2-1-3.5-1-2 1-3.5 1-2-1-3.5-1-2 1-3.5 1-2-1-3.5-1v-2zm0-4c1.5 0 2 1 3.5 1s2-1 3.5-1 2 1 3.5 1 2-1 3.5-1 2 1 3.5 1 2-1 3.5-1v2c-1.5 0-2 1-3.5 1s-2-1-3.5-1-2 1-3.5 1-2-1-3.5-1-2 1-3.5 1-2-1-3.5-1v-2z"/>
      </svg>
      <span class="absolute top-4 right-4 px-3 py-1 bg-white/20 backdrop-blur-sm text-white text-sm rounded-full">
        <%= status_text(@course.status) %>
      </span>
    </div>

    <div class="p-8">
      <div class="flex items-start justify-between mb-6">
        <div>
          <h1 class="text-3xl font-bold text-gray-900"><%= @course.name %></h1>
          <p class="text-gray-500 mt-2"><%= @course.description %></p>
        </div>
        <div class="text-right">
          <p class="text-3xl font-bold text-orange-600">¥<%= "%.2f" % @course.price %></p>
          <p class="text-sm text-gray-500">每位学员</p>
        </div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">级别</p>
          <p class="font-semibold text-gray-900 mt-1"><%= @course.level || "未设置" %></p>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">教练</p>
          <p class="font-semibold text-gray-900 mt-1"><%= @course.coach || "未设置" %></p>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">总名额</p>
          <p class="font-semibold text-gray-900 mt-1"><%= @course.capacity %> 人</p>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">已报名</p>
          <p class="font-semibold text-blue-600 mt-1"><%= @course.enrolled_count %> 人</p>
        </div>
      </div>

      <div class="mb-8">
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm font-medium text-gray-700">满班率</span>
          <span class="text-sm font-semibold <%= @course.fill_rate >= 100 ? 'text-red-600' : @course.fill_rate >= 80 ? 'text-orange-600' : 'text-green-600' %>">
            <%= @course.fill_rate %>%
          </span>
        </div>
        <div class="h-3 bg-gray-200 rounded-full overflow-hidden">
          <div class="h-full <%= @course.fill_rate >= 100 ? 'bg-red-500' : @course.fill_rate >= 80 ? 'bg-orange-500' : 'bg-green-500' %> 
                      transition-all duration-500" 
               style="width: <%= [@course.fill_rate, 100].min %>%"></div>
        </div>
        <p class="text-xs text-gray-500 mt-1">
          剩余 <%= [@course.capacity - @course.enrolled_count, 0].max %> 个名额
        </p>
      </div>

      <div class="flex space-x-4">
        <% if @course.has_available_spots? && !current_user.courses.exists?(@course.id) %>
          <%= button_to "立即报名", enroll_course_path(@course), method: :post, 
                        class: "px-8 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium",
                        data: { confirm: "确认报名《#{@course.name}》？费用 ¥#{@course.price}" } %>
        <% elsif current_user.courses.exists?(@course.id) %>
          <div class="px-8 py-3 bg-green-100 text-green-700 rounded-lg font-medium">
            ✓ 您已报名此课程
          </div>
        <% else %>
          <div class="px-8 py-3 bg-gray-100 text-gray-500 rounded-lg font-medium">
            课程已满员
          </div>
        <% end %>
        <%= link_to "返回列表", courses_path, class: "px-8 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 font-medium" %>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="text-lg font-medium text-gray-900">我的报名记录</h3>
    </div>
    <div class="divide-y divide-gray-200">
      <% if @my_enrollment.present? %>
        <div class="px-6 py-4">
          <div class="flex items-center justify-between">
            <div>
              <p class="font-medium text-gray-900">报名时间: <%= @my_enrollment.created_at.strftime("%Y-%m-%d %H:%M") %></p>
              <p class="text-sm text-gray-500">来源: <%= source_text(@my_enrollment.source) %></p>
            </div>
            <div class="flex items-center space-x-4">
              <span class="px-3 py-1 text-sm rounded-full <%= status_class(@my_enrollment.status) %>">
                <%= status_text(@my_enrollment.status) %>
              </span>
              <span class="px-3 py-1 text-sm rounded-full <%= status_class(@my_enrollment.payment_status) %>">
                支付: <%= status_text(@my_enrollment.payment_status) %>
              </span>
              <% if @my_enrollment.pending? %>
                <%= button_to "取消报名", cancel_course_enrollment_path(@my_enrollment), method: :post, 
                              class: "text-red-600 hover:text-red-700 text-sm",
                              data: { confirm: "确认取消报名？" } %>
              <% end %>
            </div>
          </div>

          <% if @my_enrollment.payment.present? %>
            <div class="mt-3 p-3 bg-gray-50 rounded-lg">
              <p class="text-sm font-medium text-gray-700">支付信息</p>
              <p class="text-sm text-gray-600 mt-1">
                支付金额: ¥<%= "%.2f" % @my_enrollment.payment.amount %>
              </p>
              <% if @my_enrollment.payment.failed? && @my_enrollment.payment.failure_reason.present? %>
                <p class="text-sm text-red-600 mt-1">
                  失败原因: <%= @my_enrollment.payment.failure_reason %>
                </p>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="px-6 py-8 text-center text-gray-500">
          您尚未报名此课程
        </div>
      <% end %>
    </div>
  </div>

  <% if @my_enrollment.present? %>
    <%= render "shared/version_history", versions: @my_enrollment.versions.order(created_at: :desc) %>
  <% end %>

  <%= link_to "← 返回课程列表", courses_path, class: "text-gray-600 hover:text-gray-900" %>
</div>
