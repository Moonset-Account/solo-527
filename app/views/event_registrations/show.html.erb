<% content_for :page_title, "赛事报名详情" %>

<div class="space-y-6">
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="h-48 bg-gradient-to-r from-orange-500 to-red-500 flex items-center justify-center relative">
      <svg class="w-20 h-20 text-white/30" fill="currentColor" viewBox="0 0 24 24">
        <path d="M13 10V3L4 14h7v7l9-11h-7z"/>
      </svg>
      <div class="absolute top-4 right-4 flex space-x-2">
        <span class="px-3 py-1 bg-white/20 backdrop-blur-sm text-white text-sm rounded-full">
          <%= status_text(@registration.status) %>
        </span>
        <span class="px-3 py-1 bg-white/20 backdrop-blur-sm text-white text-sm rounded-full">
          支付: <%= status_text(@registration.payment_status) %>
        </span>
      </div>
    </div>

    <div class="p-8">
      <div class="flex items-start justify-between mb-6">
        <div>
          <h1 class="text-3xl font-bold text-gray-900"><%= @registration.event.name %></h1>
          <p class="text-gray-500 mt-2">报名编号 #<%= @registration.id %></p>
        </div>
        <div class="text-right">
          <p class="text-3xl font-bold text-orange-600">¥<%= "%.2f" % @registration.registration_fee %></p>
          <p class="text-sm text-gray-500">参赛费用</p>
        </div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">报名状态</p>
          <p class="mt-1"><span class="px-2 py-1 text-xs rounded-full <%= status_class(@registration.status) %>"><%= status_text(@registration.status) %></span></p>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">支付状态</p>
          <p class="mt-1"><span class="px-2 py-1 text-xs rounded-full <%= status_class(@registration.payment_status) %>"><%= status_text(@registration.payment_status) %></span></p>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">参赛组别</p>
          <p class="font-semibold text-gray-900 mt-1"><%= @registration.category || "-" %></p>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">报名时间</p>
          <p class="font-semibold text-gray-900 mt-1"><%= @registration.registered_at&.strftime("%Y-%m-%d %H:%M") || "-" %></p>
        </div>
      </div>

      <% if @registration.remark.present? %>
        <div class="mb-8 p-4 bg-gray-50 rounded-lg">
          <p class="text-sm text-gray-500">备注</p>
          <p class="text-gray-900 mt-1"><%= @registration.remark %></p>
        </div>
      <% end %>

      <div class="flex space-x-4">
        <% if @registration.pending? %>
          <%= button_to "取消报名", cancel_event_registration_path(@registration), method: :post,
                        class: "px-6 py-3 bg-red-600 text-white rounded-lg hover:bg-red-700 font-medium",
                        data: { confirm: "确认取消赛事报名？" } %>
        <% end %>
        <%= link_to "返回列表", event_registrations_path, class: "px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 font-medium" %>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-medium text-gray-900">赛事信息</h3>
      </div>
      <div class="px-6 py-4 space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-sm text-gray-500">赛事名称</span>
          <span class="font-medium text-gray-900"><%= @registration.event.name %></span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-sm text-gray-500">赛事类型</span>
          <span class="font-medium text-gray-900"><%= @registration.event.event_type || "-" %></span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-sm text-gray-500">比赛日期</span>
          <span class="font-medium text-gray-900"><%= @registration.event.start_date&.strftime("%Y-%m-%d") || "-" %></span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-sm text-gray-500">赛事状态</span>
          <span class="px-2 py-1 text-xs rounded-full <%= status_class(@registration.event.status) %>"><%= status_text(@registration.event.status) %></span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-sm text-gray-500">数据来源</span>
          <span class="font-medium text-gray-900"><%= source_text(@registration.source) %></span>
        </div>
      </div>
      <div class="px-6 py-4 border-t border-gray-200">
        <%= link_to "查看赛事", event_path(@registration.event), class: "block px-4 py-2 bg-gray-50 rounded-lg text-center text-gray-700 hover:bg-gray-100 text-sm" %>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-medium text-gray-900">支付信息</h3>
      </div>
      <div class="divide-y divide-gray-200">
        <% @payments.each do |payment| %>
          <div class="px-6 py-4">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-gray-900">¥<%= "%.2f" % payment.amount %></p>
                <p class="text-xs text-gray-500 mt-1">
                  <%= payment.payment_method&.humanize || "-" %> · <%= payment.created_at.strftime("%Y-%m-%d %H:%M") %>
                </p>
              </div>
              <div class="flex items-center space-x-3">
                <span class="px-2 py-1 text-xs rounded-full <%= status_class(payment.status) %>">
                  <%= status_text(payment.status) %>
                </span>
                <%= link_to "查看", payment_path(payment), class: "text-blue-600 hover:text-blue-900 text-sm" %>
              </div>
            </div>
          </div>
        <% end %>
        <% if @payments.empty? %>
          <div class="px-6 py-8 text-center text-gray-500">
            暂无支付记录
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="text-lg font-medium text-gray-900">比赛成绩</h3>
    </div>
    <div class="divide-y divide-gray-200">
      <% @results.each do |result| %>
        <div class="px-6 py-4">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-gray-900">
                <% if result.rank.present? %>
                  第 <%= result.rank %> 名
                <% else %>
                  待出成绩
                <% end %>
              </p>
              <p class="text-xs text-gray-500 mt-1">
                <% if result.score.present? %>得分: <%= result.score %><% end %>
                <% if result.time_result.present? %> · 用时: <%= result.time_result %><% end %>
              </p>
            </div>
            <div class="flex items-center space-x-3">
              <span class="px-2 py-1 text-xs rounded-full <%= status_class(result.status) %>">
                <%= status_text(result.status) %>
              </span>
            </div>
          </div>
          <% if result.remark.present? %>
            <p class="text-sm text-gray-500 mt-2"><%= result.remark %></p>
          <% end %>
        </div>
      <% end %>
      <% if @results.empty? %>
        <div class="px-6 py-8 text-center text-gray-500">
          暂无比赛成绩
        </div>
      <% end %>
    </div>
  </div>

  <%= render "shared/version_history", versions: @versions %>

  <%= link_to "← 返回赛事报名列表", event_registrations_path, class: "text-gray-600 hover:text-gray-900" %>
</div>
