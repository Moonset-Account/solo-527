<div class="p-4 hover:bg-gray-50 transition-colors">
  <div class="flex justify-between items-start">
    <div class="flex-1">
      <div class="flex items-center space-x-2 mb-1">
        <%= link_to work_order_path(work_order), class: 'font-semibold text-blue-600 hover:underline' do %>
          <%= work_order.order_no %>
        <% end %>
        <span class="px-2 py-0.5 text-xs rounded-full <%= work_order.priority == 'urgent' ? 'bg-red-100 text-red-800' : work_order.priority == 'high' ? 'bg-orange-100 text-orange-800' : work_order.priority == 'medium' ? 'bg-yellow-100 text-yellow-800' : 'bg-gray-100 text-gray-800' %>">
          <%= work_order.priority_name %>
        </span>
        <span class="px-2 py-0.5 text-xs rounded-full <%= work_order.status == 'completed' ? 'bg-green-100 text-green-800' : work_order.status == 'in_progress' ? 'bg-blue-100 text-blue-800' : work_order.status == 'on_hold' ? 'bg-yellow-100 text-yellow-800' : 'bg-gray-100 text-gray-800' %>">
          <%= work_order.status_name %>
        </span>
      </div>
      <div class="text-sm text-gray-700 mb-1"><%= work_order.product_name %></div>
      <div class="text-xs text-gray-500 flex items-center space-x-4">
        <span>数量: <%= work_order.quantity %></span>
        <span>客户: <%= work_order.customer %></span>
        <span>计划: <%= work_order.planned_start_date.strftime('%m/%d') %> - <%= work_order.planned_end_date.strftime('%m/%d') %></span>
      </div>
    </div>
    <div class="text-right">
      <div class="text-sm font-medium">
        <span class="text-gray-500">进度:</span>
        <span class="<%= work_order.progress_percentage == 100 ? 'text-green-600' : 'text-blue-600' %>">
          <%= work_order.progress_percentage %>%
        </span>
      </div>
      <div class="w-24 h-2 bg-gray-200 rounded-full mt-1">
        <div class="h-full rounded-full <%= work_order.progress_percentage == 100 ? 'bg-green-500' : 'bg-blue-500' %>" style="width: <%= work_order.progress_percentage %>%"></div>
      </div>
      <div class="text-xs text-gray-400 mt-1">
        <%= work_order.completed_steps_count %>/<%= work_order.total_steps_count %> 工序
      </div>
    </div>
  </div>

  <% if work_order.current_process_step %>
    <div class="mt-3 pl-4 border-l-2 border-blue-200">
      <div class="flex items-center justify-between">
        <div>
          <div class="text-sm font-medium">
            <span class="text-gray-500">当前工序:</span>
            <%= link_to work_order_process_step_path(work_order, work_order.current_process_step), class: 'text-blue-600 hover:underline' do %>
              第<%= work_order.current_process_step.sequence %>序 <%= work_order.current_process_step.name %>
            <% end %>
          </div>
          <div class="text-xs text-gray-500">
            <% if work_order.current_process_step.assigned_team %>
              班组: <%= work_order.current_process_step.assigned_team.name %>
            <% end %>
            <% if work_order.current_process_step.assigned_equipment %>
              | 设备: <%= work_order.current_process_step.assigned_equipment.code %>
            <% end %>
            <% if work_order.current_process_step.mold %>
              | 模具: <%= work_order.current_process_step.mold.code %>
            <% end %>
          </div>
        </div>
        <span class="px-2 py-0.5 text-xs rounded-full <%= work_order.current_process_step.status_color %>">
          <%= work_order.current_process_step.status_name %>
        </span>
      </div>
    </div>
  <% end %>
</div>
