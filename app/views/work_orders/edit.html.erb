<% content_for :title, "编辑工单 - #{@work_order.order_no}" %>

<div class="work-order-edit-page">
  <div class="page-header">
    <h1 class="page-title">编辑工单</h1>
    <div class="header-actions">
      <%= link_to "返回列表", work_orders_path, class: "btn btn-outline" %>
      <%= link_to "查看详情", work_order_path(@work_order), class: "btn btn-outline" %>
    </div>
  </div>

  <%= render "form", work_order: @work_order %>
</div>
