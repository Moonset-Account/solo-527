<% content_for :title, "新建预约" %>

<div class="card">
  <div class="card-header">新建预约</div>
  <%= form_with model: @appointment, local: true do |f| %>
    <div class="form-row">
      <div class="form-group">
        <label>客户姓名 *</label>
        <%= text_field_tag :customer_name, nil, class: "form-control", required: true, placeholder: "请输入客户姓名" %>
      </div>
      <div class="form-group">
        <label>联系电话 *</label>
        <%= text_field_tag :phone, nil, class: "form-control", required: true, placeholder: "请输入手机号" %>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>选择医生 *</label>
        <%= select_tag :doctor_id,
            options_from_collection_for_select(@doctors, :id, ->(d) { "#{d.name} - #{d.department}" }, params[:doctor_id]),
            class: "form-control",
            include_blank: "请选择医生",
            onchange: "window.location.href = '?doctor_id=' + this.value",
            required: true %>
      </div>
      <div class="form-group">
        <label>选择时段 *</label>
        <% if @time_slots.any? %>
          <%= select_tag :time_slot_id,
              options_from_collection_for_select(@time_slots, :id,
                ->(s) {
                  available = s.capacity - s.booked_count
                  "#{s.start_time.strftime('%m-%d %H:%M')} - #{s.end_time.strftime('%H:%M')} (剩余#{available}位)"
                }),
              class: "form-control", required: true %>
        <% else %>
          <p style="color:#909399; padding:8px 0;">请先选择医生查看可用时段</p>
        <% end %>
      </div>
    </div>

    <div class="form-group">
      <label>服务项目（可多选）*</label>
      <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:12px;">
        <% @service_items.each do |item| %>
          <label style="padding:12px; border:1px solid #ebeef5; border-radius:6px; cursor:pointer;">
            <%= check_box_tag "service_item_ids[]", item.id, false %>
            <strong><%= item.name %></strong>
            <div style="color:#909399; font-size:12px; margin-top:4px;">
              <%= item.duration_minutes %>分钟 | ¥<%= item.price %>
            </div>
          </label>
        <% end %>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>已付款金额</label>
        <%= text_field_tag :paid_amount, nil, class: "form-control", placeholder: "0.00" %>
      </div>
      <div class="form-group">
        <label>备注</label>
        <%= text_field_tag :notes, nil, class: "form-control", placeholder: "选填" %>
      </div>
    </div>

    <div class="actions" style="margin-top:16px;">
      <%= f.submit "创建预约", class: "btn btn-primary" %>
      <%= link_to "返回列表", appointments_path, class: "btn btn-default" %>
    </div>
  <% end %>
</div>
