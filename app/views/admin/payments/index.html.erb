<% content_for :page_title, "支付管理" %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">支付管理</h1>
    <div class="flex items-center space-x-3">
      <%= link_to "导出支付记录", export_admin_payments_path(format: :csv, q: params[:q]), 
                  method: :post, class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50" %>
      <%= link_to "批量重试失败支付", retry_failed_admin_payments_path, method: :post,
                  data: { confirm: "确认批量重试所有失败支付？" },
                  class: "px-4 py-2 bg-orange-600 text-white rounded-lg hover:bg-orange-700" %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
    <%= search_form_for @q, url: admin_payments_path, method: :get, class: "flex items-end space-x-4" do |f| %>
      <div>
        <%= f.label "状态", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :status_eq, Payment.statuses.keys.map { |s| [status_text(s), s] }, { include_blank: "全部状态" }, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div>
        <%= f.label "支付方式", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :payment_method_eq, Payment.payment_methods.keys.map { |m| [m.humanize, m] }, { include_blank: "全部方式" }, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div>
        <%= f.label "用户", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.search_field :user_name_cont, placeholder: "用户名搜索", class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div class="flex space-x-2">
        <%= f.submit "搜索", class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
        <%= link_to "重置", admin_payments_path, class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50" %>
      </div>
    <% end %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
      <p class="text-sm text-gray-500">总支付金额</p>
      <p class="text-2xl font-bold text-gray-900 mt-1">¥<%= "%.2f" % @total_amount %></p>
    </div>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
      <p class="text-sm text-gray-500">已支付</p>
      <p class="text-2xl font-bold text-green-600 mt-1"><%= @paid_count %> 笔</p>
    </div>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
      <p class="text-sm text-gray-500">待支付</p>
      <p class="text-2xl font-bold text-yellow-600 mt-1"><%= @pending_count %> 笔</p>
    </div>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
      <p class="text-sm text-gray-500">支付失败</p>
      <p class="text-2xl font-bold text-red-600 mt-1"><%= @failed_count %> 笔</p>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">用户</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">关联对象</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">金额</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">重试次数</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">来源</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @payments.each do |payment| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                #<%= payment.id %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900"><%= payment.user.name %></div>
                <div class="text-sm text-gray-500"><%= payment.user.phone %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-gray-900"><%= payment.payable_type %></div>
                <div class="text-sm text-gray-500">#<%= payment.payable_id %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="text-sm font-medium text-gray-900">¥<%= "%.2f" % payment.amount %></span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 py-1 text-xs rounded-full <%= status_class(payment.status) %>">
                  <%= status_text(payment.status) %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= payment.retry_count %> / 3
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= source_text(payment.source) %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm space-x-2">
                <% if payment.failed? && payment.retry_count < 3 %>
                  <%= button_to "重试", retry_admin_payment_path(payment), method: :post, 
                                class: "text-orange-600 hover:text-orange-900",
                                data: { confirm: "确认重试支付？" } %>
                <% end %>
                <% if payment.pending? || payment.failed? %>
                  <%= button_to "标记已支付", mark_paid_admin_payment_path(payment), method: :post,
                                class: "text-green-600 hover:text-green-900",
                                data: { confirm: "确认标记为已支付？这将更新课程满班率。" } %>
                <% end %>
                <%= link_to "详情", admin_payment_path(payment), class: "text-blue-600 hover:text-blue-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="px-6 py-4 border-t border-gray-200">
      <%= paginate @payments %>
    </div>
  </div>
</div>
