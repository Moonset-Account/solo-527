<% content_for :page_title, "签到管理" %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">签到管理</h1>
    <div class="flex items-center space-x-3">
      <%= link_to "导出记录", export_admin_check_ins_path(format: :csv, q: params[:q]),
                  method: :post, class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50" %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
    <%= search_form_for @q, url: admin_check_ins_path, method: :get, class: "flex items-end space-x-4" do |f| %>
      <div>
        <%= f.label "用户", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.search_field :user_name_cont, placeholder: "用户名搜索", class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div>
        <%= f.label "状态", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :status_eq, CheckIn.statuses.keys.map { |s| [status_text(s), s] }, { include_blank: "全部状态" }, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div>
        <%= f.label "来源类型", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :checkinable_type_eq, [["课程报名", "CourseEnrollment"], ["赛事报名", "EventRegistration"]], { include_blank: "全部类型" }, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div>
        <%= f.label "签到方式", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :check_in_method_eq, CheckIn.check_in_methods.keys.map { |m| [m.humanize, m] }, { include_blank: "全部方式" }, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div class="flex space-x-2">
        <%= f.submit "搜索", class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
        <%= link_to "重置", admin_check_ins_path, class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50" %>
      </div>
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="text-lg font-medium text-gray-900">批量签到</h3>
    </div>
    <div class="px-6 py-4">
      <%= form_with url: bulk_check_in_admin_check_ins_path, method: :post, local: true, class: "flex items-end space-x-4" do |f| %>
        <div>
          <%= f.label :checkinable_type, "来源类型", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :checkinable_type, [["课程报名", "CourseEnrollment"], ["赛事报名", "EventRegistration"]], {}, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>
        <div>
          <%= f.label :checkinable_id, "来源ID", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :checkinable_id, placeholder: "输入ID", class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>
        <div>
          <%= f.label :user_ids, "用户ID列表", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :user_ids, placeholder: "用逗号分隔，如: 1,2,3", class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>
        <%= f.submit "批量签到", class: "px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700",
                     data: { confirm: "确认批量签到？" } %>
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">用户</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">来源</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">签到方式</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">签到时间</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @check_ins.each do |ci| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900"><%= ci.user.name %></div>
                <div class="text-sm text-gray-500"><%= ci.user.phone %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-gray-900"><%= ci.source_description %></div>
                <div class="text-sm text-gray-500">#<%= ci.checkinable_id %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= ci.check_in_method&.humanize || "-" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 py-1 text-xs rounded-full <%= status_class(ci.status) %>">
                  <%= status_text(ci.status) %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= ci.checked_in_at&.strftime("%Y-%m-%d %H:%M:%S") || "-" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm space-x-2">
                <%= link_to "查看", admin_check_in_path(ci), class: "text-blue-600 hover:text-blue-900" %>
                <% if ci.status == "pending" %>
                  <%= button_to "签到", check_in_admin_check_in_path(ci), method: :post, class: "text-green-600 hover:text-green-900" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @check_ins.empty? %>
      <div class="px-6 py-12 text-center text-gray-500">
        暂无签到记录
      </div>
    <% end %>

    <div class="px-6 py-4 border-t border-gray-200">
      <%= paginate @check_ins %>
    </div>
  </div>
</div>
