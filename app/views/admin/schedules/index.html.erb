<% content_for :page_title, "赛程管理" %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">赛程管理</h1>
    <%= link_to "赛事管理", admin_events_path, class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50" %>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
    <%= search_form_for @q, url: admin_schedules_path, method: :get, class: "flex items-end space-x-4" do |f| %>
      <div>
        <%= f.label "赛事", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :event_id_eq, Event.pluck(:id, :name), { include_blank: "全部赛事" }, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div>
        <%= f.label "状态", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :status_eq, Schedule.statuses.keys.map { |s| [status_text(s), s] }, { include_blank: "全部状态" }, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div>
        <%= f.label "标题", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.search_field :title_cont, placeholder: "赛程标题", class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div class="flex space-x-2">
        <%= f.submit "搜索", class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
        <%= link_to "重置", admin_schedules_path, class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50" %>
      </div>
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">赛事名称</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">赛程标题</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">轮次</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">开始时间</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">结束时间</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @schedules.each do |schedule| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900"><%= schedule.event.name %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900"><%= schedule.title %></div>
                <% if schedule.category.present? %>
                  <div class="text-sm text-gray-500"><%= schedule.category %></div>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= schedule.round || "-" %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= schedule.start_time&.strftime("%Y-%m-%d %H:%M") %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= schedule.end_time&.strftime("%Y-%m-%d %H:%M") %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 py-1 text-xs rounded-full <%= status_class(schedule.status) %>">
                  <%= status_text(schedule.status) %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm space-x-2">
                <%= link_to "查看", admin_schedule_path(schedule), class: "text-blue-600 hover:text-blue-900" %>
                <%= link_to "编辑", edit_admin_schedule_path(schedule), class: "text-gray-600 hover:text-gray-900" %>
                <% if schedule.scheduled? %>
                  <%= button_to "开始", start_admin_schedule_path(schedule), method: :post, class: "text-green-600 hover:text-green-900" %>
                <% end %>
                <% if schedule.in_progress? %>
                  <%= button_to "完成", complete_admin_schedule_path(schedule), method: :post, class: "text-blue-600 hover:text-blue-900" %>
                <% end %>
                <% if schedule.scheduled? || schedule.in_progress? %>
                  <%= button_to "取消", cancel_admin_schedule_path(schedule), method: :post, class: "text-red-600 hover:text-red-900", data: { confirm: "确认取消该赛程？" } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @schedules.empty? %>
      <div class="px-6 py-12 text-center text-gray-500">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        <p class="mt-2">暂无赛程数据</p>
      </div>
    <% end %>

    <div class="px-6 py-4 border-t border-gray-200">
      <%= paginate @schedules %>
    </div>
  </div>
</div>
