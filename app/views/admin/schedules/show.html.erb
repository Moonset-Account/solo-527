<% content_for :page_title, @schedule.title %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900"><%= @schedule.title %></h1>
      <p class="text-gray-500 mt-1">赛程管理 / <%= @schedule.event.name %></p>
    </div>
    <div class="flex items-center space-x-3">
      <%= link_to "返回列表", admin_schedules_path, class: "text-gray-600 hover:text-gray-900" %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
          <h3 class="text-lg font-medium text-gray-900">赛程信息</h3>
          <span class="px-3 py-1 text-sm rounded-full <%= status_class(@schedule.status) %> font-medium">
            <%= status_text(@schedule.status) %>
          </span>
        </div>
        <div class="px-6 py-4">
          <dl class="grid grid-cols-2 gap-x-6 gap-y-4">
            <div>
              <dt class="text-sm text-gray-500">赛程标题</dt>
              <dd class="mt-1 font-medium text-gray-900"><%= @schedule.title %></dd>
            </div>
            <div>
              <dt class="text-sm text-gray-500">所属赛事</dt>
              <dd class="mt-1 font-medium text-gray-900"><%= link_to @schedule.event.name, admin_event_path(@schedule.event), class: "text-blue-600 hover:text-blue-900" %></dd>
            </div>
            <div>
              <dt class="text-sm text-gray-500">分类</dt>
              <dd class="mt-1 font-medium text-gray-900"><%= @schedule.category || "未设置" %></dd>
            </div>
            <div>
              <dt class="text-sm text-gray-500">轮次</dt>
              <dd class="mt-1 font-medium text-gray-900"><%= @schedule.round || "未设置" %></dd>
            </div>
            <div>
              <dt class="text-sm text-gray-500">开始时间</dt>
              <dd class="mt-1 font-medium text-gray-900"><%= @schedule.start_time&.strftime("%Y-%m-%d %H:%M") || "-" %></dd>
            </div>
            <div>
              <dt class="text-sm text-gray-500">结束时间</dt>
              <dd class="mt-1 font-medium text-gray-900"><%= @schedule.end_time&.strftime("%Y-%m-%d %H:%M") || "-" %></dd>
            </div>
            <div>
              <dt class="text-sm text-gray-500">最大参赛人数</dt>
              <dd class="mt-1 font-medium text-gray-900"><%= @schedule.max_participants || "不限" %></dd>
            </div>
            <div>
              <dt class="text-sm text-gray-500">比赛场地</dt>
              <dd class="mt-1 font-medium text-gray-900"><%= @schedule.venue&.name || "未指定" %></dd>
            </div>
          </dl>

          <% if @schedule.description.present? %>
            <div class="mt-4 pt-4 border-t border-gray-100">
              <dt class="text-sm text-gray-500">赛程描述</dt>
              <dd class="mt-1 text-gray-900"><%= @schedule.description %></dd>
            </div>
          <% end %>
        </div>
        <div class="px-6 py-4 border-t border-gray-200 bg-gray-50 flex space-x-3">
          <%= link_to "编辑赛程", edit_admin_schedule_path(@schedule), class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 text-sm" %>
          <% if @schedule.scheduled? %>
            <%= button_to "开始比赛", start_admin_schedule_path(@schedule), method: :post, class: "px-4 py-2 border border-green-300 text-green-700 rounded-lg hover:bg-green-50 text-sm" %>
          <% end %>
          <% if @schedule.in_progress? %>
            <%= button_to "完成比赛", complete_admin_schedule_path(@schedule), method: :post, class: "px-4 py-2 border border-blue-300 text-blue-700 rounded-lg hover:bg-blue-50 text-sm" %>
          <% end %>
          <% if @schedule.scheduled? || @schedule.in_progress? %>
            <%= button_to "取消赛程", cancel_admin_schedule_path(@schedule), method: :post, class: "px-4 py-2 border border-red-300 text-red-700 rounded-lg hover:bg-red-50 text-sm", data: { confirm: "确认取消该赛程？" } %>
          <% end %>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
          <h3 class="text-lg font-medium text-gray-900">比赛成绩</h3>
          <%= link_to "录入成绩", new_admin_result_path(schedule_id: @schedule.id), class: "text-blue-600 hover:text-blue-900 text-sm" %>
        </div>
        <% if @results.any? %>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">名次</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">选手</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">用时</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">得分</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @results.each do |result| %>
                  <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                      <%= result.rank ? "第#{result.rank}名" : "-" %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                      <%= result.event_registration.user.name %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= result.time_result || "-" %></td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= result.score || "-" %></td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <span class="px-2 py-1 text-xs rounded-full <%= status_class(result.status) %>">
                        <%= status_text(result.status) %>
                      </span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm space-x-2">
                      <%= link_to "查看", admin_result_path(result), class: "text-blue-600 hover:text-blue-900" %>
                      <%= link_to "编辑", edit_admin_result_path(result), class: "text-gray-600 hover:text-gray-900" %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="px-6 py-8 text-center text-gray-500">
            暂无成绩记录
          </div>
        <% end %>
      </div>

      <%= render "shared/version_history", versions: @versions %>
    </div>

    <div class="space-y-6">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-medium text-gray-900">快捷操作</h3>
        </div>
        <div class="px-6 py-4 space-y-3">
          <%= link_to "查看赛事", admin_event_path(@schedule.event), class: "block px-4 py-2 bg-gray-50 rounded-lg text-center text-gray-700 hover:bg-gray-100 text-sm" %>
          <%= link_to "录入成绩", new_admin_result_path(schedule_id: @schedule.id), class: "block px-4 py-2 bg-gray-50 rounded-lg text-center text-gray-700 hover:bg-gray-100 text-sm" %>
          <%= link_to "所有成绩", admin_results_path(q: { schedule_id_eq: @schedule.id }), class: "block px-4 py-2 bg-gray-50 rounded-lg text-center text-gray-700 hover:bg-gray-100 text-sm" %>
        </div>
      </div>
    </div>
  </div>
</div>
