<% content_for :page_title, "请假管理" %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">请假管理</h1>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
    <%= search_form_for @q, url: admin_leave_requests_path, method: :get, class: "flex items-end space-x-4" do |f| %>
      <div>
        <%= f.label "用户", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.search_field :user_name_cont, placeholder: "用户名搜索", class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div>
        <%= f.label "状态", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :status_eq, LeaveRequest.statuses.keys.map { |s| [status_text(s), s] }, { include_blank: "全部状态" }, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div>
        <%= f.label "请假日期", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.search_field :leave_date_gteq, type: :date, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div class="flex space-x-2">
        <%= f.submit "搜索", class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
        <%= link_to "重置", admin_leave_requests_path, class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50" %>
      </div>
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">用户</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">课程</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">请假日期</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">请假原因</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @leave_requests.each do |lr| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900"><%= lr.user.name %></div>
                <div class="text-sm text-gray-500"><%= lr.user.phone %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= lr.course_enrollment.course.name %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                <%= lr.leave_date.strftime("%Y-%m-%d") %>
              </td>
              <td class="px-6 py-4 text-sm text-gray-500 max-w-xs truncate">
                <%= lr.reason %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 py-1 text-xs rounded-full <%= status_class(lr.status) %>">
                  <%= status_text(lr.status) %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm space-x-2">
                <%= link_to "查看", admin_leave_request_path(lr), class: "text-blue-600 hover:text-blue-900" %>
                <% if lr.pending? %>
                  <%= button_to "批准", approve_admin_leave_request_path(lr), method: :post, class: "text-green-600 hover:text-green-900" %>
                  <%= button_to "驳回", reject_admin_leave_request_path(lr), method: :post, class: "text-red-600 hover:text-red-900" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @leave_requests.empty? %>
      <div class="px-6 py-12 text-center text-gray-500">
        暂无请假记录
      </div>
    <% end %>

    <div class="px-6 py-4 border-t border-gray-200">
      <%= paginate @leave_requests %>
    </div>
  </div>
</div>
