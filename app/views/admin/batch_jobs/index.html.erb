<% content_for :page_title, "批量任务" %>

<div class="bg-white rounded-lg shadow-sm border border-gray-200">
  <div class="px-6 py-4 border-b border-gray-200">
    <h2 class="text-lg font-medium text-gray-900">批量任务列表</h2>
    <p class="text-sm text-gray-500 mt-1">查看所有批量任务的执行状态、进度和结果</p>
  </div>

  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">任务类型</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">进度</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">成功/失败</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">创建人</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">创建时间</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @batch_jobs.each do |job| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm font-medium text-gray-900"><%= job.job_type_text %></div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="px-2 py-1 text-xs rounded-full <%= status_class(job.status) %>">
                <%= job.status_text %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="w-32">
                <div class="flex items-center justify-between text-xs text-gray-500 mb-1">
                  <span><%= job.progress_percentage %>%</span>
                  <span><%= job.success_count + job.failure_count %>/<%= job.total_count %></span>
                </div>
                <div class="h-2 bg-gray-200 rounded-full overflow-hidden">
                  <div class="h-full <%= progress_color_class(job.status) %> transition-all" style="width: <%= job.progress_percentage %>%"></div>
                </div>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm">
                <span class="text-green-600"><%= job.success_count %> 成功</span>
                <% if job.failure_count > 0 %>
                  <span class="text-red-600 ml-2"><%= job.failure_count %> 失败</span>
                <% end %>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <%= job.user&.name || "系统" %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <%= job.created_at.strftime("%Y-%m-%d %H:%M") %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">
              <%= link_to "查看详情", admin_batch_job_path(job), class: "text-blue-600 hover:text-blue-900" %>
              <% if job.running? %>
                <%= button_to "取消", cancel_admin_batch_job_path(job), method: :post, class: "text-red-600 hover:text-red-900 ml-2" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @batch_jobs.empty? %>
    <div class="px-6 py-12 text-center text-gray-500">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
      </svg>
      <p class="mt-2">暂无批量任务</p>
    </div>
  <% end %>

  <div class="px-6 py-4 border-t border-gray-200">
    <%= paginate @batch_jobs %>
  </div>
</div>
