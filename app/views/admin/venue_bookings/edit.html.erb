<% content_for :page_title, "编辑预约" %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">编辑场地预约 #<%= @booking.id %></h1>
      <p class="text-gray-500 mt-1">场地预约</p>
    </div>
    <%= link_to "返回详情", admin_venue_booking_path(@booking), class: "text-gray-600 hover:text-gray-900" %>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <%= form_with model: [:admin, @booking], local: true, class: "px-6 py-6" do |f| %>
      <% if @booking.errors.any? %>
        <div class="mb-6 bg-red-50 border border-red-200 rounded-lg p-4">
          <h3 class="text-sm font-medium text-red-800"><%= pluralize(@booking.errors.count, "个错误") %></h3>
          <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
            <% @booking.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%= f.label :venue_id, "场地", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :venue_id, Venue.order(:name).map { |v| [v.name, v.id] }, { prompt: "请选择场地" }, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div>
          <%= f.label :user_id, "用户", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :user_id, User.order(:name).map { |u| [u.name, u.id] }, { prompt: "请选择用户" }, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div>
          <%= f.label :start_time, "开始时间", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.datetime_local_field :start_time, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div>
          <%= f.label :end_time, "结束时间", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.datetime_local_field :end_time, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div>
          <%= f.label :purpose, "用途", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :purpose, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div>
          <%= f.label :status, "状态", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :status, [["待处理", "pending"], ["已确认", "confirmed"], ["已取消", "cancelled"], ["已完成", "completed"]], {}, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div class="md:col-span-2">
          <%= f.label :remark, "备注", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_area :remark, rows: 3, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>
      </div>

      <div class="mt-6 flex items-center space-x-3">
        <%= f.submit "保存修改", class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
        <%= link_to "取消", admin_venue_booking_path(@booking), class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50" %>
      </div>
    <% end %>
  </div>
</div>
