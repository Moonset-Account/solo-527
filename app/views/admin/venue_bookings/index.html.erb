<% content_for :page_title, "场地预约" %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">场地预约</h1>
    <div class="flex items-center space-x-3">
      <%= link_to "新建预约", new_admin_venue_booking_path, class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
    <%= search_form_for @q, url: admin_venue_bookings_path, method: :get, class: "flex items-end space-x-4" do |f| %>
      <div>
        <%= f.label "场地", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.search_field :venue_name_cont, placeholder: "场地名称", class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div>
        <%= f.label "用户", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.search_field :user_name_cont, placeholder: "用户名搜索", class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div>
        <%= f.label "状态", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :status_eq, VenueBooking.validators_on(:status).find { |v| v.is_a?(ActiveModel::Validations::InclusionValidator) }&.options&.dig(:in)&.map { |s| [status_text(s), s] } || [["待处理", "pending"], ["已确认", "confirmed"], ["已取消", "cancelled"], ["已完成", "completed"]], { include_blank: "全部状态" }, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div>
        <%= f.label "来源", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :source_eq, [["网站前台", "web"], ["管理后台", "admin"], ["API接口", "api"], ["批量导入", "import"]], { include_blank: "全部来源" }, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div class="flex space-x-2">
        <%= f.submit "搜索", class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
        <%= link_to "重置", admin_venue_bookings_path, class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50" %>
      </div>
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">场地</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">用户</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">开始时间</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">结束时间</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">用途</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">来源</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @bookings.each do |booking| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900"><%= booking.venue.name %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900"><%= booking.user.name %></div>
                <div class="text-sm text-gray-500"><%= booking.user.phone %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= booking.start_time.strftime("%Y-%m-%d %H:%M") %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= booking.end_time.strftime("%Y-%m-%d %H:%M") %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                <%= booking.purpose || "-" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 py-1 text-xs rounded-full <%= status_class(booking.status) %>">
                  <%= status_text(booking.status) %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= source_text(booking.source) %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm space-x-2">
                <%= link_to "查看", admin_venue_booking_path(booking), class: "text-blue-600 hover:text-blue-900" %>
                <%= link_to "编辑", edit_admin_venue_booking_path(booking), class: "text-gray-600 hover:text-gray-900" %>
                <% if booking.status != "cancelled" %>
                  <%= button_to "取消", cancel_admin_venue_booking_path(booking), method: :post, class: "text-red-600 hover:text-red-900" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @bookings.empty? %>
      <div class="px-6 py-12 text-center text-gray-500">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        <p class="mt-2">暂无预约记录</p>
      </div>
    <% end %>

    <div class="px-6 py-4 border-t border-gray-200">
      <%= paginate @bookings %>
    </div>
  </div>
</div>
