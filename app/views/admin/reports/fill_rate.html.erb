<% content_for :page_title, "课程满班率报表" %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">课程满班率报表</h1>
    <div class="flex items-center space-x-3">
      <%= button_to "生成报表", generate_fill_rate_admin_reports_path, method: :post,
                    class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700",
                    data: { confirm: "确认生成最新满班率报表？" } %>
      <%= link_to "导出CSV", export_fill_rate_admin_reports_path(format: :csv), method: :post,
                  class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50" %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
      <p class="text-sm text-gray-500">课程总数</p>
      <p class="text-2xl font-bold text-gray-900 mt-1"><%= @total_courses %></p>
    </div>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
      <p class="text-sm text-gray-500">平均满班率</p>
      <p class="text-2xl font-bold text-blue-600 mt-1"><%= @avg_fill_rate %>%</p>
    </div>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
      <p class="text-sm text-gray-500">满员课程数</p>
      <p class="text-2xl font-bold text-green-600 mt-1"><%= @full_courses %></p>
    </div>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
      <p class="text-sm text-gray-500">低满班率课程</p>
      <p class="text-2xl font-bold text-red-600 mt-1"><%= @low_fill_courses %></p>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="text-lg font-medium text-gray-900">课程满班率明细</h3>
      <p class="text-sm text-gray-500 mt-1">支付状态变化会实时更新满班率数据</p>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">课程名称</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">级别</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">教练</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">报名人数</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">容量</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">满班率</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @courses.each do |course| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900"><%= course.name %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= course.level || "-" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= course.coach || "-" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                <%= course.enrolled_count %> 人
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= course.capacity %> 人
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center">
                  <div class="w-24 h-2 bg-gray-200 rounded-full overflow-hidden mr-2">
                    <div class="h-full <%= course.fill_rate >= 100 ? 'bg-red-500' : course.fill_rate >= 80 ? 'bg-green-500' : course.fill_rate >= 50 ? 'bg-yellow-500' : 'bg-red-400' %>"
                         style="width: <%= [course.fill_rate, 100].min %>%"></div>
                  </div>
                  <span class="text-sm font-medium <%= course.fill_rate >= 100 ? 'text-red-600' : course.fill_rate >= 80 ? 'text-green-600' : 'text-yellow-600' %>">
                    <%= course.fill_rate %>%
                  </span>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 py-1 text-xs rounded-full <%= status_class(course.status) %>">
                  <%= status_text(course.status) %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <%= link_to "查看", admin_course_path(course), class: "text-blue-600 hover:text-blue-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="px-6 py-4 border-t border-gray-200">
      <%= paginate @courses %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
    <h4 class="text-sm font-medium text-gray-700 mb-2">图例说明</h4>
    <div class="flex items-center space-x-6 text-sm">
      <div class="flex items-center">
        <div class="w-4 h-4 bg-green-500 rounded mr-2"></div>
        <span class="text-gray-600">≥ 80% 满班率良好</span>
      </div>
      <div class="flex items-center">
        <div class="w-4 h-4 bg-yellow-500 rounded mr-2"></div>
        <span class="text-gray-600">50-80% 中等</span>
      </div>
      <div class="flex items-center">
        <div class="w-4 h-4 bg-red-400 rounded mr-2"></div>
        <span class="text-gray-600">< 50% 偏低</span>
      </div>
      <div class="flex items-center">
        <div class="w-4 h-4 bg-red-500 rounded mr-2"></div>
        <span class="text-gray-600">≥ 100% 已满员</span>
      </div>
    </div>
    <p class="text-xs text-gray-500 mt-3">
      注：支付状态变更（支付成功/失败）会自动触发满班率报表更新。负责人处理支付失败后，最新状态会实时反映到此报表。
    </p>
  </div>
</div>
