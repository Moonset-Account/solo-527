<% content_for :title, "人员负荷报表" %>

<div class="card">
  <div class="card-header">
    查询范围
    <%= link_to "导出CSV",
        admin_reports_daily_load_path(format: :csv, start_date: params[:start_date], end_date: params[:end_date]),
        class: "btn btn-primary", style: "float:right;" %>
  </div>
  <%= form_tag admin_reports_daily_load_path, method: :get do %>
    <div class="form-row">
      <div class="form-group">
        <label>开始日期</label>
        <%= date_field_tag :start_date, params[:start_date] || @start_date, class: "form-control" %>
      </div>
      <div class="form-group">
        <label>结束日期</label>
        <%= date_field_tag :end_date, params[:end_date] || @end_date, class: "form-control" %>
      </div>
    </div>
    <%= submit_tag "查询", class: "btn btn-primary" %>
  <% end %>
</div>

<div class="card">
  <div class="card-header">人员负荷明细</div>
  <table>
    <thead>
      <tr>
        <th>医生</th>
        <th>日期</th>
        <th>预约数</th>
        <th>最大接待量</th>
        <th>负荷率</th>
        <th>候补入队</th>
      </tr>
    </thead>
    <tbody>
      <% @load_data.each do |row| %>
        <% row[:daily_stats].each do |stat| %>
          <tr>
            <td><%= row[:doctor].name %> (<%= row[:doctor].department %>)</td>
            <td><%= stat[:date] %></td>
            <td><%= stat[:appointment_count] %></td>
            <td><%= row[:doctor].daily_max_patients %></td>
            <td>
              <% if stat[:load_ratio] >= 90 %>
                <span class="tag tag-red"><%= stat[:load_ratio] %>%</span>
              <% elsif stat[:load_ratio] >= 70 %>
                <span class="tag tag-orange"><%= stat[:load_ratio] %>%</span>
              <% else %>
                <span class="tag tag-green"><%= stat[:load_ratio] %>%</span>
              <% end %>
            </td>
            <td><%= stat[:waiting_count] %></td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>
