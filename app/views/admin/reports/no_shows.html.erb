<% content_for :title, "客户爽约记录" %>

<div class="card">
  <div class="card-header">
    查询范围
    <%= link_to "导出CSV",
        no_shows_admin_reports_path(format: :csv, start_date: params[:start_date], end_date: params[:end_date]),
        class: "btn btn-primary", style: "float:right;" %>
  </div>
  <%= form_tag no_shows_admin_reports_path, method: :get do %>
    <div class="form-row">
      <div class="form-group">
        <label>开始日期</label>
        <%= date_field_tag :start_date, params[:start_date] || @start_date, class: "form-control" %>
      </div>
      <div class="form-group">
        <label>结束日期</label>
        <%= date_field_tag :end_date, params[:end_date] || @end_date, class: "form-control" %>
      </div>
    </div>
    <%= submit_tag "查询", class: "btn btn-primary" %>
  <% end %>
</div>

<div class="card">
  <div class="card-header">
    爽约统计
  </div>
  <div class="stats-grid" style="margin-bottom:0;">
    <div class="stat-card" style="border-left-color:#f56c6c;">
      <h3>爽约总次数</h3>
      <div class="value"><%= @no_show_stats[:total] %></div>
    </div>
    <div class="stat-card" style="border-left-color:#e6a23c;">
      <h3>涉及客户数</h3>
      <div class="value"><%= @no_show_stats[:total_customers] %></div>
    </div>
    <div class="stat-card" style="border-left-color:#f56c6c;">
      <h3>多次爽约客户</h3>
      <div class="value"><%= @no_show_stats[:repeat_offenders] %></div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">爽约明细</div>
  <table>
    <thead>
      <tr>
        <th>预约单号</th>
        <th>预约日期</th>
        <th>客户</th>
        <th>手机号</th>
        <th>医生</th>
        <th>历史爽约</th>
        <th>候补来源</th>
        <th>最后处理</th>
      </tr>
    </thead>
    <tbody>
      <% @no_show_appointments.each do |apt| %>
        <tr>
          <td><%= link_to apt.appointment_no, appointment_path(apt) %></td>
          <td><%= apt.appointment_date&.strftime("%Y-%m-%d %H:%M") %></td>
          <td>
            <%= link_to apt.customer.name, customer_path(apt.customer) %>
            <% if apt.customer.no_show_count > 1 %><span class="tag tag-red">多次爽约</span><% end %>
          </td>
          <td><%= apt.customer.phone %></td>
          <td><%= apt.doctor.name %></td>
          <td><%= apt.customer.no_show_count %>次</td>
          <td><%= apt.from_waiting_list? ? "是" : "否" %></td>
          <td><%= apt.updated_at&.strftime("%Y-%m-%d %H:%M") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div class="pagination">
    <%= paginate @no_show_appointments %>
  </div>
</div>
