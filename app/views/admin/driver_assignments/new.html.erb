<div class="min-h-screen bg-gray-50">
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-6">
      <h1 class="text-2xl font-bold text-gray-900">新建司机改派</h1>
    </div>

    <div class="rounded-lg bg-white p-6 shadow-sm">
      <%= form_with model: [:admin, @driver_assignment], local: true do |form| %>
        <% if @driver_assignment.errors.any? %>
          <div class="mb-6 rounded-md bg-red-50 p-4">
            <div class="flex">
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800">表单存在 <%= @driver_assignment.errors.count %> 个错误：</h3>
                <div class="mt-2 text-sm text-red-700">
                  <ul class="list-disc space-y-1 pl-5">
                    <% @driver_assignment.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <div class="space-y-6">
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
            <div>
              <%= form.label :vehicle_id, '选择车辆', class: 'block text-sm font-medium text-gray-700' %>
              <%= form.select :vehicle_id, Vehicle.active.map { |v| [v.plate_number, v.id] }, { include_blank: '请选择车辆' }, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
            </div>

            <div>
              <%= label_tag :old_driver, '原司机', class: 'block text-sm font-medium text-gray-700' %>
              <div class="mt-1 rounded-md border border-gray-300 bg-gray-50 px-3 py-2 text-sm text-gray-500">
                选择车辆后自动填充
              </div>
            </div>

            <div>
              <%= form.label :new_driver_id, '新司机', class: 'block text-sm font-medium text-gray-700' %>
              <%= form.select :new_driver_id, User.driver.active.map { |u| [u.name || u.email, u.id] }, { include_blank: '请选择新司机' }, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
            </div>

            <div>
              <%= form.label :reason, '改派原因', class: 'block text-sm font-medium text-gray-700' %>
              <%= form.select :reason, ['司机请假', '车辆维修', '工作调整', '其他'], { include_blank: '请选择改派原因' }, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
            </div>
          </div>

          <div>
            <%= form.label :remark, '备注', class: 'block text-sm font-medium text-gray-700' %>
            <%= form.text_area :remark, rows: 4, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', placeholder: '请输入备注信息...' %>
          </div>

          <div class="flex justify-end space-x-3 pt-4 border-t border-gray-200">
            <%= link_to '取消', admin_driver_assignments_path, class: 'inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2' %>
            <%= form.submit '提交改派', class: 'inline-flex items-center rounded-md border border-transparent bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2' %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
