<div class="min-h-screen bg-gray-50">
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-6 flex items-center justify-between">
      <h1 class="text-2xl font-bold text-gray-900">司机改派管理</h1>
      <%= link_to '新建改派', new_admin_driver_assignment_path, class: 'inline-flex items-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2' %>
    </div>

    <div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <div class="rounded-lg bg-white p-6 shadow-sm">
        <div class="flex items-center">
          <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-blue-100">
            <svg class="h-6 w-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-500">改派总次数</p>
            <p class="text-2xl font-bold text-gray-900"><%= @driver_assignments.total_count %></p>
          </div>
        </div>
      </div>

      <div class="rounded-lg bg-white p-6 shadow-sm">
        <div class="flex items-center">
          <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-green-100">
            <svg class="h-6 w-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-500">平均处理耗时</p>
            <p class="text-2xl font-bold text-gray-900">
              <% avg = @driver_assignments.rewhere(nil).average('EXTRACT(EPOCH FROM (reassigned_at - created_at))') %>
              <% if avg %>
                <%= (avg / 60).round(1) %> 分钟
              <% else %>
                -
              <% end %>
            </p>
          </div>
        </div>
      </div>

      <div class="rounded-lg bg-white p-6 shadow-sm">
        <div class="flex items-center">
          <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-yellow-100">
            <svg class="h-6 w-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-500">涉及车辆数</p>
            <p class="text-2xl font-bold text-gray-900"><%= @driver_assignments.rewhere(nil).distinct.count(:vehicle_id) %></p>
          </div>
        </div>
      </div>
    </div>

    <div class="mb-6 rounded-lg bg-white p-4 shadow-sm">
      <%= search_form_for [:admin, @q] do |f| %>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
          <div>
            <%= f.label :vehicle_plate_number_cont, '车牌号', class: 'block text-sm font-medium text-gray-700' %>
            <%= f.text_field :vehicle_plate_number_cont, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
          </div>
          <div>
            <%= f.label :old_driver_email_cont, '原司机', class: 'block text-sm font-medium text-gray-700' %>
            <%= f.text_field :old_driver_email_cont, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
          </div>
          <div>
            <%= f.label :new_driver_email_cont, '新司机', class: 'block text-sm font-medium text-gray-700' %>
            <%= f.text_field :new_driver_email_cont, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
          </div>
          <div class="flex items-end">
            <%= f.submit '筛选', class: 'w-full rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2' %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="overflow-hidden rounded-lg bg-white shadow-sm">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">车辆</th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">原司机</th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">新司机</th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">改派原因</th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">改派时间</th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">处理耗时</th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">操作人</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
            <% @driver_assignments.each do |assignment| %>
              <tr class="hover:bg-gray-50">
                <td class="whitespace-nowrap px-6 py-4">
                  <div class="flex items-center">
                    <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-gray-100">
                      <svg class="h-5 w-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
                      </svg>
                    </div>
                    <div class="ml-3">
                      <p class="text-sm font-medium text-gray-900"><%= assignment.vehicle&.plate_number %></p>
                      <p class="text-xs text-gray-500"><%= assignment.vehicle&.vehicle_type&.text %></p>
                    </div>
                  </div>
                </td>
                <td class="whitespace-nowrap px-6 py-4">
                  <div class="flex items-center">
                    <div class="h-8 w-8 rounded-full bg-red-100 flex items-center justify-center">
                      <span class="text-xs font-medium text-red-600"><%= assignment.old_driver&.email&.first&.upcase %></span>
                    </div>
                    <span class="ml-2 text-sm text-gray-700"><%= assignment.old_driver&.email %></span>
                  </div>
                </td>
                <td class="whitespace-nowrap px-6 py-4">
                  <div class="flex items-center">
                    <div class="h-8 w-8 rounded-full bg-green-100 flex items-center justify-center">
                      <span class="text-xs font-medium text-green-600"><%= assignment.new_driver&.email&.first&.upcase %></span>
                    </div>
                    <span class="ml-2 text-sm text-gray-700"><%= assignment.new_driver&.email %></span>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <p class="max-w-xs truncate text-sm text-gray-700" title="<%= assignment.reason %>"><%= assignment.reason %></p>
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                  <%= assignment.reassigned_at&.strftime('%Y-%m-%d %H:%M') %>
                </td>
                <td class="whitespace-nowrap px-6 py-4">
                  <% if assignment.handle_duration_seconds %>
                    <% duration = assignment.handle_duration_seconds %>
                    <% if duration < 60 %>
                      <span class="text-sm text-green-600 font-medium"><%= duration %> 秒</span>
                    <% elsif duration < 3600 %>
                      <span class="text-sm text-blue-600 font-medium"><%= (duration / 60).round(1) %> 分钟</span>
                    <% else %>
                      <span class="text-sm text-yellow-600 font-medium"><%= (duration / 3600).round(1) %> 小时</span>
                    <% end %>
                  <% else %>
                    <span class="text-sm text-gray-400">-</span>
                  <% end %>
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                  <%= assignment.reassigned_by&.email || '系统' %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @driver_assignments.empty? %>
        <div class="py-12 text-center">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
          </svg>
          <h3 class="mt-2 text-sm font-medium text-gray-900">暂无改派记录</h3>
          <p class="mt-1 text-sm text-gray-500">还没有任何司机改派记录。</p>
        </div>
      <% end %>

      <div class="border-t border-gray-200 px-4 py-3 sm:px-6">
        <div class="flex items-center justify-between">
          <div class="text-sm text-gray-700">
            显示第 <%= @driver_assignments.offset_value + 1 %> - <%= [@driver_assignments.offset_value + @driver_assignments.limit_value, @driver_assignments.total_count].min %> 条，共 <%= @driver_assignments.total_count %> 条
          </div>
          <div class="flex justify-end">
            <%= paginate @driver_assignments, theme: 'tailwind' %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
