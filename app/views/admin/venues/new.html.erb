<% content_for :page_title, "新建场地" %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">新建场地</h1>
      <p class="text-gray-500 mt-1">场地管理</p>
    </div>
    <div class="flex items-center space-x-3">
      <%= link_to "返回列表", admin_venues_path, class: "text-gray-600 hover:text-gray-900" %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="text-lg font-medium text-gray-900">场地信息</h3>
    </div>
    <div class="px-6 py-6">
      <%= form_with model: [:admin, @venue], local: true, class: "space-y-6" do |f| %>
        <% if @venue.errors.any? %>
          <div class="bg-red-50 border border-red-200 rounded-lg p-4">
            <h3 class="text-sm font-medium text-red-800"><%= pluralize(@venue.errors.count, "个错误") %></h3>
            <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
              <% @venue.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <%= f.label :name, "场地名称", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :name, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
          </div>

          <div>
            <%= f.label :location, "场地地址", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :location, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
          </div>

          <div>
            <%= f.label :capacity, "场地容量", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.number_field :capacity, min: 0, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
          </div>

          <div>
            <%= f.label :status, "状态", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.select :status, [["活跃", "active"], ["停用", "inactive"]], {}, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
          </div>

          <div class="md:col-span-2">
            <%= f.label :facilities, "设施信息", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_area :facilities, rows: 3, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
          </div>

          <div class="md:col-span-2">
            <%= f.label :description, "场地描述", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_area :description, rows: 4, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
          </div>
        </div>

        <div class="flex items-center space-x-3 pt-4 border-t border-gray-200">
          <%= f.submit "创建场地", class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
          <%= link_to "取消", admin_venues_path, class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
