<% content_for :page_title, "场地管理" %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">场地管理</h1>
    <div class="flex items-center space-x-3">
      <%= link_to "新建场地", new_admin_venue_path, class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
    <%= search_form_for @q, url: admin_venues_path, method: :get, class: "flex items-end space-x-4" do |f| %>
      <div>
        <%= f.label "名称", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.search_field :name_cont, placeholder: "场地名称", class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div>
        <%= f.label "状态", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :status_eq, [["活跃", "active"], ["停用", "inactive"]], { include_blank: "全部状态" }, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div class="flex space-x-2">
        <%= f.submit "搜索", class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
        <%= link_to "重置", admin_venues_path, class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50" %>
      </div>
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">场地名称</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">地址</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">容量</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @venues.each do |venue| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900"><%= venue.name %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= venue.location || "-" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                <%= venue.capacity ? "#{venue.capacity} 人" : "-" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 py-1 text-xs rounded-full <%= status_class(venue.status) %>">
                  <%= status_text(venue.status) %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm space-x-2">
                <%= link_to "查看", admin_venue_path(venue), class: "text-blue-600 hover:text-blue-900" %>
                <%= link_to "编辑", edit_admin_venue_path(venue), class: "text-gray-600 hover:text-gray-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @venues.empty? %>
      <div class="px-6 py-12 text-center text-gray-500">
        暂无场地数据
      </div>
    <% end %>

    <div class="px-6 py-4 border-t border-gray-200">
      <%= paginate @venues %>
    </div>
  </div>
</div>
