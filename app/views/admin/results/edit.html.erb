<% content_for :page_title, "编辑成绩" %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">编辑成绩</h1>
      <p class="text-gray-500 mt-1"><%= @result.user_name %> - #<%= @result.id %></p>
    </div>
    <%= link_to "返回详情", admin_result_path(@result), class: "text-gray-600 hover:text-gray-900" %>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <%= form_with model: [:admin, @result], local: true, class: "space-y-0" do |f| %>
      <% if @result.errors.any? %>
        <div class="px-6 py-4 bg-red-50 border-b border-red-200">
          <h3 class="text-sm font-medium text-red-800"><%= pluralize(@result.errors.count, "个错误") %> 导致无法保存：</h3>
          <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
            <% @result.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="px-6 py-6 space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <%= f.label :event_registration_id, "参赛报名", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.collection_select :event_registration_id, EventRegistration.includes(:user, :event).confirmed, :id, ->(er) { "#{er.user.name} - #{er.event.name}" }, { prompt: "请选择参赛选手" }, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
          </div>

          <div>
            <%= f.label :schedule_id, "赛程", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.collection_select :schedule_id, Schedule.includes(:event).ordered, :id, ->(s) { "#{s.title} (#{s.event.name})" }, { prompt: "请选择赛程" }, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
          </div>

          <div>
            <%= f.label :rank, "名次", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.number_field :rank, min: 1, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
          </div>

          <div>
            <%= f.label :status, "状态", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.select :status, Result.statuses.keys.map { |s| [status_text(s), s] }, {}, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
          </div>

          <div>
            <%= f.label :time_result, "用时", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :time_result, placeholder: "例如: 00:01:23.45", class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
          </div>

          <div>
            <%= f.label :score, "得分", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.number_field :score, step: 0.01, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
          </div>
        </div>

        <div>
          <%= f.label :remark, "备注", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_area :remark, rows: 3, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>
      </div>

      <div class="px-6 py-4 border-t border-gray-200 bg-gray-50 flex items-center justify-end space-x-3">
        <%= link_to "取消", admin_result_path(@result), class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50" %>
        <%= f.submit "保存修改", class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
      </div>
    <% end %>
  </div>
</div>
