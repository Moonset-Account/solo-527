<% content_for :page_title, "成绩详情" %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">成绩详情 #<%= @result.id %></h1>
    <%= link_to "返回列表", admin_results_path, class: "text-gray-600 hover:text-gray-900" %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
          <h3 class="text-lg font-medium text-gray-900">成绩信息</h3>
          <span class="px-3 py-1 text-sm rounded-full <%= status_class(@result.status) %> font-medium">
            <%= status_text(@result.status) %>
          </span>
        </div>
        <div class="px-6 py-4">
          <dl class="grid grid-cols-2 gap-x-6 gap-y-4">
            <div>
              <dt class="text-sm text-gray-500">赛事名称</dt>
              <dd class="mt-1 font-medium text-gray-900"><%= @result.event_name %></dd>
            </div>
            <div>
              <dt class="text-sm text-gray-500">参赛选手</dt>
              <dd class="mt-1 font-medium text-gray-900"><%= @result.user_name %></dd>
            </div>
            <div>
              <dt class="text-sm text-gray-500">赛程</dt>
              <dd class="mt-1 font-medium text-gray-900">
                <% if @result.schedule %>
                  <%= link_to @result.schedule.title, admin_schedule_path(@result.schedule), class: "text-blue-600 hover:text-blue-900" %>
                <% else %>
                  未关联
                <% end %>
              </dd>
            </div>
            <div>
              <dt class="text-sm text-gray-500">名次</dt>
              <dd class="mt-1 font-medium text-gray-900"><%= @result.rank ? "第#{@result.rank}名" : "未排名" %></dd>
            </div>
            <div>
              <dt class="text-sm text-gray-500">用时</dt>
              <dd class="mt-1 font-medium text-gray-900"><%= @result.time_result || "-" %></dd>
            </div>
            <div>
              <dt class="text-sm text-gray-500">得分</dt>
              <dd class="mt-1 font-medium text-gray-900"><%= @result.score ? "#{@result.score} 分" : "-" %></dd>
            </div>
            <div>
              <dt class="text-sm text-gray-500">备注</dt>
              <dd class="mt-1 font-medium text-gray-900"><%= @result.remark || "-" %></dd>
            </div>
            <div>
              <dt class="text-sm text-gray-500">操作人</dt>
              <dd class="mt-1 font-medium text-gray-900"><%= @result.operator&.name || "系统" %></dd>
            </div>
            <div>
              <dt class="text-sm text-gray-500">创建时间</dt>
              <dd class="mt-1 font-medium text-gray-900"><%= @result.created_at.strftime("%Y-%m-%d %H:%M:%S") %></dd>
            </div>
            <div>
              <dt class="text-sm text-gray-500">更新时间</dt>
              <dd class="mt-1 font-medium text-gray-900"><%= @result.updated_at.strftime("%Y-%m-%d %H:%M:%S") %></dd>
            </div>
          </dl>
        </div>
        <div class="px-6 py-4 border-t border-gray-200 bg-gray-50 flex space-x-3">
          <%= link_to "编辑成绩", edit_admin_result_path(@result), class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 text-sm" %>
          <% if @result.pending? %>
            <%= button_to "确认成绩", confirm_admin_result_path(@result), method: :post, class: "px-4 py-2 border border-green-300 text-green-700 rounded-lg hover:bg-green-50 text-sm" %>
          <% end %>
          <% unless @result.disqualified? %>
            <%= button_to "取消资格", disqualify_admin_result_path(@result), method: :post, class: "px-4 py-2 border border-red-300 text-red-700 rounded-lg hover:bg-red-50 text-sm", data: { confirm: "确认取消该选手成绩资格？" } %>
          <% end %>
        </div>
      </div>

      <%= render "shared/version_history", versions: @versions %>
    </div>

    <div class="space-y-6">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-medium text-gray-900">选手信息</h3>
        </div>
        <div class="px-6 py-4">
          <div class="flex items-center">
            <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
              <span class="text-blue-600 font-semibold"><%= @result.user_name[0] %></span>
            </div>
            <div class="ml-4">
              <p class="font-medium text-gray-900"><%= @result.user_name %></p>
              <p class="text-sm text-gray-500"><%= @result.event_registration.user.email %></p>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-medium text-gray-900">快捷操作</h3>
        </div>
        <div class="px-6 py-4 space-y-3">
          <%= link_to "查看赛事", admin_event_path(@result.event_registration.event), class: "block px-4 py-2 bg-gray-50 rounded-lg text-center text-gray-700 hover:bg-gray-100 text-sm" %>
          <% if @result.schedule %>
            <%= link_to "查看赛程", admin_schedule_path(@result.schedule), class: "block px-4 py-2 bg-gray-50 rounded-lg text-center text-gray-700 hover:bg-gray-100 text-sm" %>
          <% end %>
          <%= link_to "录入成绩", new_admin_result_path, class: "block px-4 py-2 bg-gray-50 rounded-lg text-center text-gray-700 hover:bg-gray-100 text-sm" %>
        </div>
      </div>
    </div>
  </div>
</div>
