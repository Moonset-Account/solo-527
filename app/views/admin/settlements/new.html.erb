<div class="min-h-screen bg-gray-50">
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-6">
      <h1 class="text-2xl font-bold text-gray-900">生成结算单</h1>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <div class="rounded-lg bg-white p-6 shadow-sm">
          <%= form_with model: [:admin, @settlement], local: true, url: preview_admin_settlements_path, method: :get, id: 'settlement-form' do |form| %>
            <% if @settlement.errors.any? %>
              <div class="mb-6 rounded-md bg-red-50 p-4">
                <div class="flex">
                  <div class="ml-3">
                    <h3 class="text-sm font-medium text-red-800">表单存在 <%= @settlement.errors.count %> 个错误：</h3>
                    <div class="mt-2 text-sm text-red-700">
                      <ul class="list-disc space-y-1 pl-5">
                        <% @settlement.errors.full_messages.each do |message| %>
                          <li><%= message %></li>
                        <% end %>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>

            <div class="space-y-6">
              <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                <div>
                  <%= form.label :vehicle_id, '选择车辆', class: 'block text-sm font-medium text-gray-700' %>
                  <%= form.select :vehicle_id, Vehicle.active.map { |v| [v.plate_number, v.id] }, { include_blank: '请选择车辆' }, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
                </div>

                <div>
                  <%= form.label :driver_id, '选择司机', class: 'block text-sm font-medium text-gray-700' %>
                  <%= form.select :driver_id, User.driver.active.map { |u| [u.name || u.email, u.id] }, { include_blank: '请选择司机' }, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
                </div>
              </div>

              <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                <div>
                  <%= form.label :start_date, '开始日期', class: 'block text-sm font-medium text-gray-700' %>
                  <%= form.date_field :start_date, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
                </div>

                <div>
                  <%= form.label :end_date, '结束日期', class: 'block text-sm font-medium text-gray-700' %>
                  <%= form.date_field :end_date, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
                </div>
              </div>

              <div class="flex justify-end space-x-3 pt-4 border-t border-gray-200">
                <%= link_to '取消', admin_settlements_path, class: 'inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2' %>
                <%= button_tag '预览费用', type: 'submit', class: 'inline-flex items-center rounded-md border border-transparent bg-yellow-500 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-yellow-600 focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:ring-offset-2' %>
                <%= form.submit '生成结算单', class: 'inline-flex items-center rounded-md border border-transparent bg-green-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2', formaction: admin_settlements_path, formmethod: 'post' %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div>
        <div class="rounded-lg bg-white p-6 shadow-sm sticky top-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">费用预览</h3>
          
          <div class="space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-gray-200">
              <span class="text-sm text-gray-500">结算周期</span>
              <span class="text-sm font-medium text-gray-900">
                <%= @settlement&.start_date&.strftime('%Y-%m-%d') || '-' %> 至 <%= @settlement&.end_date&.strftime('%Y-%m-%d') || '-' %>
              </span>
            </div>

            <div class="flex items-center justify-between">
              <span class="text-sm text-gray-500">车辆</span>
              <span class="text-sm font-medium text-gray-900"><%= @settlement&.vehicle&.plate_number || '-' %></span>
            </div>

            <div class="flex items-center justify-between">
              <span class="text-sm text-gray-500">司机</span>
              <span class="text-sm font-medium text-gray-900"><%= @settlement&.driver&.name || @settlement&.driver&.email || '-' %></span>
            </div>

            <div class="pt-3 border-t border-gray-200">
              <h4 class="text-sm font-medium text-gray-700 mb-3">费用明细</h4>
              <div class="space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-sm text-gray-500">基础运费</span>
                  <span class="text-sm text-gray-900">¥<%= number_with_precision(@preview&.base_fare || 0, precision: 2) %></span>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-sm text-gray-500">里程费用</span>
                  <span class="text-sm text-gray-900">¥<%= number_with_precision(@preview&.mileage_fee || 0, precision: 2) %></span>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-sm text-gray-500">时长费用</span>
                  <span class="text-sm text-gray-900">¥<%= number_with_precision(@preview&.time_fee || 0, precision: 2) %></span>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-sm text-gray-500">其他费用</span>
                  <span class="text-sm text-gray-900">¥<%= number_with_precision(@preview&.other_fee || 0, precision: 2) %></span>
                </div>
              </div>
            </div>

            <div class="pt-3 border-t border-gray-200">
              <div class="flex items-center justify-between">
                <span class="text-base font-semibold text-gray-900">合计</span>
                <span class="text-2xl font-bold text-green-600">¥<%= number_with_precision(@preview&.total_amount || 0, precision: 2) %></span>
              </div>
            </div>
          </div>

          <div class="mt-6 p-4 bg-gray-50 rounded-lg">
            <div class="flex items-start">
              <svg class="h-5 w-5 text-blue-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <p class="ml-2 text-xs text-gray-600">
                点击"预览费用"按钮查看详细的费用明细，确认无误后再生成结算单。
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
