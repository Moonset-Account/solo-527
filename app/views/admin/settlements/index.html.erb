<div class="min-h-screen bg-gray-50">
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-6 flex items-center justify-between">
      <h1 class="text-2xl font-bold text-gray-900">结算单管理</h1>
      <div class="flex items-center space-x-3">
        <%= link_to '生成结算单', new_admin_settlement_path, class: 'inline-flex items-center rounded-lg bg-green-600 px-4 py-2 text-sm font-medium text-white hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2' %>
      </div>
    </div>

    <div class="mb-6 rounded-lg bg-white p-4 shadow-sm">
      <%= search_form_for [:admin, @q] do |f| %>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-5">
          <div>
            <%= f.label :settlement_no_cont, '结算单号', class: 'block text-sm font-medium text-gray-700' %>
            <%= f.text_field :settlement_no_cont, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
          </div>
          <div>
            <%= f.label :vehicle_plate_number_cont, '车牌号', class: 'block text-sm font-medium text-gray-700' %>
            <%= f.text_field :vehicle_plate_number_cont, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
          </div>
          <div>
            <%= f.label :driver_email_cont, '司机', class: 'block text-sm font-medium text-gray-700' %>
            <%= f.text_field :driver_email_cont, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
          </div>
          <div>
            <%= f.label :status_eq, '状态', class: 'block text-sm font-medium text-gray-700' %>
            <%= f.select :status_eq, Settlement.status.options, { include_blank: '全部' }, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
          </div>
          <div class="flex items-end">
            <%= f.submit '筛选', class: 'w-full rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2' %>
          </div>
        </div>
        <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
          <div>
            <%= f.label :start_date_gteq, '开始日期', class: 'block text-sm font-medium text-gray-700' %>
            <%= f.date_field :start_date_gteq, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
          </div>
          <div>
            <%= f.label :end_date_lteq, '结束日期', class: 'block text-sm font-medium text-gray-700' %>
            <%= f.date_field :end_date_lteq, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="mb-4 flex items-center justify-between">
      <div class="flex flex-wrap gap-2">
        <%= link_to '全部', admin_settlements_path, class: "inline-flex items-center rounded-full px-3 py-1 text-sm font-medium #{params[:q]&.dig(:status_eq).nil? ? 'bg-blue-100 text-blue-800' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}" %>
        <% Settlement.status.each do |status| %>
          <%= link_to status.text, admin_settlements_path(q: { status_eq: status.value }), class: "inline-flex items-center rounded-full px-3 py-1 text-sm font-medium #{params[:q]&.dig(:status_eq) == status.value ? 'bg-blue-100 text-blue-800' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}" %>
        <% end %>
      </div>
      <div class="text-sm text-gray-500">
        共 <span class="font-semibold text-gray-900"><%= @settlements.total_count %></span> 条记录
      </div>
    </div>

    <div class="overflow-hidden rounded-lg bg-white shadow-sm">
      <div class="border-b border-gray-200 bg-gray-50 px-6 py-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-2">
            <input type="checkbox" id="select-all" class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500">
            <label for="select-all" class="text-sm text-gray-600">全选</label>
          </div>
          <div class="flex items-center space-x-2">
            <button type="button" class="rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50">
              批量审批
            </button>
            <button type="button" class="rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50">
              批量支付
            </button>
          </div>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="w-12 px-6 py-3"></th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">结算单号</th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">车牌号</th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">司机</th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">结算周期</th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">总金额</th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">状态</th>
              <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">操作</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
            <% @settlements.each do |settlement| %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4">
                  <input type="checkbox" class="settlement-checkbox h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500" value="<%= settlement.id %>">
                </td>
                <td class="whitespace-nowrap px-6 py-4">
                  <span class="font-mono text-sm font-semibold text-blue-600"><%= settlement.settlement_no %></span>
                </td>
                <td class="whitespace-nowrap px-6 py-4">
                  <span class="text-sm font-medium text-gray-900"><%= settlement.vehicle&.plate_number %></span>
                </td>
                <td class="whitespace-nowrap px-6 py-4">
                  <span class="text-sm text-gray-700"><%= settlement.driver&.email %></span>
                </td>
                <td class="whitespace-nowrap px-6 py-4">
                  <span class="text-sm text-gray-700"><%= settlement.start_date&.strftime('%Y-%m-%d') %> 至 <%= settlement.end_date&.strftime('%Y-%m-%d') %></span>
                </td>
                <td class="whitespace-nowrap px-6 py-4">
                  <span class="text-lg font-bold text-gray-900">¥<%= number_with_precision(settlement.total_amount, precision: 2) %></span>
                </td>
                <td class="whitespace-nowrap px-6 py-4">
                  <% status_class = case settlement.status
                    when 'draft' then 'bg-gray-100 text-gray-800'
                    when 'pending' then 'bg-yellow-100 text-yellow-800'
                    when 'approved' then 'bg-green-100 text-green-800'
                    when 'paid' then 'bg-purple-100 text-purple-800'
                    when 'cancelled' then 'bg-red-100 text-red-800'
                    else 'bg-gray-100 text-gray-800'
                    end %>
                  <span class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-medium <%= status_class %>">
                    <%= settlement.status.text %>
                  </span>
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
                  <div class="flex items-center justify-end space-x-2">
                    <%= link_to '查看', admin_settlement_path(settlement), class: 'text-blue-600 hover:text-blue-900' %>
                    <% if settlement.draft? %>
                      <%= link_to '生成', generate_admin_settlement_path(settlement), method: :post, class: 'text-green-600 hover:text-green-900' %>
                    <% end %>
                    <% if settlement.pending? %>
                      <%= link_to '审批', approve_admin_settlement_path(settlement), method: :post, class: 'text-purple-600 hover:text-purple-900' %>
                    <% end %>
                    <% if settlement.approved? %>
                      <%= link_to '支付', pay_admin_settlement_path(settlement), method: :post, class: 'text-orange-600 hover:text-orange-900' %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @settlements.empty? %>
        <div class="py-12 text-center">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          <h3 class="mt-2 text-sm font-medium text-gray-900">暂无结算单</h3>
          <p class="mt-1 text-sm text-gray-500">还没有任何结算单记录。</p>
        </div>
      <% end %>

      <div class="border-t border-gray-200 px-4 py-3 sm:px-6">
        <div class="flex items-center justify-between">
          <div class="text-sm text-gray-700">
            显示第 <%= @settlements.offset_value + 1 %> - <%= [@settlements.offset_value + @settlements.limit_value, @settlements.total_count].min %> 条，共 <%= @settlements.total_count %> 条
          </div>
          <div class="flex justify-end">
            <%= paginate @settlements, theme: 'tailwind' %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
