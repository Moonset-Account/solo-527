<% content_for :page_title, "编辑用户" %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">编辑用户 - <%= @user.name %></h1>
      <p class="text-gray-500 mt-1">用户管理</p>
    </div>
    <%= link_to "返回详情", admin_user_path(@user), class: "text-gray-600 hover:text-gray-900" %>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <%= form_with model: [:admin, @user], local: true, class: "px-6 py-6" do |f| %>
      <% if @user.errors.any? %>
        <div class="mb-6 bg-red-50 border border-red-200 rounded-lg p-4">
          <h3 class="text-sm font-medium text-red-800"><%= pluralize(@user.errors.count, "个错误") %></h3>
          <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%= f.label :name, "姓名", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :name, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div>
          <%= f.label :email, "邮箱", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.email_field :email, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div>
          <%= f.label :phone, "手机号", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :phone, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div>
          <%= f.label :role, "角色", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :role, [["普通会员", "member"], ["主管", "supervisor"], ["管理员", "admin"]], {}, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div class="md:col-span-2">
          <div class="flex items-center">
            <%= f.check_box :active, class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" %>
            <%= f.label :active, "启用账户", class: "ml-2 text-sm text-gray-700" %>
          </div>
        </div>
      </div>

      <div class="mt-6 flex items-center space-x-3">
        <%= f.submit "保存修改", class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
        <%= link_to "取消", admin_user_path(@user), class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50" %>
      </div>
    <% end %>
  </div>
</div>
