<% content_for :page_title, @user.name %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900"><%= @user.name %></h1>
      <p class="text-gray-500 mt-1">用户管理</p>
    </div>
    <div class="flex items-center space-x-3">
      <%= link_to "返回列表", admin_users_path, class: "text-gray-600 hover:text-gray-900" %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
          <h3 class="text-lg font-medium text-gray-900">用户信息</h3>
          <div class="flex items-center space-x-2">
            <span class="px-2 py-1 text-xs rounded-full <%= @user.admin? ? 'bg-purple-100 text-purple-800' : @user.supervisor? ? 'bg-blue-100 text-blue-800' : 'bg-gray-100 text-gray-800' %>">
              <%= @user.admin? ? "管理员" : @user.supervisor? ? "主管" : "普通会员" %>
            </span>
            <span class="px-2 py-1 text-xs rounded-full <%= @user.active? ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
              <%= @user.active? ? "启用" : "停用" %>
            </span>
          </div>
        </div>
        <div class="px-6 py-4">
          <dl class="grid grid-cols-2 gap-x-6 gap-y-4">
            <div>
              <dt class="text-sm text-gray-500">姓名</dt>
              <dd class="mt-1 font-medium text-gray-900"><%= @user.name %></dd>
            </div>
            <div>
              <dt class="text-sm text-gray-500">邮箱</dt>
              <dd class="mt-1 font-medium text-gray-900"><%= @user.email %></dd>
            </div>
            <div>
              <dt class="text-sm text-gray-500">手机号</dt>
              <dd class="mt-1 font-medium text-gray-900"><%= @user.phone || "-" %></dd>
            </div>
            <div>
              <dt class="text-sm text-gray-500">角色</dt>
              <dd class="mt-1 font-medium text-gray-900">
                <%= @user.admin? ? "管理员" : @user.supervisor? ? "主管" : "普通会员" %>
              </dd>
            </div>
            <div>
              <dt class="text-sm text-gray-500">注册时间</dt>
              <dd class="mt-1 font-medium text-gray-900"><%= @user.created_at.strftime("%Y-%m-%d %H:%M:%S") %></dd>
            </div>
            <div>
              <dt class="text-sm text-gray-500">更新时间</dt>
              <dd class="mt-1 font-medium text-gray-900"><%= @user.updated_at.strftime("%Y-%m-%d %H:%M:%S") %></dd>
            </div>
          </dl>
        </div>
        <div class="px-6 py-4 border-t border-gray-200 bg-gray-50 flex space-x-3">
          <%= link_to "编辑用户", edit_admin_user_path(@user), class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 text-sm" %>
          <%= button_to "删除用户", admin_user_path(@user), method: :delete, class: "px-4 py-2 border border-red-300 text-red-700 rounded-lg hover:bg-red-50 text-sm", data: { confirm: "确认删除该用户？此操作不可恢复。" } %>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-medium text-gray-900">课程报名</h3>
        </div>
        <div class="divide-y divide-gray-200">
          <% @enrollments.each do |enrollment| %>
            <div class="px-6 py-4">
              <div class="flex items-center justify-between">
                <div>
                  <p class="font-medium text-gray-900"><%= enrollment.course.name %></p>
                  <p class="text-sm text-gray-500 mt-1">
                    <span class="px-2 py-0.5 text-xs rounded-full <%= status_class(enrollment.status) %>">
                      <%= status_text(enrollment.status) %>
                    </span>
                    <span class="px-2 py-0.5 text-xs rounded-full <%= status_class(enrollment.payment_status) %> ml-1">
                      支付: <%= status_text(enrollment.payment_status) %>
                    </span>
                  </p>
                </div>
                <span class="text-xs text-gray-400"><%= enrollment.created_at.strftime("%Y-%m-%d") %></span>
              </div>
            </div>
          <% end %>
        </div>
        <% if @enrollments.empty? %>
          <div class="px-6 py-8 text-center text-gray-500">暂无报名记录</div>
        <% end %>
      </div>

      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-medium text-gray-900">赛事报名</h3>
        </div>
        <div class="divide-y divide-gray-200">
          <% @event_registrations.each do |registration| %>
            <div class="px-6 py-4">
              <div class="flex items-center justify-between">
                <div>
                  <p class="font-medium text-gray-900"><%= registration.event.name %></p>
                  <p class="text-sm text-gray-500 mt-1">
                    <span class="px-2 py-0.5 text-xs rounded-full <%= status_class(registration.status) %>">
                      <%= status_text(registration.status) %>
                    </span>
                    <span class="px-2 py-0.5 text-xs rounded-full <%= status_class(registration.payment_status) %> ml-1">
                      支付: <%= status_text(registration.payment_status) %>
                    </span>
                  </p>
                </div>
                <span class="text-xs text-gray-400"><%= registration.created_at.strftime("%Y-%m-%d") %></span>
              </div>
            </div>
          <% end %>
        </div>
        <% if @event_registrations.empty? %>
          <div class="px-6 py-8 text-center text-gray-500">暂无赛事报名记录</div>
        <% end %>
      </div>

      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-medium text-gray-900">支付记录</h3>
        </div>
        <div class="divide-y divide-gray-200">
          <% @payments.each do |payment| %>
            <div class="px-6 py-4">
              <div class="flex items-center justify-between">
                <div>
                  <p class="font-medium text-gray-900">¥<%= "%.2f" % payment.amount %></p>
                  <p class="text-sm text-gray-500 mt-1">
                    <span class="px-2 py-0.5 text-xs rounded-full <%= status_class(payment.status) %>">
                      <%= status_text(payment.status) %>
                    </span>
                    <span class="text-xs text-gray-400 ml-2"><%= payment.payable_type %>#<%= payment.payable_id %></span>
                  </p>
                </div>
                <span class="text-xs text-gray-400"><%= payment.created_at.strftime("%Y-%m-%d") %></span>
              </div>
            </div>
          <% end %>
        </div>
        <% if @payments.empty? %>
          <div class="px-6 py-8 text-center text-gray-500">暂无支付记录</div>
        <% end %>
      </div>

      <%= render "shared/version_history", versions: @versions %>
    </div>

    <div class="space-y-6">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-medium text-gray-900">用户概览</h3>
        </div>
        <div class="px-6 py-6">
          <div class="text-center">
            <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto">
              <span class="text-blue-600 text-xl font-semibold"><%= @user.name[0] %></span>
            </div>
            <p class="mt-3 font-medium text-gray-900 text-lg"><%= @user.name %></p>
            <p class="text-sm text-gray-500"><%= @user.email %></p>
            <p class="text-sm text-gray-500"><%= @user.phone %></p>
          </div>
          <div class="mt-6 grid grid-cols-2 gap-4">
            <div class="bg-gray-50 rounded-lg p-3 text-center">
              <p class="text-sm text-gray-500">课程报名</p>
              <p class="text-lg font-bold text-gray-900 mt-1"><%= @user.course_enrollments.count %></p>
            </div>
            <div class="bg-gray-50 rounded-lg p-3 text-center">
              <p class="text-sm text-gray-500">赛事报名</p>
              <p class="text-lg font-bold text-gray-900 mt-1"><%= @user.event_registrations.count %></p>
            </div>
            <div class="bg-gray-50 rounded-lg p-3 text-center">
              <p class="text-sm text-gray-500">场地预约</p>
              <p class="text-lg font-bold text-gray-900 mt-1"><%= @user.venue_bookings.count %></p>
            </div>
            <div class="bg-gray-50 rounded-lg p-3 text-center">
              <p class="text-sm text-gray-500">支付笔数</p>
              <p class="text-lg font-bold text-gray-900 mt-1"><%= @user.payments.count %></p>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-medium text-gray-900">快捷操作</h3>
        </div>
        <div class="px-6 py-4 space-y-3">
          <%= link_to "编辑用户", edit_admin_user_path(@user), class: "block px-4 py-2 bg-gray-50 rounded-lg text-center text-gray-700 hover:bg-gray-100 text-sm" %>
          <%= link_to "查看课程报名", admin_course_enrollments_path(q: { user_id_eq: @user.id }), class: "block px-4 py-2 bg-gray-50 rounded-lg text-center text-gray-700 hover:bg-gray-100 text-sm" %>
          <%= link_to "查看赛事报名", admin_event_registrations_path(q: { user_id_eq: @user.id }), class: "block px-4 py-2 bg-gray-50 rounded-lg text-center text-gray-700 hover:bg-gray-100 text-sm" %>
          <%= link_to "查看支付记录", admin_payments_path(q: { user_id_eq: @user.id }), class: "block px-4 py-2 bg-gray-50 rounded-lg text-center text-gray-700 hover:bg-gray-100 text-sm" %>
        </div>
      </div>
    </div>
  </div>
</div>
