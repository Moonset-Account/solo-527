<div class="page-header">
  <h1>用户管理</h1>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          <th>姓名</th>
          <th>邮箱</th>
          <th>联系电话</th>
          <th>角色</th>
          <th>创建时间</th>
          <th>最后登录</th>
          <th class="actions-column">操作</th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td><%= user.name || "-" %></td>
            <td><%= user.email %></td>
            <td><%= user.phone || "-" %></td>
            <td>
              <% role_class = user.admin? ? "badge-primary" : "badge-secondary" %>
              <span class="badge <%= role_class %>"><%= User.human_attribute_name("role.#{user.role}") %></span>
            </td>
            <td><%= user.created_at&.strftime("%Y-%m-%d %H:%M") %></td>
            <td><%= user.current_sign_in_at&.strftime("%Y-%m-%d %H:%M") || "-" %></td>
            <td class="actions-column">
              <%= link_to "编辑", edit_admin_user_path(user), class: "btn btn-link btn-sm" %>
              <% unless user == current_user %>
                <%= link_to "删除", admin_user_path(user), class: "btn btn-link btn-sm btn-danger-link", data: { turbo_method: :delete, turbo_confirm: "确定要删除此用户吗？" } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @users.empty? %>
    <div class="empty-state">
      <p>暂无用户数据</p>
    </div>
  <% end %>

  <div class="pagination-container">
    <%= paginate @users %>
  </div>
</div>
