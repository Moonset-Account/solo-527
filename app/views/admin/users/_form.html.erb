<%= form_with model: [:admin, @user], local: true do |form| %>
  <% if @user.errors.any? %>
    <div class="mb-6 rounded-md bg-red-50 p-4">
      <div class="flex">
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">表单存在 <%= @user.errors.count %> 个错误：</h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc space-y-1 pl-5">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="space-y-6">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      <div>
        <%= form.label :name, '姓名', class: 'block text-sm font-medium text-gray-700' %>
        <%= form.text_field :name, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', placeholder: '请输入姓名' %>
      </div>

      <div>
        <%= form.label :email, '邮箱', class: 'block text-sm font-medium text-gray-700' %>
        <%= form.email_field :email, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', placeholder: '请输入邮箱' %>
      </div>

      <div>
        <%= form.label :phone_number, '手机号', class: 'block text-sm font-medium text-gray-700' %>
        <%= form.text_field :phone_number, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', placeholder: '请输入手机号' %>
      </div>

      <div>
        <%= form.label :role, '角色', class: 'block text-sm font-medium text-gray-700' %>
        <%= form.select :role, User.role.options, { include_blank: '请选择角色' }, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
      </div>

      <div>
        <%= form.label :status, '状态', class: 'block text-sm font-medium text-gray-700' %>
        <%= form.select :status, User.status.options, { include_blank: '请选择状态' }, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      <div>
        <%= form.label :password, '密码', class: 'block text-sm font-medium text-gray-700' %>
        <%= form.password_field :password, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', placeholder: @user.new_record? ? '请输入密码' : '留空则不修改密码' %>
        <% if @user.persisted? %>
          <p class="mt-1 text-xs text-gray-500">留空则不修改密码</p>
        <% end %>
      </div>

      <div>
        <%= form.label :password_confirmation, '确认密码', class: 'block text-sm font-medium text-gray-700' %>
        <%= form.password_field :password_confirmation, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', placeholder: '请再次输入密码' %>
      </div>
    </div>

    <div class="flex justify-end space-x-3 pt-4 border-t border-gray-200">
      <%= link_to '取消', admin_users_path, class: 'inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2' %>
      <%= form.submit @user.new_record? ? '创建用户' : '更新用户', class: 'inline-flex items-center rounded-md border border-transparent bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2' %>
    </div>
  </div>
<% end %>
