<% content_for :page_title, "课程管理" %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">课程管理</h1>
    <div class="flex items-center space-x-3">
      <%= link_to "导出课程", export_admin_courses_path(format: :csv, q: params[:q]),
                  method: :post, class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50" %>
      <%= link_to "新建课程", new_admin_course_path, class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
    <%= search_form_for @q, url: admin_courses_path, method: :get, class: "flex items-end space-x-4" do |f| %>
      <div>
        <%= f.label "名称", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.search_field :name_cont, placeholder: "课程名称", class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div>
        <%= f.label "状态", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :status_eq, Course.statuses.keys.map { |s| [status_text(s), s] }, { include_blank: "全部状态" }, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div>
        <%= f.label "级别", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :level_eq, Course.pluck(:level).uniq.compact.map { |l| [l, l] }, { include_blank: "全部级别" }, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div class="flex space-x-2">
        <%= f.submit "搜索", class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
        <%= link_to "重置", admin_courses_path, class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50" %>
      </div>
    <% end %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
      <p class="text-sm text-gray-500">课程总数</p>
      <p class="text-2xl font-bold text-gray-900 mt-1"><%= @total_courses %></p>
    </div>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
      <p class="text-sm text-gray-500">进行中</p>
      <p class="text-2xl font-bold text-green-600 mt-1"><%= @active_courses %></p>
    </div>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
      <p class="text-sm text-gray-500">平均满班率</p>
      <p class="text-2xl font-bold text-blue-600 mt-1"><%= @avg_fill_rate %>%</p>
    </div>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
      <p class="text-sm text-gray-500">总报名人数</p>
      <p class="text-2xl font-bold text-orange-600 mt-1"><%= @total_enrollments %></p>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">课程名称</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">级别</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">教练</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">费用</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">报名/容量</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">满班率</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
        </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
        <% @courses.each do |course| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 whitespace-nowrap">
            <div class="text-sm font-medium text-gray-900"><%= course.name %></div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= course.level || "-" %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= course.coach || "-" %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 font-medium">¥<%= "%.2f" % course.price %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <%= course.enrolled_count %> / <%= course.capacity %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center">
                <div class="w-20 h-2 bg-gray-200 rounded-full overflow-hidden mr-2">
                  <div class="h-full <%= course.fill_rate >= 100 ? 'bg-red-500' : course.fill_rate >= 80 ? 'bg-green-500' : 'bg-yellow-500' %>"
                       style="width: <%= [course.fill_rate, 100].min %>"></div>
                </div>
                <span class="text-sm font-medium"><%= course.fill_rate %>%</span>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="px-2 py-1 text-xs rounded-full <%= status_class(course.status) %>">
                <%= status_text(course.status) %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm space-x-2">
              <%= link_to "查看", admin_course_path(course), class: "text-blue-600 hover:text-blue-900" %>
              <%= link_to "编辑", edit_admin_course_path(course), class: "text-gray-600 hover:text-gray-900" %>
              <% if course.active? %>
                <%= button_to "下架", deactivate_admin_course_path(course), method: :post, class: "text-red-600 hover:text-red-900" %>
              <% else %>
                <%= button_to "上架", activate_admin_course_path(course), method: :post, class: "text-green-600 hover:text-green-900" %>
              <% end %>
            </td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>

    <div class="px-6 py-4 border-t border-gray-200">
      <%= paginate @courses %>
    </div>
  </div>
</div>
