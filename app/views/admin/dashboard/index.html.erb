<% content_for :title, "后台管理 - 数据总览" %>

<div class="stats-grid">
  <div class="stat-card" style="border-left-color:#409eff;">
    <h3>本月预约</h3>
    <div class="value"><%= Appointment.where(appointment_date: @month_start..@today).count %></div>
  </div>
  <div class="stat-card" style="border-left-color:#67c23a;">
    <h3>候补转化率</h3>
    <div class="value"><%= @conversion_rate %>%</div>
  </div>
  <div class="stat-card" style="border-left-color:#f56c6c;">
    <h3>爽约率</h3>
    <div class="value"><%= @no_show_rate %>%</div>
  </div>
  <div class="stat-card" style="border-left-color:#e6a23c;">
    <h3>今日退款</h3>
    <div class="value">¥<%= @daily_stats[:refund_amount] %></div>
  </div>
</div>

<div class="card">
  <div class="card-header">今日运营数据</div>
  <table>
    <thead>
      <tr>
        <th>指标</th>
        <th>数值</th>
        <th>指标</th>
        <th>数值</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>预约数</td>
        <td><%= @daily_stats[:appointments] %></td>
        <td>已完成</td>
        <td><%= @daily_stats[:completed] %></td>
      </tr>
      <tr>
        <td>爽约数</td>
        <td style="color:#f56c6c;"><%= @daily_stats[:no_shows] %></td>
        <td>候补入队</td>
        <td><%= @daily_stats[:waiting_added] %></td>
      </tr>
      <tr>
        <td>候补转化</td>
        <td style="color:#67c23a;"><%= @daily_stats[:converted] %></td>
        <td>退款笔数</td>
        <td><%= @daily_stats[:refund_count] %>笔 / ¥<%= @daily_stats[:refund_amount] %></td>
      </tr>
    </tbody>
  </table>
</div>

<div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
  <div class="card">
    <div class="card-header">
      快捷功能
    </div>
    <div class="actions" style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
      <%= link_to "候补释放规则管理", waiting_list_rules_path, class: "btn btn-default" %>
      <%= link_to "批量操作", new_admin_batch_operation_path, class: "btn btn-default" %>
      <%= link_to "人员负荷报表", admin_reports_daily_load_path, class: "btn btn-default" %>
      <%= link_to "爽约记录", admin_reports_no_shows_path, class: "btn btn-default" %>
      <%= link_to "明细导出", admin_reports_export_details_path, class: "btn btn-primary" %>
      <%= link_to "Sidekiq监控", "/sidekiq", class: "btn btn-warning" %>
    </div>
  </div>

  <div class="card">
    <div class="card-header">医生今日负荷</div>
    <table>
      <thead>
        <tr>
          <th>医生</th>
          <th>科室</th>
          <th>预约</th>
          <th>负荷率</th>
        </tr>
      </thead>
      <tbody>
        <% @doctors.each do |doctor| %>
          <tr>
            <td><%= doctor.name %></td>
            <td><%= doctor.department %></td>
            <td><%= doctor.daily_appointments_count %>/<%= doctor.daily_max_patients %></td>
            <td>
              <% ratio = doctor.daily_load_ratio %>
              <% if ratio >= 90 %>
                <span class="tag tag-red"><%= ratio %>%</span>
              <% elsif ratio >= 70 %>
                <span class="tag tag-orange"><%= ratio %>%</span>
              <% else %>
                <span class="tag tag-green"><%= ratio %>%</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
