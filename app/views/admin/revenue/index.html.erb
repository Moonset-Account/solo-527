<% content_for :title, "收入分析" %>

<div class="space-y-6">
  <h2 class="text-2xl font-bold">收入分析</h2>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-[#16162a] rounded-lg p-5 border border-gray-800">
      <div class="text-sm text-gray-400">总收入</div>
      <div class="text-2xl font-bold text-[#10B981] mt-1"><%= format_currency(@total_revenue || 0) %></div>
    </div>
    <div class="bg-[#16162a] rounded-lg p-5 border border-gray-800">
      <div class="text-sm text-gray-400">已退款</div>
      <div class="text-2xl font-bold text-red-400 mt-1"><%= format_currency(@refunded_amount || 0) %></div>
    </div>
    <div class="bg-[#16162a] rounded-lg p-5 border border-gray-800">
      <div class="text-sm text-gray-400">净收入</div>
      <div class="text-2xl font-bold text-[#F59E0B] mt-1"><%= format_currency((@total_revenue || 0) - (@refunded_amount || 0)) %></div>
    </div>
    <div class="bg-[#16162a] rounded-lg p-5 border border-gray-800">
      <div class="text-sm text-gray-400">异常金额</div>
      <div class="text-2xl font-bold text-red-500 mt-1"><%= format_currency(@anomaly_amount || 0) %></div>
    </div>
  </div>

  <div class="bg-[#16162a] rounded-lg border border-gray-800">
    <div class="p-5 border-b border-gray-800">
      <h3 class="font-semibold">收入异常 <span class="text-red-400 text-sm font-normal">(<%= @anomalies&.count || 0 %> 条未解决)</span></h3>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="text-left text-xs text-gray-500 uppercase border-b border-gray-800">
            <th class="px-5 py-3">异常类型</th>
            <th class="px-5 py-3">订单号</th>
            <th class="px-5 py-3">金额</th>
            <th class="px-5 py-3">描述</th>
            <th class="px-5 py-3">状态</th>
            <th class="px-5 py-3">检测时间</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-800">
          <% (@anomalies || []).each do |anomaly| %>
            <tr class="hover:bg-gray-800/50 transition-colors <%= 'bg-red-900/10' if anomaly.open? %>">
              <td class="px-5 py-3 text-sm font-medium <%= 'text-red-400' if anomaly.open? %>"><%= anomaly.anomaly_type %></td>
              <td class="px-5 py-3 text-sm"><%= anomaly.order.order_no %></td>
              <td class="px-5 py-3 text-sm text-red-400"><%= format_currency(anomaly.amount) %></td>
              <td class="px-5 py-3 text-sm text-gray-400"><%= anomaly.description&.truncate(40) %></td>
              <td class="px-5 py-3 text-sm"><%= status_badge(anomaly.status) %></td>
              <td class="px-5 py-3 text-sm text-gray-400"><%= anomaly.detected_at&.strftime("%Y-%m-%d %H:%M") %></td>
            </tr>
          <% end %>
          <% if (@anomalies || []).empty? %>
            <tr><td colspan="6" class="px-5 py-12 text-center text-gray-500">暂无异常</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
