<% content_for :title, "到场预警" %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h2 class="text-2xl font-bold">到场预警</h2>
    <%= link_to "← 返回到场管理", admin_attendance_index_path, class: "text-[#6C3CE1] hover:underline text-sm" %>
  </div>

  <div class="bg-[#16162a] rounded-lg border border-gray-800 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="text-left text-xs text-gray-500 uppercase border-b border-gray-800">
            <th class="px-5 py-3">演出</th>
            <th class="px-5 py-3">赛程</th>
            <th class="px-5 py-3">预期人数</th>
            <th class="px-5 py-3">实际人数</th>
            <th class="px-5 py-3">差值</th>
            <th class="px-5 py-3">状态</th>
            <th class="px-5 py-3">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-800">
          <% @attendance_alerts.each do |alert| %>
            <tr class="hover:bg-gray-800/50 transition-colors <%= 'bg-red-900/10' if alert.open? %>">
              <td class="px-5 py-3 text-sm"><%= alert.event.title %></td>
              <td class="px-5 py-3 text-sm text-gray-400"><%= alert.schedule.name %></td>
              <td class="px-5 py-3 text-sm"><%= alert.expected_count %></td>
              <td class="px-5 py-3 text-sm"><%= alert.actual_count %></td>
              <td class="px-5 py-3 text-sm text-red-400 font-medium"><%= alert.gap_count %></td>
              <td class="px-5 py-3 text-sm"><%= status_badge(alert.status) %></td>
              <td class="px-5 py-3 text-sm">
                <% if alert.open? %>
                  <%= button_to "关闭", close_admin_attendance_alert_path(alert), method: :patch, class: "px-3 py-1 bg-gray-700 hover:bg-gray-600 text-white text-xs rounded transition-colors cursor-pointer" %>
                <% end %>
              </td>
            </tr>
          <% end %>
          <% if @attendance_alerts.empty? %>
            <tr><td colspan="7" class="px-5 py-12 text-center text-gray-500">暂无预警</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
