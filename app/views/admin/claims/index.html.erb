<div class="min-h-screen bg-gray-50">
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-6 flex items-center justify-between">
      <h1 class="text-2xl font-bold text-gray-900">工单管理</h1>
    </div>

    <% pending_count = Claim.pending.count %>
    <% if pending_count > 0 %>
      <div class="mb-6 rounded-lg border-l-4 border-yellow-500 bg-yellow-50 p-4">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm font-medium text-yellow-800">
              有 <span class="font-bold"><%= pending_count %></span> 条待处理工单需要及时处理
            </p>
          </div>
        </div>
      </div>
    <% end %>

    <div class="mb-6 rounded-lg bg-white p-4 shadow-sm">
      <%= search_form_for [:admin, @q] do |f| %>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-5">
          <div>
            <%= f.label :claim_no_cont, '工单号', class: 'block text-sm font-medium text-gray-700' %>
            <%= f.text_field :claim_no_cont, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
          </div>
          <div>
            <%= f.label :vehicle_plate_number_cont, '车牌号', class: 'block text-sm font-medium text-gray-700' %>
            <%= f.text_field :vehicle_plate_number_cont, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
          </div>
          <div>
            <%= f.label :status_eq, '状态', class: 'block text-sm font-medium text-gray-700' %>
            <%= f.select :status_eq, Claim.status.options, { include_blank: '全部' }, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
          </div>
          <div>
            <%= f.label :claim_type_eq, '工单类型', class: 'block text-sm font-medium text-gray-700' %>
            <%= f.select :claim_type_eq, Claim.claim_type.options, { include_blank: '全部' }, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
          </div>
          <div class="flex items-end">
            <%= f.submit '筛选', class: 'w-full rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2' %>
          </div>
        </div>
        <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
          <div>
            <%= f.label :created_at_gteq, '开始时间', class: 'block text-sm font-medium text-gray-700' %>
            <%= f.date_field :created_at_gteq, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
          </div>
          <div>
            <%= f.label :created_at_lteq, '结束时间', class: 'block text-sm font-medium text-gray-700' %>
            <%= f.date_field :created_at_lteq, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="mb-4 flex flex-wrap gap-2">
      <%= link_to '全部', admin_claims_path, class: "inline-flex items-center rounded-full px-3 py-1 text-sm font-medium #{params[:q]&.dig(:status_eq).nil? ? 'bg-blue-100 text-blue-800' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}" %>
      <% Claim.status.each do |status| %>
        <% count = Claim.where(status: status.value).count %>
        <%= link_to "#{status.text} (#{count})", admin_claims_path(q: { status_eq: status.value }), class: "inline-flex items-center rounded-full px-3 py-1 text-sm font-medium #{params[:q]&.dig(:status_eq) == status.value ? 'bg-blue-100 text-blue-800' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}" %>
      <% end %>
    </div>

    <div class="overflow-hidden rounded-lg bg-white shadow-sm">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">工单号</th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">车牌号</th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">司机</th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">工单类型</th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">金额</th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">状态</th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">处理人</th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">上报时间</th>
              <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">操作</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
            <% @claims.each do |claim| %>
              <tr class="<%= claim.pending? ? 'bg-yellow-50' : '' %> hover:bg-gray-50">
                <td class="whitespace-nowrap px-6 py-4">
                  <div class="flex items-center">
                    <% if claim.pending? %>
                      <span class="mr-2 inline-flex h-2 w-2 rounded-full bg-yellow-500 animate-pulse"></span>
                    <% end %>
                    <span class="font-mono text-sm font-semibold text-blue-600"><%= claim.claim_no %></span>
                  </div>
                </td>
                <td class="whitespace-nowrap px-6 py-4">
                  <span class="text-sm font-medium text-gray-900"><%= claim.vehicle&.plate_number %></span>
                </td>
                <td class="whitespace-nowrap px-6 py-4">
                  <span class="text-sm text-gray-700"><%= claim.driver&.email %></span>
                </td>
                <td class="whitespace-nowrap px-6 py-4">
                  <span class="text-sm text-gray-700"><%= claim.claim_type&.text %></span>
                </td>
                <td class="whitespace-nowrap px-6 py-4">
                  <span class="text-sm font-semibold text-gray-900">¥<%= number_with_precision(claim.amount, precision: 2) %></span>
                </td>
                <td class="whitespace-nowrap px-6 py-4">
                  <% status_class = case claim.status
                    when 'pending' then 'bg-yellow-100 text-yellow-800'
                    when 'processing' then 'bg-blue-100 text-blue-800'
                    when 'approved' then 'bg-green-100 text-green-800'
                    when 'rejected' then 'bg-red-100 text-red-800'
                    when 'paid' then 'bg-purple-100 text-purple-800'
                    else 'bg-gray-100 text-gray-800'
                    end %>
                  <span class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-medium <%= status_class %>">
                    <%= claim.status.text %>
                  </span>
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                  <%= claim.handler&.email || '<span class="text-yellow-600">待分配</span>'.html_safe %>
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
                  <%= claim.created_at&.strftime('%Y-%m-%d %H:%M') %>
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
                  <div class="flex items-center justify-end space-x-2">
                    <%= link_to '查看', admin_claim_path(claim), class: 'text-blue-600 hover:text-blue-900' %>
                    <% if claim.pending? %>
                      <%= link_to '受理', handle_admin_claim_path(claim), method: :post, class: 'text-green-600 hover:text-green-900' %>
                    <% end %>
                    <% if claim.processing? %>
                      <%= link_to '批准', approve_admin_claim_path(claim), method: :post, class: 'text-purple-600 hover:text-purple-900' %>
                      <%= link_to '拒绝', reject_admin_claim_path(claim), method: :post, class: 'text-red-600 hover:text-red-900' %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @claims.empty? %>
        <div class="py-12 text-center">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          <h3 class="mt-2 text-sm font-medium text-gray-900">暂无工单</h3>
          <p class="mt-1 text-sm text-gray-500">还没有任何赔付工单记录。</p>
        </div>
      <% end %>

      <div class="border-t border-gray-200 px-4 py-3 sm:px-6">
        <div class="flex items-center justify-between">
          <div class="text-sm text-gray-700">
            显示第 <%= @claims.offset_value + 1 %> - <%= [@claims.offset_value + @claims.limit_value, @claims.total_count].min %> 条，共 <%= @claims.total_count %> 条
          </div>
          <div class="flex justify-end">
            <%= paginate @claims, theme: 'tailwind' %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
