<%= form_with model: [:admin, @vehicle], local: true do |form| %>
  <% if @vehicle.errors.any? %>
    <div class="mb-6 rounded-md bg-red-50 p-4">
      <div class="flex">
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">表单存在 <%= @vehicle.errors.count %> 个错误：</h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc space-y-1 pl-5">
              <% @vehicle.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="space-y-6">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      <div>
        <%= form.label :plate_number, '车牌号', class: 'block text-sm font-medium text-gray-700' %>
        <%= form.text_field :plate_number, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', placeholder: '请输入车牌号' %>
      </div>

      <div>
        <%= form.label :vehicle_type, '车型', class: 'block text-sm font-medium text-gray-700' %>
        <%= form.select :vehicle_type, Vehicle.vehicle_type.options, { include_blank: '请选择车型' }, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
      </div>

      <div>
        <%= form.label :model, '型号', class: 'block text-sm font-medium text-gray-700' %>
        <%= form.text_field :model, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', placeholder: '请输入车辆型号' %>
      </div>

      <div>
        <%= form.label :load_capacity, '载重 (吨)', class: 'block text-sm font-medium text-gray-700' %>
        <%= form.number_field :load_capacity, step: '0.1', min: '0', class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', placeholder: '请输入载重' %>
      </div>

      <div>
        <%= form.label :min_temperature, '最低温度 (°C)', class: 'block text-sm font-medium text-gray-700' %>
        <%= form.number_field :min_temperature, step: '0.1', class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', placeholder: '请输入最低温度' %>
      </div>

      <div>
        <%= form.label :max_temperature, '最高温度 (°C)', class: 'block text-sm font-medium text-gray-700' %>
        <%= form.number_field :max_temperature, step: '0.1', class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', placeholder: '请输入最高温度' %>
      </div>

      <div>
        <%= form.label :status, '状态', class: 'block text-sm font-medium text-gray-700' %>
        <%= form.select :status, Vehicle.status.options, { include_blank: '请选择状态' }, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
      </div>

      <div>
        <%= form.label :current_driver_id, '当前司机', class: 'block text-sm font-medium text-gray-700' %>
        <%= form.select :current_driver_id, User.driver.active.map { |u| [u.name || u.email, u.id] }, { include_blank: '请选择司机' }, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
      </div>
    </div>

    <div class="flex justify-end space-x-3 pt-4 border-t border-gray-200">
      <%= link_to '取消', admin_vehicles_path, class: 'inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2' %>
      <%= form.submit @vehicle.new_record? ? '创建车辆' : '更新车辆', class: 'inline-flex items-center rounded-md border border-transparent bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2' %>
    </div>
  </div>
<% end %>
