<div class="min-h-screen bg-gray-50">
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-6 flex items-center justify-between">
      <h1 class="text-2xl font-bold text-gray-900">车辆管理</h1>
      <%= link_to '新建车辆', new_admin_vehicle_path, class: 'inline-flex items-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2' %>
    </div>

    <div class="mb-6 rounded-lg bg-white p-4 shadow-sm">
      <%= search_form_for [:admin, @q] do |f| %>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-5">
          <div>
            <%= f.label :plate_number_cont, '车牌号', class: 'block text-sm font-medium text-gray-700' %>
            <%= f.text_field :plate_number_cont, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', placeholder: '请输入车牌号' %>
          </div>
          <div>
            <%= f.label :vehicle_type_eq, '车型', class: 'block text-sm font-medium text-gray-700' %>
            <%= f.select :vehicle_type_eq, Vehicle.vehicle_type.options, { include_blank: '全部' }, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
          </div>
          <div>
            <%= f.label :status_eq, '状态', class: 'block text-sm font-medium text-gray-700' %>
            <%= f.select :status_eq, Vehicle.status.options, { include_blank: '全部' }, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
          </div>
          <div>
            <%= f.label :current_driver_name_or_email_cont, '司机', class: 'block text-sm font-medium text-gray-700' %>
            <%= f.text_field :current_driver_name_or_email_cont, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm', placeholder: '请输入司机姓名或邮箱' %>
          </div>
          <div class="flex items-end">
            <%= f.submit '筛选', class: 'w-full rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2' %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="overflow-hidden rounded-lg bg-white shadow-sm">
      <div class="border-b border-gray-200 bg-gray-50 px-6 py-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-2">
            <input type="checkbox" id="select-all" class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500">
            <label for="select-all" class="text-sm text-gray-600">全选</label>
          </div>
          <div class="flex items-center space-x-2">
            <button type="button" class="rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50">
              批量启用
            </button>
            <button type="button" class="rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50">
              批量停用
            </button>
          </div>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="w-12 px-6 py-3"></th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">车牌号</th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">车型</th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">载重</th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">温度范围</th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">当前司机</th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">状态</th>
              <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">操作</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
            <% @vehicles.each do |vehicle| %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4">
                  <input type="checkbox" class="vehicle-checkbox h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500" value="<%= vehicle.id %>">
                </td>
                <td class="whitespace-nowrap px-6 py-4">
                  <div class="flex items-center">
                    <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-gray-100">
                      <svg class="h-5 w-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"></path>
                      </svg>
                    </div>
                    <div class="ml-3">
                      <p class="text-sm font-medium text-gray-900"><%= vehicle.plate_number %></p>
                      <p class="text-xs text-gray-500"><%= vehicle.model || '未设置型号' %></p>
                    </div>
                  </div>
                </td>
                <td class="whitespace-nowrap px-6 py-4">
                  <% vehicle_type_class = case vehicle.vehicle_type
                    when 'refrigerated' then 'bg-blue-100 text-blue-800'
                    when 'freezer' then 'bg-cyan-100 text-cyan-800'
                    else 'bg-gray-100 text-gray-800'
                    end %>
                  <span class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-medium <%= vehicle_type_class %>">
                    <%= vehicle.vehicle_type.text %>
                  </span>
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-700">
                  <%= vehicle.load_capacity ? "#{vehicle.load_capacity} 吨" : '-' %>
                </td>
                <td class="whitespace-nowrap px-6 py-4">
                  <% if vehicle.min_temperature && vehicle.max_temperature %>
                    <span class="text-sm text-gray-700">
                      <%= vehicle.min_temperature %>°C ~ <%= vehicle.max_temperature %>°C
                    </span>
                  <% else %>
                    <span class="text-sm text-gray-400">-</span>
                  <% end %>
                </td>
                <td class="whitespace-nowrap px-6 py-4">
                  <% if vehicle.current_driver %>
                    <div class="flex items-center">
                      <div class="h-8 w-8 rounded-full bg-gray-200 flex items-center justify-center">
                        <span class="text-xs font-medium text-gray-600"><%= vehicle.current_driver.name.present? ? vehicle.current_driver.name.first.upcase : vehicle.current_driver.email.first.upcase %></span>
                      </div>
                      <span class="ml-2 text-sm text-gray-700"><%= vehicle.current_driver.name || vehicle.current_driver.email %></span>
                    </div>
                  <% else %>
                    <span class="text-sm text-gray-400">未分配</span>
                  <% end %>
                </td>
                <td class="whitespace-nowrap px-6 py-4">
                  <% status_class = case vehicle.status
                    when 'active' then 'bg-green-100 text-green-800'
                    when 'maintenance' then 'bg-yellow-100 text-yellow-800'
                    when 'inactive' then 'bg-gray-100 text-gray-800'
                    else 'bg-gray-100 text-gray-800'
                    end %>
                  <span class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-medium <%= status_class %>">
                    <%= vehicle.status.text %>
                  </span>
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
                  <div class="flex items-center justify-end space-x-2">
                    <%= link_to '查看', vehicle_path(vehicle), class: 'text-blue-600 hover:text-blue-900' %>
                    <%= link_to '编辑', edit_admin_vehicle_path(vehicle), class: 'text-blue-600 hover:text-blue-900' %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @vehicles.empty? %>
        <div class="py-12 text-center">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"></path>
          </svg>
          <h3 class="mt-2 text-sm font-medium text-gray-900">暂无车辆</h3>
          <p class="mt-1 text-sm text-gray-500">还没有任何车辆记录。</p>
        </div>
      <% end %>

      <div class="border-t border-gray-200 px-4 py-3 sm:px-6">
        <div class="flex items-center justify-between">
          <div class="text-sm text-gray-700">
            显示第 <%= @vehicles.offset_value + 1 %> - <%= [@vehicles.offset_value + @vehicles.limit_value, @vehicles.total_count].min %> 条，共 <%= @vehicles.total_count %> 条
          </div>
          <div class="flex justify-end">
            <%= paginate @vehicles, theme: 'tailwind' %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
