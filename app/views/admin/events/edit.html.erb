<% content_for :page_title, "编辑赛事" %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">编辑赛事</h1>
      <p class="text-gray-500 mt-1"><%= @event.name %></p>
    </div>
    <%= link_to "返回详情", admin_event_path(@event), class: "text-gray-600 hover:text-gray-900" %>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <%= form_with model: [:admin, @event], local: true, class: "space-y-0" do |f| %>
      <% if @event.errors.any? %>
        <div class="px-6 py-4 bg-red-50 border-b border-red-200">
          <h3 class="text-sm font-medium text-red-800"><%= pluralize(@event.errors.count, "个错误") %> 导致无法保存：</h3>
          <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
            <% @event.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="px-6 py-6 space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <%= f.label :name, "赛事名称", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :name, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
          </div>

          <div>
            <%= f.label :event_type, "赛事类型", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_field :event_type, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
          </div>

          <div>
            <%= f.label :venue_id, "比赛场地", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.collection_select :venue_id, Venue.all, :id, :name, { include_blank: "请选择场地" }, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
          </div>

          <div>
            <%= f.label :status, "状态", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.select :status, Event.statuses.keys.map { |s| [status_text(s), s] }, {}, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
          </div>

          <div>
            <%= f.label :start_date, "开始日期", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.datetime_local_field :start_date, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
          </div>

          <div>
            <%= f.label :end_date, "结束日期", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.datetime_local_field :end_date, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
          </div>

          <div>
            <%= f.label :registration_start, "报名开始时间", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.datetime_local_field :registration_start, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
          </div>

          <div>
            <%= f.label :registration_end, "报名截止时间", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.datetime_local_field :registration_end, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
          </div>

          <div>
            <%= f.label :max_participants, "最大参赛人数", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.number_field :max_participants, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
          </div>

          <div>
            <%= f.label :registration_fee, "报名费用", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.number_field :registration_fee, step: 0.01, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
          </div>
        </div>

        <div>
          <%= f.label :description, "赛事描述", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_area :description, rows: 4, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div>
          <%= f.label :rules, "赛事规则", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_area :rules, rows: 4, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div>
          <%= f.label :prizes, "奖品设置", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_area :prizes, rows: 4, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>
      </div>

      <div class="px-6 py-4 border-t border-gray-200 bg-gray-50 flex items-center justify-end space-x-3">
        <%= link_to "取消", admin_event_path(@event), class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50" %>
        <%= f.submit "保存修改", class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
      </div>
    <% end %>
  </div>
</div>
