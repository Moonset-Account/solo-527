<div class="page-header">
  <h1>班组详情</h1>
  <div class="page-actions">
    <%= link_to "编辑", edit_admin_team_path(@team), class: "btn btn-primary btn-sm" %>
    <%= link_to "删除", admin_team_path(@team), class: "btn btn-danger btn-sm", data: { turbo_method: :delete, turbo_confirm: "确定要删除此班组吗？" } %>
    <%= link_to "返回列表", admin_teams_path, class: "btn btn-outline btn-sm" %>
  </div>
</div>

<div class="card">
  <div class="detail-grid">
    <div class="detail-item">
      <span class="detail-label">班组编号</span>
      <span class="detail-value"><%= @team.code %></span>
    </div>
    <div class="detail-item">
      <span class="detail-label">班组名称</span>
      <span class="detail-value"><%= @team.name %></span>
    </div>
    <div class="detail-item">
      <span class="detail-label">班组长</span>
      <span class="detail-value"><%= @team.leader_name %></span>
    </div>
    <div class="detail-item">
      <span class="detail-label">成员人数</span>
      <span class="detail-value"><%= @team.member_count %> 人</span>
    </div>
    <div class="detail-item">
      <span class="detail-label">班次</span>
      <span class="detail-value">
        <% shift_class = case @team.shift
                        when "morning" then "badge-success"
                        when "afternoon" then "badge-warning"
                        when "night" then "badge-primary"
                        else "badge-secondary"
                        end %>
        <span class="badge <%= shift_class %>"><%= Team.human_attribute_name("shift.#{@team.shift}") %></span>
      </span>
    </div>
    <div class="detail-item">
      <span class="detail-label">创建时间</span>
      <span class="detail-value"><%= @team.created_at&.strftime("%Y-%m-%d %H:%M:%S") %></span>
    </div>
    <div class="detail-item">
      <span class="detail-label">更新时间</span>
      <span class="detail-value"><%= @team.updated_at&.strftime("%Y-%m-%d %H:%M:%S") %></span>
    </div>
  </div>
</div>
