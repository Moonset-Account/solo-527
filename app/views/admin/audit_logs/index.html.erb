<% content_for :page_title, "审计日志" %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">审计日志</h1>
    <p class="text-sm text-gray-500">数据溯源：查看所有操作记录和数据变更历史</p>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4">
    <%= form_tag admin_audit_logs_path, method: :get, class: "flex items-end space-x-4" do %>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">操作类型</label>
        <%= select_tag :event, options_for_select([["全部操作", ""], ["创建", "create"], ["更新", "update"], ["删除", "destroy"]], params[:event]),
                       class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">数据类型</label>
        <%= select_tag :item_type, options_for_select([["全部类型", ""], ["课程", "Course"], ["课程报名", "CourseEnrollment"], ["赛事", "Event"], ["赛事报名", "EventRegistration"], ["签到", "CheckIn"], ["支付", "Payment"], ["场地预约", "VenueBooking"], ["用户", "User"]], params[:item_type]),
                       class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">操作人</label>
        <%= text_field_tag :whodunnit, params[:whodunnit], placeholder: "用户ID或名称",
                           class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">起始日期</label>
        <%= date_field_tag :start_date, params[:start_date],
                           class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">结束日期</label>
        <%= date_field_tag :end_date, params[:end_date],
                           class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      <div class="flex space-x-2">
        <%= submit_tag "筛选", class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
        <%= link_to "重置", admin_audit_logs_path, class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50" %>
      </div>
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="text-lg font-medium text-gray-900">操作记录</h3>
    </div>

    <div class="divide-y divide-gray-200">
      <% @versions.each do |version| %>
        <div class="px-6 py-4 hover:bg-gray-50">
          <div class="flex items-start justify-between">
            <div class="flex items-start">
              <div class="w-10 h-10 rounded-full flex items-center justify-center mr-4 
                          <%= case version.event
                              when 'create' then 'bg-green-100'
                              when 'update' then 'bg-blue-100'
                              when 'destroy' then 'bg-red-100'
                              else 'bg-gray-100'
                              end %>">
                <svg class="w-5 h-5 
                           <%= case version.event
                               when 'create' then 'text-green-600'
                               when 'update' then 'text-blue-600'
                               when 'destroy' then 'text-red-600'
                               else 'text-gray-600'
                               end %>" 
                     fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <% if version.event == 'create' %>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                  <% elsif version.event == 'update' %>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                  <% else %>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                  <% end %>
                </svg>
              </div>
              <div>
                <div class="flex items-center space-x-2">
                  <span class="font-medium text-gray-900">
                    <%= case version.event
                        when 'create' then '创建'
                        when 'update' then '更新'
                        when 'destroy' then '删除'
                        else version.event
                        end %>
                  </span>
                  <span class="text-gray-500"><%= version.item_type %></span>
                  <span class="text-gray-400">#<%= version.item_id %></span>
                </div>
                <p class="text-sm text-gray-500 mt-1">
                  操作人: <%= version.whodunnit ? User.find_by(id: version.whodunnit)&.name || "用户##{version.whodunnit}" : "系统" %>
                </p>

                <% if version.object_changes.present? %>
                  <% changes = YAML.safe_load(version.object_changes) rescue {} %>
                  <% if changes.any? %>
                    <details class="mt-2">
                      <summary class="text-sm text-blue-600 cursor-pointer hover:text-blue-700">
                        查看变更详情 (<%= changes.reject { |k, _| %w[updated_at created_at].include?(k) }.size %> 处变更)
                      </summary>
                      <div class="mt-2 p-3 bg-gray-50 rounded-lg">
                        <div class="space-y-1 text-sm">
                          <% changes.each do |field, values| %>
                            <% next if %w[updated_at created_at].include?(field) %>
                            <% old_val, new_val = values %>
                            <div class="flex items-start">
                              <span class="text-gray-600 w-28 flex-shrink-0"><%= field.humanize %>:</span>
                              <div class="flex-1">
                                <span class="text-red-600 line-through"><%= old_val.inspect %></span>
                                <span class="text-gray-400 mx-2">→</span>
                                <span class="text-green-600"><%= new_val.inspect %></span>
                              </div>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    </details>
                  <% end %>
                <% end %>
              </div>
            </div>
            <span class="text-sm text-gray-400">
              <%= time_ago_in_words(version.created_at) %>前
            </span>
          </div>
        </div>
      <% end %>
    </div>

    <% if @versions.empty? %>
      <div class="px-6 py-12 text-center text-gray-500">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
        </svg>
        <p class="mt-2">暂无审计记录</p>
      </div>
    <% end %>

    <div class="px-6 py-4 border-t border-gray-200">
      <%= paginate @versions %>
    </div>
  </div>
</div>
