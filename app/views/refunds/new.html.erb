<% content_for :title, "申请退票" %>

<div class="space-y-6">
  <%= link_to "← 返回退票列表", refunds_path, class: "text-[#6C3CE1] hover:underline text-sm" %>

  <div class="max-w-lg">
    <div class="bg-[#16162a] rounded-lg border border-gray-800 p-6">
      <h2 class="text-xl font-bold mb-6">申请退票</h2>

      <%= form_with model: @refund, url: refunds_path, method: :post, class: "space-y-5" do |f| %>
        <%= f.hidden_field :order_id, value: params[:order_id] %>

        <div>
          <%= f.label :order_id, "关联订单", class: "block text-sm text-gray-400 mb-1.5" %>
          <%= f.select :order_id, options_from_collection_for_select(current_user.orders.paid, :id, :order_no, params[:order_id]), {}, class: "w-full px-4 py-2.5 bg-[#1E1E2E] border border-gray-700 rounded-lg text-gray-100 focus:outline-none focus:ring-2 focus:ring-[#6C3CE1]" %>
        </div>

        <div>
          <%= f.label :amount, "退款金额", class: "block text-sm text-gray-400 mb-1.5" %>
          <%= f.number_field :amount, step: 0.01, min: 0.01, class: "w-full px-4 py-2.5 bg-[#1E1E2E] border border-gray-700 rounded-lg text-gray-100 focus:outline-none focus:ring-2 focus:ring-[#6C3CE1]" %>
        </div>

        <div>
          <%= f.label :reason, "退票原因", class: "block text-sm text-gray-400 mb-1.5" %>
          <%= f.text_area :reason, rows: 4, placeholder: "请说明退票原因...", class: "w-full px-4 py-2.5 bg-[#1E1E2E] border border-gray-700 rounded-lg text-gray-100 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#6C3CE1]" %>
        </div>

        <div class="flex gap-3">
          <%= f.submit "提交申请", class: "px-6 py-2.5 bg-[#6C3CE1] hover:bg-[#5B2FD0] text-white font-medium rounded-lg transition-all duration-200 cursor-pointer" %>
          <%= link_to "取消", refunds_path, class: "px-6 py-2.5 bg-gray-700 hover:bg-gray-600 text-gray-200 rounded-lg transition-colors" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
