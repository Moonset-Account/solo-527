<div class="auth-links">
  <%- if controller_name != 'sessions' %>
    <%= link_to "已有账号？立即登录", new_session_path(resource_name), class: "auth-link" %>
  <% end -%>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <%= link_to "没有账号？立即注册", new_registration_path(resource_name), class: "auth-link" %>
  <% end -%>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <%= link_to "忘记密码？", new_password_path(resource_name), class: "auth-link" %>
  <% end -%>
</div>
