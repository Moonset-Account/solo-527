<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
  <div class="bg-white rounded-2xl shadow-xl border border-gray-200 overflow-hidden">
    <div class="px-8 py-10 bg-gradient-to-r from-indigo-500 to-purple-600">
      <div class="flex items-center justify-center mb-4">
        <div class="w-16 h-16 rounded-2xl bg-white/20 backdrop-blur flex items-center justify-center">
          <span class="text-3xl text-white font-bold">闭</span>
        </div>
      </div>
      <h2 class="text-center text-2xl font-bold text-white">事项闭环台</h2>
      <p class="text-center text-indigo-100 mt-1">重置密码</p>
    </div>

    <div class="px-8 py-8 space-y-6">
      <h3 class="text-xl font-semibold text-gray-900 text-center">找回密码</h3>

      <% if resource.errors.any? %>
        <div class="p-4 rounded-lg bg-red-50 border border-red-200">
          <ul class="text-sm text-red-600 list-disc list-inside space-y-1">
            <% resource.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :email, "注册邮箱", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.email_field :email, required: true, autofocus: true, autocomplete: "email", class: "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-shadow", placeholder: "请输入注册邮箱" %>
      </div>

      <div>
        <%= f.submit "发送重置邮件", class: "w-full px-6 py-3 bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl transition-all" %>
      </div>

      <div class="text-center text-sm">
        <%= link_to "返回登录", new_session_path(resource_name), class: "text-indigo-600 hover:text-indigo-700 font-medium" %>
      </div>
    </div>
  </div>
<% end %>
