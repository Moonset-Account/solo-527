<div class="container mx-auto px-4 py-6">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-800">工单排期</h1>
    <div class="flex space-x-4">
      <%= link_to "日视图", schedules_path(view: 'day', date: @date), class: "px-4 py-2 rounded #{@view_mode == 'day' ? 'bg-blue-600 text-white' : 'bg-gray-200 text-gray-700'}" %>
      <%= link_to "周视图", schedules_path(view: 'week', date: @date), class: "px-4 py-2 rounded #{@view_mode == 'week' ? 'bg-blue-600 text-white' : 'bg-gray-200 text-gray-700'}" %>
      <%= link_to "月视图", schedules_path(view: 'month', date: @date), class: "px-4 py-2 rounded #{@view_mode == 'month' ? 'bg-blue-600 text-white' : 'bg-gray-200 text-gray-700'}" %>
      <%= link_to "甘特图", gantt_schedules_path(start_date: @start_date, end_date: @end_date), class: "px-4 py-2 rounded bg-purple-600 text-white" %>
    </div>
  </div>

  <div class="flex justify-between items-center mb-6 bg-white p-4 rounded-lg shadow">
    <div class="flex items-center space-x-4">
      <%= link_to "←", schedules_path(view: @view_mode, date: @date - 1.send(@view_mode == 'day' ? 'day' : @view_mode == 'week' ? 'week' : 'month')), class: "p-2 bg-gray-200 rounded" %>
      <span class="text-xl font-semibold">
        <% if @view_mode == 'day' %>
          <%= @date.strftime('%Y年%m月%d日 %A') %>
        <% elsif @view_mode == 'week' %>
          <%= @start_date.strftime('%Y年%m月%d日') %> - <%= @end_date.strftime('%m月%d日') %>
        <% else %>
          <%= @date.strftime('%Y年%m月') %>
        <% end %>
      </span>
      <%= link_to "→", schedules_path(view: @view_mode, date: @date + 1.send(@view_mode == 'day' ? 'day' : @view_mode == 'week' ? 'week' : 'month')), class: "p-2 bg-gray-200 rounded" %>
    </div>
    <%= link_to "今天", schedules_path(view: @view_mode), class: "px-4 py-2 bg-blue-100 text-blue-700 rounded" %>
  </div>

  <%= search_form_for @q, url: schedules_path, method: :get, class: 'mb-6' do |f| %>
    <div class="flex space-x-4">
      <%= f.search_field :order_no_or_product_name_cont, placeholder: '搜索工单号或产品名称', class: 'flex-1 px-4 py-2 border rounded-lg' %>
      <%= f.select :status_eq, WorkOrder.statuses.map { |k, v| [WorkOrder.human_attribute_name("status.#{k}"), v] }, { include_blank: '全部状态' }, class: 'px-4 py-2 border rounded-lg' %>
      <%= f.select :priority_eq, WorkOrder.priorities.map { |k, v| [WorkOrder.human_attribute_name("priority.#{k}"), v] }, { include_blank: '全部优先级' }, class: 'px-4 py-2 border rounded-lg' %>
      <%= f.submit '搜索', class: 'px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700' %>
    </div>
    <%= hidden_field_tag :view, @view_mode %>
    <%= hidden_field_tag :date, @date %>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
    <div class="lg:col-span-3">
      <%= turbo_frame_tag "schedule_work_orders" do %>
        <div class="bg-white rounded-lg shadow overflow-hidden">
          <div class="bg-gray-50 px-6 py-3 border-b">
            <h2 class="font-semibold text-gray-700">工单列表 (<%= @work_orders.count %>)</h2>
          </div>
          <div class="divide-y">
            <% @work_orders.each do |work_order| %>
              <%= turbo_frame_tag dom_id(work_order) do %>
                <%= render 'work_orders/work_order_card', work_order: work_order %>
              <% end %>
            <% end %>
            <% if @work_orders.empty? %>
              <div class="p-8 text-center text-gray-500">
                暂无排期工单
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="space-y-6">
      <div class="bg-white rounded-lg shadow p-4">
        <h3 class="font-semibold text-gray-700 mb-3">班组负载</h3>
        <div class="space-y-3">
          <% @teams.each do |team| %>
            <% active_steps = team.process_steps.in_progress_or_paused.count %>
            <% today_steps = team.process_steps.today_active.count %>
            <div class="flex items-center justify-between p-2 hover:bg-gray-50 rounded">
              <div>
                <%= link_to by_team_schedules_path(id: team.id, date: @date), class: 'font-medium' do %>
                  <%= team.name %>
                <% end %>
                <div class="text-sm text-gray-500"><%= team.shift_name %> <%= team.shift_hours %></div>
              </div>
              <div class="text-right">
                <div class="text-sm font-medium <%= active_steps > 0 ? 'text-blue-600' : 'text-gray-400' %>">
                  <%= active_steps %> 进行中
                </div>
                <div class="text-xs text-gray-400">今日 <%= today_steps %> 个工序</div>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow p-4">
        <h3 class="font-semibold text-gray-700 mb-3">设备状态</h3>
        <div class="space-y-2">
          <% @equipment.each do |eq| %>
            <% current_step = eq.current_process_step %>
            <div class="flex items-center justify-between p-2 hover:bg-gray-50 rounded">
              <div>
                <%= link_to by_equipment_schedules_path(id: eq.id, date: @date), class: 'font-medium' do %>
                  <%= eq.code %> <%= eq.name %>
                <% end %>
              </div>
              <span class="px-2 py-1 text-xs rounded-full <%= eq.status_color %>">
                <%= eq.status_name %>
              </span>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
