<%= content_for(:title, @review_conclusion.persisted? ? "编辑复盘结论" : "新建复盘结论") %>

<div class="mb-6">
  <div class="flex items-center space-x-4">
    <%= link_to ticket_path(@ticket), class: "p-2 text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-lg transition-colors" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
    <% end %>
    <div>
      <h1 class="text-2xl font-bold text-gray-900"><%= @review_conclusion.persisted? ? "编辑复盘结论" : "新建复盘结论" %></h1>
      <p class="mt-1 text-gray-500">关联需求: <%= @ticket.title %></p>
    </div>
  </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-200 max-w-4xl">
  <%= form_with(model: [@ticket, @review_conclusion], url: @review_conclusion.persisted? ? review_conclusion_path(@review_conclusion) : nil, class: "divide-y divide-gray-200") do |f| %>
    <% if @review_conclusion.errors.any? %>
      <div class="p-4 bg-red-50 border-b border-red-200">
        <ul class="text-sm text-red-600 list-disc list-inside">
          <% @review_conclusion.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="p-6 space-y-6">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <div>
          <%= f.label :efficiency_before, "改进前协作效率 (%)", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.number_field :efficiency_before, min: 0, max: 100, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
          <input type="range" min="0" max="100" class="w-full mt-2" oninput="this.previousElementSibling.value=this.value" value="<%= @review_conclusion.efficiency_before || 50 %>">
        </div>
        <div>
          <%= f.label :efficiency_after, "改进后协作效率 (%)", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.number_field :efficiency_after, min: 0, max: 100, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
          <input type="range" min="0" max="100" class="w-full mt-2" oninput="this.previousElementSibling.value=this.value" value="<%= @review_conclusion.efficiency_after || 50 %>">
        </div>
      </div>

      <div>
        <%= f.label :content, "复盘结论", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_area :content, rows: 4, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500", placeholder: "请描述复盘结论..." %>
      </div>

      <div>
        <%= f.label :root_cause, "根本原因分析", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_area :root_cause, rows: 4, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500", placeholder: "分析问题产生的根本原因..." %>
      </div>

      <div>
        <%= f.label :improvement, "改进措施", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_area :improvement, rows: 4, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500", placeholder: "描述具体的改进措施和行动项..." %>
      </div>

      <div>
        <%= f.label :result, "最终结果", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_area :result, rows: 4, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500", placeholder: "总结改进后的最终结果..." %>
      </div>

      <div>
        <%= f.label :reviewed_at, "审核时间", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.datetime_field :reviewed_at, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>
    </div>

    <div class="px-6 py-4 bg-gray-50 rounded-b-xl flex items-center justify-end space-x-3">
      <%= link_to "取消", ticket_path(@ticket), class: "px-6 py-2.5 border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 transition-colors" %>
      <%= f.submit class: "px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg shadow-sm transition-colors" %>
    </div>
  <% end %>
</div>
