<% content_for :title, "演出大厅" %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h2 class="text-2xl font-bold">演出大厅</h2>
    <%= form_with url: events_path, method: :get, class: "flex gap-2", data: { turbo_frame: "events_list" } do |f| %>
      <%= f.text_field :q, value: params[:q], placeholder: "搜索演出...", class: "px-4 py-2 bg-[#16162a] border border-gray-700 rounded-lg text-sm text-gray-100 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-[#6C3CE1]" %>
      <%= f.submit "搜索", class: "px-4 py-2 bg-[#6C3CE1] hover:bg-[#5B2FD0] text-white text-sm rounded-lg transition-colors cursor-pointer" %>
    <% end %>
  </div>

  <%= turbo_frame_tag "events_list" do %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @events.each do |event| %>
        <%= link_to event_path(event), class: "block bg-[#16162a] rounded-lg border border-gray-800 overflow-hidden hover:shadow-lg hover:shadow-[#6C3CE1]/10 hover:-translate-y-1 transition-all duration-200" do %>
          <div class="p-6">
            <div class="flex items-center justify-between mb-3">
              <%= status_badge(event.status) %>
              <span class="text-xs text-gray-500"><%= event.starts_at&.strftime("%Y-%m-%d") %></span>
            </div>
            <h3 class="text-lg font-semibold mb-2"><%= event.title %></h3>
            <p class="text-sm text-gray-400 line-clamp-2"><%= event.description&.truncate(100) %></p>
            <div class="mt-4 flex items-center text-sm text-gray-500">
              <span>📍 <%= event.venue || "待定" %></span>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <% if @events.empty? %>
      <div class="text-center py-16">
        <p class="text-gray-500 text-lg">暂无演出</p>
      </div>
    <% end %>
  <% end %>
</div>
