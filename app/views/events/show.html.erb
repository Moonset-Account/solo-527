<% content_for :page_title, @event.name %>

<div class="space-y-6">
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="h-64 bg-gradient-to-r from-orange-500 to-red-500 flex items-center justify-center relative">
      <svg class="w-32 h-32 text-white/20" fill="currentColor" viewBox="0 0 24 24">
        <path d="M13 10V3L4 14h7v7l9-11h-7z"/>
      </svg>
      <div class="absolute top-4 left-4 flex space-x-2">
        <span class="px-3 py-1 bg-white/20 backdrop-blur-sm text-white text-sm rounded-full">
          <%= @event.event_type %>
        </span>
        <span class="px-3 py-1 bg-white/20 backdrop-blur-sm text-white text-sm rounded-full">
          <%= status_text(@event.status) %>
        </span>
      </div>
    </div>

    <div class="p-8">
      <div class="flex items-start justify-between mb-6">
        <div>
          <h1 class="text-3xl font-bold text-gray-900"><%= @event.name %></h1>
          <p class="text-gray-500 mt-2"><%= @event.description %></p>
        </div>
        <div class="text-right">
          <p class="text-3xl font-bold text-orange-600">¥<%= "%.2f" % @event.price %></p>
          <p class="text-sm text-gray-500">参赛费用</p>
        </div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">比赛日期</p>
          <p class="font-semibold text-gray-900 mt-1"><%= @event.event_date&.strftime("%Y-%m-%d") || "待定" %></p>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">比赛地点</p>
          <p class="font-semibold text-gray-900 mt-1"><%= @event.location || "待定" %></p>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">最大参赛人数</p>
          <p class="font-semibold text-gray-900 mt-1"><%= @event.max_participants %> 人</p>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">已报名</p>
          <p class="font-semibold text-blue-600 mt-1"><%= @event.registered_count %> 人</p>
        </div>
      </div>

      <div class="mb-8">
        <h3 class="text-lg font-medium text-gray-900 mb-4">报名时间</h3>
        <div class="flex items-center space-x-4">
          <div class="flex-1">
            <div class="flex items-center justify-between text-sm text-gray-600 mb-2">
              <span>报名开始</span>
              <span><%= @event.registration_start&.strftime("%Y-%m-%d %H:%M") || "待定" %></span>
            </div>
          </div>
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
          <div class="flex-1">
            <div class="flex items-center justify-between text-sm text-gray-600 mb-2">
              <span>报名截止</span>
              <span><%= @event.registration_end&.strftime("%Y-%m-%d %H:%M") || "待定" %></span>
            </div>
          </div>
        </div>
      </div>

      <div class="flex space-x-4">
        <% if @event.registration_open? && @event.has_available_spots? && !current_user.events.exists?(@event.id) %>
          <%= button_to "立即报名", register_event_path(@event), method: :post, 
                        class: "px-8 py-3 bg-orange-600 text-white rounded-lg hover:bg-orange-700 font-medium",
                        data: { confirm: "确认报名《#{@event.name}》？费用 ¥#{@event.price}" } %>
        <% elsif current_user.events.exists?(@event.id) %>
          <div class="px-8 py-3 bg-green-100 text-green-700 rounded-lg font-medium">
            ✓ 您已报名此赛事
          </div>
        <% elsif !@event.registration_open? %>
          <div class="px-8 py-3 bg-gray-100 text-gray-500 rounded-lg font-medium">
            报名未开始或已结束
          </div>
        <% else %>
          <div class="px-8 py-3 bg-gray-100 text-gray-500 rounded-lg font-medium">
            参赛名额已满
          </div>
        <% end %>
        <%= link_to "返回列表", events_path, class: "px-8 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 font-medium" %>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="text-lg font-medium text-gray-900">我的报名记录</h3>
    </div>
    <div class="divide-y divide-gray-200">
      <% if @my_registration.present? %>
        <div class="px-6 py-4">
          <div class="flex items-center justify-between">
            <div>
              <p class="font-medium text-gray-900">报名时间: <%= @my_registration.created_at.strftime("%Y-%m-%d %H:%M") %></p>
              <p class="text-sm text-gray-500">
                来源: <%= source_text(@my_registration.source) %>
                <% if @my_registration.category.present? %> | 组别: <%= @my_registration.category %><% end %>
              </p>
            </div>
            <div class="flex items-center space-x-4">
              <span class="px-3 py-1 text-sm rounded-full <%= status_class(@my_registration.status) %>">
                <%= status_text(@my_registration.status) %>
              </span>
              <span class="px-3 py-1 text-sm rounded-full <%= status_class(@my_registration.payment_status) %>">
                支付: <%= status_text(@my_registration.payment_status) %>
              </span>
            </div>
          </div>

          <% if @my_registration.payment.present? %>
            <div class="mt-3 p-3 bg-gray-50 rounded-lg">
              <p class="text-sm font-medium text-gray-700">支付信息</p>
              <p class="text-sm text-gray-600 mt-1">
                支付金额: ¥<%= "%.2f" % @my_registration.payment.amount %>
              </p>
              <% if @my_registration.payment.failed? && @my_registration.payment.failure_reason.present? %>
                <p class="text-sm text-red-600 mt-1">
                  失败原因: <%= @my_registration.payment.failure_reason %>
                </p>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="px-6 py-8 text-center text-gray-500">
          您尚未报名此赛事
        </div>
      <% end %>
    </div>
  </div>

  <% if @my_registration.present? %>
    <%= render "shared/version_history", versions: @my_registration.versions.order(created_at: :desc) %>
  <% end %>

  <%= link_to "← 返回赛事列表", events_path, class: "text-gray-600 hover:text-gray-900" %>
</div>
