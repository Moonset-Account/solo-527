<% content_for :page_title, "预约场地" %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">预约场地</h1>
    <%= link_to "返回", venue_bookings_path, class: "text-gray-600 hover:text-gray-900" %>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="text-lg font-medium text-gray-900">填写预约信息</h3>
    </div>
    <div class="p-6">
      <%= form_with model: @booking, url: venue_bookings_path, local: true, class: "space-y-6" do |f| %>
        <% if @booking.errors.any? %>
          <div class="bg-red-50 border border-red-200 rounded-lg p-4">
            <h4 class="text-sm font-medium text-red-800">请修正以下问题：</h4>
            <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
              <% @booking.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= f.label :venue_id, "选择场地", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :venue_id, Venue.active.map { |v| [v.name, v.id] }, { prompt: "请选择场地" }, class: "block w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div class="grid grid-cols-2 gap-6">
          <div>
            <%= f.label :start_time, "开始时间", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.datetime_local_field :start_time, class: "block w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
          </div>
          <div>
            <%= f.label :end_time, "结束时间", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.datetime_local_field :end_time, class: "block w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
          </div>
        </div>

        <div>
          <%= f.label :purpose, "预约用途", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :purpose, placeholder: "请输入预约用途", class: "block w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div>
          <%= f.label :remark, "备注", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_area :remark, rows: 3, placeholder: "补充说明（可选）", class: "block w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div class="flex space-x-4">
          <%= f.submit "提交预约", class: "px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 font-medium" %>
          <%= link_to "取消", venue_bookings_path, class: "px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 font-medium" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
