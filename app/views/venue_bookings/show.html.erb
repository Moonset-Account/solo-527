<% content_for :page_title, "预约详情" %>

<div class="space-y-6">
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="h-40 bg-gradient-to-r from-green-500 to-teal-500 flex items-center justify-center relative">
      <svg class="w-16 h-16 text-white/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
      </svg>
      <span class="absolute top-4 right-4 px-3 py-1 bg-white/20 backdrop-blur-sm text-white text-sm rounded-full">
        <%= status_text(@booking.status) %>
      </span>
    </div>

    <div class="p-8">
      <div class="flex items-start justify-between mb-6">
        <div>
          <h1 class="text-3xl font-bold text-gray-900"><%= @booking.venue.name %></h1>
          <p class="text-gray-500 mt-2">预约编号 #<%= @booking.id %></p>
        </div>
        <span class="px-3 py-1 text-sm rounded-full <%= status_class(@booking.status) %> font-medium">
          <%= status_text(@booking.status) %>
        </span>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">预约日期</p>
          <p class="font-semibold text-gray-900 mt-1"><%= @booking.start_time.strftime("%Y-%m-%d") %></p>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">开始时间</p>
          <p class="font-semibold text-gray-900 mt-1"><%= @booking.start_time.strftime("%H:%M") %></p>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">结束时间</p>
          <p class="font-semibold text-gray-900 mt-1"><%= @booking.end_time.strftime("%H:%M") %></p>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">预约状态</p>
          <p class="mt-1"><span class="px-2 py-1 text-xs rounded-full <%= status_class(@booking.status) %>"><%= status_text(@booking.status) %></span></p>
        </div>
      </div>

      <% if @booking.purpose.present? %>
        <div class="mb-6 p-4 bg-gray-50 rounded-lg">
          <p class="text-sm text-gray-500">预约用途</p>
          <p class="text-gray-900 mt-1"><%= @booking.purpose %></p>
        </div>
      <% end %>

      <% if @booking.remark.present? %>
        <div class="mb-6 p-4 bg-gray-50 rounded-lg">
          <p class="text-sm text-gray-500">备注</p>
          <p class="text-gray-900 mt-1"><%= @booking.remark %></p>
        </div>
      <% end %>

      <div class="flex space-x-4">
        <% if @booking.status.in?(%w[pending confirmed]) %>
          <%= button_to "取消预约", cancel_venue_booking_path(@booking), method: :post,
                        class: "px-6 py-3 bg-red-600 text-white rounded-lg hover:bg-red-700 font-medium",
                        data: { confirm: "确认取消预约？" } %>
        <% end %>
        <%= link_to "返回列表", venue_bookings_path, class: "px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 font-medium" %>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-medium text-gray-900">场地信息</h3>
      </div>
      <div class="px-6 py-4 space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-sm text-gray-500">场地名称</span>
          <span class="font-medium text-gray-900"><%= @booking.venue.name %></span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-sm text-gray-500">场地位置</span>
          <span class="font-medium text-gray-900"><%= @booking.venue.location || "-" %></span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-sm text-gray-500">容纳人数</span>
          <span class="font-medium text-gray-900"><%= @booking.venue.capacity || "-" %></span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-sm text-gray-500">场地状态</span>
          <span class="px-2 py-1 text-xs rounded-full <%= status_class(@booking.venue.status) %>"><%= status_text(@booking.venue.status) %></span>
        </div>
      </div>
      <div class="px-6 py-4 border-t border-gray-200">
        <%= link_to "查看场地", venue_path(@booking.venue), class: "block px-4 py-2 bg-gray-50 rounded-lg text-center text-gray-700 hover:bg-gray-100 text-sm" %>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-medium text-gray-900">来源追溯</h3>
      </div>
      <div class="px-6 py-4 space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-sm text-gray-500">创建来源</span>
          <span class="font-medium text-gray-900"><%= source_text(@booking.source) %></span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-sm text-gray-500">创建时间</span>
          <span class="font-medium text-gray-900"><%= @booking.created_at.strftime("%Y-%m-%d %H:%M") %></span>
        </div>
        <% if @booking.bookable.present? %>
          <div class="flex items-center justify-between">
            <span class="text-sm text-gray-500">关联类型</span>
            <span class="font-medium text-gray-900">
              <%= case @booking.bookable_type
                  when "CourseEnrollment" then "课程报名"
                  when "EventRegistration" then "赛事报名"
                  else @booking.bookable_type
                  end %>
            </span>
          </div>
          <% if @booking.bookable_type == "CourseEnrollment" %>
            <div class="pt-3">
              <%= link_to "查看关联报名", course_enrollment_path(@booking.bookable), class: "text-blue-600 hover:text-blue-900 text-sm" %>
            </div>
          <% elsif @booking.bookable_type == "EventRegistration" %>
            <div class="pt-3">
              <%= link_to "查看关联报名", event_registration_path(@booking.bookable), class: "text-blue-600 hover:text-blue-900 text-sm" %>
            </div>
          <% end %>
        <% else %>
          <div class="flex items-center justify-between">
            <span class="text-sm text-gray-500">关联类型</span>
            <span class="font-medium text-gray-500">独立预约</span>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%= render "shared/version_history", versions: @versions %>

  <%= link_to "← 返回预约列表", venue_bookings_path, class: "text-gray-600 hover:text-gray-900" %>
</div>
