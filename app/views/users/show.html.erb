<%= content_for(:title, @user.name) %>

<div class="mb-6">
  <div class="flex items-center justify-between">
    <div class="flex items-center space-x-4">
      <%= link_to users_path, class: "p-2 text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-lg transition-colors" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
      <% end %>
      <div class="flex items-center space-x-4">
        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-blue-400 to-indigo-500 flex items-center justify-center text-white text-2xl font-bold">
          <%= @user.name.first %>
        </div>
        <div>
          <div class="flex items-center space-x-2">
            <h1 class="text-2xl font-bold text-gray-900"><%= @user.name %></h1>
            <% if @user.executive? %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800 border border-purple-200">总经办</span>
            <% elsif @user.admin? %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 border border-blue-200">管理员</span>
            <% end %>
          </div>
          <p class="mt-1 text-gray-500"><%= @user.email %> · <%= @user.department&.name || "未分配部门" %></p>
        </div>
      </div>
    </div>
    <% if policy(@user).edit? %>
      <%= link_to "编辑", edit_user_path(@user), class: "px-4 py-2 bg-white hover:bg-gray-50 border border-gray-300 text-gray-700 font-medium rounded-lg transition-colors" %>
    <% end %>
  </div>
</div>

<div class="grid grid-cols-1 gap-4 mb-6 sm:grid-cols-2">
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <p class="text-sm font-medium text-gray-500">提交的需求</p>
    <p class="mt-2 text-3xl font-bold text-indigo-600"><%= @user.submitted_tickets.count %></p>
  </div>
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <p class="text-sm font-medium text-gray-500">负责的需求</p>
    <p class="mt-2 text-3xl font-bold text-purple-600"><%= @user.assigned_tickets.count %></p>
  </div>
</div>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
  <div class="bg-white rounded-xl shadow-sm border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">提交的需求</h2>
    </div>
    <% if @submitted_tickets.any? %>
      <ul class="divide-y divide-gray-200">
        <% @submitted_tickets.each do |ticket| %>
          <li class="px-6 py-4 hover:bg-gray-50 transition-colors">
            <%= link_to ticket_path(ticket), class: "block" do %>
              <div class="flex items-start justify-between">
                <div class="min-w-0 flex-1">
                  <%= status_badge(ticket.status) %>
                  <p class="mt-1 text-sm font-medium text-gray-900 truncate"><%= ticket.title %></p>
                  <p class="text-xs text-gray-500 mt-0.5">#<%= ticket.id %> · <%= format_date(ticket.created_at) %></p>
                </div>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>
      <div class="px-6 py-4 border-t border-gray-200">
        <%= paginate @submitted_tickets, param_name: :submitted_page %>
      </div>
    <% else %>
      <div class="px-6 py-12 text-center text-gray-500">暂无提交的需求</div>
    <% end %>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">负责的需求</h2>
    </div>
    <% if @assigned_tickets.any? %>
      <ul class="divide-y divide-gray-200">
        <% @assigned_tickets.each do |ticket| %>
          <li class="px-6 py-4 hover:bg-gray-50 transition-colors">
            <%= link_to ticket_path(ticket), class: "block" do %>
              <div class="flex items-start justify-between">
                <div class="min-w-0 flex-1">
                  <div class="flex items-center space-x-2">
                    <%= status_badge(ticket.status) %>
                    <%= priority_badge(ticket.priority) %>
                  </div>
                  <p class="mt-1 text-sm font-medium text-gray-900 truncate"><%= ticket.title %></p>
                  <p class="text-xs text-gray-500 mt-0.5">
                    #<%= ticket.id %> · <%= ticket.department&.name %> · <%= format_date(ticket.created_at) %>
                  </p>
                </div>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>
      <div class="px-6 py-4 border-t border-gray-200">
        <%= paginate @assigned_tickets, param_name: :assigned_page %>
      </div>
    <% else %>
      <div class="px-6 py-12 text-center text-gray-500">暂无负责的需求</div>
    <% end %>
  </div>
</div>
