<%= content_for(:title, "编辑用户 - #{@user.name}") %>

<div class="mb-6">
  <div class="flex items-center space-x-4">
    <%= link_to user_path(@user), class: "p-2 text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-lg transition-colors" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
    <% end %>
    <div>
      <h1 class="text-2xl font-bold text-gray-900">编辑用户</h1>
      <p class="mt-1 text-gray-500"><%= @user.name %></p>
    </div>
  </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-200 max-w-2xl">
  <%= form_with(model: @user, url: user_path(@user), method: :patch, class: "divide-y divide-gray-200") do |f| %>
    <% if @user.errors.any? %>
      <div class="p-4 bg-red-50 border-b border-red-200">
        <ul class="text-sm text-red-600 list-disc list-inside">
          <% @user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="p-6 space-y-6">
      <div>
        <%= f.label :name, "姓名", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_field :name, required: true, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>

      <div>
        <%= f.label :email, "邮箱", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.email_field :email, required: true, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>

      <div>
        <%= f.label :department_id, "所属部门", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.collection_select :department_id, Department.ordered, :id, :name, { include_blank: "未分配" }, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>

      <% if current_user.executive? %>
        <div>
          <%= f.label :role, "角色权限", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.select :role, User.roles.map { |k, v| [I18n.t("activerecord.attributes.user.roles.#{k}"), v] }, {}, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>
      <% end %>

      <div class="pt-4 border-t border-gray-200">
        <h3 class="text-base font-semibold text-gray-900 mb-4">修改密码 (留空则不修改)</h3>
        <div class="space-y-4">
          <div>
            <%= f.label :password, "新密码", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.password_field :password, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500", autocomplete: "new-password" %>
          </div>
          <div>
            <%= f.label :password_confirmation, "确认新密码", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.password_field :password_confirmation, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500", autocomplete: "new-password" %>
          </div>
        </div>
      </div>
    </div>

    <div class="px-6 py-4 bg-gray-50 rounded-b-xl flex items-center justify-end space-x-3">
      <%= link_to "取消", user_path(@user), class: "px-6 py-2.5 border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 transition-colors" %>
      <%= f.submit "保存修改", class: "px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg shadow-sm transition-colors" %>
    </div>
  <% end %>
</div>
