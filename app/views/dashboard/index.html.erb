<% content_for :title, "仪表盘" %>

<div class="space-y-8">
  <div class="flex items-center justify-between">
    <h2 class="text-2xl font-bold">仪表盘</h2>
    <span class="text-sm text-gray-400"><%= Time.current.strftime("%Y年%m月%d日") %></span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
    <div class="bg-[#16162a] rounded-lg p-5 border border-gray-800 hover:shadow-lg hover:shadow-[#6C3CE1]/10 transition-all duration-200">
      <div class="text-sm text-gray-400">今日订单</div>
      <div class="text-3xl font-bold text-[#6C3CE1] mt-1"><%= @today_orders %></div>
    </div>
    <div class="bg-[#16162a] rounded-lg p-5 border border-gray-800 hover:shadow-lg hover:shadow-[#F59E0B]/10 transition-all duration-200">
      <div class="text-sm text-gray-400">待审报名</div>
      <div class="text-3xl font-bold text-[#F59E0B] mt-1"><%= @pending_registrations %></div>
    </div>
    <div class="bg-[#16162a] rounded-lg p-5 border border-gray-800 hover:shadow-lg hover:shadow-yellow-500/10 transition-all duration-200">
      <div class="text-sm text-gray-400">待审退票</div>
      <div class="text-3xl font-bold text-yellow-400 mt-1"><%= @pending_refunds %></div>
    </div>
    <div class="bg-[#16162a] rounded-lg p-5 border border-gray-800 hover:shadow-lg hover:shadow-red-500/10 transition-all duration-200">
      <div class="text-sm text-gray-400">到场预警</div>
      <div class="text-3xl font-bold text-red-400 mt-1"><%= @open_alerts %></div>
    </div>
    <div class="bg-[#16162a] rounded-lg p-5 border border-gray-800 hover:shadow-lg hover:shadow-red-500/10 transition-all duration-200">
      <div class="text-sm text-gray-400">收入异常</div>
      <div class="text-3xl font-bold text-red-500 mt-1"><%= @open_anomalies %></div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 bg-[#16162a] rounded-lg border border-gray-800">
      <div class="p-5 border-b border-gray-800">
        <h3 class="font-semibold">最近订单</h3>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="text-left text-xs text-gray-500 uppercase border-b border-gray-800">
              <th class="px-5 py-3">订单号</th>
              <th class="px-5 py-3">金额</th>
              <th class="px-5 py-3">状态</th>
              <th class="px-5 py-3">时间</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-800">
            <% @recent_orders.each do |order| %>
              <tr class="hover:bg-gray-800/50 transition-colors">
                <td class="px-5 py-3 text-sm"><%= link_to order.order_no, order_path(order), class: "text-[#6C3CE1] hover:underline" %></td>
                <td class="px-5 py-3 text-sm"><%= format_currency(order.total_amount) %></td>
                <td class="px-5 py-3 text-sm"><%= status_badge(order.status) %></td>
                <td class="px-5 py-3 text-sm text-gray-400"><%= order.created_at.strftime("%m-%d %H:%M") %></td>
              </tr>
            <% end %>
            <% if @recent_orders.empty? %>
              <tr><td colspan="4" class="px-5 py-8 text-center text-gray-500">暂无订单</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="bg-[#16162a] rounded-lg border border-gray-800">
      <div class="p-5 border-b border-gray-800">
        <h3 class="font-semibold">库存预警</h3>
      </div>
      <div class="p-5 space-y-3">
        <% @low_stock_inventories.each do |inv| %>
          <div class="p-3 bg-red-900/20 border border-red-900/50 rounded-lg">
            <div class="text-sm font-medium"><%= inv.ticket_type.name %></div>
            <div class="text-xs text-gray-400 mt-1">剩余: <%= inv.available %> / <%= inv.total %></div>
            <div class="mt-2 w-full bg-gray-700 rounded-full h-1.5">
              <div class="bg-red-500 h-1.5 rounded-full" style="width: <%= inv.total > 0 ? (inv.available.to_f / inv.total * 100).round : 0 %>%"></div>
            </div>
          </div>
        <% end %>
        <% if @low_stock_inventories.empty? %>
          <p class="text-gray-500 text-sm text-center py-4">库存充足</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
