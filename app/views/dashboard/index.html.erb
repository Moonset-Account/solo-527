<%= content_for(:title, "工作台") %>

<div class="mb-8">
  <h1 class="text-2xl font-bold text-gray-900">欢迎回来，<%= current_user.name %></h1>
  <p class="mt-1 text-gray-500">今天是 <%= Date.current.strftime("%Y年%m月%d日 %A") %>，以下是您的工作概览。</p>
</div>

<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-8">
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-gray-500">我的待办</p>
        <p class="mt-2 text-3xl font-bold text-yellow-600"><%= @my_pending %></p>
      </div>
      <div class="w-12 h-12 bg-yellow-100 rounded-xl flex items-center justify-center">
        <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-gray-500">处理中</p>
        <p class="mt-2 text-3xl font-bold text-blue-600"><%= @my_in_progress %></p>
      </div>
      <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-gray-500">已完成</p>
        <p class="mt-2 text-3xl font-bold text-green-600"><%= @my_completed %></p>
      </div>
      <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center">
        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-gray-500">异常</p>
        <p class="mt-2 text-3xl font-bold text-red-600"><%= @my_exception %></p>
      </div>
      <div class="w-12 h-12 bg-red-100 rounded-xl flex items-center justify-center">
        <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
      </div>
    </div>
  </div>
</div>

<% if current_user.executive_or_admin? %>
  <div class="bg-gradient-to-r from-indigo-50 to-purple-50 rounded-xl p-6 mb-8 border border-indigo-100">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">全局数据概览</h2>
    <div class="grid grid-cols-2 gap-4 md:grid-cols-5">
      <div class="text-center">
        <p class="text-2xl font-bold text-yellow-600"><%= @total_pending %></p>
        <p class="text-sm text-gray-500">全部待办</p>
      </div>
      <div class="text-center">
        <p class="text-2xl font-bold text-blue-600"><%= @total_in_progress %></p>
        <p class="text-sm text-gray-500">全部处理中</p>
      </div>
      <div class="text-center">
        <p class="text-2xl font-bold text-green-600"><%= @total_completed %></p>
        <p class="text-sm text-gray-500">全部已完成</p>
      </div>
      <div class="text-center">
        <p class="text-2xl font-bold text-red-600"><%= @total_exception %></p>
        <p class="text-sm text-gray-500">全部异常</p>
      </div>
      <div class="text-center">
        <p class="text-2xl font-bold text-orange-600"><%= @overdue_count %></p>
        <p class="text-sm text-gray-500">超期未完成</p>
      </div>
    </div>
  </div>
<% end %>

<div class="bg-white rounded-xl shadow-sm border border-gray-200">
  <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
    <h2 class="text-lg font-semibold text-gray-900">最近的需求</h2>
    <%= link_to "查看全部", tickets_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-700" %>
  </div>

  <% if @tickets.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">需求</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状态</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">负责人</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">部门</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">截止日期</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @tickets.each do |ticket| %>
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4">
                <%= link_to ticket_path(ticket), class: "block" do %>
                  <div class="flex items-center space-x-3">
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= ticket.priority_color %>">
                      <%= ticket.priority_name %>
                    </span>
                    <div>
                      <p class="text-sm font-medium text-gray-900"><%= truncate(ticket.title, length: 50) %></p>
                      <p class="text-xs text-gray-500"><%= ticket.process_node %> · <%= ticket.submitter&.name %> 提交</p>
                    </div>
                  </div>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium border <%= ticket.status_color %>">
                  <%= ticket.status_name %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                <%= ticket.assignee&.name %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= ticket.department&.name %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <% if ticket.deadline %>
                  <span class="<%= 'text-red-600 font-medium' if ticket.overdue? %>">
                    <%= ticket.deadline.strftime("%Y-%m-%d") %>
                  </span>
                <% else %>
                  <span class="text-gray-400">未设置</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="px-6 py-16 text-center">
      <svg class="w-12 h-12 mx-auto text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
      </svg>
      <p class="mt-4 text-gray-500">暂无需求，<%= link_to "立即提交需求", new_ticket_path, class: "text-indigo-600 hover:text-indigo-700 font-medium" %></p>
    </div>
  <% end %>
</div>
