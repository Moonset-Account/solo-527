<%= content_for(:title, "审核中心") %>

<div class="mb-6">
  <h1 class="text-2xl font-bold text-gray-900">审核中心</h1>
  <p class="mt-1 text-gray-500">查看全系统操作审计日志，追踪所有变更行为</p>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-200 mb-6">
  <%= search_form_for @q, url: audit_logs_path, method: :get, html: { class: "px-6 py-4 border-b border-gray-200" } do |f| %>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-4">
      <div>
        <%= f.label :action_type_eq, "操作类型", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :action_type_eq, AuditLog::ACTION_TYPES.map { |a| [I18n.t("activerecord.attributes.audit_log.actions.#{a}"), a] }, { include_blank: "全部类型" }, class: "w-full px-3 py-2 border border-gray-300 rounded-lg" %>
      </div>
      <div>
        <%= f.label :user_id_eq, "操作人", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :user_id_eq, User.ordered.pluck(:name, :id), { include_blank: "全部操作人" }, class: "w-full px-3 py-2 border border-gray-300 rounded-lg" %>
      </div>
      <div>
        <%= f.label :ticket_id_eq, "需求ID", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.search_field :ticket_id_eq, class: "w-full px-3 py-2 border border-gray-300 rounded-lg", placeholder: "输入需求ID..." %>
      </div>
      <div class="flex items-end space-x-2">
        <%= f.submit "搜索", class: "flex-1 px-4 py-2 bg-gray-800 hover:bg-gray-900 text-white font-medium rounded-lg transition-colors" %>
        <%= link_to "重置", audit_logs_path, class: "px-4 py-2 bg-white hover:bg-gray-50 border border-gray-300 text-gray-700 font-medium rounded-lg" %>
      </div>
    </div>
  <% end %>
</div>

<% summary = {
  create_ticket: 0,
  update_assignee: 0,
  update_status: 0,
  update_department: 0,
  create_review: 0,
  update_review: 0
} %>
<% @audit_logs.each { |l| summary[l.action_type.to_sym] = (summary[l.action_type.to_sym] || 0) + 1 } if @audit_logs %>

<div class="grid grid-cols-2 gap-4 mb-6 sm:grid-cols-3 lg:grid-cols-6">
  <% summary.each do |key, count| %>
    <% colors = { create_ticket: "bg-green-50 text-green-700 border-green-200", update_assignee: "bg-purple-50 text-purple-700 border-purple-200", update_status: "bg-blue-50 text-blue-700 border-blue-200", update_department: "bg-orange-50 text-orange-700 border-orange-200", create_review: "bg-indigo-50 text-indigo-700 border-indigo-200", update_review: "bg-teal-50 text-teal-700 border-teal-200" } %>
    <div class="p-4 rounded-xl border <%= colors[key] %>">
      <p class="text-xs font-medium uppercase tracking-wide opacity-80"><%= I18n.t("activerecord.attributes.audit_log.actions.#{key}") %></p>
      <p class="mt-1 text-2xl font-bold"><%= count %></p>
    </div>
  <% end %>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-200">
  <% if @audit_logs.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">时间</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作类型</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作人</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">关联需求</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">变更字段</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">变更内容</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @audit_logs.each do |log| %>
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= format_datetime(log.created_at) %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-50 text-indigo-700 border border-indigo-200">
                  <%= log.action_name %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <div class="flex items-center space-x-2">
                  <div class="w-6 h-6 rounded-full bg-gradient-to-br from-blue-400 to-indigo-500 flex items-center justify-center text-white text-xs">
                    <%= log.user&.name&.first %>
                  </div>
                  <span class="font-medium text-gray-900"><%= log.user&.name %></span>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <%= link_to ticket_path(log.ticket), class: "text-indigo-600 hover:text-indigo-900 text-sm" do %>
                  <span class="font-medium">##{log.ticket_id}</span>
                  <span class="text-gray-500 ml-1"><%= truncate(log.ticket.title, length: 20) %></span>
                <% end %>
              </td>
              <td class="px-6 py-4 text-sm text-gray-600 whitespace-nowrap">
                <%= log.display_field_name || '-' %>
              </td>
              <td class="px-6 py-4 text-sm">
                <% if log.old_value.present? || log.new_value.present? %>
                  <div class="flex flex-wrap items-center gap-1">
                    <% if log.old_value.present? %>
                      <span class="px-2 py-0.5 bg-red-50 text-red-700 rounded text-xs line-through"><%= truncate(log.old_value.to_s, length: 25) %></span>
                    <% end %>
                    <% if log.old_value.present? && log.new_value.present? %>
                      <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                      </svg>
                    <% end %>
                    <% if log.new_value.present? %>
                      <span class="px-2 py-0.5 bg-green-50 text-green-700 rounded text-xs font-medium"><%= truncate(log.new_value.to_s, length: 25) %></span>
                    <% end %>
                  </div>
                <% elsif log.remark.present? %>
                  <span class="text-gray-600 truncate max-w-xs"><%= log.remark %></span>
                <% else %>
                  <span class="text-gray-400">-</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="px-6 py-4 border-t border-gray-200">
      <%= paginate @audit_logs %>
    </div>
  <% else %>
    <div class="px-6 py-16 text-center">
      <svg class="w-12 h-12 mx-auto text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
      </svg>
      <p class="mt-4 text-gray-500">暂无审计日志数据</p>
    </div>
  <% end %>
</div>
