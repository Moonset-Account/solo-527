<div class="min-h-screen bg-gray-50">
  <div class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-6">
      <h1 class="text-2xl font-bold text-gray-900">操作记录</h1>
      <p class="mt-1 text-sm text-gray-500">系统所有操作记录，按时间倒序排列</p>
    </div>

    <div class="mb-6 rounded-lg bg-white p-4 shadow-sm">
      <%= search_form_for @q do |f| %>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
          <div>
            <%= f.label :user_email_cont, '操作人', class: 'block text-sm font-medium text-gray-700' %>
            <%= f.text_field :user_email_cont, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
          </div>
          <div>
            <%= f.label :action_eq, '操作类型', class: 'block text-sm font-medium text-gray-700' %>
            <%= f.select :action_eq, options_for_select(OperationLog.distinct.pluck(:action).map { |a| [a, a] }), { include_blank: '全部' }, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
          </div>
          <div>
            <%= f.label :created_at_gteq, '开始时间', class: 'block text-sm font-medium text-gray-700' %>
            <%= f.datetime_field :created_at_gteq, class: 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm' %>
          </div>
          <div class="flex items-end">
            <%= f.submit '筛选', class: 'w-full rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2' %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="rounded-lg bg-white p-6 shadow-sm">
      <% if @operation_logs.any? %>
        <div class="relative">
          <div class="absolute left-5 top-0 h-full w-0.5 bg-gray-200"></div>

          <div class="space-y-6">
            <% @operation_logs.each do |log| %>
              <% icon_color = case log.action
                when /create/ then 'bg-green-500'
                when /update|edit/ then 'bg-blue-500'
                when /destroy|delete|reject/ then 'bg-red-500'
                when /approve|pay|generate/ then 'bg-purple-500'
                when /handle|assign/ then 'bg-yellow-500'
                else 'bg-gray-500'
                end %>

              <% icon_svg = case log.action
                when /create/ then 'M12 6v6m0 0v6m0-6h6m-6 0H6'
                when /update|edit/ then 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z'
                when /destroy|delete|reject/ then 'M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16'
                when /approve|pay|generate/ then 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'
                when /handle|assign/ then 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z'
                else 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
                end %>

              <div class="relative flex items-start">
                <div class="flex h-10 w-10 items-center justify-center rounded-full <%= icon_color %> text-white z-10">
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= icon_svg %>"></path>
                  </svg>
                </div>
                <div class="ml-4 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="text-sm font-semibold text-gray-900"><%= log.action %></span>
                    <span class="text-xs text-gray-500"><%= log.created_at.strftime('%Y-%m-%d %H:%M:%S') %></span>
                  </div>
                  <div class="mt-1 text-sm text-gray-600">
                    操作人：<span class="font-medium text-gray-900"><%= log.user&.email || '系统' %></span>
                  </div>
                  <% if log.target %>
                    <div class="mt-1 text-sm text-gray-600">
                      目标对象：<span class="font-medium"><%= log.target_type %> #<%= log.target_id %></span>
                    </div>
                  <% end %>
                  <% if log.details.present? %>
                    <div class="mt-2 rounded-md bg-gray-50 p-3">
                      <p class="text-xs font-medium text-gray-500 mb-1">详细信息</p>
                      <pre class="text-xs text-gray-700 whitespace-pre-wrap"><%= log.details.is_a?(String) ? log.details : log.details.to_json %></pre>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <div class="mt-8 border-t border-gray-200 pt-4">
          <div class="flex items-center justify-between">
            <div class="text-sm text-gray-700">
              显示第 <%= @operation_logs.offset_value + 1 %> - <%= [@operation_logs.offset_value + @operation_logs.limit_value, @operation_logs.total_count].min %> 条，共 <%= @operation_logs.total_count %> 条
            </div>
            <div class="flex justify-end">
              <%= paginate @operation_logs, theme: 'tailwind' %>
            </div>
          </div>
        </div>
      <% else %>
        <div class="py-12 text-center">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
          </svg>
          <h3 class="mt-2 text-sm font-medium text-gray-900">暂无操作记录</h3>
          <p class="mt-1 text-sm text-gray-500">还没有任何操作记录。</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
