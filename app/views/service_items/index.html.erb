<% content_for :title, "服务项目管理" %>

<div class="card">
  <div class="card-header">
    服务项目列表
    <%= link_to "新建服务项目", new_service_item_path, class: "btn btn-primary", style: "float:right;" %>
  </div>
  <table>
    <thead>
      <tr>
        <th>项目编码</th>
        <th>项目名称</th>
        <th>分类</th>
        <th>价格</th>
        <th>时长</th>
        <th>状态</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% @service_items.each do |item| %>
        <tr>
          <td><%= link_to item.code, service_item_path(item) %></td>
          <td><%= item.name %></td>
          <td><%= item.category %></td>
          <td style="color:#409eff; font-weight:600;">¥<%= item.price %></td>
          <td><%= item.duration_minutes %> 分钟</td>
          <td>
            <% if item.active? %>
              <span class="tag tag-green">启用</span>
            <% else %>
              <span class="tag tag-gray">停用</span>
            <% end %>
          </td>
          <td class="actions">
            <%= link_to "详情", service_item_path(item), class: "btn btn-sm btn-default" %>
            <%= link_to "编辑", edit_service_item_path(item), class: "btn btn-sm btn-default" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div class="pagination">
    <%= paginate @service_items %>
  </div>
</div>
