<% content_for :page_title, "支付详情" %>

<div class="space-y-6">
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="h-48 bg-gradient-to-r from-emerald-500 to-cyan-500 flex items-center justify-center relative">
      <svg class="w-20 h-20 text-white/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
      </svg>
      <span class="absolute top-4 right-4 px-3 py-1 bg-white/20 backdrop-blur-sm text-white text-sm rounded-full">
        <%= status_text(@payment.status) %>
      </span>
    </div>

    <div class="p-8">
      <div class="flex items-start justify-between mb-6">
        <div>
          <h1 class="text-3xl font-bold text-gray-900">支付详情</h1>
          <p class="text-gray-500 mt-2">支付编号 #<%= @payment.id %></p>
        </div>
        <div class="text-right">
          <p class="text-3xl font-bold text-orange-600">¥<%= "%.2f" % @payment.amount %></p>
          <p class="text-sm text-gray-500">支付金额</p>
        </div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">支付状态</p>
          <p class="mt-1"><span class="px-2 py-1 text-xs rounded-full <%= status_class(@payment.status) %>"><%= status_text(@payment.status) %></span></p>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">支付方式</p>
          <p class="font-semibold text-gray-900 mt-1"><%= @payment.payment_method&.humanize || "-" %></p>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">创建时间</p>
          <p class="font-semibold text-gray-900 mt-1"><%= @payment.created_at.strftime("%Y-%m-%d %H:%M") %></p>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">数据来源</p>
          <p class="font-semibold text-gray-900 mt-1"><%= source_text(@payment.source) %></p>
        </div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">交易流水号</p>
          <p class="font-semibold text-gray-900 mt-1 text-sm"><%= @payment.transaction_id || "-" %></p>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">支付时间</p>
          <p class="font-semibold text-gray-900 mt-1"><%= @payment.paid_at&.strftime("%Y-%m-%d %H:%M") || "-" %></p>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">重试次数</p>
          <p class="font-semibold text-gray-900 mt-1"><%= @payment.retry_count %> / 3</p>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-sm text-gray-500">失败时间</p>
          <p class="font-semibold text-gray-900 mt-1"><%= @payment.failed_at&.strftime("%Y-%m-%d %H:%M") || "-" %></p>
        </div>
      </div>

      <% if @payment.remark.present? %>
        <div class="mb-6 p-4 bg-gray-50 rounded-lg">
          <p class="text-sm text-gray-500">备注</p>
          <p class="text-gray-900 mt-1"><%= @payment.remark %></p>
        </div>
      <% end %>

      <div class="flex space-x-4">
        <%= link_to "返回列表", payments_path, class: "px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 font-medium" %>
      </div>
    </div>
  </div>

  <% if @payment.failed? && @payment.failure_reason.present? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-6">
      <div class="flex items-start">
        <svg class="w-6 h-6 text-red-600 mt-0.5 mr-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
        </svg>
        <div>
          <h3 class="text-lg font-medium text-red-800">支付失败原因</h3>
          <p class="mt-2 text-red-700"><%= @payment.failure_reason %></p>
        </div>
      </div>
    </div>
  <% end %>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="text-lg font-medium text-gray-900">关联订单</h3>
    </div>
    <div class="px-6 py-4 space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-sm text-gray-500">订单类型</span>
        <span class="font-medium text-gray-900">
          <%= case @payment.payable_type
              when "CourseEnrollment" then "课程报名"
              when "EventRegistration" then "赛事报名"
              else @payment.payable_type
              end %>
        </span>
      </div>
      <div class="flex items-center justify-between">
        <span class="text-sm text-gray-500">订单编号</span>
        <span class="font-medium text-gray-900">#<%= @payment.payable_id %></span>
      </div>
      <% if @payment.payable_type == "CourseEnrollment" %>
        <div class="flex items-center justify-between">
          <span class="text-sm text-gray-500">课程名称</span>
          <span class="font-medium text-gray-900"><%= @payment.payable.course.name %></span>
        </div>
        <div class="px-6 py-4 border-t border-gray-200 mt-3 -mx-6">
          <%= link_to "查看课程报名", course_enrollment_path(@payment.payable), class: "block px-4 py-2 bg-gray-50 rounded-lg text-center text-gray-700 hover:bg-gray-100 text-sm" %>
        </div>
      <% elsif @payment.payable_type == "EventRegistration" %>
        <div class="flex items-center justify-between">
          <span class="text-sm text-gray-500">赛事名称</span>
          <span class="font-medium text-gray-900"><%= @payment.payable.event.name %></span>
        </div>
        <div class="px-6 py-4 border-t border-gray-200 mt-3 -mx-6">
          <%= link_to "查看赛事报名", event_registration_path(@payment.payable), class: "block px-4 py-2 bg-gray-50 rounded-lg text-center text-gray-700 hover:bg-gray-100 text-sm" %>
        </div>
      <% end %>
    </div>
  </div>

  <%= render "shared/version_history", versions: @versions %>

  <%= link_to "← 返回支付列表", payments_path, class: "text-gray-600 hover:text-gray-900" %>
</div>
