<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">我的支付记录</h1>
    <div class="flex items-center space-x-4">
      <%= search_form_for @q, url: payments_path, method: :get, class: "flex items-center space-x-2" do |f| %>
        <%= f.select :status_eq, [["待支付", "pending"], ["已支付", "paid"], ["支付失败", "failed"], ["已退款", "refunded"], ["已取消", "cancelled"]], { include_blank: "全部状态" }, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        <%= f.submit "搜索", class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">支付金额</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">关联订单</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">支付方式</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">支付状态</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">创建时间</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @payments.each do |payment| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4">
              <div class="text-lg font-bold text-gray-900">¥<%= "%.2f" % payment.amount %></div>
            </td>
            <td class="px-6 py-4">
              <div class="font-medium text-gray-900">
                <%= case payment.payable_type
                    when "CourseEnrollment" then payment.payable.course.name
                    when "EventRegistration" then payment.payable.event.name
                    else payment.payable_type
                    end %>
              </div>
              <div class="text-sm text-gray-500"><%= payment.payable_type %> #<%= payment.payable_id %></div>
            </td>
            <td class="px-6 py-4 text-sm text-gray-900">
              <%= payment.payment_method&.humanize || "-" %>
            </td>
            <td class="px-6 py-4">
              <span class="px-2 py-1 text-xs rounded-full <%= status_class(payment.status) %>">
                <%= status_text(payment.status) %>
              </span>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500">
              <%= payment.created_at.strftime("%Y-%m-%d %H:%M") %>
            </td>
            <td class="px-6 py-4 text-right">
              <%= link_to "查看详情", payment_path(payment), class: "text-blue-600 hover:text-blue-900 text-sm font-medium" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if @payments.empty? %>
      <div class="p-12 text-center">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">暂无支付记录</h3>
        <p class="mt-1 text-sm text-gray-500">您还没有支付记录</p>
      </div>
    <% end %>
  </div>

  <div class="flex justify-center">
    <%= paginate @payments %>
  </div>
</div>
