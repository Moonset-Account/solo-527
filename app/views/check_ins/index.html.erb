<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">我的签到记录</h1>
    <div class="flex items-center space-x-4">
      <%= search_form_for @q, url: check_ins_path, method: :get, class: "flex items-center space-x-2" do |f| %>
        <%= f.select :status_eq, [["待签到", "pending"], ["已签到", "checked_in"], ["未到场", "no_show"], ["已取消", "cancelled"]], { include_blank: "全部状态" }, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        <%= f.select :checkinable_type_eq, [["课程", "CourseEnrollment"], ["赛事", "EventRegistration"]], { include_blank: "全部类型" }, class: "px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" %>
        <%= f.submit "搜索", class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">关联项目</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">签到方式</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">签到状态</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">签到时间</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">来源</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @check_ins.each do |ci| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4">
              <div class="font-medium text-gray-900"><%= ci.source_description %></div>
            </td>
            <td class="px-6 py-4 text-sm text-gray-900">
              <%= ci.check_in_method&.humanize || "-" %>
            </td>
            <td class="px-6 py-4">
              <span class="px-2 py-1 text-xs rounded-full <%= status_class(ci.status) %>">
                <%= status_text(ci.status) %>
              </span>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500">
              <%= ci.checked_in_at&.strftime("%Y-%m-%d %H:%M") || "-" %>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500">
              <%= source_text(ci.source) %>
            </td>
            <td class="px-6 py-4 text-right">
              <%= link_to "查看详情", check_in_path(ci), class: "text-blue-600 hover:text-blue-900 text-sm font-medium" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if @check_ins.empty? %>
      <div class="p-12 text-center">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">暂无签到记录</h3>
        <p class="mt-1 text-sm text-gray-500">您还没有签到记录</p>
      </div>
    <% end %>
  </div>

  <div class="flex justify-center">
    <%= paginate @check_ins %>
  </div>
</div>
