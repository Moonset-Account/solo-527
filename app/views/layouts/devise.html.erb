<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <title><%= content_for(:title) || "事项闭环台 - 登录" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="min-h-screen bg-gradient-to-br from-indigo-50 via-white to-purple-50">
    <div class="min-h-screen flex items-center justify-center px-4 py-12 sm:px-6 lg:px-8">
      <div class="w-full max-w-md">
        <% if flash[:notice].present? %>
          <div class="mb-4 p-4 rounded-lg bg-green-50 border border-green-200 text-green-800 text-sm">
            <%= flash[:notice] %>
          </div>
        <% end %>
        <% if flash[:alert].present? %>
          <div class="mb-4 p-4 rounded-lg bg-red-50 border border-red-200 text-red-800 text-sm">
            <%= flash[:alert] %>
          </div>
        <% end %>
        <%= yield %>
      </div>
    </div>
  </body>
</html>
