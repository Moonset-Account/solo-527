<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "管理后台 - 游泳馆赛事系统" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="bg-gray-100">
    <div class="flex h-screen">
      <aside class="w-64 bg-gray-800 text-white flex flex-col">
        <div class="p-4 border-b border-gray-700">
          <%= link_to admin_dashboard_path, class: "flex items-center text-xl font-bold" do %>
            <svg class="w-8 h-8 mr-2 text-blue-400" fill="currentColor" viewBox="0 0 24 24"><path d="M2 15c1.5 0 2 1 3.5 1s2-1 3.5-1 2 1 3.5 1 2-1 3.5-1 2 1 3.5 1 2-1 3.5-1v2c-1.5 0-2 1-3.5 1s-2-1-3.5-1-2 1-3.5 1-2-1-3.5-1-2 1-3.5 1-2-1-3.5-1v-2zm0-4c1.5 0 2 1 3.5 1s2-1 3.5-1 2 1 3.5 1 2-1 3.5-1 2 1 3.5 1 2-1 3.5-1v2c-1.5 0-2 1-3.5 1s-2-1-3.5-1-2 1-3.5 1-2-1-3.5-1-2 1-3.5 1-2-1-3.5-1v-2zm0-4c1.5 0 2 1 3.5 1s2-1 3.5-1 2 1 3.5 1 2-1 3.5-1 2 1 3.5 1 2-1 3.5-1v2c-1.5 0-2 1-3.5 1s-2-1-3.5-1-2 1-3.5 1-2-1-3.5-1-2 1-3.5 1-2-1-3.5-1v-2z"/></svg>
            <span>管理后台</span>
          <% end %>
        </div>

        <nav class="flex-1 py-4">
          <div class="px-4 mb-2 text-xs font-semibold text-gray-400 uppercase">数据概览</div>
          <%= link_to admin_dashboard_path, class: "flex items-center px-4 py-2 text-gray-300 hover:bg-gray-700 hover:text-white" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
            <span>仪表盘</span>
          <% end %>

          <div class="px-4 mt-6 mb-2 text-xs font-semibold text-gray-400 uppercase">课程管理</div>
          <%= link_to admin_courses_path, class: "flex items-center px-4 py-2 text-gray-300 hover:bg-gray-700 hover:text-white" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
            <span>课程管理</span>
          <% end %>
          <%= link_to admin_course_enrollments_path, class: "flex items-center px-4 py-2 text-gray-300 hover:bg-gray-700 hover:text-white" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
            <span>课程报名</span>
          <% end %>
          <%= link_to admin_leave_requests_path, class: "flex items-center px-4 py-2 text-gray-300 hover:bg-gray-700 hover:text-white" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <span>请假审核</span>
            <% if LeaveRequest.pending.count > 0 %>
              <span class="ml-auto bg-red-500 text-white text-xs px-2 py-0.5 rounded-full"><%= LeaveRequest.pending.count %></span>
            <% end %>
          <% end %>

          <div class="px-4 mt-6 mb-2 text-xs font-semibold text-gray-400 uppercase">赛事管理</div>
          <%= link_to admin_events_path, class: "flex items-center px-4 py-2 text-gray-300 hover:bg-gray-700 hover:text-white" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            <span>赛事管理</span>
          <% end %>
          <%= link_to admin_event_registrations_path, class: "flex items-center px-4 py-2 text-gray-300 hover:bg-gray-700 hover:text-white" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
            <span>赛事报名</span>
          <% end %>
          <%= link_to admin_schedules_path, class: "flex items-center px-4 py-2 text-gray-300 hover:bg-gray-700 hover:text-white" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <span>赛程管理</span>
          <% end %>
          <%= link_to admin_results_path, class: "flex items-center px-4 py-2 text-gray-300 hover:bg-gray-700 hover:text-white" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
            <span>成绩管理</span>
          <% end %>

          <div class="px-4 mt-6 mb-2 text-xs font-semibold text-gray-400 uppercase">运营管理</div>
          <%= link_to admin_check_ins_path, class: "flex items-center px-4 py-2 text-gray-300 hover:bg-gray-700 hover:text-white" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>签到核销</span>
          <% end %>
          <%= link_to admin_payments_path, class: "flex items-center px-4 py-2 text-gray-300 hover:bg-gray-700 hover:text-white" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
            <span>支付管理</span>
            <% if Payment.failed.count > 0 %>
              <span class="ml-auto bg-red-500 text-white text-xs px-2 py-0.5 rounded-full"><%= Payment.failed.count %></span>
            <% end %>
          <% end %>
          <%= link_to admin_venues_path, class: "flex items-center px-4 py-2 text-gray-300 hover:bg-gray-700 hover:text-white" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
            <span>场地管理</span>
          <% end %>
          <%= link_to admin_venue_bookings_path, class: "flex items-center px-4 py-2 text-gray-300 hover:bg-gray-700 hover:text-white" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <span>场地预约</span>
          <% end %>

          <div class="px-4 mt-6 mb-2 text-xs font-semibold text-gray-400 uppercase">数据报表</div>
          <%= link_to fill_rate_admin_reports_path, class: "flex items-center px-4 py-2 text-gray-300 hover:bg-gray-700 hover:text-white" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
            <span>满班率报表</span>
          <% end %>
          <%= link_to admin_batch_jobs_path, class: "flex items-center px-4 py-2 text-gray-300 hover:bg-gray-700 hover:text-white" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
            <span>批量任务</span>
          <% end %>
          <%= link_to admin_audit_logs_path, class: "flex items-center px-4 py-2 text-gray-300 hover:bg-gray-700 hover:text-white" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
            <span>操作日志</span>
          <% end %>

          <div class="px-4 mt-6 mb-2 text-xs font-semibold text-gray-400 uppercase">系统管理</div>
          <%= link_to admin_users_path, class: "flex items-center px-4 py-2 text-gray-300 hover:bg-gray-700 hover:text-white" do %>
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            <span>用户管理</span>
          <% end %>
        </nav>

        <div class="p-4 border-t border-gray-700">
          <div class="flex items-center">
            <div class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center">
              <span class="text-white font-semibold"><%= current_user.name.to_s.first %></span>
            </div>
            <div class="ml-3">
              <p class="text-sm font-medium"><%= current_user.name.to_s %></p>
              <p class="text-xs text-gray-400"><%= current_user.role %></p>
            </div>
          </div>
          <div class="mt-3">
            <%= link_to root_path, class: "text-sm text-gray-400 hover:text-white" do %>
              ← 返回前台
            <% end %>
          </div>
        </div>
      </aside>

      <div class="flex-1 flex flex-col overflow-hidden">
        <header class="bg-white border-b border-gray-200 px-6 py-4">
          <div class="flex items-center justify-between">
            <h1 class="text-xl font-semibold text-gray-800"><%= content_for(:page_title) || "管理后台" %></h1>
            <div class="flex items-center space-x-4">
              <% if notice %>
                <span class="px-3 py-1 bg-green-100 text-green-800 text-sm rounded"><%= notice %></span>
              <% end %>
              <% if alert %>
                <span class="px-3 py-1 bg-red-100 text-red-800 text-sm rounded"><%= alert %></span>
              <% end %>
              <%= link_to "退出登录", destroy_user_session_path, data: { turbo_method: :delete }, class: "text-sm text-gray-500 hover:text-red-600" %>
            </div>
          </div>
        </header>

        <main class="flex-1 overflow-auto p-6">
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>
