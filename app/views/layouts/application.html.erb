<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "口腔洁牙候补队列平台" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; background: #f5f7fa; color: #303133; }
      .container { max-width: 1400px; margin: 0 auto; padding: 20px; }
      .navbar { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 16px 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.15); }
      .navbar-inner { max-width: 1400px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; }
      .navbar-brand { font-size: 20px; font-weight: 600; }
      .navbar-nav { display: flex; gap: 24px; list-style: none; }
      .navbar-nav a { color: white; text-decoration: none; opacity: 0.9; font-size: 14px; }
      .navbar-nav a:hover { opacity: 1; }
      .card { background: white; border-radius: 8px; padding: 24px; margin-bottom: 20px; box-shadow: 0 1px 4px rgba(0,0,0,0.08); }
      .card-header { font-size: 16px; font-weight: 600; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid #ebeef5; color: #303133; }
      .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px; }
      .stat-card { background: white; border-radius: 8px; padding: 20px; box-shadow: 0 1px 4px rgba(0,0,0,0.08); border-left: 4px solid #667eea; }
      .stat-card h3 { font-size: 12px; color: #909399; margin-bottom: 8px; font-weight: normal; }
      .stat-card .value { font-size: 28px; font-weight: 600; color: #303133; }
      .btn { display: inline-block; padding: 8px 16px; border-radius: 4px; font-size: 14px; cursor: pointer; text-decoration: none; border: none; transition: all 0.2s; }
      .btn-primary { background: #409eff; color: white; }
      .btn-primary:hover { background: #66b1ff; }
      .btn-success { background: #67c23a; color: white; }
      .btn-success:hover { background: #85ce61; }
      .btn-warning { background: #e6a23c; color: white; }
      .btn-danger { background: #f56c6c; color: white; }
      .btn-danger:hover { background: #f78989; }
      .btn-default { background: white; color: #606266; border: 1px solid #dcdfe6; }
      .btn-sm { padding: 4px 12px; font-size: 12px; }
      table { width: 100%; border-collapse: collapse; font-size: 14px; }
      th { background: #f5f7fa; padding: 12px; text-align: left; font-weight: 500; color: #606266; border-bottom: 1px solid #ebeef5; }
      td { padding: 12px; border-bottom: 1px solid #f2f6fc; color: #606266; }
      tr:hover td { background: #fafafa; }
      .tag { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 12px; }
      .tag-green { background: #f0f9eb; color: #67c23a; }
      .tag-blue { background: #ecf5ff; color: #409eff; }
      .tag-orange { background: #fdf6ec; color: #e6a23c; }
      .tag-red { background: #fef0f0; color: #f56c6c; }
      .tag-gray { background: #f4f4f5; color: #909399; }
      .form-group { margin-bottom: 16px; }
      .form-group label { display: block; margin-bottom: 6px; font-size: 14px; color: #606266; }
      .form-control { width: 100%; padding: 8px 12px; border: 1px solid #dcdfe6; border-radius: 4px; font-size: 14px; }
      .form-control:focus { outline: none; border-color: #409eff; }
      .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
      .notice { padding: 12px 16px; background: #ecf5ff; border: 1px solid #d9ecff; color: #409eff; border-radius: 4px; margin-bottom: 16px; font-size: 14px; }
      .alert { padding: 12px 16px; background: #fef0f0; border: 1px solid #fbc4c4; color: #f56c6c; border-radius: 4px; margin-bottom: 16px; font-size: 14px; }
      .timeline { position: relative; padding-left: 24px; }
      .timeline-item { position: relative; padding-bottom: 20px; border-left: 2px solid #e4e7ed; padding-left: 20px; }
      .timeline-item:last-child { border-left-color: transparent; }
      .timeline-item::before { content: ''; position: absolute; left: -7px; top: 0; width: 12px; height: 12px; border-radius: 50%; background: #409eff; }
      .timeline-time { font-size: 12px; color: #909399; margin-bottom: 4px; }
      .timeline-content { font-size: 14px; color: #606266; }
      .detail-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-bottom: 16px; }
      .detail-item { font-size: 14px; }
      .detail-label { color: #909399; }
      .detail-value { color: #303133; font-weight: 500; }
      .section-title { font-size: 15px; font-weight: 600; color: #303133; margin: 20px 0 12px; padding-left: 8px; border-left: 3px solid #409eff; }
      .tabs { display: flex; gap: 0; border-bottom: 2px solid #e4e7ed; margin-bottom: 20px; }
      .tab { padding: 10px 20px; cursor: pointer; font-size: 14px; color: #606266; border-bottom: 2px solid transparent; margin-bottom: -2px; }
      .tab.active { color: #409eff; border-bottom-color: #409eff; }
      .actions { display: flex; gap: 8px; flex-wrap: wrap; }
      .inline-form { display: inline; }
      .pagination { display: flex; justify-content: center; gap: 8px; margin-top: 20px; }
    </style>
  </head>
  <body>
    <nav class="navbar">
      <div class="navbar-inner">
        <div class="navbar-brand">🦷 口腔洁牙候补队列平台</div>
        <ul class="navbar-nav">
          <li><%= link_to "仪表盘", root_path %></li>
          <li><%= link_to "预约", appointments_path %></li>
          <li><%= link_to "候补队列", waiting_lists_path %></li>
          <li><%= link_to "医生", doctors_path %></li>
          <li><%= link_to "客户", customers_path %></li>
          <li><%= link_to "服务项目", service_items_path %></li>
          <li><%= link_to "退款记录", refund_records_path %></li>
          <li><%= link_to "变化日志", waiting_list_change_logs_path %></li>
          <li style="border-left:1px solid rgba(255,255,255,0.3); padding-left:24px;">
            <%= link_to "后台管理", admin_dashboard_path %>
          </li>
        </ul>
      </div>
    </nav>

    <div class="container">
      <% if notice %>
        <div class="notice"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="alert"><%= alert %></div>
      <% end %>

      <%= yield %>
    </div>
  </body>
</html>
