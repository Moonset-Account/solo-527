<% content_for :title, "客户管理" %>

<div class="card">
  <div class="card-header">
    客户列表
    <%= link_to "新建客户", new_customer_path, class: "btn btn-primary", style: "float:right;" %>
  </div>
  <table>
    <thead>
      <tr>
        <th>姓名</th>
        <th>联系电话</th>
        <th>身份证号</th>
        <th>性别</th>
        <th>生日</th>
        <th>VIP</th>
        <th>爽约次数</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% @customers.each do |customer| %>
        <tr>
          <td>
            <%= link_to customer.name, customer_path(customer) %>
            <% if customer.vip? %><span class="tag tag-orange">VIP</span><% end %>
          </td>
          <td><%= customer.phone %></td>
          <td><%= customer.id_card %></td>
          <td><%= customer.gender %></td>
          <td><%= customer.birthday&.strftime("%Y-%m-%d") %></td>
          <td>
            <% if customer.vip? %>
              <span class="tag tag-orange">是</span>
            <% else %>
              <span class="tag tag-gray">否</span>
            <% end %>
          </td>
          <td>
            <% if customer.no_show_count > 0 %>
              <span class="tag tag-red"><%= customer.no_show_count %></span>
            <% else %>
              <span class="tag tag-gray">0</span>
            <% end %>
          </td>
          <td class="actions">
            <%= link_to "详情", customer_path(customer), class: "btn btn-sm btn-default" %>
            <%= link_to "编辑", edit_customer_path(customer), class: "btn btn-sm btn-default" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div class="pagination">
    <%= paginate @customers %>
  </div>
</div>
