[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/ui/main_menu.gd" id="1_script"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_button_normal"]
bg_color = Color(0.29, 0.22, 0.16, 1)
border_radius_top_left = 4
border_radius_top_right = 4
border_radius_bottom_left = 4
border_radius_bottom_right = 4

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_button_hover"]
bg_color = Color(0.42, 0.31, 0.23, 1)
border_radius_top_left = 4
border_radius_top_right = 4
border_radius_bottom_left = 4
border_radius_bottom_right = 4

[sub_resource type="LabelSettings" id="LabelSettings_title"]
font_color = Color(0.96, 0.64, 0.38, 1)
font_size = 36

[sub_resource type="LabelSettings" id="LabelSettings_version"]
font_color = Color(0.5, 0.5, 0.5, 1)
font_size = 14

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.17, 0.09, 0.06, 1)

[node name="CenterContainer" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_right = 0.5
anchor_top = 0.5
anchor_bottom = 0.5
offset_left = -200.0
offset_right = 200.0
offset_top = -250.0
offset_bottom = 250.0
grow_horizontal = 2
grow_vertical = 2
alignment = 1

[node name="TitleLabel" type="Label" parent="CenterContainer"]
layout_mode = 2
text = "RETRO FACTORY TYCOON"
label_settings = SubResource("LabelSettings_title")

[node name="HSeparator" type="HSeparator" parent="CenterContainer"]
layout_mode = 2

[node name="StartButton" type="Button" parent="CenterContainer"]
layout_mode = 2
custom_minimum_size = Vector2(250, 50)
theme_override_styles/normal = SubResource("StyleBoxFlat_button_normal")
theme_override_styles/hover = SubResource("StyleBoxFlat_button_hover")
theme_override_colors/font_color = Color(0.96, 0.64, 0.38, 1)
text = "New Game"

[node name="ContinueButton" type="Button" parent="CenterContainer"]
layout_mode = 2
custom_minimum_size = Vector2(250, 50)
theme_override_styles/normal = SubResource("StyleBoxFlat_button_normal")
theme_override_styles/hover = SubResource("StyleBoxFlat_button_hover")
theme_override_colors/font_color = Color(0.96, 0.64, 0.38, 1)
text = "Continue"

[node name="SettingsButton" type="Button" parent="CenterContainer"]
layout_mode = 2
custom_minimum_size = Vector2(250, 50)
theme_override_styles/normal = SubResource("StyleBoxFlat_button_normal")
theme_override_styles/hover = SubResource("StyleBoxFlat_button_hover")
theme_override_colors/font_color = Color(0.96, 0.64, 0.38, 1)
text = "Settings"

[node name="QuitButton" type="Button" parent="CenterContainer"]
layout_mode = 2
custom_minimum_size = Vector2(250, 50)
theme_override_styles/normal = SubResource("StyleBoxFlat_button_normal")
theme_override_styles/hover = SubResource("StyleBoxFlat_button_hover")
theme_override_colors/font_color = Color(0.96, 0.64, 0.38, 1)
text = "Quit"

[node name="HSeparator2" type="HSeparator" parent="CenterContainer"]
layout_mode = 2

[node name="VersionLabel" type="Label" parent="CenterContainer"]
layout_mode = 2
text = "v0.1.0"
label_settings = SubResource("LabelSettings_version")

[connection signal="pressed" from="CenterContainer/StartButton" to="." method="_on_start_pressed"]
