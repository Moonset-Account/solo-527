generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  RESIDENT
  REPRESENTATIVE
  ADMIN
  AUDITOR
}

enum TopicStatus {
  DRAFT
  PUBLISHED
  VOTING
  CLOSED
  CANCELLED
}

enum VoteType {
  SINGLE
  MULTIPLE
  RANKED
}

enum FacilityStatus {
  NORMAL
  DAMAGED
  UNDER_REPAIR
  REPAIRED
  RECTIFIED
}

enum DamageReportStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  REVIEWED
}

enum VolunteerStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model User {
  id             String         @id @default(cuid())
  clerkId        String         @unique
  email          String         @unique
  name           String?
  phone          String?
  address        String?
  role           UserRole       @default(RESIDENT)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  votes          Vote[]
  damageReports  DamageReport[]
  assignedTasks  VolunteerTask[] @relation("TaskAssignee")
  auditLogs      AuditLog[]
}

model Topic {
  id           String        @id @default(cuid())
  title        String
  description  String        @db.Text
  status       TopicStatus   @default(DRAFT)
  voteType     VoteType      @default(SINGLE)
  maxSelections Int?         @default(1)
  startAt      DateTime?
  endAt        DateTime?
  quorum       Int?
  passThreshold Float?      @default(0.5)
  isAnonymous  Boolean       @default(false)
  creatorId    String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  options      VoteOption[]
  votes        Vote[]
}

model VoteOption {
  id         String   @id @default(cuid())
  topicId    String
  label      String
  description String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  votes      Vote[]
}

model Vote {
  id         String      @id @default(cuid())
  topicId    String
  optionId   String
  userId     String
  comment    String?
  rankOrder  Int?
  votedAt    DateTime    @default(now())
  topic      Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  option     VoteOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([topicId, userId, optionId])
}

model VotingRule {
  id             String  @id @default(cuid())
  name           String  @unique
  description    String?
  defaultVoteType VoteType @default(SINGLE)
  defaultQuorum  Int?
  defaultThreshold Float @default(0.5)
  allowAnonymous Boolean @default(false)
  allowAmendments Boolean @default(true)
  votingDurationHours Int @default(72)
  requireVerification Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Facility {
  id             String        @id @default(cuid())
  name           String
  type           String
  location       String
  description    String?
  status         FacilityStatus @default(NORMAL)
  lastCheckedAt  DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  photos         FacilityPhoto[]
  damageReports  DamageReport[]
  reviews        RectificationReview[]
}

model FacilityPhoto {
  id         String   @id @default(cuid())
  facilityId String
  url        String
  caption    String?
  uploadedBy String?
  createdAt  DateTime @default(now())
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
}

model DamageReport {
  id             String              @id @default(cuid())
  facilityId     String
  reporterId     String
  title          String
  description    String              @db.Text
  photoUrl       String?
  status         DamageReportStatus  @default(PENDING)
  priority       Int                 @default(1)
  assignedTo     String?
  resultNote     String?             @db.Text
  resultPhotoUrl String?
  resolvedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  facility       Facility            @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  reporter       User                @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  volunteerTasks VolunteerTask[]
  reviews        RectificationReview[]
}

model RectificationReview {
  id             String   @id @default(cuid())
  damageReportId String
  facilityId     String
  reviewerId     String?
  result         String   @db.Text
  photoUrl       String?
  isPassed       Boolean
  reviewedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  damageReport   DamageReport @relation(fields: [damageReportId], references: [id], onDelete: Cascade)
  facility       Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
}

model VolunteerTask {
  id             String          @id @default(cuid())
  title          String
  description    String          @db.Text
  type           String
  damageReportId String?
  assigneeId     String?
  status         VolunteerStatus @default(PENDING)
  scheduledAt    DateTime?
  completedAt    DateTime?
  hoursSpent     Float?
  note           String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  damageReport   DamageReport?   @relation(fields: [damageReportId], references: [id], onDelete: SetNull)
  assignee       User?           @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  userId     String?
  detail     Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}
