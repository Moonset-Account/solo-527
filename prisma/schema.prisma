// Prisma schema for Sales Data Portal

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  username      String    @unique
  name          String
  email         String?
  passwordHash  String
  roleId        String
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  role          Role      @relation(fields: [roleId], references: [id])
  applications  PermissionApplication[]
  assignedTodos Todo[]
  ownedDatasets Dataset[]
  fluctuations  Fluctuation[] @relation("Assignee")
  approvedApps  PermissionApplication[] @relation("Approver")
  summaryPushes SummaryPush[]
  fluctuationLogs FluctuationLog[]
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  resourceType String?
  createdAt   DateTime @default(now())

  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())

  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model PermissionApplication {
  id            String   @id @default(uuid())
  applicantId   String
  permissionType String
  datasetId     String?
  reason        String
  status        String   @default("pending") // pending, approved, rejected
  approverId    String?
  approvalComment String?
  createdAt     DateTime @default(now())
  approvedAt    DateTime?

  applicant     User     @relation("Applicant", fields: [applicantId], references: [id])
  approver      User?    @relation("Approver", fields: [approverId], references: [id])
  dataset       Dataset? @relation(fields: [datasetId], references: [id])
}

model Dataset {
  id           String   @id @default(uuid())
  name         String
  description  String?
  businessLine String?
  ownerId      String
  createdAt    DateTime @default(now())

  owner        User              @relation(fields: [ownerId], references: [id])
  permissions  DatasetPermission[]
  applications PermissionApplication[]
}

model DatasetPermission {
  id          String   @id @default(uuid())
  userId      String
  datasetId   String
  accessLevel String   @default("view") // view, edit, admin
  grantedAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  dataset     Dataset  @relation(fields: [datasetId], references: [id])

  @@unique([userId, datasetId])
}

model Metric {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  unit        String?
  category    String?
  description String?
  createdAt   DateTime @default(now())

  alertRules  AlertRule[]
  fluctuations Fluctuation[]
  metricData  MetricData[]
}

model MetricData {
  id        String   @id @default(uuid())
  metricId  String
  value     Decimal  @db.Decimal(18, 4)
  date      DateTime
  createdAt DateTime @default(now())

  metric    Metric   @relation(fields: [metricId], references: [id])

  @@index([metricId, date])
}

model AlertRule {
  id               String   @id @default(uuid())
  metricId         String
  ruleType         String   // threshold, fluctuation, trend
  thresholdConfig  Json
  notificationType String   // email, inapp, both
  assigneeId       String?
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now())

  metric           Metric   @relation(fields: [metricId], references: [id])
  fluctuations     Fluctuation[]
}

model Fluctuation {
  id              String   @id @default(uuid())
  title           String
  description     String?  @db.Text
  readableReason  String   @db.VarChar(500)
  metricId        String?
  currentValue    Decimal? @db.Decimal(18, 4)
  expectedValue   Decimal? @db.Decimal(18, 4)
  deviation       Decimal? @db.Decimal(10, 2)
  priority        String   @default("medium") // high, medium, low
  status          String   @default("pending") // pending, processing, closed
  assigneeId      String?
  deadline        DateTime?
  source          String   // metric_monitor, api_error, manual
  detectedAt      DateTime
  closedAt        DateTime?
  resolution      String?  @db.Text

  metric          Metric?         @relation(fields: [metricId], references: [id])
  assignee        User?           @relation("Assignee", fields: [assigneeId], references: [id])
  logs            FluctuationLog[]
  alertRule       AlertRule?      @relation(fields: [alertRuleId], references: [id])
  alertRuleId     String?
}

model FluctuationLog {
  id             String     @id @default(uuid())
  fluctuationId  String
  action         String
  operatorId     String?
  remark         String?
  createdAt      DateTime   @default(now())

  fluctuation    Fluctuation @relation(fields: [fluctuationId], references: [id])
  operator       User?       @relation(fields: [operatorId], references: [id])
}

model Todo {
  id          String   @id @default(uuid())
  type        String   // alert, approval, summary
  refId       String
  title       String
  description String?  @db.Text
  priority    String   @default("medium") // high, medium, low
  status      String   @default("pending") // pending, processing, done
  assigneeId  String?
  deadline    DateTime?
  createdAt   DateTime @default(now())

  assignee    User?    @relation(fields: [assigneeId], references: [id])
}

model SummaryPush {
  id        String   @id @default(uuid())
  name      String
  type      String   // daily, weekly
  metricIds Json
  frequency String
  userId    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

model DataMasking {
  id          String   @id @default(uuid())
  fieldName   String   @unique
  displayName String
  maskType    String   @default("none") // none, partial, full
  roleConfig  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ApiErrorLog {
  id          String   @id @default(uuid())
  endpoint    String
  method      String
  statusCode  Int
  errorMessage String  @db.Text
  requestBody Json?
  timestamp   DateTime @default(now())
  notified    Boolean  @default(false)
  fluctuationId String?

  fluctuation Fluctuation? @relation(fields: [fluctuationId], references: [id])

  @@index([timestamp])
}
