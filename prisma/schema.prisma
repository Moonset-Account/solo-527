generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  DESIGNER
  PROJECT_MANAGER
  ADMIN
  DECORATION_BOSS
}

enum ProjectStatus {
  DRAFT
  QUOTATION_PENDING
  QUOTATION_CONFIRMED
  IN_PROGRESS
  INSPECTION
  ACCEPTANCE
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum BudgetAlertLevel {
  NORMAL
  WARNING
  CRITICAL
}

enum QuotationStatus {
  DRAFT
  PENDING_CONFIRM
  CONFIRMED
  REJECTED
}

enum ExtraItemStatus {
  DRAFT
  PENDING_CONFIRM
  CONFIRMED
  REJECTED
}

enum InspectionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum AcceptanceStatus {
  PENDING
  PASSED
  FAILED
  RECTIFYING
}

enum ComplaintStatus {
  OPEN
  PROCESSING
  RESOLVED
  ESCALATED
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id             String   @id @default(cuid())
  clerkId        String   @unique
  email          String   @unique
  name           String?
  role           UserRole @default(DESIGNER)
  phone          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  managedProjects       Project[]        @relation("ProjectManager")
  designedProjects      Project[]        @relation("Designer")
  assignedInspections   InspectionTask[] @relation("Inspector")
  responsibleChanges    ChangeHistory[]  @relation("ChangeResponsible")
  createdBy             ChangeHistory[]  @relation("ChangeCreator")
  confirmedQuotations   Quotation[]      @relation("QuotationConfirmer")
  confirmedExtraItems   ExtraItem[]      @relation("ExtraItemConfirmer")
  budgetChangeResponsible BudgetChange[] @relation("BudgetChangeResponsible")
  budgetChangeCreator   BudgetChange[]   @relation("BudgetChangeCreator")
  assignedComplaints    Complaint[]      @relation("ComplaintAssignee")
  decorationCompany     DecorationCompany? @relation(fields: [decorationCompanyId], references: [id])
  decorationCompanyId   String?
}

model DecorationCompany {
  id          String   @id @default(cuid())
  name        String
  bossName    String
  bossEmail   String
  bossPhone   String
  contactName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  users       User[]
  projects    Project[]
  complaints  Complaint[]
}

model Project {
  id                  String        @id @default(cuid())
  code                String        @unique
  name                String
  clientName          String
  clientPhone         String
  clientEmail         String?
  address             String
  area                Float?
  status              ProjectStatus @default(DRAFT)
  totalBudget         Decimal       @default(0) @db.Decimal(12, 2)
  actualCost          Decimal       @default(0) @db.Decimal(12, 2)
  budgetUsedPercent   Float         @default(0)
  budgetAlertLevel    BudgetAlertLevel @default(NORMAL)
  startDate           DateTime?
  endDate             DateTime?
  description         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @default(now()) @updatedAt

  designerId          String?
  designer            User?         @relation("Designer", fields: [designerId], references: [id])

  projectManagerId    String?
  projectManager      User?         @relation("ProjectManager", fields: [projectManagerId], references: [id])

  decorationCompanyId String?
  decorationCompany   DecorationCompany? @relation(fields: [decorationCompanyId], references: [id])

  quotations          Quotation[]
  extraItems          ExtraItem[]
  phases              ProjectPhase[]
  budgetChanges       BudgetChange[]
  inspections         InspectionTask[]
  acceptances         Acceptance[]
  designPlans         DesignPlan[]
  complaints          Complaint[]
  contractRisks       ContractRisk[]
  changeHistories     ChangeHistory[]
}

model ProjectPhase {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  isCurrent   Boolean  @default(false)
  completedAt DateTime?
  remark      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Quotation {
  id           String          @id @default(cuid())
  projectId    String
  version      Int             @default(1)
  amount       Decimal         @db.Decimal(12, 2)
  status       QuotationStatus @default(DRAFT)
  items        Json[]
  remark       String?
  confirmedAt  DateTime?
  confirmedById String?
  rejectedReason String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @default(now()) @updatedAt

  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  confirmedBy  User?           @relation("QuotationConfirmer", fields: [confirmedById], references: [id])
}

model ExtraItem {
  id            String          @id @default(cuid())
  projectId     String
  name          String
  description   String
  amount        Decimal         @db.Decimal(12, 2)
  reason        String?
  status        ExtraItemStatus @default(DRAFT)
  confirmedAt   DateTime?
  confirmedById String?
  rejectedReason String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt

  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  confirmedBy   User?           @relation("ExtraItemConfirmer", fields: [confirmedById], references: [id])
}

model BudgetChange {
  id              String           @id @default(cuid())
  projectId       String
  oldBudget       Decimal          @db.Decimal(12, 2)
  newBudget       Decimal          @db.Decimal(12, 2)
  changeAmount    Decimal          @db.Decimal(12, 2)
  changePercent   Float
  reason          String
  isAbnormal      Boolean          @default(false)
  alertLevel      BudgetAlertLevel @default(NORMAL)
  responsibleId   String?
  remark          String?
  createdAt       DateTime         @default(now())
  createdById     String?

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  responsible     User?            @relation("BudgetChangeResponsible", fields: [responsibleId], references: [id])
  createdBy       User?            @relation("BudgetChangeCreator", fields: [createdById], references: [id])
}

model InspectionTask {
  id            String           @id @default(cuid())
  projectId     String
  title         String
  description   String?
  scheduledDate DateTime
  completedDate DateTime?
  status        InspectionStatus @default(PENDING)
  result        String?
  issues        Json[]
  inspectorId   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt

  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inspector     User?            @relation("Inspector", fields: [inspectorId], references: [id])
}

model Acceptance {
  id            String           @id @default(cuid())
  projectId     String
  title         String
  description   String?
  scheduledDate DateTime
  completedDate DateTime?
  status        AcceptanceStatus @default(PENDING)
  feedback      String?
  rectifyItems  Json[]
  passedItems   Json[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt

  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model DesignPlan {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  version     String
  fileUrl     String?
  description String?
  isActive    Boolean  @default(false)
  approvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Complaint {
  id            String           @id @default(cuid())
  projectId     String
  title         String
  description   String
  priority      ComplaintPriority @default(MEDIUM)
  status        ComplaintStatus  @default(OPEN)
  clientName    String
  clientContact String
  assignedToId  String?
  decorationCompanyId String?
  bossNotified  Boolean          @default(false)
  notifiedAt    DateTime?
  resolvedAt    DateTime?
  resolution    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt

  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  decorationCompany DecorationCompany? @relation(fields: [decorationCompanyId], references: [id])
  assignedTo        User?              @relation("ComplaintAssignee", fields: [assignedToId], references: [id])
}

model ContractRisk {
  id          String     @id @default(cuid())
  projectId   String
  title       String
  description String
  riskLevel   RiskLevel  @default(MEDIUM)
  category    String
  mitigation  String?
  isResolved  Boolean    @default(false)
  resolvedAt  DateTime?
  reportMonth String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt

  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ChangeHistory {
  id              String   @id @default(cuid())
  projectId       String
  entityType      String
  entityId        String
  fieldName       String
  oldValue        String?
  newValue        String?
  changeType      String
  responsibleId   String?
  remark          String?
  createdAt       DateTime @default(now())
  createdById     String?

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  responsible     User?    @relation("ChangeResponsible", fields: [responsibleId], references: [id])
  createdBy       User?    @relation("ChangeCreator", fields: [createdById], references: [id])
}
