generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  passwordHash  String
  role          String          @db.VarChar(50)
  name          String
  athleteId     String?         @unique
  athlete       Athlete?        @relation(fields: [athleteId], references: [id])
  filterPresets FilterPreset[]
  createdAt     DateTime        @default(now())

  @@index([role])
}

model Athlete {
  id         String           @id @default(uuid())
  name       String
  team       String?
  sport      String
  position   String?
  birthDate  DateTime?
  user       User?
  training   TrainingData[]
  strength   StrengthData[]
  recovery   RecoveryData[]
  injuries   InjuryRecord[]
  createdAt  DateTime         @default(now())

  @@index([sport])
}

model TrainingData {
  id            String   @id @default(uuid())
  athleteId     String
  athlete       Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  date          DateTime
  sessionType   String   @db.VarChar(100)
  durationMin   Int
  avgHeartRate  Int?
  maxHeartRate  Int?
  paceKmPerH    Decimal? @db.Decimal(5, 2)
  distanceKm    Decimal? @db.Decimal(6, 2)
  loadScore     Int
  rpe           Int?
  source        String?  @db.VarChar(100)
  createdAt     DateTime @default(now())

  @@index([athleteId, date])
}

model StrengthData {
  id           String   @id @default(uuid())
  athleteId    String
  athlete      Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  date         DateTime
  exercise     String   @db.VarChar(100)
  weightKg     Decimal  @db.Decimal(5, 1)
  reps         Int
  sets         Int
  estimated1Rm Decimal? @db.Decimal(5, 1)
  notes        String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([athleteId, exercise])
}

model RecoveryData {
  id             String   @id @default(uuid())
  athleteId      String
  athlete        Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  date           DateTime
  sleepScore     Int?
  hrv            Int?
  sorenessScore  Int?
  moodScore      Int?
  overallScore   Int
  source         String?  @db.VarChar(100)
  createdAt      DateTime @default(now())

  @@index([athleteId, date])
}

model InjuryRecord {
  id          String   @id @default(uuid())
  athleteId   String
  athlete     Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  date        DateTime
  injuryType  String   @db.VarChar(100)
  severity    String   @db.VarChar(20)
  description String   @db.Text
  notes       String?  @db.Text
  status      String   @default("active") @db.VarChar(20)
  returnDate  DateTime?
  createdAt   DateTime @default(now())

  @@index([athleteId])
  @@index([status])
}

model FilterPreset {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(255)
  isDefault Boolean  @default(false)
  filters   String   @db.JsonB
  createdAt DateTime @default(now())

  @@index([userId])
}

model EtlLog {
  id               String    @id @default(uuid())
  source           String    @db.VarChar(100)
  status           String    @db.VarChar(20)
  recordsProcessed Int       @default(0)
  errors           String?   @db.Text
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?

  @@index([status])
  @@index([startedAt])
}
