<div class="container mx-auto px-4 py-8 max-w-2xl">
  <div class="mb-6">
    <%= link_to "返回用户列表", admin_users_path, class: "text-blue-600 hover:text-blue-800" %>
  </div>

  <h1 class="text-3xl font-bold mb-6">编辑用户</h1>

  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with model: [:admin, @user] do |form| %>
      <% if @user.errors.any? %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
          <ul>
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="space-y-4">
        <div>
          <%= form.label :name, "姓名", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.text_field :name, class: "w-full rounded-md border-gray-300" %>
        </div>
        <div>
          <%= form.label :email, "邮箱", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.email_field :email, class: "w-full rounded-md border-gray-300" %>
        </div>
        <div>
          <%= form.label :phone, "电话", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.text_field :phone, class: "w-full rounded-md border-gray-300" %>
        </div>
        <div>
          <%= form.label :role, "角色", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.select :role, User.roles.keys.map { |k| [k.humanize, k] }, {}, class: "w-full rounded-md border-gray-300" %>
        </div>
      </div>

      <div class="mt-6 flex justify-end space-x-3">
        <%= link_to "取消", admin_users_path, class: "px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50" %>
        <%= form.submit "保存", class: "bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700" %>
      </div>
    <% end %>
  </div>
</div>
