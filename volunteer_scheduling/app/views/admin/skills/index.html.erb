<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold">技能管理</h1>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-xl font-bold mb-4">创建新技能</h2>
      <%= form_with model: [:admin, @skill], url: admin_skills_path do |form| %>
        <% if @skill.errors.any? %>
          <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
            <ul>
              <% @skill.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="space-y-4">
          <div>
            <%= form.label :name, "技能名称", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.text_field :name, class: "w-full rounded-md border-gray-300" %>
          </div>
          <div>
            <%= form.label :category, "分类", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.select :category, [["医疗健康", "medical"], ["教育培训", "education"], ["社区服务", "community"], ["应急救援", "emergency"], ["技术支持", "technical"], ["其他", "other"]], {}, class: "w-full rounded-md border-gray-300" %>
          </div>
          <div>
            <%= form.label :description, "描述", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.text_area :description, rows: 2, class: "w-full rounded-md border-gray-300" %>
          </div>
        </div>

        <div class="mt-4">
          <%= form.submit "创建技能", class: "bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700" %>
        </div>
      <% end %>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-xl font-bold mb-4">现有技能</h2>
      <% if @skills.any? %>
        <div class="space-y-2">
          <% @skills.each do |skill| %>
            <div class="flex justify-between items-center p-3 bg-gray-50 rounded">
              <div>
                <span class="font-medium"><%= skill.name %></span>
                <span class="ml-2 px-2 py-0.5 bg-blue-100 text-blue-800 text-xs rounded"><%= skill.category.humanize %></span>
              </div>
              <%= button_to "删除", admin_skill_path(skill), method: :delete, class: "text-red-600 hover:text-red-800 text-sm", data: { confirm: "确定删除？" } %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500">暂无技能</p>
      <% end %>
    </div>
  </div>
</div>
