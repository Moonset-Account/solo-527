<div class="container mx-auto px-4 py-8 max-w-2xl">
  <div class="mb-6">
    <%= link_to "返回档案", volunteer_profile_path, class: "text-blue-600 hover:text-blue-800" %>
  </div>

  <h1 class="text-3xl font-bold mb-6">管理可服务时段</h1>

  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with url: update_availabilities_volunteer_profile_path, method: :patch do |form| %>
      <div id="availabilities-container" class="space-y-4">
        <% day_names = %w[周日 周一 周二 周三 周四 周五 周六] %>
        <% current_avails = @volunteer_profile.availabilities.to_a %>
        <% (0..6).each do |i| %>
          <% avail = current_avails.find { |a| a.day_of_week == i } %>
          <div class="flex items-center space-x-4 p-3 border rounded-lg">
            <div class="w-20">
              <%= select_tag "availabilities[#{i}][day_of_week]", options_for_select(day_names.each_with_index.to_a, i), class: "w-full rounded-md border-gray-300" %>
            </div>
            <div class="flex items-center space-x-2">
              <%= time_field_tag "availabilities[#{i}][start_time]", avail&.start_time&.strftime("%H:%M"), class: "rounded-md border-gray-300" %>
              <span class="text-gray-500">至</span>
              <%= time_field_tag "availabilities[#{i}][end_time]", avail&.end_time&.strftime("%H:%M"), class: "rounded-md border-gray-300" %>
            </div>
          </div>
        <% end %>
      </div>

      <div class="mt-6 flex justify-end space-x-3">
        <%= link_to "取消", volunteer_profile_path, class: "px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50" %>
        <%= form.submit "保存时段", class: "bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700" %>
      </div>
    <% end %>
  </div>
</div>
