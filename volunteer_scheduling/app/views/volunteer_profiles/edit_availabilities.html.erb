<div class="container mx-auto px-4 py-8 max-w-2xl">
  <div class="mb-6">
    <%= link_to "返回档案", volunteer_profile_path, class: "text-blue-600 hover:text-blue-800" %>
  </div>

  <h1 class="text-3xl font-bold mb-6">管理可服务时段</h1>

  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with url: update_availabilities_volunteer_profile_path, method: :patch do |form| %>
      <div class="space-y-4">
        <% day_names = %w[周日 周一 周二 周三 周四 周五 周六] %>
        <% current_avails = @volunteer_profile.availabilities.index_by(&:day_of_week) %>
        
        <% (0..6).each do |day| %>
          <% avail = current_avails[day] %>
          <div class="flex items-center space-x-4 p-4 border rounded-lg bg-gray-50">
            <div class="w-24 font-medium">
              <%= day_names[day] %>
            </div>
            <div class="flex items-center space-x-3 flex-1">
              <% if avail %>
                <%= time_field_tag "availabilities[#{day}][start_time]", avail.start_time.strftime("%H:%M"), class: "rounded-md border-gray-300" %>
                <span class="text-gray-500">至</span>
                <%= time_field_tag "availabilities[#{day}][end_time]", avail.end_time.strftime("%H:%M"), class: "rounded-md border-gray-300" %>
                <%= hidden_field_tag "availabilities[#{day}][day_of_week]", day %>
                <%= check_box_tag "availabilities[#{day}][_destroy]", "1", false, class: "ml-4" %>
                <span class="text-sm text-gray-500">删除</span>
              <% else %>
                <%= time_field_tag "availabilities[#{day}][start_time]", "", class: "rounded-md border-gray-300" %>
                <span class="text-gray-500">至</span>
                <%= time_field_tag "availabilities[#{day}][end_time]", "", class: "rounded-md border-gray-300" %>
                <%= hidden_field_tag "availabilities[#{day}][day_of_week]", day %>
                <span class="text-sm text-gray-400 ml-4">（留空则不设置）</span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <div class="mt-6 flex justify-end space-x-3">
        <%= link_to "取消", volunteer_profile_path, class: "px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50" %>
        <%= form.submit "保存时段", class: "bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700" %>
      </div>
    <% end %>
  </div>
</div>
