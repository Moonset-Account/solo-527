<div class="container mx-auto px-4 py-8 max-w-2xl">
  <div class="mb-6">
    <%= link_to "返回档案", volunteer_profile_path, class: "text-blue-600 hover:text-blue-800" %>
  </div>

  <h1 class="text-3xl font-bold mb-6">监护人信息</h1>

  <% if @volunteer_profile.is_minor? %>
    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-6">
      <p class="text-yellow-800 text-sm">
        <strong>注意：</strong>您是未成年人，必须填写至少一位监护人信息才能完成档案。
      </p>
    </div>
  <% end %>

  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with url: update_guardians_volunteer_profile_path, method: :patch do |form| %>
      <div id="guardians-container" class="space-y-4">
        <% current_guardians = @volunteer_profile.guardians.to_a %>
        
        <% 2.times do |i| %>
          <% g = current_guardians[i] %>
          <div class="p-4 border rounded-lg bg-gray-50">
            <h3 class="font-medium mb-3">监护人 <%= i + 1 %></h3>
            <div class="grid grid-cols-3 gap-3">
              <div>
                <%= label_tag "guardians_#{i}_name", "姓名", class: "block text-sm text-gray-600 mb-1" %>
                <%= text_field_tag "guardians[#{i}][name]", g&.name, placeholder: "请输入姓名", class: "w-full rounded-md border-gray-300" %>
              </div>
              <div>
                <%= label_tag "guardians_#{i}_relationship", "关系", class: "block text-sm text-gray-600 mb-1" %>
                <%= text_field_tag "guardians[#{i}][relationship]", g&.relationship, placeholder: "如：父亲、母亲", class: "w-full rounded-md border-gray-300" %>
              </div>
              <div>
                <%= label_tag "guardians_#{i}_phone", "电话", class: "block text-sm text-gray-600 mb-1" %>
                <%= text_field_tag "guardians[#{i}][phone]", g&.phone, placeholder: "联系电话", class: "w-full rounded-md border-gray-300" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <div class="mt-6 flex justify-end space-x-3">
        <%= link_to "取消", volunteer_profile_path, class: "px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50" %>
        <%= form.submit "保存监护人信息", class: "bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700" %>
      </div>
    <% end %>
  </div>
</div>
