<div class="container mx-auto px-4 py-8 max-w-4xl">
  <div class="mb-6">
    <%= link_to "返回档案", volunteer_profile_path, class: "text-blue-600 hover:text-blue-800" %>
  </div>

  <h1 class="text-3xl font-bold mb-6">编辑个人档案</h1>

  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with model: @volunteer_profile do |form| %>
      <% if @volunteer_profile.errors.any? %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
          <ul>
            <% @volunteer_profile.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="space-y-6">
        <div>
          <h2 class="text-xl font-bold mb-4">基本信息</h2>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <%= form.label :birth_date, "出生日期", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.date_field :birth_date, class: "w-full rounded-md border-gray-300" %>
              <p class="text-xs text-gray-500 mt-1">必填，用于计算年龄和判断是否为未成年人</p>
            </div>
            <div>
              <%= form.label :gender, "性别", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.select :gender, [["请选择", ""], ["男", "male"], ["女", "female"], ["其他", "other"]], {}, class: "w-full rounded-md border-gray-300" %>
            </div>
            <div class="col-span-2">
              <%= form.label :address, "居住地址", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.text_field :address, class: "w-full rounded-md border-gray-300" %>
            </div>
            <div class="col-span-2">
              <%= form.label :bio, "个人简介", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.text_area :bio, rows: 3, class: "w-full rounded-md border-gray-300" %>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-6 flex justify-end space-x-3">
        <%= link_to "取消", volunteer_profile_path, class: "px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50" %>
        <%= form.submit "保存", class: "bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700" %>
      </div>
    <% end %>
  </div>
</div>
