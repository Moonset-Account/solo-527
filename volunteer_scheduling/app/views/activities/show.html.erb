<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "返回活动列表", activities_path, class: "text-blue-600 hover:text-blue-800" %>
  </div>

  <div class="bg-white rounded-lg shadow p-6 mb-6">
    <div class="flex justify-between items-start mb-4">
      <div>
        <h1 class="text-3xl font-bold mb-2"><%= @activity.title %></h1>
        <div class="flex items-center space-x-4 text-gray-600">
          <span>负责人：<%= @activity.project_manager&.name %></span>
          <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
            <%= case @activity.status
                 when 'draft' then 'bg-gray-100 text-gray-800'
                 when 'published' then 'bg-green-100 text-green-800'
                 when 'in_progress' then 'bg-blue-100 text-blue-800'
                 when 'completed' then 'bg-purple-100 text-purple-800'
                 else 'bg-red-100 text-red-800'
                 end %>">
            <%= @activity.status.humanize %>
          </span>
        </div>
      </div>
      <div class="space-x-2">
        <% if policy(@activity).edit? %>
          <%= link_to "编辑", edit_activity_path(@activity), class: "text-yellow-600 hover:text-yellow-800" %>
        <% end %>
        <% if policy(@activity).publish? && @activity.draft? %>
          <%= button_to "发布活动", publish_activity_path(@activity), method: :post, class: "bg-green-600 text-white px-3 py-1 rounded hover:bg-green-700" %>
        <% end %>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4 mb-4 text-gray-600">
      <div>
        <strong>开始时间：</strong><%= @activity.start_time&.strftime("%Y年%m月%d日 %H:%M") %>
      </div>
      <div>
        <strong>结束时间：</strong><%= @activity.end_time&.strftime("%Y年%m月%d日 %H:%M") %>
      </div>
      <div>
        <strong>活动分类：</strong><%= @activity.category&.humanize %>
      </div>
      <div>
        <strong>需求人数：</strong><%= @activity.volunteers_needed %> 人
      </div>
    </div>

    <div class="mb-4">
      <strong class="text-gray-700">活动描述：</strong>
      <p class="mt-1 text-gray-600"><%= @activity.description %></p>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-6 mb-6">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-xl font-bold">活动点位</h2>
      <% if policy(@activity).edit? %>
        <%= link_to "添加点位", new_activity_location_path(@activity), class: "bg-blue-600 text-white px-3 py-1 rounded hover:bg-blue-700 text-sm" %>
      <% end %>
    </div>
    <% if @locations.any? %>
      <div class="space-y-4">
        <% @locations.each do |location| %>
          <div class="border rounded-lg p-4">
            <div class="flex justify-between">
              <div>
                <h3 class="font-semibold"><%= location.name %></h3>
                <p class="text-gray-600 text-sm"><%= location.address %></p>
                <p class="text-gray-500 text-sm mt-1">
                  需要技能：<%= location.required_skills.pluck(:name).join(", ") %>
                </p>
              </div>
              <div class="text-right">
                <p class="text-sm text-gray-500">已排班：<%= location.assignments.count %> 人</p>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-500">暂无点位</p>
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-xl font-bold">排班管理</h2>
      <% if policy(@activity).assign_volunteers? %>
        <%= link_to "智能推荐排班", recommendations_activity_assignments_path(@activity), class: "bg-purple-600 text-white px-3 py-1 rounded hover:bg-purple-700 text-sm" %>
        <%= link_to "手动排班", new_activity_assignment_path(@activity), class: "bg-blue-600 text-white px-3 py-1 rounded hover:bg-blue-700 text-sm ml-2" %>
      <% end %>
    </div>
    <% if @assignments.any? %>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-2 text-left text-sm font-medium text-gray-500">志愿者</th>
              <th class="px-4 py-2 text-left text-sm font-medium text-gray-500">点位</th>
              <th class="px-4 py-2 text-left text-sm font-medium text-gray-500">匹配原因</th>
              <th class="px-4 py-2 text-left text-sm font-medium text-gray-500">状态</th>
              <th class="px-4 py-2 text-left text-sm font-medium text-gray-500">操作</th>
            </tr>
          </thead>
          <tbody class="divide-y">
            <% @assignments.each do |assignment| %>
              <tr>
                <td class="px-4 py-3"><%= assignment.volunteer_profile.user.name %></td>
                <td class="px-4 py-3"><%= assignment.location&.name %></td>
                <td class="px-4 py-3 text-sm text-gray-600"><%= assignment.match_reason %></td>
                <td class="px-4 py-3">
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                    <%= case assignment.status
                         when 'pending' then 'bg-yellow-100 text-yellow-800'
                         when 'accepted' then 'bg-green-100 text-green-800'
                         when 'declined' then 'bg-red-100 text-red-800'
                         else 'bg-gray-100 text-gray-800'
                         end %>">
                    <%= assignment.status.humanize %>
                  </span>
                </td>
                <td class="px-4 py-3 text-sm space-x-2">
                  <%= link_to "详情", assignment_path(assignment), class: "text-blue-600" %>
                  <% if policy(assignment).swap? %>
                    <%= link_to "调换", assignment_path(assignment), class: "text-orange-600" %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-gray-500">暂无排班</p>
    <% end %>
  </div>
</div>
