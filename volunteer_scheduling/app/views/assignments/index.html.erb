<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold mb-6">排班管理</h1>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="w-full">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">活动</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">志愿者</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">点位</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">状态</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">操作</th>
        </tr>
      </thead>
      <tbody class="divide-y">
        <% @assignments.each do |assignment| %>
          <tr>
            <td class="px-6 py-4">
              <div class="text-sm font-medium"><%= assignment.activity.title %></div>
              <div class="text-xs text-gray-500"><%= assignment.activity.start_time&.strftime("%m-%d %H:%M") %></div>
            </td>
            <td class="px-6 py-4 text-sm"><%= assignment.volunteer_profile.user.name %></td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= assignment.location&.name %></td>
            <td class="px-6 py-4">
              <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                <%= case assignment.status
                     when 'pending' then 'bg-yellow-100 text-yellow-800'
                     when 'accepted' then 'bg-green-100 text-green-800'
                     when 'declined' then 'bg-red-100 text-red-800'
                     when 'swapped' then 'bg-purple-100 text-purple-800'
                     else 'bg-gray-100 text-gray-800'
                     end %>">
                <%= assignment.status.humanize %>
              </span>
            </td>
            <td class="px-6 py-4 text-sm space-x-2">
              <%= link_to "详情", assignment_path(assignment), class: "text-blue-600 hover:text-blue-800" %>
              <% if policy(assignment).accept? && assignment.pending? %>
                <%= button_to "确认", accept_assignment_path(assignment), method: :post, class: "text-green-600 hover:text-green-800 bg-transparent border-none p-0 cursor-pointer" %>
                <%= button_to "拒绝", decline_assignment_path(assignment), method: :post, class: "text-red-600 hover:text-red-800 bg-transparent border-none p-0 cursor-pointer" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
