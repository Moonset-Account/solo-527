<div class="container mx-auto px-4 py-8 max-w-2xl">
  <div class="mb-6">
    <%= link_to "返回证明列表", service_certificates_path, class: "text-blue-600 hover:text-blue-800" %>
  </div>

  <h1 class="text-3xl font-bold mb-6">申请服务证明</h1>

  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with url: service_certificates_path do |form| %>
      <% if flash[:alert].present? %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <div class="space-y-4">
        <% if current_user.admin? %>
          <div>
            <%= form.label :volunteer_profile_id, "选择志愿者", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.select :volunteer_profile_id, VolunteerProfile.all.map { |vp| [vp.user.name, vp.id] }, {}, class: "w-full rounded-md border-gray-300" %>
          </div>
        <% end %>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= form.label :start_date, "开始日期", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.date_field :start_date, class: "w-full rounded-md border-gray-300" %>
          </div>
          <div>
            <%= form.label :end_date, "结束日期", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.date_field :end_date, class: "w-full rounded-md border-gray-300" %>
          </div>
        </div>

        <div class="bg-blue-50 p-4 rounded-lg">
          <p class="text-sm text-blue-700">
            <strong>提示：</strong>系统将自动统计该时间段内已审核通过的服务时长。
          </p>
          <% if current_user.volunteer? %>
            <p class="text-sm text-blue-600 mt-2">
              您目前累计服务时长：<strong><%= current_user.volunteer_profile.total_service_hours.round(1) %></strong> 小时
            </p>
          <% end %>
        </div>
      </div>

      <div class="mt-6 flex justify-end space-x-3">
        <%= link_to "取消", service_certificates_path, class: "px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50" %>
        <%= form.submit "申请开具", class: "bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700" %>
      </div>
    <% end %>
  </div>
</div>
