<div class="space-y-4">
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold">排班管理</h1>
    <%= link_to "新建排班", new_admin_schedule_path, class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
  </div>

  <div class="bg-white rounded-lg shadow p-4">
    <%= form_with url: admin_schedules_path, method: :get, local: true, class: "flex gap-2" do |f| %>
      <%= f.date_field :start_date, value: params[:start_date], class: "border rounded px-3 py-2" %>
      <%= f.date_field :end_date, value: params[:end_date], class: "border rounded px-3 py-2" %>
      <%= f.submit "筛选", class: "bg-gray-200 px-4 py-2 rounded hover:bg-gray-300 cursor-pointer" %>
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="w-full">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">技师</th>
          <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">日期</th>
          <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">上班时间</th>
          <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">下班时间</th>
          <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">状态</th>
          <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">操作</th>
        </tr>
      </thead>
      <tbody class="divide-y">
        <% @schedules.each do |s| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3"><%= s.technician.name %></td>
            <td class="px-4 py-3"><%= s.work_date.strftime("%Y-%m-%d") %></td>
            <td class="px-4 py-3"><%= s.start_time&.strftime("%H:%M") %></td>
            <td class="px-4 py-3"><%= s.end_time&.strftime("%H:%M") %></td>
            <td class="px-4 py-3"><%= s.status.humanize %></td>
            <td class="px-4 py-3 space-x-2">
              <%= link_to "编辑", edit_admin_schedule_path(s), class: "text-blue-600 hover:underline" %>
              <%= button_to "删除", admin_schedule_path(s), method: :delete, class: "text-red-600 hover:underline cursor-pointer bg-transparent border-0 p-0" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
