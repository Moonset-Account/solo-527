<div class="space-y-4">
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold">提醒规则管理</h1>
    <%= link_to "新建规则", new_admin_consumable_rule_path, class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="w-full">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">规则名称</th>
          <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">关联疗程</th>
          <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">次数阈值</th>
          <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">百分比阈值</th>
          <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">状态</th>
          <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">操作</th>
        </tr>
      </thead>
      <tbody class="divide-y">
        <% @consumable_rules.each do |rule| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3"><%= rule.name %></td>
            <td class="px-4 py-3"><%= rule.treatment.name %></td>
            <td class="px-4 py-3"><%= rule.threshold_sessions %>次</td>
            <td class="px-4 py-3"><%= rule.threshold_percentage ? "#{rule.threshold_percentage}%" : "-" %></td>
            <td class="px-4 py-3"><%= rule.active ? tag.span("启用", class: "text-green-600") : tag.span("停用", class: "text-red-600") %></td>
            <td class="px-4 py-3 space-x-2">
              <%= link_to "编辑", edit_admin_consumable_rule_path(rule), class: "text-blue-600 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
