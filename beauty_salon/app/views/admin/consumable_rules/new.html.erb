<div class="max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold mb-4">新建提醒规则</h1>
  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with model: [:admin, @consumable_rule], local: true do |f| %>
      <div class="space-y-4">
        <div>
          <%= f.label :name, "规则名称", class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_field :name, class: "mt-1 block w-full border rounded px-3 py-2" %>
        </div>
        <div>
          <%= f.label :treatment_id, "关联疗程", class: "block text-sm font-medium text-gray-700" %>
          <%= f.select :treatment_id, @treatments.map { |t| [t.name, t.id] }, {}, class: "mt-1 block w-full border rounded px-3 py-2" %>
        </div>
        <div>
          <%= f.label :threshold_sessions, "次数阈值（剩余次数<=此值触发）", class: "block text-sm font-medium text-gray-700" %>
          <%= f.number_field :threshold_sessions, class: "mt-1 block w-full border rounded px-3 py-2" %>
        </div>
        <div>
          <%= f.label :threshold_percentage, "百分比阈值（剩余比例<=此值触发）", class: "block text-sm font-medium text-gray-700" %>
          <%= f.number_field :threshold_percentage, step: 0.1, class: "mt-1 block w-full border rounded px-3 py-2" %>
        </div>
        <div class="flex gap-2">
          <%= f.submit "创建", class: "bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 cursor-pointer" %>
          <%= link_to "取消", admin_consumable_rules_path, class: "bg-gray-200 px-6 py-2 rounded hover:bg-gray-300" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
