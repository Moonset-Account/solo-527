<div class="space-y-4">
  <h1 class="text-2xl font-bold"><%= @notification.title %></h1>

  <div class="bg-white rounded-lg shadow p-6">
    <div class="space-y-3">
      <div class="flex items-center gap-2">
        <% if @notification.urgent? %>
          <span class="px-2 py-0.5 bg-red-100 text-red-700 text-xs rounded-full">紧急</span>
        <% end %>
        <span class="px-2 py-0.5 bg-gray-100 text-gray-600 text-xs rounded-full"><%= @notification.category.humanize %></span>
      </div>
      <p class="text-gray-600"><%= @notification.body %></p>
      <p class="text-sm text-gray-400"><%= @notification.created_at.strftime("%Y-%m-%d %H:%M:%S") %></p>
    </div>
  </div>

  <%= link_to "← 返回消息中心", admin_notifications_path, class: "text-blue-600 hover:underline" %>
</div>
