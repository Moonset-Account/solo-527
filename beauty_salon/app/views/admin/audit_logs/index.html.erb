<div class="space-y-4">
  <h1 class="text-2xl font-bold">审核日志</h1>

  <div class="bg-white rounded-lg shadow p-4">
    <%= form_with url: admin_audit_logs_path, method: :get, local: true, class: "flex gap-2 flex-wrap" do |f| %>
      <%= f.select :auditable_type, ["TreatmentCard", "Appointment", "CheckIn", "Schedule", "Treatment"], { selected: params[:auditable_type], prompt: "全部类型" }, class: "border rounded px-3 py-2" %>
      <%= f.select :action_type, ["create", "update", "destroy", "session_change", "expire"], { selected: params[:action_type], prompt: "全部操作" }, class: "border rounded px-3 py-2" %>
      <%= f.date_field :start_date, value: params[:start_date], class: "border rounded px-3 py-2" %>
      <%= f.date_field :end_date, value: params[:end_date], class: "border rounded px-3 py-2" %>
      <%= f.submit "筛选", class: "bg-gray-200 px-4 py-2 rounded hover:bg-gray-300 cursor-pointer" %>
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="w-full">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">时间</th>
          <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">类型</th>
          <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">操作</th>
          <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">描述</th>
          <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">变更详情</th>
        </tr>
      </thead>
      <tbody class="divide-y">
        <% @audit_logs.each do |log| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 text-sm"><%= log.created_at.strftime("%Y-%m-%d %H:%M") %></td>
            <td class="px-4 py-3"><%= log.auditable_type %></td>
            <td class="px-4 py-3"><%= log.action.humanize %></td>
            <td class="px-4 py-3"><%= log.description %></td>
            <td class="px-4 py-3">
              <% if log.changes_data.present? %>
                <details>
                  <summary class="text-blue-600 cursor-pointer text-sm">查看变更</summary>
                  <pre class="mt-1 text-xs bg-gray-50 p-2 rounded overflow-auto max-h-40"><%= JSON.pretty_generate(log.changes_data) %></pre>
                </details>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
