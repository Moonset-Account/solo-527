<div class="space-y-4">
  <h1 class="text-2xl font-bold">审核日志详情</h1>

  <div class="bg-white rounded-lg shadow p-6">
    <div class="grid grid-cols-2 gap-4">
      <div><p class="text-sm text-gray-500">操作类型</p><p class="text-lg"><%= @audit_log.auditable_type %></p></div>
      <div><p class="text-sm text-gray-500">操作</p><p class="text-lg"><%= @audit_log.action.humanize %></p></div>
      <div><p class="text-sm text-gray-500">时间</p><p class="text-lg"><%= @audit_log.created_at.strftime("%Y-%m-%d %H:%M:%S") %></p></div>
      <div><p class="text-sm text-gray-500">描述</p><p class="text-lg"><%= @audit_log.description %></p></div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-lg font-semibold mb-3">变更详情</h2>
    <% if @audit_log.changes_data.present? %>
      <pre class="bg-gray-50 p-4 rounded overflow-auto"><%= JSON.pretty_generate(@audit_log.changes_data) %></pre>
    <% else %>
      <p class="text-gray-500">无变更数据</p>
    <% end %>
  </div>

  <%= link_to "← 返回列表", admin_audit_logs_path, class: "text-blue-600 hover:underline" %>
</div>
