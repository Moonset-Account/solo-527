<div class="max-w-3xl mx-auto">
  <h1 class="text-2xl font-bold mb-4">新建疗程卡</h1>
  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with model: [:admin, @treatment_card], local: true do |f| %>
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= f.label :customer_id, "客户", class: "block text-sm font-medium text-gray-700" %>
            <%= f.select :customer_id, Customer.pluck(:name, :id), {}, class: "mt-1 block w-full border rounded px-3 py-2" %>
          </div>
          <div>
            <%= f.label :card_number, "卡号", class: "block text-sm font-medium text-gray-700" %>
            <%= f.text_field :card_number, class: "mt-1 block w-full border rounded px-3 py-2" %>
          </div>
          <div>
            <%= f.label :total_amount, "总金额", class: "block text-sm font-medium text-gray-700" %>
            <%= f.number_field :total_amount, step: 0.01, class: "mt-1 block w-full border rounded px-3 py-2" %>
          </div>
          <div>
            <%= f.label :remaining_amount, "剩余金额", class: "block text-sm font-medium text-gray-700" %>
            <%= f.number_field :remaining_amount, step: 0.01, class: "mt-1 block w-full border rounded px-3 py-2" %>
          </div>
          <div>
            <%= f.label :purchased_at, "购买日期", class: "block text-sm font-medium text-gray-700" %>
            <%= f.date_field :purchased_at, class: "mt-1 block w-full border rounded px-3 py-2" %>
          </div>
          <div>
            <%= f.label :expired_at, "到期日期", class: "block text-sm font-medium text-gray-700" %>
            <%= f.date_field :expired_at, class: "mt-1 block w-full border rounded px-3 py-2" %>
          </div>
        </div>

        <div class="border-t pt-4">
          <h3 class="text-lg font-medium mb-3">疗程项目明细</h3>
          <div id="card-items">
            <%= f.fields_for :treatment_card_items do |item_form| %>
              <div class="grid grid-cols-3 gap-4 mb-2">
                <div>
                  <%= item_form.select :treatment_id, Treatment.active_only.pluck(:name, :id), { prompt: "选择疗程" }, class: "block w-full border rounded px-3 py-2" %>
                </div>
                <div>
                  <%= item_form.number_field :total_sessions, placeholder: "总次数", class: "block w-full border rounded px-3 py-2" %>
                </div>
                <div>
                  <%= item_form.number_field :remaining_sessions, placeholder: "剩余次数", class: "block w-full border rounded px-3 py-2" %>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <div class="flex gap-2">
          <%= f.submit "创建", class: "bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 cursor-pointer" %>
          <%= link_to "取消", admin_treatment_cards_path, class: "bg-gray-200 px-6 py-2 rounded hover:bg-gray-300" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
