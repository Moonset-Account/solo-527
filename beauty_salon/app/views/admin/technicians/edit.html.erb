<div class="max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold mb-4">编辑技师</h1>
  <div class="bg-white rounded-lg shadow p-6">
    <%= form_with model: [:admin, @technician], local: true do |f| %>
      <div class="space-y-4">
        <div>
          <%= f.label :name, "姓名", class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_field :name, class: "mt-1 block w-full border rounded px-3 py-2" %>
        </div>
        <div>
          <%= f.label :phone, "手机号", class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_field :phone, class: "mt-1 block w-full border rounded px-3 py-2" %>
        </div>
        <div>
          <%= f.label :specialty, "专长", class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_field :specialty, class: "mt-1 block w-full border rounded px-3 py-2" %>
        </div>
        <div>
          <label class="flex items-center gap-2">
            <%= f.check_box :active, class: "rounded" %>
            <span class="text-sm font-medium text-gray-700">在职</span>
          </label>
        </div>
        <div class="flex gap-2">
          <%= f.submit "保存", class: "bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 cursor-pointer" %>
          <%= link_to "取消", admin_technician_path(@technician), class: "bg-gray-200 px-6 py-2 rounded hover:bg-gray-300" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
