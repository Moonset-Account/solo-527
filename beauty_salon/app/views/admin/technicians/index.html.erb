<div class="space-y-4">
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold">技师管理</h1>
    <%= link_to "新建技师", new_admin_technician_path, class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="w-full">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">姓名</th>
          <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">手机号</th>
          <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">专长</th>
          <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">状态</th>
          <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">操作</th>
        </tr>
      </thead>
      <tbody class="divide-y">
        <% @technicians.each do |t| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3"><%= t.name %></td>
            <td class="px-4 py-3"><%= t.phone %></td>
            <td class="px-4 py-3"><%= t.specialty %></td>
            <td class="px-4 py-3"><%= t.active ? tag.span("在职", class: "text-green-600") : tag.span("离职", class: "text-red-600") %></td>
            <td class="px-4 py-3 space-x-2">
              <%= link_to "查看", admin_technician_path(t), class: "text-blue-600 hover:underline" %>
              <%= link_to "编辑", edit_admin_technician_path(t), class: "text-blue-600 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
