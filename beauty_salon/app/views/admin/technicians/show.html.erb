<div class="space-y-4">
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold"><%= @technician.name %></h1>
    <%= link_to "编辑", edit_admin_technician_path(@technician), class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <div class="grid grid-cols-3 gap-4">
      <div><p class="text-sm text-gray-500">手机号</p><p class="text-lg"><%= @technician.phone %></p></div>
      <div><p class="text-sm text-gray-500">专长</p><p class="text-lg"><%= @technician.specialty %></p></div>
      <div><p class="text-sm text-gray-500">状态</p><p><%= @technician.active ? tag.span("在职", class: "text-green-600") : tag.span("离职", class: "text-red-600") %></p></div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-lg font-semibold mb-3">排班记录</h2>
    <% if @schedules.any? %>
      <table class="w-full">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-2 text-left text-sm text-gray-600">日期</th>
            <th class="px-4 py-2 text-left text-sm text-gray-600">开始时间</th>
            <th class="px-4 py-2 text-left text-sm text-gray-600">结束时间</th>
            <th class="px-4 py-2 text-left text-sm text-gray-600">状态</th>
          </tr>
        </thead>
        <tbody class="divide-y">
          <% @schedules.each do |s| %>
            <tr>
              <td class="px-4 py-2"><%= s.work_date.strftime("%Y-%m-%d") %></td>
              <td class="px-4 py-2"><%= s.start_time&.strftime("%H:%M") %></td>
              <td class="px-4 py-2"><%= s.end_time&.strftime("%H:%M") %></td>
              <td class="px-4 py-2"><%= s.status.humanize %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-gray-500 text-sm">暂无排班记录</p>
    <% end %>
  </div>

  <%= link_to "← 返回列表", admin_technicians_path, class: "text-blue-600 hover:underline" %>
</div>
