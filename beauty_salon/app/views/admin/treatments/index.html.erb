<div class="space-y-4">
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold">疗程项目管理</h1>
    <div class="flex gap-2">
      <%= link_to "新建项目", new_admin_treatment_path, class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
      <%= form_with url: admin_exports_path, method: :post, class: "inline" do |f| %>
        <%= f.hidden_field :model_name, value: "Treatment" %>
        <%= f.submit "导出CSV", class: "bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700 cursor-pointer" %>
      <% end %>
    </div>
  </div>

  <div class="flex gap-2 mb-4">
    <%= link_to "全部", admin_treatments_path, class: "px-3 py-1 rounded #{params[:category].blank? ? 'bg-blue-600 text-white' : 'bg-gray-200'}" %>
    <% @categories.each do |cat| %>
      <%= link_to cat.humanize, admin_treatments_path(category: cat), class: "px-3 py-1 rounded #{params[:category] == cat ? 'bg-blue-600 text-white' : 'bg-gray-200'}" %>
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="w-full">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">名称</th>
          <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">分类</th>
          <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">价格</th>
          <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">时长</th>
          <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">状态</th>
          <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">操作</th>
        </tr>
      </thead>
      <tbody class="divide-y">
        <% @treatments.each do |t| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3"><%= t.name %></td>
            <td class="px-4 py-3"><%= t.category.humanize %></td>
            <td class="px-4 py-3">¥<%= number_with_delimiter(t.price, delimiter: ',') %></td>
            <td class="px-4 py-3"><%= t.duration %>分钟</td>
            <td class="px-4 py-3"><%= t.active ? tag.span("启用", class: "text-green-600") : tag.span("停用", class: "text-red-600") %></td>
            <td class="px-4 py-3 space-x-2">
              <%= link_to "查看", admin_treatment_path(t), class: "text-blue-600 hover:underline" %>
              <%= link_to "编辑", edit_admin_treatment_path(t), class: "text-blue-600 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
