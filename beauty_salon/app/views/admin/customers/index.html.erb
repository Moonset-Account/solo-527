<div class="space-y-4">
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold">客户管理</h1>
    <%= link_to "新建客户", new_admin_customer_path, class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
  </div>

  <div class="bg-white rounded-lg shadow p-4">
    <%= form_with url: admin_customers_path, method: :get, local: true, class: "flex gap-2" do |f| %>
      <%= f.text_field :q, value: params[:q], placeholder: "搜索姓名或手机号...", class: "border rounded px-3 py-2 flex-1" %>
      <%= f.submit "搜索", class: "bg-gray-200 px-4 py-2 rounded hover:bg-gray-300 cursor-pointer" %>
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="w-full">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">姓名</th>
          <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">手机号</th>
          <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">疗程卡</th>
          <th class="px-4 py-3 text-left text-sm font-medium text-gray-600">操作</th>
        </tr>
      </thead>
      <tbody class="divide-y">
        <% @customers.each do |c| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3"><%= c.name %></td>
            <td class="px-4 py-3"><%= c.phone %></td>
            <td class="px-4 py-3"><%= c.treatment_cards.count %></td>
            <td class="px-4 py-3 space-x-2">
              <%= link_to "查看", admin_customer_path(c), class: "text-blue-600 hover:underline" %>
              <%= link_to "编辑", edit_admin_customer_path(c), class: "text-blue-600 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
