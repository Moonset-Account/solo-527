<div class="max-w-4xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-6">疗程项目</h1>

  <div class="flex gap-2 mb-6 flex-wrap">
    <%= link_to "全部", external_treatments_path, class: "px-4 py-2 rounded #{params[:category].blank? ? 'bg-blue-600 text-white' : 'bg-gray-200'}" %>
    <% @categories.each do |cat| %>
      <%= link_to cat.humanize, external_treatments_path(category: cat), class: "px-4 py-2 rounded #{params[:category] == cat ? 'bg-blue-600 text-white' : 'bg-gray-200'}" %>
    <% end %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <% @treatments.each do |treatment| %>
      <div class="border rounded-lg p-4 hover:shadow-md transition-shadow">
        <h2 class="text-lg font-semibold"><%= treatment.name %></h2>
        <p class="text-gray-500 text-sm mt-1"><%= treatment.category.humanize %></p>
        <p class="text-gray-600 text-sm mt-1"><%= treatment.description %></p>
        <div class="mt-3 flex justify-between items-center">
          <span class="text-xl font-bold text-blue-600">¥<%= number_with_delimiter(treatment.price, delimiter: ',') %></span>
          <span class="text-sm text-gray-500"><%= treatment.duration %>分钟</span>
        </div>
      </div>
    <% end %>
  </div>

  <% if @treatments.empty? %>
    <p class="text-center text-gray-500 mt-8">暂无疗程项目</p>
  <% end %>
</div>
