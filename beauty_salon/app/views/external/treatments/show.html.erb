<div class="max-w-2xl mx-auto px-4 py-8">
  <%= link_to "← 返回", external_treatments_path, class: "text-blue-600 hover:underline" %>

  <div class="mt-6 bg-white rounded-lg border p-6">
    <h1 class="text-2xl font-bold"><%= @treatment.name %></h1>
    <p class="text-gray-500 mt-1"><%= @treatment.category.humanize %></p>
    <p class="text-gray-600 mt-3"><%= @treatment.description %></p>
    <div class="mt-4 flex justify-between items-center">
      <span class="text-2xl font-bold text-blue-600">¥<%= number_with_delimiter(@treatment.price, delimiter: ',') %></span>
      <span class="text-gray-500">时长 <%= @treatment.duration %> 分钟</span>
    </div>
  </div>
</div>
