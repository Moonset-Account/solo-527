<!DOCTYPE html>
<html>
<head>
  <title>美容院 - 管理后台</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= stylesheet_link_tag "application" %>
  <%= javascript_importmap_tags %>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen">
  <div class="flex min-h-screen">
    <aside class="w-64 bg-white border-r shadow-sm">
      <div class="p-4 border-b">
        <h1 class="text-xl font-bold text-blue-600">美容院管理</h1>
      </div>
      <nav class="p-4 space-y-1">
        <%= nav_link "仪表盘", admin_root_path %>
        <%= nav_link "客户管理", admin_customers_path %>
        <%= nav_link "疗程项目", admin_treatments_path %>
        <%= nav_link "疗程卡", admin_treatment_cards_path %>
        <%= nav_link "技师管理", admin_technicians_path %>
        <%= nav_link "排班管理", admin_schedules_path %>
        <%= nav_link "预约管理", admin_appointments_path %>
        <%= nav_link "到店核销", admin_check_ins_path %>
        <%= nav_link "审核日志", admin_audit_logs_path %>
        <%= nav_link "消息中心", admin_notifications_path %>
        <%= nav_link "待办事项", admin_todo_items_path %>
        <%= nav_link "提醒规则", admin_consumable_rules_path %>
        <%= nav_link "API异常", admin_api_failure_logs_path %>
      </nav>
    </aside>
    <main class="flex-1 p-6 overflow-auto">
      <% if notice %>
        <div class="mb-4 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded"><%= alert %></div>
      <% end %>
      <%= yield %>
    </main>
  </div>
</body>
</html>
