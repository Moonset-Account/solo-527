{
  "info": {
    "name": "物业报修和巡检系统 API 测试集合",
    "description": "系统核心接口测试用例，包含认证、工单、巡检、消息、文件、费用、满意度等模块",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "ownerToken", "value": "", "type": "string" },
    { "key": "maintToken", "value": "", "type": "string" },
    { "key": "testOrderId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. 认证模块",
      "item": [
        {
          "name": "1.1 物业主管登录",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "params": [
              { "key": "username", "value": "admin" },
              { "key": "password", "value": "123456" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('登录成功', function() { pm.response.to.have.status(200); pm.expect(jsonData.code).to.eql(200); });",
                  "pm.collectionVariables.set('adminToken', jsonData.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 业主登录",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "params": [
              { "key": "username", "value": "owner01" },
              { "key": "password", "value": "123456" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('登录成功', function() { pm.expect(jsonData.code).to.eql(200); });",
                  "pm.collectionVariables.set('ownerToken', jsonData.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 维修人员登录",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "params": [
              { "key": "username", "value": "maint01" },
              { "key": "password", "value": "123456" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('maintToken', jsonData.data.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. 工单模块 - 完整流程测试",
      "item": [
        {
          "name": "2.1 业主提交报修工单",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "url": "{{baseUrl}}/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"API测试-卫生间水龙头漏水\",\n  \"description\": \"卫生间洗手盆水龙头漏水，需要维修处理\",\n  \"category\": \"水电维修\",\n  \"priority\": \"NORMAL\",\n  \"roomId\": 1,\n  \"contactPerson\": \"测试业主\",\n  \"contactPhone\": \"13800000001\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('工单创建成功', function() { pm.expect(jsonData.code).to.eql(200); });",
                  "pm.test('状态为待审核', function() { pm.expect(jsonData.data.status).to.eql('PENDING'); });",
                  "pm.collectionVariables.set('testOrderId', jsonData.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 物业审核并派单",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/:id/approve?approved=true&assigneeId=3",
              "path": ["{{baseUrl}}", "orders", ":id", "approve"],
              "variable": [{ "key": "id", "value": "{{testOrderId}}" }],
              "query": [
                { "key": "approved", "value": "true" },
                { "key": "assigneeId", "value": "3" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('审核通过', function() { pm.expect(jsonData.code).to.eql(200); });",
                  "pm.test('状态为已派单', function() { pm.expect(jsonData.data.status).to.eql('APPROVED'); });",
                  "pm.test('已指派处理人', function() { pm.expect(jsonData.data.assigneeId).to.eql(3); });"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 维修人员开始处理",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{maintToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/:id/start",
              "path": ["{{baseUrl}}", "orders", ":id", "start"],
              "variable": [{ "key": "id", "value": "{{testOrderId}}" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('开始处理成功', function() { pm.expect(jsonData.code).to.eql(200); });",
                  "pm.test('状态为处理中', function() { pm.expect(jsonData.data.status).to.eql('PROCESSING'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "2.4 维修人员完成处理",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{maintToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/:id/complete?handlerRemark=已更换水龙头，测试正常",
              "path": ["{{baseUrl}}", "orders", ":id", "complete"],
              "variable": [{ "key": "id", "value": "{{testOrderId}}" }],
              "query": [
                { "key": "handlerRemark", "value": "已更换水龙头，测试正常" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('处理完成', function() { pm.expect(jsonData.code).to.eql(200); });",
                  "pm.test('状态为待验收', function() { pm.expect(jsonData.data.status).to.eql('COMPLETED'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "2.5 无照片尝试关闭工单(应失败)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/:id/close",
              "path": ["{{baseUrl}}", "orders", ":id", "close"],
              "variable": [{ "key": "id", "value": "{{testOrderId}}" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('没有照片关闭工单应失败', function() { pm.expect(jsonData.code).to.not.eql(200); });",
                  "pm.test('错误信息包含照片', function() { pm.expect(jsonData.message).to.include('照片'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "2.6 查看工单历史记录",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/:id/history",
              "path": ["{{baseUrl}}", "orders", ":id", "history"],
              "variable": [{ "key": "id", "value": "{{testOrderId}}" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('获取历史记录成功', function() { pm.expect(jsonData.code).to.eql(200); });",
                  "pm.test('历史记录数量>=4', function() { pm.expect(jsonData.data.length).to.be.at.least(4); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. 紧急工单测试",
      "item": [
        {
          "name": "3.1 提交紧急工单",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "url": "{{baseUrl}}/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"API测试-紧急！水管爆裂\",\n  \"description\": \"厨房水管突然爆裂，漏水严重！\",\n  \"category\": \"水电维修\",\n  \"priority\": \"URGENT\",\n  \"roomId\": 1,\n  \"contactPerson\": \"测试业主\",\n  \"contactPhone\": \"13800000001\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('紧急工单创建成功', function() { pm.expect(jsonData.code).to.eql(200); });",
                  "pm.test('优先级为紧急', function() { pm.expect(jsonData.data.priority).to.eql('URGENT'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 验证管理员收到紧急消息",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/messages?isRead=0"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('获取消息成功', function() { pm.expect(jsonData.code).to.eql(200); });",
                  "var hasUrgent = jsonData.data.some(m => m.priority === 'URGENT');",
                  "pm.test('包含紧急消息', function() { pm.expect(hasUrgent).to.be.true; });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. 巡检模块测试",
      "item": [
        {
          "name": "4.1 获取巡检点列表",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/inspection/points?page=1&size=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('获取巡检点成功', function() { pm.expect(jsonData.code).to.eql(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "4.2 巡检打卡(正常)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/inspection/checkin?pointId=1&status=NORMAL"
          }
        },
        {
          "name": "4.3 巡检打卡(异常)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/inspection/checkin?pointId=2&status=ABNORMAL&abnormalDescription=API测试：消防栓门损坏"
          }
        }
      ]
    },
    {
      "name": "5. 消息和仪表盘",
      "item": [
        {
          "name": "5.1 获取未读消息数",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/messages/unread/count"
          }
        },
        {
          "name": "5.2 仪表盘统计",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/orders/dashboard/stats"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('获取统计成功', function() { pm.expect(jsonData.code).to.eql(200); });",
                  "pm.test('包含总工单数', function() { pm.expect(jsonData.data).to.have.property('totalOrders'); });",
                  "pm.test('包含紧急工单数', function() { pm.expect(jsonData.data).to.have.property('urgentOrders'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. 角色权限测试",
      "item": [
        {
          "name": "6.1 业主查看工单(验证敏感字段隐藏)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "url": "{{baseUrl}}/orders?page=1&size=5"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('获取工单列表成功', function() { pm.expect(jsonData.code).to.eql(200); });",
                  "var firstOrder = jsonData.data.records[0];",
                  "if(firstOrder) {",
                  "  pm.test('业主看不到预估费用', function() { pm.expect(firstOrder.expectedCost).to.be.undefined; });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "6.2 维修人员查看工单(只能看到自己的)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{maintToken}}" }
            ],
            "url": "{{baseUrl}}/orders?page=1&size=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "var records = jsonData.data.records;",
                  "var allAssignedToMe = records.every(o => o.assigneeId === 3 || o.assigneeId === null);",
                  "pm.test('只能看到指派给自己的工单', function() { pm.expect(allAssignedToMe).to.be.true; });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
