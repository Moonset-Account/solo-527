{
  "description": "电商订单数据Schema - 数据运营日常校验用",
  "strict": false,
  "fields": [
    {
      "name": "order_id",
      "type": "string",
      "required": true,
      "unique": true,
      "pattern": "^ORD[0-9]{8}$",
      "description": "订单号，格式 ORD + 8位数字"
    },
    {
      "name": "user_id",
      "type": "integer",
      "required": true,
      "description": "用户ID"
    },
    {
      "name": "product_id",
      "type": "string",
      "required": true,
      "description": "商品ID"
    },
    {
      "name": "quantity",
      "type": "integer",
      "required": true,
      "min_value": 1,
      "max_value": 999,
      "description": "购买数量，1-999"
    },
    {
      "name": "price",
      "type": "float",
      "required": true,
      "min_value": 0.01,
      "description": "单价，元"
    },
    {
      "name": "status",
      "type": "string",
      "required": true,
      "enum": ["pending", "paid", "shipped", "delivered", "cancelled", "refunded"],
      "description": "订单状态枚举"
    },
    {
      "name": "order_date",
      "type": "date",
      "required": true,
      "format": "%Y-%m-%d",
      "description": "下单日期，YYYY-MM-DD"
    },
    {
      "name": "paid",
      "type": "boolean",
      "required": false,
      "description": "是否已支付"
    },
    {
      "name": "remark",
      "type": "string",
      "required": false,
      "description": "备注，可选"
    }
  ],
  "unique_keys": [
    ["user_id", "order_date"]
  ]
}
