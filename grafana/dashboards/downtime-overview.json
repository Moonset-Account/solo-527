          "rawSql": "SELECT sp.spare_part_name, sp.spare_part_code, SUM(sp.consumption_qty) as consumption_count, SUM(sp.unit_price * sp.consumption_qty) as total_cost, df.fault_type, df.production_line FROM spare_part_consumption sp JOIN downtime_fact df ON sp.downtime_id = df.id WHERE 1=1 AND ($__timeFilter(sp.consumption_time)) AND ($production_line = 'All' OR df.production_line = $production_line) AND ($fault_type = 'All' OR df.fault_type = $fault_type) GROUP BY sp.spare_part_name, sp.spare_part_code, df.fault_type, df.production_line ORDER BY consumption_count DESC LIMIT 10",
