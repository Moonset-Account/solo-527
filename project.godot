[layer_names]

2d_physics/layer_1="Items"
2d_physics/layer_2="Container"
2d_physics/layer_3="UI"
2d_physics/layer_4="Debug"
2d_physics/layer_5="Hazards"

[rendering]

textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.1, 0.12, 0.15, 1)
2d/snap/snap_2d_transforms_to_pixel=false

[physics]

common/physics_fps=60
2d/physics_engine="Box2D"
2d/default_gravity=980.0

[audio]

default_bus_layout="res://audio/bus_layout.tres"

[autoload]

GameManager="*res://scripts/GameManager.gd"
AudioManager="*res://scripts/AudioManager.gd"
SaveManager="*res://scripts/SaveManager.gd"
InputManager="*res://scripts/InputManager.gd"
UIManager="*res://scripts/UIManager.gd"
PlaySessionRecorder="*res://scripts/PlaySessionRecorder.gd"
