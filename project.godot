; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="搬家装箱"
config/description="搬家装箱物理益智游戏"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/show_image=false

[autoload]

SceneManager="*res://scripts/core/SceneManager.gd"
InputManager="*res://scripts/core/InputManager.gd"
ResourceLoader_="*res://scripts/core/ResourceLoader.gd"
SaveSystem="*res://scripts/core/SaveSystem.gd"
AudioManager="*res://scripts/core/AudioManager.gd"
UIManager="*res://scripts/core/UIManager.gd"
AchievementSystem="*res://scripts/core/AchievementSystem.gd"
LeaderboardSystem="*res://scripts/core/LeaderboardSystem.gd"
GameState="*res://scripts/core/GameState.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[input]

drag={
