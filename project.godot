; Engine configuration file.
; Godot 4.x project - Retro Factory Pipeline Idle Game

config_version=5

[application]

config/name="复古工厂流水线"
config/description="Retro Factory Pipeline - 放置经营类游戏原型"
run/main_scene="res://scenes/ui/MainMenu.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://assets/icons/icon.svg"
boot_splash/show_image=false

[autoload]

GameState="*res://scripts/autoload/GameState.gd"
SaveSystem="*res://scripts/autoload/SaveSystem.gd"
SceneManager="*res://scripts/autoload/SceneManager.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
AchievementSystem="*res://scripts/autoload/AchievementSystem.gd"
PlaytestRecorder="*res://scripts/autoload/PlaytestRecorder.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

place_item={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":0,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":1,"canceled":false,"pressed":true,"double_click":false,"script":null)
]
}
