; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="档案室时间线推理"
config/description="档案整理推理游戏 - 拖拽排序、证据关联、分层提示"
run/main_scene="res://scenes/BootScene.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/show_image=false

[gdscript]

completion/warnings-as-errors=0
warnings/enable=0
warn/typed_assignments=0
warn/untyped_declaration=0
warn/infer_variant=0
warn/redundant_type_test=0
warn/unused_parameter=0
warn/unused_variable=0
warn/unused_signal=0
warn/unused_method=0
warn/unused_class_variable=0
warn/shadowed_variable=0
warn/shadowed_parameter=0
warn/return_value_discarded=0
warn/unsafe_property_access=0
warn/unsafe_method_access=0
warn/unsafe_cast=0
warn/unsafe_call_argument=0
warn/native_method_override=0

[autoload]

GameManager="*res://scripts/core/GameManager.gd"
EventBus="*res://scripts/core/EventBus.gd"
ConfigManager="*res://scripts/core/ConfigManager.gd"
SaveManager="*res://scripts/core/SaveManager.gd"
AudioManager="*res://scripts/core/AudioManager.gd"
InputManager="*res://scripts/core/InputManager.gd"
PerformanceStats="*res://scripts/core/PerformanceStats.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

