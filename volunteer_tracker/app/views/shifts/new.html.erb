<div class="mb-6">
  <h2 class="text-2xl font-bold text-gray-900">新建班次</h2>
</div>

<div class="bg-white rounded-lg shadow p-6">
  <%= form_with(model: @shift, local: true) do |f| %>
    <% if @shift.errors.any? %>
      <div class="bg-red-50 text-red-800 p-4 rounded mb-4">
        <ul>
          <% @shift.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-4">
      <%= f.label :title, "标题", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :title, class: "w-full border border-gray-300 rounded px-3 py-2" %>
    </div>

    <div class="mb-4">
      <%= f.label :description, "描述", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :description, rows: 3, class: "w-full border border-gray-300 rounded px-3 py-2" %>
    </div>

    <div class="grid grid-cols-2 gap-4 mb-4">
      <div>
        <%= f.label :start_time, "开始时间", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.datetime_local_field :start_time, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
      <div>
        <%= f.label :end_time, "结束时间", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.datetime_local_field :end_time, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
    </div>

    <div class="mb-4">
      <%= f.label :capacity, "容量", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :capacity, class: "w-full border border-gray-300 rounded px-3 py-2" %>
    </div>

    <div class="flex gap-2">
      <%= f.submit "创建班次", class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
      <%= link_to "取消", shifts_path, class: "bg-gray-200 text-gray-700 px-4 py-2 rounded hover:bg-gray-300" %>
    </div>
  <% end %>
</div>
