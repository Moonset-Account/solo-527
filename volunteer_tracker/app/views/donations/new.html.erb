<div class="mb-6">
  <h2 class="text-2xl font-bold text-gray-900">新建捐赠</h2>
</div>

<div class="bg-white rounded-lg shadow p-6">
  <%= form_with(model: @donation, local: true) do |f| %>
    <% if @donation.errors.any? %>
      <div class="bg-red-50 text-red-800 p-4 rounded mb-4">
        <ul>
          <% @donation.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid grid-cols-2 gap-4 mb-4">
      <div>
        <%= f.label :donor_name, "捐赠人", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :donor_name, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
      <div>
        <%= f.label :donor_contact, "联系方式", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :donor_contact, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4 mb-4">
      <div>
        <%= f.label :donation_type, "类型", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :donation_type, [['资金', 'money'], ['物资', 'material']], {}, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
      <div>
        <%= f.label :amount, "金额", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :amount, step: 0.01, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4 mb-4">
      <div>
        <%= f.label :material_id, "关联物资", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :material_id, Material.pluck(:name, :id), { include_blank: true }, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
      <div>
        <%= f.label :quantity, "物资数量", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :quantity, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
    </div>

    <div class="mb-4">
      <%= f.label :remark, "备注", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :remark, rows: 3, class: "w-full border border-gray-300 rounded px-3 py-2" %>
    </div>

    <div class="flex gap-2">
      <%= f.submit "创建捐赠", class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
      <%= link_to "取消", donations_path, class: "bg-gray-200 text-gray-700 px-4 py-2 rounded hover:bg-gray-300" %>
    </div>
  <% end %>
</div>
