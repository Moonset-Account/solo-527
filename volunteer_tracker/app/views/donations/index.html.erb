<div class="mb-6 flex items-center justify-between">
  <h2 class="text-2xl font-bold text-gray-900">捐赠管理</h2>
  <%= link_to "新建捐赠", new_donation_path, class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
</div>

<div class="mb-4 flex gap-2 flex-wrap">
  <div class="flex gap-2 items-center">
    <span class="text-sm text-gray-600">状态:</span>
    <%= link_to "全部", donations_path, class: "px-3 py-1 rounded #{params[:status].blank? ? 'bg-blue-600 text-white' : 'bg-gray-200 text-gray-700'}" %>
    <% %w[pending received confirmed rejected].each do |s| %>
      <%= link_to ApplicationHelper::STATUS_LABEL_MAP[s], donations_path(status: s), class: "px-3 py-1 rounded #{params[:status] == s ? 'bg-blue-600 text-white' : 'bg-gray-200 text-gray-700'}" %>
    <% end %>
  </div>
  <div class="flex gap-2 items-center ml-4">
    <span class="text-sm text-gray-600">类型:</span>
    <%= link_to "全部", donations_path, class: "px-3 py-1 rounded #{params[:donation_type].blank? ? 'bg-blue-600 text-white' : 'bg-gray-200 text-gray-700'}" %>
    <%= link_to "资金", donations_path(donation_type: 'money'), class: "px-3 py-1 rounded #{params[:donation_type] == 'money' ? 'bg-blue-600 text-white' : 'bg-gray-200 text-gray-700'}" %>
    <%= link_to "物资", donations_path(donation_type: 'material'), class: "px-3 py-1 rounded #{params[:donation_type] == 'material' ? 'bg-blue-600 text-white' : 'bg-gray-200 text-gray-700'}" %>
  </div>
</div>

<div class="bg-white rounded-lg shadow overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">捐赠人</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">联系方式</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">类型</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">金额/数量</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">状态</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">操作</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% @donations.each do |donation| %>
        <tr id="<%= dom_id(donation) %>">
          <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= link_to donation.donor_name, donation_path(donation) %></td>
          <td class="px-6 py-4 text-sm text-gray-500"><%= donation.donor_contact || '-' %></td>
          <td class="px-6 py-4 text-sm">
            <% if donation.donation_type == 'money' %>
              <span class="px-2 py-1 text-xs font-medium rounded-full bg-blue-100 text-blue-800">资金</span>
            <% else %>
              <span class="px-2 py-1 text-xs font-medium rounded-full bg-purple-100 text-purple-800">物资</span>
            <% end %>
          </td>
          <td class="px-6 py-4 text-sm text-gray-900">
            <% if donation.donation_type == 'money' %>
              ¥<%= donation.amount || 0 %>
            <% else %>
              <%= donation.quantity || 0 %>
            <% end %>
          </td>
          <td class="px-6 py-4 text-sm"><%= status_badge(donation.status) %></td>
          <td class="px-6 py-4 text-sm">
            <% if donation.may_receive? %>
              <%= button_to "接收", receive_donation_path(donation), method: :post, class: "bg-green-600 text-white px-3 py-1 rounded text-xs hover:bg-green-700" %>
            <% end %>
            <% if donation.may_confirm? %>
              <%= button_to "确认", confirm_donation_path(donation), method: :post, class: "bg-blue-600 text-white px-3 py-1 rounded text-xs hover:bg-blue-700" %>
            <% end %>
            <% if donation.may_reject? %>
              <%= button_to "拒绝", reject_donation_path(donation), method: :post, class: "bg-red-600 text-white px-3 py-1 rounded text-xs hover:bg-red-700" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
