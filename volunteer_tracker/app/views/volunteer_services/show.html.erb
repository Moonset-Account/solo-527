<div class="mb-6 flex items-center justify-between">
  <h2 class="text-2xl font-bold text-gray-900">服务详情</h2>
  <%= link_to "返回列表", volunteer_services_path, class: "text-blue-600 hover:underline" %>
</div>

<div class="bg-white rounded-lg shadow p-6 mb-6">
  <div class="flex items-center justify-between mb-4">
    <h3 class="text-xl font-semibold text-gray-900"><%= @volunteer_service.title %></h3>
    <div class="flex items-center gap-2">
      <%= status_badge(@volunteer_service.status) %>
      <span class="text-sm text-gray-500"><%= next_action_for(@volunteer_service) %></span>
    </div>
  </div>

  <dl class="grid grid-cols-2 gap-4">
    <div>
      <dt class="text-sm font-medium text-gray-500">分类</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @volunteer_service.category %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">时间范围</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @volunteer_service.start_date || '-' %> ~ <%= @volunteer_service.end_date || '-' %></dd>
    </div>
    <div class="col-span-2">
      <dt class="text-sm font-medium text-gray-500">描述</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @volunteer_service.description || '-' %></dd>
    </div>
  </dl>

  <div class="mt-4 flex gap-2">
    <% if @volunteer_service.may_activate? %>
      <%= button_to "激活", activate_volunteer_service_path(@volunteer_service), method: :post, class: "bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700" %>
    <% end %>
    <% if @volunteer_service.may_pause? %>
      <%= button_to "暂停", pause_volunteer_service_path(@volunteer_service), method: :post, class: "bg-yellow-600 text-white px-4 py-2 rounded hover:bg-yellow-700" %>
    <% end %>
    <% if @volunteer_service.may_resume? %>
      <%= button_to "恢复", resume_volunteer_service_path(@volunteer_service), method: :post, class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
    <% end %>
    <% if @volunteer_service.may_complete? %>
      <%= button_to "完成", complete_volunteer_service_path(@volunteer_service), method: :post, class: "bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700" %>
    <% end %>
    <%= link_to "编辑", edit_volunteer_service_path(@volunteer_service), class: "bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700" %>
  </div>
</div>

<div class="bg-white rounded-lg shadow">
  <div class="p-4 border-b border-gray-200">
    <h3 class="text-lg font-semibold text-gray-900">分配志愿者</h3>
  </div>
  <% assignments = @volunteer_service.volunteer_service_assignments.includes(:user) %>
  <% if assignments.any? %>
    <ul class="divide-y divide-gray-200">
      <% assignments.each do |assignment| %>
        <li class="px-6 py-3 text-sm text-gray-900"><%= assignment.user.name %></li>
      <% end %>
    </ul>
  <% else %>
    <div class="p-6 text-gray-500 text-sm">暂无分配志愿者</div>
  <% end %>
</div>
