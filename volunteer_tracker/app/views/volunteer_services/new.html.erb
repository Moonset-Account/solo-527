<div class="mb-6">
  <h2 class="text-2xl font-bold text-gray-900">新建志愿服务</h2>
</div>

<div class="bg-white rounded-lg shadow p-6">
  <%= form_with(model: @volunteer_service, local: true) do |f| %>
    <% if @volunteer_service.errors.any? %>
      <div class="bg-red-50 text-red-800 p-4 rounded mb-4">
        <ul>
          <% @volunteer_service.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-4">
      <%= f.label :title, "标题", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :title, class: "w-full border border-gray-300 rounded px-3 py-2" %>
    </div>

    <div class="mb-4">
      <%= f.label :description, "描述", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :description, rows: 3, class: "w-full border border-gray-300 rounded px-3 py-2" %>
    </div>

    <div class="grid grid-cols-2 gap-4 mb-4">
      <div>
        <%= f.label :category, "分类", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :category, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
      <div>
        <%= f.label :status, "状态", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :status, VolunteerService.aasm.states.map { |s| [ApplicationHelper::STATUS_LABEL_MAP[s.name.to_s] || s.name, s.name] }, {}, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4 mb-4">
      <div>
        <%= f.label :start_date, "开始日期", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.date_field :start_date, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
      <div>
        <%= f.label :end_date, "结束日期", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.date_field :end_date, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
    </div>

    <div class="flex gap-2">
      <%= f.submit "创建服务", class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
      <%= link_to "取消", volunteer_services_path, class: "bg-gray-200 text-gray-700 px-4 py-2 rounded hover:bg-gray-300" %>
    </div>
  <% end %>
</div>
