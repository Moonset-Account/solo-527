<%= form_with(model: material_transaction, url: material_transactions_path, local: true) do |f| %>
  <% if material_transaction.errors.any? %>
    <div class="bg-red-50 text-red-800 p-4 rounded mb-4">
      <ul>
        <% material_transaction.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= f.hidden_field :material_id, value: material_transaction.material_id %>

  <div class="grid grid-cols-2 gap-4 mb-4">
    <div>
      <%= f.label :transaction_type, "类型", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :transaction_type, [['入库', 'in'], ['出库', 'out']], {}, class: "w-full border border-gray-300 rounded px-3 py-2" %>
    </div>
    <div>
      <%= f.label :quantity, "数量", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :quantity, min: 1, class: "w-full border border-gray-300 rounded px-3 py-2" %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4 mb-4">
    <div>
      <%= f.label :recipient, "领用人", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :recipient, class: "w-full border border-gray-300 rounded px-3 py-2" %>
    </div>
    <div>
      <%= f.label :remark, "备注", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :remark, class: "w-full border border-gray-300 rounded px-3 py-2" %>
    </div>
  </div>

  <%= f.submit "提交", class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
<% end %>
