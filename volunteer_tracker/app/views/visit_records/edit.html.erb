<div class="mb-6">
  <h2 class="text-2xl font-bold text-gray-900">编辑探访记录</h2>
</div>

<div class="bg-white rounded-lg shadow p-6">
  <%= form_with(model: @visit_record, local: true) do |f| %>
    <% if @visit_record.errors.any? %>
      <div class="bg-red-50 text-red-800 p-4 rounded mb-4">
        <ul>
          <% @visit_record.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid grid-cols-2 gap-4 mb-4">
      <div>
        <%= f.label :target_name, "探访对象", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :target_name, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
      <div>
        <%= f.label :visit_date, "探访日期", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.date_field :visit_date, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4 mb-4">
      <div>
        <%= f.label :target_address, "地址", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :target_address, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
      <div>
        <%= f.label :target_contact, "联系方式", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :target_contact, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
    </div>

    <div class="mb-4">
      <%= f.label :purpose, "目的", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :purpose, rows: 3, class: "w-full border border-gray-300 rounded px-3 py-2" %>
    </div>

    <div class="mb-4">
      <%= f.label :result, "结果", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :result, rows: 3, class: "w-full border border-gray-300 rounded px-3 py-2" %>
    </div>

    <div class="mb-4">
      <%= f.label :next_action, "下一步动作", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :next_action, class: "w-full border border-gray-300 rounded px-3 py-2" %>
    </div>

    <div class="flex gap-2">
      <%= f.submit "更新探访记录", class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
      <%= link_to "取消", visit_record_path(@visit_record), class: "bg-gray-200 text-gray-700 px-4 py-2 rounded hover:bg-gray-300" %>
    </div>
  <% end %>
</div>
