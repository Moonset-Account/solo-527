<div class="mb-6 flex items-center justify-between">
  <h2 class="text-2xl font-bold text-gray-900">探访记录</h2>
  <%= link_to "新建探访", new_visit_record_path, class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
</div>

<div class="bg-white rounded-lg shadow p-4 mb-6">
  <%= search_form_for @q, url: visit_records_path, method: :get do |f| %>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div>
        <%= f.label :target_name_cont, "探访对象", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.search_field :target_name_cont, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
      <div>
        <%= f.label :status_eq, "状态", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :status_eq, VisitRecord.aasm.states.map { |s| [ApplicationHelper::STATUS_LABEL_MAP[s.name.to_s] || s.name, s.name] }, { include_blank: true }, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
      <div>
        <%= f.label :visit_date_gteq, "开始日期", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.date_field :visit_date_gteq, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
      <div>
        <%= f.label :visit_date_lteq, "结束日期", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.date_field :visit_date_lteq, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
    </div>
    <div class="mt-3">
      <%= f.submit "搜索", class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
    </div>
  <% end %>
</div>

<div class="bg-white rounded-lg shadow overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">探访对象</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">探访日期</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">志愿者</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">状态</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">下一步动作</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">操作</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% @visit_records.each do |record| %>
        <tr class="<%= record.overdue? ? 'bg-red-50' : '' %>">
          <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= link_to record.target_name, visit_record_path(record) %></td>
          <td class="px-6 py-4 text-sm text-gray-500"><%= record.visit_date %></td>
          <td class="px-6 py-4 text-sm text-gray-500"><%= record.volunteer.name %></td>
          <td class="px-6 py-4 text-sm"><%= status_badge(record.status) %></td>
          <td class="px-6 py-4 text-sm text-gray-500"><%= next_action_for(record) %></td>
          <td class="px-6 py-4 text-sm">
            <%= link_to "查看", visit_record_path(record), class: "text-blue-600 hover:underline" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
