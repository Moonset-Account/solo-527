<div class="mb-6">
  <h2 class="text-2xl font-bold text-gray-900">仪表盘</h2>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
  <div class="bg-white rounded-lg shadow p-6">
    <div class="text-sm font-medium text-gray-500">活跃班次</div>
    <div class="mt-1 text-3xl font-bold text-gray-900"><%= Shift.where(status: 'open').count %></div>
    <div class="mt-2">
      <%= status_badge('open') %>
      <span class="text-xs text-gray-500 ml-1">可报名</span>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <div class="text-sm font-medium text-gray-500">待处理捐赠</div>
    <div class="mt-1 text-3xl font-bold text-gray-900"><%= @pending_donations %></div>
    <div class="mt-2">
      <%= status_badge('pending') %>
      <span class="text-xs text-gray-500 ml-1">待接收</span>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <div class="text-sm font-medium text-gray-500">逾期探访</div>
    <div class="mt-1 text-3xl font-bold text-gray-900"><%= @overdue_visits %></div>
    <div class="mt-2">
      <%= status_badge('overdue') %>
      <span class="text-xs text-gray-500 ml-1">需复盘</span>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <div class="text-sm font-medium text-gray-500">待发送提醒</div>
    <div class="mt-1 text-3xl font-bold text-gray-900"><%= @upcoming_reminders.size %></div>
    <div class="mt-2">
      <%= status_badge('pending') %>
      <span class="text-xs text-gray-500 ml-1">待发送</span>
    </div>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <div class="bg-white rounded-lg shadow">
    <div class="p-4 border-b border-gray-200">
      <h3 class="text-lg font-semibold text-gray-900">最近班次</h3>
    </div>
    <div class="p-4">
      <% recent_shifts = Shift.order(start_time: :desc).limit(5) %>
      <% if recent_shifts.any? %>
        <div class="space-y-3">
          <% recent_shifts.each do |shift| %>
            <div class="flex items-center justify-between">
              <div>
                <div class="text-sm font-medium text-gray-900"><%= shift.title %></div>
                <div class="text-xs text-gray-500"><%= format_datetime(shift.start_time) %></div>
              </div>
              <div class="flex items-center gap-2">
                <%= status_badge(shift.status) %>
                <span class="text-xs text-gray-500"><%= next_action_for(shift) %></span>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500 text-sm">暂无班次</p>
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow">
    <div class="p-4 border-b border-gray-200">
      <h3 class="text-lg font-semibold text-gray-900">待跟进探访</h3>
    </div>
    <div class="p-4">
      <% pending_visits = VisitRecord.where(status: ['planned', 'in_progress', 'overdue']).order(visit_date: :asc).limit(5) %>
      <% if pending_visits.any? %>
        <div class="space-y-3">
          <% pending_visits.each do |visit| %>
            <div class="flex items-center justify-between">
              <div>
                <div class="text-sm font-medium text-gray-900"><%= visit.target_name %></div>
                <div class="text-xs text-gray-500"><%= visit.visit_date %></div>
              </div>
              <div class="flex items-center gap-2">
                <%= status_badge(visit.status) %>
                <span class="text-xs text-gray-500"><%= next_action_for(visit) %></span>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500 text-sm">暂无待跟进探访</p>
      <% end %>
    </div>
  </div>
</div>
