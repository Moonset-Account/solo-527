<div class="mb-6">
  <h2 class="text-2xl font-bold text-gray-900">编辑物资</h2>
</div>

<div class="bg-white rounded-lg shadow p-6">
  <%= form_with(model: [:admin, @material], local: true) do |f| %>
    <% if @material.errors.any? %>
      <div class="bg-red-50 text-red-800 p-4 rounded mb-4">
        <ul>
          <% @material.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid grid-cols-2 gap-4 mb-4">
      <div>
        <%= f.label :name, "名称", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :name, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
      <div>
        <%= f.label :category, "分类", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :category, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4 mb-4">
      <div>
        <%= f.label :unit, "单位", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :unit, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
      <div>
        <%= f.label :threshold, "预警阈值", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :threshold, min: 0, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
    </div>

    <div class="bg-yellow-50 border border-yellow-200 rounded p-3 mb-4">
      <p class="text-sm text-yellow-800">当前库存: <strong><%= @material.current_quantity %></strong> <%= @material.unit %>（通过出入库流水计算，请通过出入库操作调整库存）</p>
    </div>

    <div class="flex gap-2">
      <%= f.submit "保存", class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
      <%= link_to "取消", admin_materials_path, class: "bg-gray-200 text-gray-700 px-4 py-2 rounded hover:bg-gray-300" %>
    </div>
  <% end %>
</div>
