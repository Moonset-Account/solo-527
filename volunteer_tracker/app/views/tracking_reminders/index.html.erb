<div class="mb-6">
  <h2 class="text-2xl font-bold text-gray-900">追踪提醒</h2>
</div>

<% @grouped.each do |trackable_type, reminders| %>
  <div class="mb-6">
    <h3 class="text-lg font-semibold text-gray-900 mb-3"><%= trackable_type == 'VisitRecord' ? '探访记录' : trackable_type %></h3>
    <div class="bg-white rounded-lg shadow overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">关联对象</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">提醒类型</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">提醒日期</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">消息</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">状态</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">操作</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% reminders.each do |reminder| %>
            <tr>
              <td class="px-6 py-4 text-sm font-medium text-gray-900">
                <% if reminder.trackable.respond_to?(:target_name) %>
                  <%= link_to reminder.trackable.target_name, polymorphic_path(reminder.trackable) %>
                <% else %>
                  <%= reminder.trackable_type %>#<%= reminder.trackable_id %>
                <% end %>
              </td>
              <td class="px-6 py-4 text-sm text-gray-500"><%= reminder.reminder_type %></td>
              <td class="px-6 py-4 text-sm text-gray-500"><%= reminder.reminder_date %></td>
              <td class="px-6 py-4 text-sm text-gray-500"><%= reminder.message %></td>
              <td class="px-6 py-4 text-sm"><%= status_badge(reminder.status) %></td>
              <td class="px-6 py-4 text-sm">
                <% if reminder.may_mark_sent? %>
                  <%= button_to "标记已发送", mark_sent_tracking_reminder_path(reminder), method: :post, class: "bg-blue-600 text-white px-3 py-1 rounded text-xs hover:bg-blue-700" %>
                <% end %>
                <% if reminder.may_dismiss? %>
                  <%= button_to "忽略", dismiss_tracking_reminder_path(reminder), method: :post, class: "bg-gray-600 text-white px-3 py-1 rounded text-xs hover:bg-gray-700" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>

<% if @grouped.empty? %>
  <div class="bg-white rounded-lg shadow p-6 text-gray-500 text-sm">暂无待处理提醒</div>
<% end %>
