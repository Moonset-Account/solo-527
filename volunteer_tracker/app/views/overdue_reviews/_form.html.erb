<%= form_with(model: [visit_record, OverdueReview.new], url: visit_record_overdue_reviews_path(visit_record), local: true) do |f| %>
  <% if overdue_review && overdue_review.errors.any? %>
    <div class="bg-red-50 text-red-800 p-4 rounded mb-4">
      <ul>
        <% overdue_review.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= f.label :impact_scope, "影响范围", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :impact_scope, rows: 3, class: "w-full border border-gray-300 rounded px-3 py-2" %>
  </div>

  <div class="mb-4">
    <%= f.label :responsible_person, "责任人", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :responsible_person, class: "w-full border border-gray-300 rounded px-3 py-2" %>
  </div>

  <div class="mb-4">
    <%= f.label :conclusion, "结论", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :conclusion, rows: 3, class: "w-full border border-gray-300 rounded px-3 py-2" %>
  </div>

  <div class="mb-4">
    <%= f.label :review_date, "复盘日期", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.date_field :review_date, value: Date.current, class: "w-full border border-gray-300 rounded px-3 py-2" %>
  </div>

  <div class="flex gap-2">
    <%= f.submit "提交复盘", class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
  </div>
<% end %>
