<div class="mb-6 flex items-center justify-between">
  <h2 class="text-2xl font-bold text-gray-900">物资详情</h2>
  <%= link_to "返回列表", materials_path, class: "text-blue-600 hover:underline" %>
</div>

<div class="bg-white rounded-lg shadow p-6 mb-6">
  <div class="flex items-center justify-between mb-4">
    <h3 class="text-xl font-semibold text-gray-900"><%= @material.name %></h3>
    <div class="flex items-center gap-2">
      <% if @material.low_stock? %>
        <span class="px-2 py-1 text-xs font-medium rounded-full bg-red-100 text-red-800">库存不足</span>
        <span class="text-sm text-gray-500">需入库</span>
      <% else %>
        <span class="px-2 py-1 text-xs font-medium rounded-full bg-green-100 text-green-800">正常</span>
        <span class="text-sm text-gray-500">可出库</span>
      <% end %>
    </div>
  </div>

  <dl class="grid grid-cols-2 gap-4">
    <div>
      <dt class="text-sm font-medium text-gray-500">分类</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @material.category %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">单位</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @material.unit %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">当前库存</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @material.current_quantity %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">预警阈值</dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @material.threshold || '-' %></dd>
    </div>
  </dl>

  <div class="mt-4 flex gap-2">
    <% if current_user_admin? %>
      <%= link_to "编辑", edit_material_path(@material), class: "bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700" %>
    <% end %>
  </div>
</div>

<% if current_user_admin? %>
  <div class="bg-white rounded-lg shadow p-6 mb-6">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">出入库操作</h3>
    <%= render partial: "material_transactions/form", locals: { material_transaction: MaterialTransaction.new(material_id: @material.id) } %>
  </div>
<% end %>

<div class="bg-white rounded-lg shadow">
  <div class="p-4 border-b border-gray-200">
    <h3 class="text-lg font-semibold text-gray-900">流水记录</h3>
  </div>
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">类型</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">数量</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">操作人</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">领用人</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">备注</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">时间</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% @material.material_transactions.order(created_at: :desc).each do |tx| %>
        <tr>
          <td class="px-6 py-4 text-sm">
            <% if tx.transaction_type == 'in' %>
              <span class="px-2 py-1 text-xs font-medium rounded-full bg-green-100 text-green-800">入库</span>
            <% else %>
              <span class="px-2 py-1 text-xs font-medium rounded-full bg-red-100 text-red-800">出库</span>
            <% end %>
          </td>
          <td class="px-6 py-4 text-sm text-gray-900"><%= tx.quantity %></td>
          <td class="px-6 py-4 text-sm text-gray-500"><%= tx.operator&.name || '-' %></td>
          <td class="px-6 py-4 text-sm text-gray-500"><%= tx.recipient || '-' %></td>
          <td class="px-6 py-4 text-sm text-gray-500"><%= tx.remark || '-' %></td>
          <td class="px-6 py-4 text-sm text-gray-500"><%= format_datetime(tx.created_at) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
