{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "resolveJsonModule": true,
    "declaration": false,
    "outDir": "./dist-api",
    "rootDir": "./api",
    "baseUrl": "./",
    "paths": {
      "@api/*": ["./api/*"]
    }
  },
  "include": [
    "api/**/*.ts"
  ]
}
