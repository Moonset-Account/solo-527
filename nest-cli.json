{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "api",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.api.json",
    "webpack": false,
    "assets": [
      {
        "include": "../package.json",
        "outDir": "dist/server",
        "watchAssets": false,
        "flat": true
      }
    ]
  },
  "entryFile": "main"
}
