{
  "name": "photography-pipeline-server",
  "version": "1.0.0",
  "description": "Photography order and brand collaboration pipeline backend",
  "main": "src/index.js",
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "prisma:setup": "prisma generate && prisma migrate dev --name init && prisma db seed"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@prisma/client": "5.10.2",
    "cors": "2.8.5",
    "express": "4.18.3",
    "multer": "1.4.5-lts.1",
    "dayjs": "1.11.10"
  },
  "devDependencies": {
    "nodemon": "3.1.0",
    "prisma": "5.10.2"
  }
}
