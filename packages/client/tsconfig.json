{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["@remix-run/node", "node"],
    "outDir": "./build",
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "paths": {
      "~/*": ["./app/*"],
      "@qinghe/shared": ["../shared/src"],
      "@qinghe/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", ".env"],
  "exclude": ["node_modules"]
}
