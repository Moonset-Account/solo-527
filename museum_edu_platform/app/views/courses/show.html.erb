
<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="bg-white rounded-lg shadow-md overflow-hidden">
    <% if @course.cover_image.attached? %>
      <%= image_tag @course.cover_image, class: "w-full h-64 object-cover" %>
    <% else %>
      <div class="w-full h-64 bg-gradient-to-r from-blue-500 to-purple-600 flex items-center justify-center">
        <h1 class="text-3xl font-bold text-white"><%= @course.title %></h1>
      </div>
    <% end %>

    <div class="p-6">
      <div class="flex items-start justify-between mb-4">
        <div>
          <h1 class="text-3xl font-bold text-gray-900 mb-2"><%= @course.title %></h1>
          <div class="flex items-center gap-4 text-sm text-gray-600">
            <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded"><%= @course.category %></span>
            <span><%= @course.age_range %></span>
            <span><%= @course.duration_minutes %>分钟</span>
            <span>容量: <%= @course.capacity %>人</span>
          </div>
        </div>
        <div class="text-right">
          <span class="inline-block px-3 py-1 rounded-full text-sm font-medium 
            <%= @course.published? ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
            <%= @course.status == 'published' ? '报名中' : '未开放' %>
          </span>
        </div>
      </div>

      <div class="prose max-w-none mb-6">
        <p class="text-gray-700"><%= @course.description %></p>
      </div>

      <div class="border-t pt-6">
        <h2 class="text-xl font-semibold mb-4">可报名场次</h2>
        <% if @upcoming_sessions.any? %>
          <div class="space-y-3">
            <% @upcoming_sessions.each do |session| %>
              <div class="border rounded-lg p-4 hover:border-blue-500 transition-colors">
                <div class="flex items-center justify-between">
                  <div>
                    <div class="font-medium"><%= session.start_at.strftime('%Y年%m月%d日 %H:%M') %></div>
                    <div class="text-sm text-gray-600">
                      <%= session.start_at.strftime('%A') %> · 
                      剩余名额: <span class="<%= session.available_spots > 0 ? 'text-green-600' : 'text-red-600' %>"><%= session.available_spots %></span>
                    </div>
                    <% if session.guides.any? %>
                      <div class="text-sm text-gray-500 mt-1">
                        讲解员: <%= session.guides.pluck(:name).join(', ') %>
                      </div>
                    <% end %>
                  </div>
                  <div>
                    <% if session.can_register? %>
                      <%= link_to '立即报名', new_registration_path(session_id: session.id), 
                        class: "bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors" %>
                    <% else %>
                      <span class="text-gray-400 px-4 py-2">暂不可报名</span>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-gray-500">暂无可报名的场次</p>
        <% end %>
      </div>
    </div>
  </div>

  <div class="mt-6">
    <%= link_to '← 返回课程列表', courses_path, class: "text-blue-600 hover:text-blue-800" %>
  </div>
</div>
