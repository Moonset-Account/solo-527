
<div class="max-w-3xl mx-auto px-4 py-8">
  <div class="bg-white rounded-lg shadow-md overflow-hidden">
    <div class="px-6 py-4 border-b">
      <div class="flex items-center justify-between">
        <h1 class="text-xl font-bold text-gray-900">报名详情</h1>
        <span class="inline-block px-3 py-1 rounded-full text-sm font-medium 
          <%= case @registration.status
                when 'pending' then 'bg-yellow-100 text-yellow-800'
                when 'approved' then 'bg-green-100 text-green-800'
                when 'rejected' then 'bg-red-100 text-red-800'
                when 'cancelled' then 'bg-gray-100 text-gray-800'
                else 'bg-blue-100 text-blue-800'
              end %>">
          <%= case @registration.status
              when 'pending' then '待审核'
              when 'approved' then '已通过'
              when 'rejected' then '已拒绝'
              when 'cancelled' then '已取消'
              when 'completed' then '已完成'
              else @registration.status
            end %>
        </span>
      </div>
    </div>

    <div class="p-6">
      <div class="bg-gray-50 rounded-lg p-4 mb-6">
        <h2 class="font-medium text-gray-900 mb-2">活动信息</h2>
        <div class="grid grid-cols-2 gap-4 text-sm">
          <div>
            <span class="text-gray-500">课程名称：</span>
            <span class="font-medium"><%= @registration.session.course.title %></span>
          </div>
          <div>
            <span class="text-gray-500">活动时间：</span>
            <span class="font-medium"><%= @registration.session.start_at.strftime('%Y年%m月%d日 %H:%M') %></span>
          </div>
          <div>
            <span class="text-gray-500">报名类型：</span>
            <span class="font-medium"><%= @registration.school_group? ? '学校团体' : '散客报名' %></span>
          </div>
          <div>
            <span class="text-gray-500">学生人数：</span>
            <span class="font-medium"><%= @registration.student_count %>人</span>
          </div>
          <% if @registration.school.present? %>
            <div class="col-span-2">
              <span class="text-gray-500">学校：</span>
              <span class="font-medium"><%= @registration.school.name %></span>
            </div>
          <% end %>
        </div>
      </div>

      <div class="mb-6">
        <h2 class="font-medium text-gray-900 mb-2">联系人信息</h2>
        <div class="grid grid-cols-2 gap-4 text-sm">
          <div>
            <span class="text-gray-500">姓名：</span>
            <span class="font-medium"><%= @registration.contact_name %></span>
          </div>
          <div>
            <span class="text-gray-500">电话：</span>
            <span class="font-medium"><%= @registration.contact_phone %></span>
          </div>
          <div class="col-span-2">
            <span class="text-gray-500">邮箱：</span>
            <span class="font-medium"><%= @registration.contact_email %></span>
          </div>
        </div>
      </div>

      <% if @registration.notes.present? %>
        <div class="mb-6">
          <h2 class="font-medium text-gray-900 mb-2">备注</h2>
          <p class="text-sm text-gray-700"><%= @registration.notes %></p>
        </div>
      <% end %>

      <% if @registration.rejected? && @registration.rejection_reason.present? %>
        <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
          <h2 class="font-medium text-red-800 mb-1">拒绝原因</h2>
          <p class="text-sm text-red-700"><%= @registration.rejection_reason %></p>
        </div>
      <% end %>

      <div class="text-sm text-gray-500 border-t pt-4">
        <div class="grid grid-cols-2 gap-2">
          <div>提交时间：<%= @registration.submitted_at&.strftime('%Y-%m-%d %H:%M') %></div>
          <% if @registration.approved_at.present? %>
            <div>审核时间：<%= @registration.approved_at.strftime('%Y-%m-%d %H:%M') %></div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="bg-gray-50 px-6 py-4 border-t">
      <div class="flex items-center justify-between">
        <%= link_to '返回', courses_path, class: "text-gray-600 hover:text-gray-800" %>
        <% if @registration.pending? || @registration.approved? %>
          <%= button_to '取消报名', cancel_registration_path(@registration), 
            method: :patch, 
            data: { confirm: '确定要取消报名吗？' },
            class: "text-red-600 hover:text-red-800 bg-transparent border-none cursor-pointer" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
