
<div class="max-w-2xl mx-auto px-4 py-8">
  <div class="bg-white rounded-lg shadow-md overflow-hidden">
    <div class="bg-gradient-to-r from-blue-600 to-purple-600 px-6 py-4">
      <h1 class="text-2xl font-bold text-white">活动报名</h1>
      <p class="text-blue-100 mt-1"><%= @session.course.title %> - <%= @session.start_at.strftime('%Y年%m月%d日 %H:%M') %></p>
    </div>

    <div class="p-6">
      <% if @registration.errors.any? %>
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded mb-6">
          <p class="font-medium mb-2">请修正以下错误：</p>
          <ul class="list-disc list-inside text-sm">
            <% @registration.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @registration, local: true do |f| %>
        <%= f.hidden_field :session_id %>
        <%= f.hidden_field :student_count, id: 'student_count_hidden' %>

        <div class="mb-6">
          <label class="block text-sm font-medium text-gray-700 mb-2">报名类型</label>
          <div class="grid grid-cols-2 gap-4">
            <label class="cursor-pointer">
              <%= f.radio_button :registration_type, 'school_group', class: "sr-only peer" %>
              <div class="border-2 rounded-lg p-4 text-center peer-checked:border-blue-500 peer-checked:bg-blue-50 transition-all">
                <div class="font-medium">学校团体</div>
                <div class="text-xs text-gray-500 mt-1">学校统一组织报名</div>
              </div>
            </label>
            <label class="cursor-pointer">
              <%= f.radio_button :registration_type, 'individual', class: "sr-only peer" %>
              <div class="border-2 rounded-lg p-4 text-center peer-checked:border-blue-500 peer-checked:bg-blue-50 transition-all">
                <div class="font-medium">散客报名</div>
                <div class="text-xs text-gray-500 mt-1">个人或家庭报名</div>
              </div>
            </label>
          </div>
        </div>

        <div id="school-group-fields" class="mb-6">
          <label class="block text-sm font-medium text-gray-700 mb-2">选择学校</label>
          <%= f.select :school_id, options_from_collection_for_select(@schools, :id, :name, @registration.school_id), 
            { include_blank: '请选择学校' }, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div class="mb-6">
          <div class="flex items-center justify-between mb-3">
            <label class="block text-sm font-medium text-gray-700">学生名单</label>
            <span class="text-sm text-gray-500">已添加 <span id="student-count">0</span> 人（剩余 <%= @session.available_spots %> 个名额）</span>
          </div>
          
          <div id="students-list" class="space-y-3">
            <%= f.fields_for :students do |student_form| %>
              <%= render 'student_fields', f: student_form %>
            <% end %>
          </div>

          <button type="button" id="add-student-btn"
            class="mt-3 w-full border-2 border-dashed border-gray-300 rounded-lg py-3 text-gray-500 hover:border-blue-500 hover:text-blue-600 transition-colors">
            + 添加学生
          </button>
        </div>

        <div class="border-t border-b py-4 my-6">
          <h3 class="font-medium mb-4">联系人信息</h3>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="mb-4">
              <label class="block text-sm font-medium text-gray-700 mb-2">联系人姓名</label>
              <%= f.text_field :contact_name, 
                class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
                placeholder: "请输入联系人姓名" %>
            </div>
            <div class="mb-4">
              <label class="block text-sm font-medium text-gray-700 mb-2">联系电话</label>
              <%= f.text_field :contact_phone, 
                class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
                placeholder: "请输入联系电话" %>
            </div>
          </div>
          
          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-2">联系邮箱</label>
            <%= f.email_field :contact_email, 
              class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
              placeholder: "请输入联系邮箱" %>
          </div>
        </div>

        <div class="mb-6">
          <label class="block text-sm font-medium text-gray-700 mb-2">备注（选填）</label>
          <%= f.text_area :notes, rows: 3, 
            class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
            placeholder: "如有特殊需求请在此说明" %>
        </div>

        <div class="flex items-center justify-between">
          <%= link_to '取消', course_path(@session.course), class: "text-gray-600 hover:text-gray-800" %>
          <%= f.submit '提交报名', class: "bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition-colors cursor-pointer", onclick: "return validateForm()" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<template id="student-template">
  <div class="student-item bg-gray-50 rounded-lg p-4 relative">
    <button type="button" class="remove-student absolute top-2 right-2 text-gray-400 hover:text-red-500">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <div class="grid grid-cols-3 gap-3">
      <div class="col-span-3 md:col-span-1">
        <label class="block text-xs font-medium text-gray-600 mb-1">姓名</label>
        <input type="text" name="registration[students_attributes][NEW_ID][name]" 
          class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          placeholder="请输入姓名" required>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">性别</label>
        <select name="registration[students_attributes][NEW_ID][gender]" 
          class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" required>
          <option value="">请选择</option>
          <option value="male">男</option>
          <option value="female">女</option>
          <option value="other">其他</option>
        </select>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1">年龄段</label>
        <select name="registration[students_attributes][NEW_ID][age_group]" 
          class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" required>
          <option value="">请选择</option>
          <option value="preschool">学龄前</option>
          <option value="primary_1_2">小学1-2年级</option>
          <option value="primary_3_4">小学3-4年级</option>
          <option value="primary_5_6">小学5-6年级</option>
          <option value="junior_high">初中</option>
          <option value="senior_high">高中</option>
        </select>
      </div>
    </div>
  </div>
</template>

<script>
let studentIndex = <%= @registration.students.size %>;
const maxStudents = <%= @session.available_spots %>;

function updateStudentCount() {
  const count = document.querySelectorAll('.student-item').length;
  document.getElementById('student-count').textContent = count;
  document.getElementById('student_count_hidden').value = count;
}

function addStudent() {
  if (document.querySelectorAll('.student-item').length >= maxStudents) {
    alert('已达到场次最大容量限制');
    return;
  }
  
  const template = document.getElementById('student-template');
  const clone = template.content.cloneNode(true);
  const newId = Date.now();
  
  clone.querySelectorAll('input, select').forEach(el => {
    el.name = el.name.replace('NEW_ID', newId);
  });
  
  clone.querySelector('.remove-student').addEventListener('click', function() {
    this.closest('.student-item').remove();
    updateStudentCount();
  });
  
  document.getElementById('students-list').appendChild(clone);
  studentIndex++;
  updateStudentCount();
}

document.addEventListener('DOMContentLoaded', function() {
  document.getElementById('add-student-btn').addEventListener('click', addStudent);
  
  document.querySelectorAll('.remove-student').forEach(btn => {
    btn.addEventListener('click', function() {
      this.closest('.student-item').remove();
      updateStudentCount();
    });
  });
  
  updateStudentCount();

  const schoolGroupFields = document.getElementById('school-group-fields');
  const registrationTypeInputs = document.querySelectorAll('input[name="registration[registration_type]"]');
  
  function toggleSchoolFields() {
    const selected = document.querySelector('input[name="registration[registration_type]"]:checked');
    if (selected && selected.value === 'individual') {
      schoolGroupFields.style.display = 'none';
      document.getElementById('registration_school_id').value = '';
    } else {
      schoolGroupFields.style.display = 'block';
    }
  }
  
  registrationTypeInputs.forEach(input => {
    input.addEventListener('change', toggleSchoolFields);
  });
  
  toggleSchoolFields();
});

function validateForm() {
  const count = document.querySelectorAll('.student-item').length;
  if (count === 0) {
    alert('请至少添加一名学生');
    return false;
  }
  if (count > maxStudents) {
    alert('学生人数超过场次容量限制');
    return false;
  }
  return true;
}
</script>
