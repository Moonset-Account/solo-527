<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "移动端签到 - 博物馆研学平台" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>
  <body class="bg-gray-50 min-h-screen mobile-check-in-page">
    <header class="bg-white shadow-sm sticky top-0 z-10">
      <div class="px-4 py-3 flex items-center justify-between">
        <h1 class="text-lg font-semibold text-gray-800"><%= yield :page_title || '签到' %></h1>
        <div class="flex items-center space-x-2">
          <span id="offline-badge" class="hidden px-2 py-1 text-xs bg-yellow-500 text-white rounded-full">0</span>
          <button id="sync-btn" class="px-3 py-1 text-sm bg-blue-600 text-white rounded hover:bg-blue-700">
            同步
          </button>
        </div>
      </div>
      <div id="network-status" class="px-4 py-1 text-xs text-center">
        <span id="status-text" class="text-green-600">● 在线</span>
      </div>
    </header>

    <main class="p-4 pb-20">
      <% if notice.present? %>
        <div class="mb-4 p-3 bg-green-100 border border-green-200 text-green-700 rounded text-sm">
          <%= notice %>
        </div>
      <% end %>
      <% if alert.present? %>
        <div class="mb-4 p-3 bg-red-100 border border-red-200 text-red-700 rounded text-sm">
          <%= alert %>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <script>
      function updateNetworkStatus() {
        const statusText = document.getElementById('status-text');
        if (statusText) {
          if (navigator.onLine) {
            statusText.textContent = '● 在线';
            statusText.className = 'text-green-600';
          } else {
            statusText.textContent = '● 离线模式';
            statusText.className = 'text-yellow-600';
          }
        }
      }
      updateNetworkStatus();
      window.addEventListener('online', updateNetworkStatus);
      window.addEventListener('offline', updateNetworkStatus);
    </script>
  </body>
</html>
