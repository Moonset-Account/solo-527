<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "博物馆研学活动平台" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>
  <body class="bg-gray-50 min-h-screen">
    <nav class="bg-white shadow-sm border-b">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <div class="flex items-center">
            <%= link_to root_path, class: "flex items-center" do %>
              <span class="text-xl font-bold text-blue-600">博物馆研学平台</span>
            <% end %>
            <div class="hidden sm:ml-8 sm:flex sm:space-x-4">
              <%= link_to "课程列表", courses_path, class: "text-gray-600 hover:text-blue-600 px-3 py-2" %>
              <% if user_signed_in? %>
                <%= link_to "我的报名", my_registrations_path, class: "text-gray-600 hover:text-blue-600 px-3 py-2" %>
                <% if current_user.admin? || current_user.teacher? %>
                  <%= link_to "管理后台", admin_dashboard_path, class: "text-blue-600 hover:text-blue-800 px-3 py-2 font-medium" %>
                <% end %>
                <% if current_user.guide? %>
                  <%= link_to "讲解员后台", guide_dashboard_path, class: "text-blue-600 hover:text-blue-800 px-3 py-2 font-medium" %>
                <% end %>
              <% end %>
            </div>
          </div>
          <div class="flex items-center space-x-4">
            <% if user_signed_in? %>
              <span class="text-sm text-gray-600"><%= current_user.name %></span>
              <%= link_to "退出", destroy_user_session_path, data: { turbo_method: :delete }, class: "text-gray-600 hover:text-red-600" %>
            <% else %>
              <%= link_to "登录", new_user_session_path, class: "text-blue-600 hover:text-blue-800" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <main class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
      <% if notice.present? %>
        <div class="mb-4 p-4 bg-green-100 border border-green-200 text-green-700 rounded">
          <%= notice %>
        </div>
      <% end %>
      <% if alert.present? %>
        <div class="mb-4 p-4 bg-red-100 border border-red-200 text-red-700 rounded">
          <%= alert %>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="bg-white border-t mt-12">
      <div class="max-w-7xl mx-auto py-6 px-4 text-center text-gray-500 text-sm">
        <p>© 2026 博物馆研学活动平台. 版权所有</p>
      </div>
    </footer>
  </body>
</html>
