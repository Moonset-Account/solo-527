<div class="space-y-8">
  <section class="text-center py-12 bg-gradient-to-r from-blue-600 to-indigo-700 text-white rounded-lg">
    <h1 class="text-4xl font-bold mb-4">博物馆研学活动平台</h1>
    <p class="text-xl mb-8 opacity-90">探索历史文化，开启知识之旅</p>
    <%= link_to "浏览课程", courses_path, class: "px-8 py-3 bg-white text-blue-600 rounded-lg font-semibold hover:bg-gray-100 transition" %>
  </section>

  <section>
    <h2 class="text-2xl font-bold mb-6 text-gray-800">热门课程</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <% @courses.each do |course| %>
        <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition">
          <div class="h-40 bg-gradient-to-br from-blue-400 to-indigo-500 flex items-center justify-center">
            <span class="text-white text-4xl font-bold"><%= course.category %></span>
          </div>
          <div class="p-4">
            <h3 class="text-lg font-semibold text-gray-800 mb-2"><%= course.title %></h3>
            <p class="text-gray-600 text-sm mb-3 line-clamp-2"><%= course.description %></p>
            <div class="flex items-center justify-between text-sm text-gray-500">
              <span>年龄段: <%= course.age_range %></span>
              <span><%= course.duration_minutes %>分钟</span>
            </div>
            <%= link_to "查看详情", course_path(course), class: "mt-4 block text-center w-full py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition" %>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <section>
    <h2 class="text-2xl font-bold mb-6 text-gray-800">近期活动</h2>
    <div class="bg-white rounded-lg shadow-md divide-y">
      <% @upcoming_sessions.each do |session| %>
        <div class="p-4 flex items-center justify-between">
          <div>
            <h3 class="font-semibold text-gray-800"><%= session.course.title %></h3>
            <p class="text-sm text-gray-500">
              <%= session.start_at.strftime('%Y年%m月%d日 %H:%M') %> - <%= session.end_at.strftime('%H:%M') %>
              &nbsp;·&nbsp; <%= session.location %>
            </p>
          </div>
          <div class="text-right">
            <p class="text-sm text-gray-500">剩余名额: <span class="text-blue-600 font-semibold"><%= session.available_spots %></span></p>
            <% if user_signed_in? && session.can_register? %>
              <%= link_to "立即报名", new_registration_path(session_id: session.id), class: "ml-4 px-4 py-2 bg-blue-600 text-white text-sm rounded hover:bg-blue-700 transition" %>
            <% end %>
          </div>
        </div>
      <% end %>
      <% if @upcoming_sessions.empty? %>
        <div class="p-8 text-center text-gray-500">
          暂无近期活动
        </div>
      <% end %>
    </div>
  </section>
</div>
