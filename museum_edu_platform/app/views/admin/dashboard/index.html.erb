<% provide :page_title, '仪表盘' %>

<div class="space-y-6">
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center">
        <div class="p-3 rounded-full bg-blue-100 text-blue-600">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>
        <div class="ml-4">
          <p class="text-sm text-gray-500">开设课程</p>
          <p class="text-2xl font-bold text-gray-800"><%= @active_courses_count %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center">
        <div class="p-3 rounded-full bg-green-100 text-green-600">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
        </div>
        <div class="ml-4">
          <p class="text-sm text-gray-500">学生总数</p>
          <p class="text-2xl font-bold text-gray-800"><%= @total_students %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center">
        <div class="p-3 rounded-full bg-purple-100 text-purple-600">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </div>
        <div class="ml-4">
          <p class="text-sm text-gray-500">讲解员</p>
          <p class="text-2xl font-bold text-gray-800"><%= @active_guides_count %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center">
        <div class="p-3 rounded-full bg-yellow-100 text-yellow-600">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <div class="ml-4">
          <p class="text-sm text-gray-500">待审核报名</p>
          <p class="text-2xl font-bold text-yellow-600"><%= @pending_registrations.count %></p>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white rounded-lg shadow">
      <div class="p-4 border-b">
        <h3 class="font-semibold text-gray-800">今日场次</h3>
      </div>
      <div class="p-4">
        <% if @today_sessions.any? %>
          <div class="space-y-3">
            <% @today_sessions.each do |session| %>
              <div class="flex items-center justify-between p-3 bg-gray-50 rounded">
                <div>
                  <p class="font-medium text-gray-800"><%= session.course.title %></p>
                  <p class="text-sm text-gray-500">
                    <%= session.start_at.strftime('%H:%M') %> - <%= session.end_at.strftime('%H:%M') %>
                    &nbsp;·&nbsp; <%= session.location %>
                  </p>
                </div>
                <span class="px-2 py-1 text-xs bg-blue-100 text-blue-700 rounded">
                  <%= session.status %>
                </span>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-gray-500 text-center py-4">今日暂无场次</p>
        <% end %>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow">
      <div class="p-4 border-b flex items-center justify-between">
        <h3 class="font-semibold text-gray-800">待审核报名</h3>
        <%= link_to "查看全部", admin_registrations_path(status: :pending), class: "text-sm text-blue-600 hover:text-blue-800" %>
      </div>
      <div class="p-4">
        <% if @pending_registrations.any? %>
          <div class="space-y-3">
            <% @pending_registrations.limit(5).each do |registration| %>
              <div class="flex items-center justify-between p-3 bg-yellow-50 rounded">
                <div>
                  <p class="font-medium text-gray-800"><%= registration.contact_name %></p>
                  <p class="text-sm text-gray-500">
                    <%= registration.session.course.title %>
                    &nbsp;·&nbsp; <%= registration.student_count %>人
                  </p>
                </div>
                <%= link_to "审核", admin_registration_path(registration), class: "text-sm text-blue-600 hover:text-blue-800" %>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-gray-500 text-center py-4">暂无待审核报名</p>
        <% end %>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow">
    <div class="p-4 border-b">
      <h3 class="font-semibold text-gray-800">即将开始的场次</h3>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left text-sm font-medium text-gray-500">课程名称</th>
            <th class="px-4 py-3 text-left text-sm font-medium text-gray-500">时间</th>
            <th class="px-4 py-3 text-left text-sm font-medium text-gray-500">地点</th>
            <th class="px-4 py-3 text-left text-sm font-medium text-gray-500">报名/容量</th>
            <th class="px-4 py-3 text-left text-sm font-medium text-gray-500">状态</th>
          </tr>
        </thead>
        <tbody class="divide-y">
          <% @upcoming_sessions.each do |session| %>
            <tr>
              <td class="px-4 py-3"><%= session.course.title %></td>
              <td class="px-4 py-3 text-sm text-gray-600"><%= session.start_at.strftime('%m-%d %H:%M') %></td>
              <td class="px-4 py-3 text-sm text-gray-600"><%= session.location %></td>
              <td class="px-4 py-3 text-sm text-gray-600"><%= session.registered_count %>/<%= session.capacity %></td>
              <td class="px-4 py-3">
                <span class="px-2 py-1 text-xs bg-green-100 text-green-700 rounded">
                  <%= session.status %>
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
