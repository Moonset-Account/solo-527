
<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to '← 返回报名列表', admin_registrations_path, class: "text-blue-600 hover:text-blue-800" %>
  </div>

  <div class="bg-white rounded-lg shadow-md overflow-hidden">
    <div class="px-6 py-4 border-b bg-gray-50">
      <div class="flex items-center justify-between">
        <h1 class="text-xl font-bold text-gray-900">报名审核</h1>
        <span class="inline-block px-3 py-1 rounded-full text-sm font-medium 
          <%= case @registration.status
                when 'pending' then 'bg-yellow-100 text-yellow-800'
                when 'approved' then 'bg-green-100 text-green-800'
                when 'rejected' then 'bg-red-100 text-red-800'
                when 'cancelled' then 'bg-gray-100 text-gray-800'
                else 'bg-blue-100 text-blue-800'
              end %>">
          <%= case @registration.status
              when 'pending' then '待审核'
              when 'approved' then '已通过'
              when 'rejected' then '已拒绝'
              when 'cancelled' then '已取消'
              when 'completed' then '已完成'
              else @registration.status
            end %>
        </span>
      </div>
    </div>

    <div class="p-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-blue-50 rounded-lg p-4">
          <h2 class="font-medium text-blue-900 mb-3">活动信息</h2>
          <div class="space-y-2 text-sm">
            <div>
              <span class="text-blue-700">课程：</span>
              <span class="font-medium"><%= @registration.session.course.title %></span>
            </div>
            <div>
              <span class="text-blue-700">时间：</span>
              <span class="font-medium"><%= @registration.session.start_at.strftime('%Y年%m月%d日 %H:%M') %></span>
            </div>
            <div>
              <span class="text-blue-700">场次容量：</span>
              <span class="font-medium"><%= @registration.session.capacity %>人</span>
            </div>
            <div>
              <span class="text-blue-700">剩余名额：</span>
              <span class="font-medium <%= @registration.session.available_spots > 0 ? 'text-green-600' : 'text-red-600' %>"><%= @registration.session.available_spots %>人</span>
            </div>
          </div>
        </div>

        <div class="bg-green-50 rounded-lg p-4">
          <h2 class="font-medium text-green-900 mb-3">报名信息</h2>
          <div class="space-y-2 text-sm">
            <div>
              <span class="text-green-700">类型：</span>
              <span class="font-medium"><%= @registration.school_group? ? '学校团体' : '散客报名' %></span>
            </div>
            <div>
              <span class="text-green-700">人数：</span>
              <span class="font-medium"><%= @registration.student_count %>人</span>
            </div>
            <% if @registration.school.present? %>
              <div>
                <span class="text-green-700">学校：</span>
                <span class="font-medium"><%= @registration.school.name %></span>
              </div>
            <% end %>
            <% if @registration.user.present? %>
              <div>
                <span class="text-green-700">提交用户：</span>
                <span class="font-medium"><%= @registration.user.name %></span>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="mt-6">
        <h2 class="font-medium text-gray-900 mb-3">联系人信息</h2>
        <div class="bg-gray-50 rounded-lg p-4 grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
          <div>
            <span class="text-gray-500">姓名</span>
            <div class="font-medium"><%= @registration.contact_name %></div>
          </div>
          <div>
            <span class="text-gray-500">电话</span>
            <div class="font-medium"><%= @registration.contact_phone %></div>
          </div>
          <div>
            <span class="text-gray-500">邮箱</span>
            <div class="font-medium"><%= @registration.contact_email %></div>
          </div>
        </div>
      </div>

      <% if @registration.students.any? %>
        <div class="mt-6">
          <h2 class="font-medium text-gray-900 mb-3">学生名单 <span class="text-sm font-normal text-gray-500">(儿童信息最小化采集)</span></h2>
          <div class="bg-gray-50 rounded-lg overflow-hidden">
            <table class="w-full text-sm">
              <thead class="bg-gray-100">
                <tr>
                  <th class="px-4 py-2 text-left font-medium text-gray-600">姓名</th>
                  <th class="px-4 py-2 text-left font-medium text-gray-600">性别</th>
                  <th class="px-4 py-2 text-left font-medium text-gray-600">年龄段</th>
                  <th class="px-4 py-2 text-left font-medium text-gray-600">学校</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">
                <% @registration.students.each do |student| %>
                  <tr>
                    <td class="px-4 py-2"><%= student.name %></td>
                    <td class="px-4 py-2"><%= student.gender == 'male' ? '男' : student.gender == 'female' ? '女' : '其他' %></td>
                    <td class="px-4 py-2">
                      <% case student.age_group
                         when 'preschool' then '学龄前'
                         when 'primary_1_2' then '小学1-2年级'
                         when 'primary_3_4' then '小学3-4年级'
                         when 'primary_5_6' then '小学5-6年级'
                         when 'junior_high' then '初中'
                         when 'senior_high' then '高中'
                         else student.age_group
                         end %>
                    </td>
                    <td class="px-4 py-2"><%= student.school&.name || '无' %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <p class="text-xs text-gray-500 mt-2">* 仅采集姓名、性别、年龄段，不采集身份证号、家庭住址、家长联系方式等敏感信息</p>
        </div>
      <% end %>

      <% if @registration.notes.present? %>
        <div class="mt-6">
          <h2 class="font-medium text-gray-900 mb-3">备注</h2>
          <div class="bg-gray-50 rounded-lg p-4 text-sm text-gray-700">
            <%= @registration.notes %>
          </div>
        </div>
      <% end %>

      <% if @registration.rejected? && @registration.rejection_reason.present? %>
        <div class="mt-6">
          <h2 class="font-medium text-red-800 mb-3">拒绝原因</h2>
          <div class="bg-red-50 border border-red-200 rounded-lg p-4 text-sm text-red-700">
            <%= @registration.rejection_reason %>
          </div>
        </div>
      <% end %>

      <% if @registration.pending? %>
        <div class="mt-6 border-t pt-6">
          <h2 class="font-medium text-gray-900 mb-4">审核操作</h2>
          
          <div class="flex flex-col sm:flex-row gap-4">
            <%= button_to '通过报名', approve_admin_registration_path(@registration), 
              method: :post, 
              data: { confirm: '确定通过此报名？' },
              class: "flex-1 bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700 transition-colors font-medium" %>
            
            <button type="button" onclick="document.getElementById('reject-modal').classList.remove('hidden')"
              class="flex-1 bg-red-600 text-white px-6 py-3 rounded-lg hover:bg-red-700 transition-colors font-medium">
              拒绝报名
            </button>
          </div>
        </div>
      <% end %>
    </div>

    <% if @registration.versions.any? %>
      <div class="border-t">
        <div class="px-6 py-4 bg-gray-50">
          <h2 class="font-medium text-gray-900">操作审计记录</h2>
        </div>
        <div class="px-6 py-4">
          <div class="space-y-3">
            <% @registration.versions.recent.each do |version| %>
              <div class="flex items-start gap-3 text-sm">
                <div class="flex-shrink-0 w-2 h-2 mt-2 rounded-full bg-blue-500"></div>
                <div class="flex-1">
                  <div class="text-gray-900">
                    <% if version.event == 'create' %>
                      创建报名
                    <% elsif version.event == 'update' %>
                      更新报名
                    <% else %>
                      <%= version.event %>
                    <% end %>
                    <% if version.whodunnit.present? %>
                      <span class="text-gray-500">by <%= User.find_by(id: version.whodunnit)&.name || '系统' %></span>
                    <% end %>
                  </div>
                  <div class="text-gray-500 text-xs"><%= version.created_at.strftime('%Y-%m-%d %H:%M:%S') %></div>
                  <% if version.changeset.present? %>
                    <div class="mt-1 text-xs text-gray-600 bg-gray-50 rounded p-2">
                      <% version.changeset.each do |field, (old_val, new_val)| %>
                        <% next if %w[updated_at created_at].include?(field) %>
                        <div><%= field.humanize %>: <%= old_val %> → <%= new_val %></div>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<div id="reject-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center z-50">
  <div class="bg-white rounded-lg max-w-md w-full mx-4">
    <div class="px-6 py-4 border-b">
      <h3 class="text-lg font-medium text-gray-900">拒绝报名</h3>
    </div>
    <%= form_tag reject_admin_registration_path(@registration), method: :post do %>
      <div class="p-6">
        <label class="block text-sm font-medium text-gray-700 mb-2">拒绝原因</label>
        <textarea name="rejection_reason" rows="4" required
          class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-red-500 focus:border-red-500"
          placeholder="请填写拒绝原因..."></textarea>
      </div>
      <div class="px-6 py-4 bg-gray-50 rounded-b-lg flex justify-end gap-3">
        <button type="button" onclick="document.getElementById('reject-modal').classList.add('hidden')"
          class="px-4 py-2 text-gray-600 hover:text-gray-800">
          取消
        </button>
        <%= submit_tag '确认拒绝', class: "bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition-colors" %>
      </div>
    <% end %>
  </div>
</div>
